// VAYREN dark visual identity (matches the Qt APP_PALETTE family: cool
// near-black surfaces, teal accent, muted grays). Palette-only — no
// component may hardcode colors outside this global.

export global VayrenPalette {
    out property <color> bg: #101418;
    out property <color> surface: #141922;
    out property <color> hover: #1a222c;
    out property <color> hairline: #232a35;
    out property <color> text: #d7dde8;
    out property <color> muted: #8a93a6;
    out property <color> faint: #5d6778;
    out property <color> accent: #26a69a;
    out property <color> teal: #26a69a;
    out property <color> accent-text: #0b0f13;
    out property <color> red: #ef5350;
    out property <color> amber: #d9a441;
}
