// VAYREN canonical UI tokens — single source of truth for the native shell.
//
// Values are canonical: a use site that disagrees is wrong — fix it here,
// never add a second literal. No component may hardcode colors, type
// sizes, spacing, or radii outside VayrenPalette / VayrenDesign.

export global VayrenPalette {
    // Surfaces (§3.1).
    out property <color> bg: #070B10;
    out property <color> bg1: #0B1017;
    out property <color> bg2: #0F151D;
    out property <color> surface: #101720;
    out property <color> hover: #131B24;
    out property <color> selected: #18212C;
    out property <color> hairline: #202B36;
    out property <color> hairline-soft: #1A232D;
    // Premium interaction states (UI polish — never overrides above).
    out property <color> pressed: #0D1520;
    out property <color> focus-ring: #00C7B740;
    out property <color> elevated: #121A24;
    out property <color> row-hover: #151E29;
    // Accent + text.
    out property <color> accent: #00C7B7;
    out property <color> accent-dim: #00A99D;
    out property <color> accent-text: #04211E;
    out property <color> text: #E6EDF3;
    out property <color> muted: #8B98A7;
    out property <color> faint: #596675;
    // Semantics (§3.1, §10) — identical on every screen.
    out property <color> pos: #21C58B;
    out property <color> pos-dim: #16493A;
    out property <color> neg: #F05A67;
    out property <color> neg-dim: #4A2027;
    out property <color> amber: #DDAA45;
    out property <color> warn-dim: #4A3C18;
    // Strategy-marker parity tokens (legacy PlotOverlay glyph colors — the
    // reference chart paints EOD blue / diamond purple; no palette hue
    // matches, so they land here explicitly instead of as screen literals).
    out property <color> strat-blue: #42A5F5;
    out property <color> strat-purple: #AB47BC;
    out property <color> strat-orange: #FF7043;
    // Legacy aliases — do NOT use in new code; kept so existing surfaces
    // keep compiling while they converge onto the canonical names above.
    out property <color> teal: #21C58B;
    out property <color> red: #F05A67;
}

export global VayrenDesign {
    // Spacing scale (§3.3) — every margin/padding/gap derives from these.
    // Typed <length> so uses need no conversion; single values only.
    out property <length> sp-xs: 2px;
    out property <length> sp-sm: 4px;
    out property <length> sp-md: 8px;
    out property <length> sp-lg: 12px;
    out property <length> sp-xl: 16px;
    out property <length> sp-xxl: 24px;
    // Fixed chrome heights (§3.3).
    out property <length> h-topbar: 42px;
    out property <length> h-context: 34px;
    out property <length> h-tabs: 34px;
    out property <length> h-strip: 36px;
    out property <length> row-height: 22px;
    // Radii (§3.3).
    out property <length> radius: 4px;
    out property <length> radius-sm: 3px;
    out property <length> radius-lg: 6px;
    // Extra spacing / sizing (UI polish).
    out property <length> sp-3xl: 32px;
    out property <length> fs-kpi: 22px;
    // Typography (§3.2). Floor: nothing renders below fs-label (11).
    out property <length> fs-display: 24px;
    out property <length> fs-hero: 26px;
    out property <length> fs-title: 18px;
    out property <length> fs-metric: 19px;
    out property <length> fs-metric-sm: 16px;
    out property <length> fs-body: 14px;
    out property <length> fs-table: 13px;
    out property <length> fs-small: 12px;
    out property <length> fs-label: 11px;
    // Shell minima (§5) — smallest usable window, logical units.
    out property <length> shell-min-width: 1024px;
    out property <length> shell-min-height: 640px;
    out property <length> rail-width: 104px;
    out property <length> status-height: 24px;
    // Reflow breakpoint (§5): KPI grids fold 4→2 columns below this width.
    out property <length> kpi-fold-width: 620px;
    // Research recomposition breakpoints (§5): three-region ≥ wide,
    // navigator + workspace with inspector drawer ≥ medium, single-column
    // view tabs below. Logical px — DPI-independent by construction.
    out property <length> research-wide: 1180px;
    out property <length> research-medium: 760px;
    // Research chrome heights (§3.3): state-driven log telemetry.
    out property <length> research-log-compact: 46px;
    out property <length> research-log-expanded: 132px;
    out property <length> research-inspector-drawer: 240px;
    // Live recomposition breakpoints (§29) — derived from CONTENT MINIMA
    // (logical px, DPI-independent): dock the inspector only when the
    // 440 px workspace floor + 340 px inspector floor + gutters fit; show
    // bar groups only while their labels stay readable side by side.
    out property <length> live-dock-inspector: 800px;
    out property <length> live-bar-core: 760px;
    out property <length> live-bar-secondary: 1040px;
    out property <length> live-bar-extended: 1120px;
    out property <length> live-blotter-side-by-side: 1240px;
    // Market recomposition breakpoints (§5): full workstation (rail +
    // watchlist + chart + inspector) ≥ wide; inspector becomes a drawer
    // below wide; watchlist compacts to a symbol strip below medium.
    // Logical px — DPI-independent by construction.
    out property <length> market-wide: 1180px;
    out property <length> market-medium: 820px;
}

export global LabPalette {
    // Strategy Lab redesign — exact reference CSS variable match.
    // These are ONLY for lab.slint; no other surface may use lab-* tokens.
    // Colour-role names carry the lab- prefix so a role stays defined once
    // repo-wide (validate_authority duplicate-token gate).
    // Surfaces.
    out property <color> lab-bg:   #06090c;
    out property <color> panel:    #0a0f14;
    out property <color> panel2:   #0c1219;
    out property <color> inset:    #080d12;
    // Borders.
    out property <color> line:     rgba(255,255,255, 0.08);
    out property <color> line2:    rgba(255,255,255, 0.045);
    // Text.
    out property <color> lab-text: #eef3f5;
    out property <color> soft:     #c2ccd1;
    out property <color> lab-muted:#7b8790;
    out property <color> dim:      #525e67;
    out property <color> lab-faint:#39434b;
    // Accent.
    out property <color> lab-teal: #2dd4bf;
    out property <color> teal-dim: rgba(45,212,191, 0.12);
    // Semantics.
    out property <color> lab-red:  #f87171;
    out property <color> red-dim:  rgba(248,113,113, 0.08);
    out property <color> green:    #34d399;
    out property <color> green-dim:rgba(52,211,153, 0.12);
    out property <color> lab-amber:#e5b45c;
    out property <color> amber-dim:rgba(229,180,92, 0.05);
    // Typography.
    out property <length> fs-strat-name: 44px;
    out property <length> fs-strat-name-sm: 34px;
    out property <length> fs-outcome: 46px;
    out property <length> fs-outcome-sm: 36px;
    out property <length> fs-insp-big: 30px;
    out property <length> fs-outcome-sm2: 13px;
    // Layout.
    out property <length> topbar-h: 58px;
    out property <length> rail-h:   42px;
    out property <length> max-w:    1280px;
    out property <length> ws-px:    26px;
    out property <length> ws-py:    30px;
    out property <length> section-radius: 14px;
    out property <length> section-gap: 44px;
    out property <length> field-h:  36px;
    out property <length> insp-w:   330px;
    out property <length> dialog-w: 460px;
    // Breakpoints.
    out property <length> bp-wide: 1100px;
    out property <length> bp-narrow: 720px;
    // Extra reference surfaces.
    out property <color> code-bg:      #070c11;
    out property <color> chip-bg:      #080c0f;
    out property <color> panel3:       #0b1218;
    out property <color> field-bg:     #0d141b;
    out property <color> dialog-bg:    #0e151c;
    out property <color> run-done-bg:  #0f2e26;
    out property <color> hover2:       #141c23;
    out property <color> selected2:    #16202a;
    out property <color> btn-idle-bg:  #242c33;
    out property <color> run-error-bg: #331416;
    // RUN primary button interaction states (§15): hover lifts, press dips.
    out property <color> run-hover:    #f4f8fa;
    out property <color> run-press:    #cfd9de;
    out property <color> run-done-hover: #14402f;
    out property <color> run-done-press: #0a2019;
    out property <color> green-bright: #5eeab0;
    out property <color> soft2:        #dfe6ea;
    out property <color> run-ink:      #e8eef1;
    out property <color> red-soft:     #fca5a5;
    // Alpha tints (reference rgba values, CSS #RRGGBBAA order — Slint
    // parses 8-digit hex like CSS; pixel-verified: wrong order painted
    // white-06 as opaque cyan).
    out property <color> scrim:     #00000099;
    out property <color> white-02:  #ffffff05;
    out property <color> white-04:  #ffffff0a;
    out property <color> white-05:  #ffffff0d;
    out property <color> white-06:  #ffffff0f;
    out property <color> white-16:  #ffffff29;
    out property <color> white-20:  #ffffff33;
    out property <color> teal-06:   #2dd4bf0f;
    out property <color> teal-25:   #2dd4bf40;
    out property <color> teal-35:   #2dd4bf59;
    out property <color> teal-40:   #2dd4bf66;
    out property <color> red-06:    #f871710f;
    out property <color> red-08:    #f8717114;
    out property <color> red-12:    #f871711f;
    out property <color> red-35:    #f8717159;
    out property <color> green-30:  #34d3994d;
    out property <color> green-35:  #34d39959;
    out property <color> amber-05:  #e5b45c0d;
    out property <color> amber-06:  #e5b45c0f;
    out property <color> amber-08:  #e5b45c14;
    out property <color> amber-25:  #e5b45c40;
    out property <color> amber-30:  #e5b45c4d;
}
