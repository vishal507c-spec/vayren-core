    in-out property <int> portfolio-selected-position: -1;
    in-out property <[PortfolioAlloc]> portfolio-allocation;
    in-out property <bool> portfolio-alloc-has-data: false;
    in-out property <string> portfolio-detail-symbol: "";
    in-out property <string> portfolio-detail-side: "";
    in-out property <int> portfolio-detail-side-tone: 0;
    in-out property <string> portfolio-detail-qty: "";
    in-out property <string> portfolio-detail-avg: "";
    in-out property <string> portfolio-detail-value: "";
    in-out property <string> portfolio-detail-pnl: "";
    in-out property <int> portfolio-detail-pnl-tone: 0;
    in-out property <string> portfolio-detail-alloc: "";
    in-out property <int> portfolio-orders-tab: 0;
    in-out property <[PortfolioOrder]> portfolio-orders;
    in-out property <[PortfolioFill]> portfolio-fills;
    in-out property <bool> portfolio-active-has-rows: false;
    in-out property <string> portfolio-active-empty-title: "";
    in-out property <string> portfolio-active-empty-detail: "";
    in-out property <string> portfolio-health-label: "";
    in-out property <int> portfolio-health-tone: 0;
    in-out property <string> portfolio-health-note: "";
    in-out property <[PortfolioRisk]> portfolio-risk-rows;
    in-out property <bool> portfolio-risk-has-data: false;
    in-out property <string> portfolio-risk-empty-detail: "";

    // LIVE — projected LiveState (Rust owns it; these are render data only).
    in-out property <LiveBar> live-bar;
    in-out property <LiveSetup> live-setup;
    in-out property <LiveMarket> live-market;
    in-out property <[LiveCandle]> live-candles;
    in-out property <[string]> live-strategy-names;
    in-out property <int> live-strategy-selected: -1;
    in-out property <[LiveSymbolRow]> live-symbols;
    in-out property <string> live-symbol-filter;
    in-out property <[string]> live-timeframe-names;
    in-out property <int> live-timeframe-selected: -1;
    in-out property <[LiveGate]> live-gates;
    in-out property <string> live-arm-note;
    in-out property <[string]> live-blockers;
    in-out property <[LiveKv]> live-strategy-rows;
    in-out property <[LiveKv]> live-position-rows;
    in-out property <[LiveKv]> live-risk-rows;
    in-out property <[LiveKv]> live-broker-rows;
    in-out property <[LiveKv]> live-recon-rows;
    in-out property <[LivePosition]> live-positions;
    in-out property <[LiveOrder]> live-orders;
    in-out property <[LiveFill]> live-fills;
    in-out property <[LiveStat]> live-stats;
    in-out property <[LiveEventRow]> live-events;
    in-out property <[string]> live-event-types;
    in-out property <int> live-event-type-index: 0;
    in-out property <string> live-event-filter;
    in-out property <bool> live-inspector-open: true;
    // LIVE recomposition tiers evaluated against the content column width
    // (the window size is platform-owned — screens derive layout from these
    // inputs, never from their own width: single LiveTiers decision source).
    in-out property <length> live-screen-width: root.width - VayrenDesign.rail-width;
    in-out property <bool> live-dock-inspector: LiveTiers.dock-inspector(root.live-screen-width);
    in-out property <bool> live-bar-core: LiveTiers.bar-core(root.live-screen-width);
    in-out property <bool> live-bar-secondary: LiveTiers.bar-secondary(root.live-screen-width);
    in-out property <bool> live-bar-extended: LiveTiers.bar-extended(root.live-screen-width);
    in-out property <bool> live-blotter-side: LiveTiers.blotters-side-by-side(root.live-screen-width);
    in-out property <bool> live-tall-inspector: (root.height - VayrenDesign.h-nav-header - VayrenDesign.status-height) >= 720px;
    in-out property <length> live-inspector-w: LiveTiers.inspector-width(root.live-screen-width);

    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.alt && event.text == "1") {
                root.nav-selected(ShellScreen.chart);
                return accept;
            }
            if (event.modifiers.alt && event.text == "2") {
                root.nav-selected(ShellScreen.lab);
                return accept;
            }
            if (event.modifiers.alt && event.text == "3") {
                root.nav-selected(ShellScreen.research);
                return accept;
            }
            if (event.modifiers.alt && event.text == "4") {
                root.nav-selected(ShellScreen.portfolio);
                return accept;
            }
            if (event.modifiers.alt && event.text == "5") {
                root.nav-selected(ShellScreen.live);
                return accept;
            }
            if (event.modifiers.alt && event.text == "6") {
                root.nav-selected(ShellScreen.broker);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0;

        // Global top navigation header (50px, horizontal, minimal Apple-grade design)
        VGlobalHeader {
            active-screen: root.active-screen;
            nav-selected(screen) => {
                root.nav-selected(screen);
            }
        }


            Rectangle {
                background: VayrenPalette.bg;

                if root.screen-pending: PendingCard {
                    card-title: root.screen-title;
                }
                if !root.screen-pending && root.active-screen == ShellScreen.chart: MarketScreen {
                    width: 100%;
                    height: 100%;
                    panel-visible: root.market-panel-visible;
