// VAYREN application shell â€” Rust + Slint native UI (AI_ENTRY.md §1).
//
// Presentation only: every displayed value is bound to a property fed by the
// Rust side from the BrokerPanel view-model (backend facts, never UI
// inference). Screens not yet migrated render their honest migration state.

import { VayrenPalette, VayrenDesign } from "palette.slint";
import { VBadge, VButton } from "components.slint";
import { StrategyLabScreen, LabHeader, LabLibraryRow, LabKpi, LabRankRow, LabTradeRow, LabPoint, LabParam, LabDetailMetric, LabBoardCell, LabMatrixRow, LabPreset } from "lab.slint";
import { MarketScreen, MarketWatchRow, MarketCandle, MarketTick, MarketRayLevel, MarketTimeframe, MarketIndicator, MarketStatusRow, MarketSettingsRow, MarketPopupRow, MarketPlotSeg, MarketMarker, MarketTradeContext, DlPlan, DlStatus, DlCalDay, DlCredField, DlStock } from "market.slint";
import { ResearchScreen, ResearchMetric, ResearchSignalRow, ResearchTradeRow, ResearchRobustRow, ResearchKv, ResearchCompareRow, ResearchStrategyRow, ResearchExperimentRow, ResearchField, ResearchConfigGroup, ResearchEvidenceDim, ResearchEvidenceWhy, ResearchKvGroup } from "research.slint";
import { PortfolioScreen, PortfolioKpi, PortfolioGate, PortfolioPosition, PortfolioAlloc, PortfolioOrder, PortfolioFill, PortfolioRisk } from "portfolio.slint";
import { LiveScreen, LiveBar, LiveSetup, LiveMarket, LiveSymbolRow, LiveGate, LiveKv, LiveStat, LivePosition, LiveOrder, LiveFill, LiveEventRow, LiveCandle, LiveTiers } from "live.slint";
import { BrokerPanel, BrokerCheckRow } from "broker.slint";
import { BrokerConnectionWorkspace, BrokerRowView, CredentialFieldView, ProgressStepView } from "broker_connection.slint";

import { ShellScreen, VGlobalHeader, VGlobalNavItem } from "global_header.slint";
export { ShellScreen }

export struct CapabilityRowView {
    id: string,
    label: string,
    kind: int,
}

    component PendingCard inherits Rectangle {
    in property <string> card-title;

    background: transparent;

    Rectangle {
        width: 420px;
        height: 132px;
        border-radius: VayrenDesign.radius;
        background: VayrenPalette.surface;
        border-width: 1px;
        border-color: VayrenPalette.hairline;

        VerticalLayout {
            padding: VayrenDesign.sp-xl;
            spacing: VayrenDesign.sp-md;
            alignment: center;

            Text {
                text: root.card-title;
                color: VayrenPalette.text;
                font-size: VayrenDesign.fs-body;
                font-weight: 700;
            }
            VBadge {
                text: "PENDING MIGRATION";
                tone: 2;
            }
            Text {
                text: "This workspace currently lives in the legacy Python application. Its native surface arrives in a later migration slice.";
                color: VayrenPalette.muted;
                font-size: VayrenDesign.fs-label;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "VAYREN";
    background: VayrenPalette.bg;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 640px;

    callback nav-selected(ShellScreen);
    callback reset-zoom();

    // Broker parity actions (Slint reports intent only; the embed host
    // dispatches to BrokerManager. The standalone shell leaves these
    // unwired — demo surface, no backend).
    callback broker-login-requested();
    callback broker-refresh-requested();
    callback broker-disconnect-requested();
    callback broker-remove-requested();
    callback broker-config-saved(string, string);
    callback broker-copy-callback();
    // Broker CONNECTION workspace actions (Slint reports intent only; the
    // embed host dispatches to BrokerManager/selection service. Retry reuses
    // the login intent, Manage reuses refresh, Disconnect is shared).
    callback broker-select-requested(string);
    callback broker-connect-requested(string, string, string, string, string, string);
    callback broker-help-requested();
    callback broker-add-requested();
    callback broker-paste-requested(int);

    // Strategy Lab interactions (Slint reports; Rust view-model owns state).
    callback lab-library-picked(int);
    callback lab-filter-picked(int);
    callback lab-search-changed(string);
    callback lab-mode-picked(int);
    callback lab-tab-picked(int);
    callback lab-run-requested();
    callback lab-save-requested();
    callback lab-compile-requested();
    callback lab-new-requested();
    callback lab-row-menu(int);
    callback lab-rank-picked(string);
