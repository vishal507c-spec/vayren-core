                    evidence-why: root.research-evidence-why;
                    evidence-dims: root.research-evidence-dims;
                    stats-rows: root.research-stats-rows;
                    montecarlo-rows: root.research-montecarlo-rows;
                    benchmark-rows: root.research-benchmark-rows;
                    inspector-groups: root.research-inspector-groups;
                    tab: root.research-tab;
                    inspector-open: root.research-inspector-open;
                    narrow-view: root.research-narrow-view;
                    signal-filter: root.research-signal-filter;
                    log-lines: root.research-log-lines;
                    log-status: root.research-log-status;
                    log-expanded: root.research-log-expanded;
                    hypothesis-open: root.research-hypothesis-open;
                    why-open: root.research-why-open;
                    technical-open: root.research-technical-open;
                    show-next-steps: root.research-show-next-steps;
                    strategy-picked(idx) => { root.research-strategy-picked(idx); }
                    config-edited(k, t) => { root.research-config-edited(k, t); }
                    config-option(k, v) => { root.research-config-option(k, v); }
                    hypothesis-edited(t) => { root.research-hypothesis-edited(t); }
                    question-edited(t) => { root.research-question-edited(t); }
                    effect-edited(t) => { root.research-effect-edited(t); }
                    create-pressed() => { root.research-create-pressed(); }
                    run-pressed() => { root.research-run-pressed(); }
                    cancel-pressed() => { root.research-cancel-pressed(); }
                    tab-picked(i) => { root.research-tab-picked(i); }
                    inspector-toggled() => { root.research-inspector-toggled(); }
                    narrow-view-picked(i) => { root.research-narrow-view-picked(i); }
                    signal-filter-changed(t) => { root.research-signal-filter-changed(t); }
                    experiment-picked(i) => { root.research-experiment-picked(i); }
                    hypothesis-toggled() => { root.research-hypothesis-toggled(); }
                    why-toggled() => { root.research-why-toggled(); }
                    technical-toggled() => { root.research-technical-toggled(); }
                }
                if !root.screen-pending && root.active-screen == ShellScreen.live: LiveScreen {
                    width: 100%;
                    height: 100%;
                    bar: root.live-bar;
                    inspector-open: root.live-inspector-open;
                    dock-inspector: root.live-dock-inspector;
                    bar-core: root.live-bar-core;
                    bar-secondary: root.live-bar-secondary;
                    bar-extended: root.live-bar-extended;
                    blotters-side-by-side: root.live-blotter-side;
                    tall-inspector: root.live-tall-inspector;
                    inspector-w: root.live-inspector-w;
                    setup: root.live-setup;
                    market: root.live-market;
                    candles: root.live-candles;
                    strategy-names: root.live-strategy-names;
                    strategy-selected: root.live-strategy-selected;
                    symbols: root.live-symbols;
                    symbol-filter: root.live-symbol-filter;
                    timeframe-names: root.live-timeframe-names;
                    timeframe-selected: root.live-timeframe-selected;
                    gates: root.live-gates;
                    arm-note: root.live-arm-note;
                    blockers: root.live-blockers;
                    strategy-rows: root.live-strategy-rows;
                    position-rows: root.live-position-rows;
                    risk-rows: root.live-risk-rows;
                    broker-rows: root.live-broker-rows;
                    recon-rows: root.live-recon-rows;
                    positions: root.live-positions;
                    orders: root.live-orders;
                    fills: root.live-fills;
                    stats: root.live-stats;
                    events: root.live-events;
                    event-types: root.live-event-types;
                    event-type-index: root.live-event-type-index;
                    event-filter: root.live-event-filter;
                    mode-picked(k) => { root.live-mode-picked(k); }
                    strategy-picked(i) => { root.live-strategy-picked(i); }
                    symbol-toggled(i) => { root.live-symbol-toggled(i); }
                    symbol-filter-changed(t) => { root.live-symbol-filter-changed(t); }
                    timeframe-picked(i) => { root.live-timeframe-picked(i); }
                    quantity-edited(t) => { root.live-quantity-edited(t); }
                    start-requested() => { root.live-start-requested(); }
                    stop-requested() => { root.live-stop-requested(); }
                    arm-requested() => { root.live-arm-requested(); }
                    halt-requested() => { root.live-halt-requested(); }
                    confirm-requested() => { root.live-confirm-requested(); }
                    event-filter-changed(t) => { root.live-event-filter-changed(t); }
                    event-type-picked(i) => { root.live-event-type-picked(i); }
                    inspector-toggled() => { root.live-inspector-toggled(); }
                    configure-broker() => { root.live-configure-broker(); }
                }
            }
    }
}
