    callback research-experiment-picked(int);
    callback research-hypothesis-toggled();
    callback research-why-toggled();
    callback research-technical-toggled();

    // Portfolio interactions (Slint reports; Rust view-model owns state).
    callback portfolio-refresh-requested();
    callback portfolio-orders-tab-picked(int);
    callback portfolio-position-picked(int);

    // LIVE interactions (Slint reports; Rust view-model owns state).
    callback live-mode-picked(int);
