                    empty-title: root.research-empty-title;
                    empty-detail: root.research-empty-detail;
                    conclusion: root.research-conclusion;
                    validation-status: root.research-validation-status;
                    validation-summary: root.research-validation-summary;
                    fingerprint-line: root.research-fingerprint-line;
                    evidence-verdict: root.research-evidence-verdict;
                    evidence-tone: root.research-evidence-tone;
