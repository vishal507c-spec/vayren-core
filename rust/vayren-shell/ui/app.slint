    // Research interactions (same contract: report-only surface).
    callback research-strategy-picked(int);
    callback research-config-edited(string, string);
    callback research-config-option(string, string);
    callback research-hypothesis-edited(string);
    callback research-question-edited(string);
    callback research-effect-edited(string);
