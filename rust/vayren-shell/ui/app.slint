                    last-price: root.market-last-price;
                    last-price-pos: root.market-last-price-pos;
                    last-price-up: root.market-last-price-up;
                    has-last-price: root.market-has-last-price;
                    volume-max-label: root.market-volume-max-label;
                    last-volume: root.market-last-volume;
                    last-volume-pos: root.market-last-volume-pos;
                    last-volume-up: root.market-last-volume-up;
                    has-last-volume: root.market-has-last-volume;
