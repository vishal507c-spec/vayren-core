// VAYREN Strategy Lab — native Slint workstation surface (AI_ENTRY.md §1).
// Presentation only: every value arrives via the `lab`
// struct + row models projected by the Rust view-model (lab.rs); the screen
// reports user actions through callbacks and never infers state.
//
// Visual contract: ONE unified strategy header (replaces the fragmented
// NO STRATEGY / BUY—LONG / -- / READY strip), mode segmented control lives
// HERE only (floating BUY/LONG box removed), compact institutional config
// toolbar, hairline-separated KPI band (no card-per-metric, Net P&L
// strongest), analysis tabs whose content always fills the remaining space
// (no giant voids), and stock ranking integrated as the PERFORMANCE section.

import { VayrenPalette, VayrenDesign, LabPalette } from "palette.slint";
import { VBadge, VButton, VBanner, VEmptyState, VCell } from "components.slint";
import { ScrollView, TextEdit, Palette } from "std-widgets.slint";

export struct LabPoint {
    x: length,
    y: length,
}

export struct LabHeader {
    has-strategy: bool,
    name: string,
    description: string,
    tags: string,
    version: string,
    modified: string,
    last-backtest: string,
    state-label: string,
    state-tone: int, // VBadge tone
    mode: int,       // 0 LONG, 1 SHORT, 2 COMPARE
    outdated: bool,
    run-enabled: bool,
    universe: string,
    timeframe: string,
    dates: string,
    capital: string,
    show-results: bool,
    tab: int,
    summary-line: string,
    empty-reason: string,
    equity-caption: string,
    drawdown-caption: string,
    ranking-count: string,
    run-stop: bool,
    verdict-label: string,
    verdict-note: string,
    verdict-tone: int,
    progress-label: string,
    run-label: string,
    code: string,
    dirty: bool,
    cfg-universe-csv: string,
    timeframe-index: int,
    cfg-dates-start: string,
    cfg-dates-end: string,
    cfg-capital: string,
    config-error: string,
    rank-search: string,
    rank-desc: bool,
    rankby-current: int,
    trade-needle: string,
    trade-symbol: string,
    trade-filters-active: bool,
    selected-trade: int,
    compare-side: int, // 0 ALL, 1 LONG, 2 SHORT
    is-compare: bool,
    // drill-down (empty symbol = none selected)
    detail-symbol: string,
    detail-title: string,
    detail-stats: string,
    detail-caption: string,
    // compare page
    cmp-verdict: string,
    cmp-reason: string,
    cmp-tone: int,
    cmp-trade-summary: string,
    cmp-stale: string,
    cmp-scope: string,
    cmp-leader: string,
    cmp-has-sides: bool,
    sym-open: bool,
    sym-search: string,
    sym-button-line: string,
    sym-count-line: string,
    // ── Reference redesign additions ──
    cfg-cost: string,
    cfg-cost-warn: bool,
    run-id: string,
    run-ts: string,
    cfg-hash: string,
    result-pnl: string,
    result-return: string,
    result-pnl-tone: int,       // 2=positive, 3=negative
    result-exec-line: string,
    stale-exec-line: string,
    stale-cur-line: string,
    range-line: string,
    diag-show: bool,
    diag-title: string,
    diag-detail: string,
    diag-stale: bool,
    risk-gate-show: bool,
    risk-gate-text: string,
    lens: int,                  // 0=Performance 1=Trades 2=Equity 3=Drawdown 4=Analytics 5=Strategy
    strategy-count-line: string,
    editing-hint: string,
    studio-ref-pf: string,
    studio-source: string,
    equity-select: int,         // 0=Cumulative P&L 1=Daily P&L 2=Return%
    // ── Date-range control (presentation derives from the ISO cfg dates) ──
    dates-human: string,        // "22 Sep 2026 — 22 Sep 2026"
    dates-error: string,        // inline validation, empty = valid
    today-days: int,            // days since 1970-01-01 (calendar anchor)
    // Committed selection as calendar anchors (days since epoch, -1 = unset).
    // Rust parses the ISO fields once — Slint never re-parses strings.
    dates-start-days: int,
    dates-end-days: int,
}

export struct LabPreset {
    label: string,
    start-days: int,            // preset range as days since epoch
    end-days: int,
}

export struct LabLibraryRow {
    real-index: int,
    name: string,
    description: string,
    state-label: string,
    favorite: bool,
    selected: bool,
}

export struct LabKpi {
    label: string,
    value: string,
    tone: int, // 0 muted, 1 neutral, 2 positive, 3 negative, 4 warning
    emphasized: bool,
}

export struct LabRankRow {
    rank: string,
    symbol: string,
    pnl: string,
    ret: string,
    trades: string,
    win: string,
    pf: string,
    dd: string,
    sharpe: string,
    pnl-tone: int,
    pf-tone: int,
    unranked: bool,
}

export struct LabTradeRow {
    no: string,
    abs-index: int,
    symbol: string,
    side: string,
    entry: string,
    entry-px: string,
    exit: string,
    exit-px: string,
    pnl: string,
    r: string,
    bars: string,
    reason: string,
    pnl-tone: int,
    selected: bool,
}

export struct LabParam {
    key: string,
    label: string,
    value: string,
}

export struct LabDetailMetric {
    label: string,
    value: string,
}

export struct LabBoardCell {
    symbol: string,
    text: string,
    best: bool,
}

export struct LabMatrixRow {
    key: string,
    buy: string,
    sell: string,
    winner: int, // 0 none, 1 BUY, 2 SELL
}

// ══════════════ reference-layout helpers ══════════════

component LabEyebrow inherits Rectangle {
    in property <string> eyebrow-text;
    height: 20px;
    width: 100%;
    ebtx := Text {
        text: eyebrow-text;
        font-size: 10px;
        letter-spacing: 1.6px;
        color: LabPalette.dim;
        font-weight: 600;
        x: 0;
        y: (parent.height - self.height) / 2;
    }
    Rectangle {
        x: ebtx.width + 10px;
        y: parent.height / 2;
        height: 1px;
        width: parent.width - ebtx.width - 20px;
        background: LabPalette.line2;
    }
}

component LabRailStep inherits Rectangle {
    in property <string> num;
    in property <string> name;
    in property <bool> step-on: false;
    height: 100%;
    background: rsta.has-hover ? LabPalette.white-02 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;
        alignment: center;
        Text {
            text: root.num;
            font-family: "monospace";
            font-size: 9px;
            color: root.step-on ? LabPalette.lab-teal : LabPalette.lab-faint;
            vertical-alignment: center;
        }
        Text {
            text: root.name;
            font-size: 10px;
            letter-spacing: 0.8px;
            font-weight: root.step-on ? 650 : 400;
            color: root.step-on ? LabPalette.lab-text : rsta.has-hover ? LabPalette.soft : LabPalette.dim;
            vertical-alignment: center;
        }
    }
    rsta := TouchArea { }
    Rectangle {
        x: 0; y: parent.height - 2px; width: 100%; height: 2px;
        background: root.step-on ? LabPalette.lab-teal : transparent;
    }
}

component LabFieldLabel inherits Rectangle {
    in property <string> lbl;
    height: 19px;
    Text {
        text: root.lbl;
        font-size: 9.5px;
        letter-spacing: 1px;
        color: LabPalette.lab-muted;
        vertical-alignment: center;
    }
}

component LabFieldDivider inherits Rectangle {
    width: 1px;
    background: LabPalette.line2;
}

component LabCtlButton inherits Rectangle {
    in property <string> ctl-label;
    in property <length> ctl-h: LabPalette.field-h;
    callback clicked();
    height: root.ctl-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: cbta.has-hover ? LabPalette.white-16 : LabPalette.line;
    cbta := TouchArea {
        mouse-cursor: pointer;
        // Immediate action on press (brief §6): no release-wait latency.
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        Text { text: root.ctl-label; font-size: 12px; color: LabPalette.lab-text; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
        Text { text: "⌄"; color: LabPalette.dim; font-size: 12px; vertical-alignment: center; }
    }
}

// Dark text field — same control family as LabCtlButton (height, radius,
// border, focus). TextInput mirror follows the proven broker_connection
// pattern (local mirror + commit on accepted).
component LabCtlInput inherits Rectangle {
    in property <string> val;
    in property <string> pre-fix: "";
    in property <string> post-fix: "";
    in property <string> ph: "";
    callback committed(string);
    height: LabPalette.field-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: ctl-ti.has-focus ? LabPalette.teal-40 : LabPalette.line;
    property <string> cur: root.val;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        spacing: 0;
        Text { visible: root.pre-fix != ""; text: root.pre-fix; color: LabPalette.dim; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
        ctl-ti := TextInput {
            horizontal-stretch: 1;
            min-width: 0;
            text: root.cur;
            font-family: "monospace";
            font-size: 11.5px;
            color: LabPalette.lab-text;
            single-line: true;
            vertical-alignment: center;
            edited => { root.cur = self.text; }
            accepted => { root.committed(self.text); }
        }
        Text { visible: root.post-fix != ""; text: root.post-fix; color: LabPalette.dim; font-size: 11px; vertical-alignment: center; }
    }
    if root.cur == "": Text {
        // Placeholder overlay (non-interactive; pointer passes through).
        x: root.pre-fix != "" ? 22px : 11px;
        width: parent.width - (root.pre-fix != "" ? 33px : 22px);
        height: 100%;
        text: root.ph;
        color: LabPalette.lab-faint;
        font-size: 11.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Dark live-search field — mirrors text on every edit (filter-as-you-type).
component LabCtlSearch inherits Rectangle {
    in property <string> val;
    in property <string> ph: "";
    in property <length> ctl-h: LabPalette.field-h;
    callback changed(string);
    height: root.ctl-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: s-ti.has-focus ? LabPalette.teal-40 : LabPalette.line;
    property <string> cur: root.val;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        s-ti := TextInput {
            horizontal-stretch: 1;
            min-width: 0;
            text: root.cur;
            font-size: 11.5px;
            color: LabPalette.lab-text;
            single-line: true;
            vertical-alignment: center;
            edited => { root.cur = self.text; root.changed(self.text); }
        }
    }
    if root.cur == "": Text {
        x: 11px;
        width: parent.width - 22px;
        height: 100%;
        text: root.ph;
        color: LabPalette.lab-faint;
        font-size: 11.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component LabTh inherits Rectangle {
    in property <string> th;
    in property <length> tw: 0px;
    in property <int> stretch: 0;
    in property <bool> ta-left: false;
    height: 30px;
    width: root.tw;
    horizontal-stretch: root.stretch;
    Text {
        text: root.th;
        font-size: 8.5px;
        letter-spacing: 0.8px;
        color: LabPalette.dim;
        font-weight: 600;
        horizontal-alignment: root.ta-left ? left : right;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }
}

component LabTd inherits Rectangle {
    in property <string> td;
    in property <length> tw: 0px;
    in property <int> stretch: 0;
    in property <bool> ta-left: false;
    in property <bool> bold: false;
    in property <bool> no-mono: false;
    in property <color> tc: LabPalette.soft;
    height: 40px;
    width: root.tw;
    horizontal-stretch: root.stretch;
    Text {
        text: root.td;
        font-family: root.no-mono ? "Inter" : "monospace";
        font-size: 11.5px;
        font-weight: root.bold ? 650 : 400;
        color: root.tc;
        horizontal-alignment: root.ta-left ? left : right;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }
}

component LabEqStat inherits Rectangle {
    in property <string> es-label;
    in property <string> es-value;
    in property <int> es-tone: 0;
    horizontal-stretch: 1;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 6px;
        Text { text: root.es-label; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.dim; }
        Text {
            text: root.es-value;
            font-family: "monospace";
            font-size: 12.5px;
            color: root.es-tone == 2 ? LabPalette.green : root.es-tone == 3 ? LabPalette.lab-red : LabPalette.lab-text;
            overflow: elide;
        }
    }
}

component LabMetaCell inherits Rectangle {
    in property <string> mc-label;
    in property <string> mc-value;
    horizontal-stretch: 1;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 5px;
        Text { text: root.mc-label; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.dim; }
        Text { text: root.mc-value; font-size: 11.5px; font-family: "monospace"; color: LabPalette.lab-text; overflow: elide; }
    }
}

struct LabCivil {
    y: int,
    m: int,
    d: int,
}

// ── Compact date-range picker ──────────────────────────────────────────
// START → END two-step mental model with live hover preview, presets and
// one-click correction (end-before-start auto-swaps). Pure presentation:
// the calendar is integer civil-date arithmetic; data stays ISO and is
// committed through the existing dates-committed(start, end) contract.
component LabDateRangePicker inherits Rectangle {
    in property <int> start-days;   // committed selection (-1 = unset)
    in property <int> end-days;
    in property <int> today-days;
    in property <[LabPreset]> presets;
    callback committed(string, string);
    callback cancelled();

    width: 296px;
    height: 344px;
    border-radius: 12px;
    background: LabPalette.dialog-bg;
    border-width: 1px;
    border-color: LabPalette.white-16;
    // Swallow background clicks so the scrim below does not close the picker.
    TouchArea { }

    // ---- epoch<->civil (days since 1970-01-01, proleptic Gregorian) ----
    pure function dfc(y: int, m: int, d: int) -> int {
        let my = m <= 2 ? y - 1 : y;
        let era = Math.floor((my >= 0 ? my : my - 399) / 400);
        let yoe = my - era * 400;
        let mp = m + (m > 2 ? -3 : 9);
        let doy = Math.floor((153 * mp + 2) / 5) + d - 1;
        let doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
        return era * 146097 + doe - 719468;
    }
    pure function cfd(z: int) -> LabCivil {
        let zz = z + 719468;
        let era = Math.floor((zz >= 0 ? zz : zz - 146096) / 146097);
        let doe = zz - era * 146097;
        let yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
        let y = yoe + era * 400;
        let doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
        let mp = Math.floor((5 * doy + 2) / 153);
        let d = doy - Math.floor((153 * mp + 2) / 5) + 1;
        let m = mp + (mp < 10 ? 3 : -9);
        return { y: y + (m <= 2 ? 1 : 0), m: m, d: d };
    }
    pure function iso(z: int) -> string {
        let c = root.cfd(z);
        return c.y + "-" + (c.m < 10 ? "0" : "") + c.m + "-" + (c.d < 10 ? "0" : "") + c.d;
    }
    pure function human(z: int) -> string {
        let c = root.cfd(z);
        let mo = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][c.m - 1];
        return c.d + " " + mo + " " + c.y;
    }
    pure function months-of(z: int) -> int {
        let c = root.cfd(z);
        return c.y * 12 + c.m - 1;
    }

    // ---- selection state (-2 = untouched → follow committed props) ----
    property <int> st-start: -2;
    property <int> st-end: -2;
    property <int> a-start: root.st-start == -2 ? root.start-days : root.st-start;
    property <int> a-end: root.st-end == -2 ? root.end-days : root.st-end;
    property <int> hover-days: -1;
    // live preview end: committed/hovered while the START is already set
    property <int> eff-end: root.a-end >= 0 ? root.a-end
        : root.a-start >= 0 && root.hover-days >= root.a-start ? root.hover-days : -1;
    property <bool> picking-end: root.a-start >= 0 && root.a-end < 0;

    function pick(z: int) {
        if (root.a-start < 0 || root.a-end >= 0) {
            // fresh START (also restarts the range after a complete pair)
            root.st-start = z;
            root.st-end = -1;
        } else if (z < root.a-start) {
            // never destroy the selection — correct it by swapping
            root.st-end = root.st-start;
            root.st-start = z;
        } else {
            root.st-end = z;
        }
        root.vshift = 0;
    }
    function apply-preset(p: LabPreset) {
        root.st-start = p.start-days;
        root.st-end = p.end-days;
        root.vshift = 0;
    }

    // ---- viewed month: anchor (start → today) + manual navigation ----
    property <int> anchor-days: root.a-start >= 0 ? root.a-start : root.today-days;
    property <int> vshift;
    property <int> vtotal: root.months-of(root.anchor-days) + root.vshift;
    property <int> vy: Math.floor(root.vtotal / 12);
    property <int> vm: root.vtotal - root.vy * 12 + 1;
    property <int> m-first: root.dfc(root.vy, root.vm, 1);
    property <int> m-last: root.dfc(root.vy, root.vm, root.vm == 2
        ? (Math.mod(root.vy, 4) == 0 && (Math.mod(root.vy, 100) != 0 || Math.mod(root.vy, 400) == 0) ? 29 : 28)
        : (root.vm == 4 || root.vm == 6 || root.vm == 9 || root.vm == 11) ? 30 : 31);
    property <int> m-offset: Math.mod(root.m-first + 3, 7); // Monday-first grid

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        // month navigation — "where am I"
        Rectangle {
            height: 28px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 26px; height: 26px; border-radius: 7px;
                    background: pvta.has-hover ? LabPalette.hover2 : transparent;
                    pvta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.vshift -= 1; }
                    }
                    Text { text: "‹"; color: LabPalette.soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: ["January", "February", "March", "April", "May", "June", "July",
                               "August", "September", "October", "November", "December"][root.vm - 1] + " " + root.vy;
                        font-size: 12px; font-weight: 650; color: LabPalette.lab-text;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 26px; height: 26px; border-radius: 7px;
                    background: nxta.has-hover ? LabPalette.hover2 : transparent;
                    nxta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.vshift += 1; }
                    }
                    Text { text: "›"; color: LabPalette.soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        // weekday header
        HorizontalLayout {
            spacing: 0;
            for wd in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]: Rectangle {
                horizontal-stretch: 1;
                height: 16px;
                Text { text: wd; font-size: 8.5px; letter-spacing: 0.5px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // day grid — 6 weeks × 7 days
        for widx in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
            spacing: 0;
            for didx in [0, 1, 2, 3, 4, 5, 6]: cell := Rectangle {
                horizontal-stretch: 1;
                height: 27px;
                property <int> cd: root.m-first + (widx * 7 + didx) - root.m-offset;
                property <bool> valid: self.cd >= root.m-first && self.cd <= root.m-last;
                property <bool> is-start: self.valid && root.a-start == self.cd;
                property <bool> is-end: self.valid && root.eff-end == self.cd && self.cd != root.a-start;
                property <bool> in-range: self.valid && root.a-start >= 0 && root.eff-end >= 0
                    && self.cd > root.a-start && self.cd < root.eff-end;
                property <bool> is-today: self.valid && self.cd == root.today-days;
                background: self.in-range ? LabPalette.teal-06
                    : self.valid && cta.has-hover ? LabPalette.white-04 : transparent;
                cta := TouchArea {
                    enabled: cell.valid;
                    mouse-cursor: pointer;
                    clicked => { root.pick(cell.cd); }
                    changed has-hover => {
                        if self.has-hover {
                            root.hover-days = cell.cd;
                        } else if root.hover-days == cell.cd {
                            root.hover-days = -1;
                        }
                    }
                }
                Rectangle {
                    visible: cell.in-range;
                    x: 0; y: 4px; width: 100%; height: cell.height - 8px;
                    background: LabPalette.teal-06;
                }
                Rectangle {
                    visible: cell.valid;
                    width: 23px; height: 23px;
                    border-radius: 12px;
                    x: (cell.width - self.width) / 2;
                    y: (cell.height - self.height) / 2;
                    background: cell.is-start || cell.is-end ? LabPalette.lab-teal : transparent;
                    border-width: cell.is-today && !cell.is-start && !cell.is-end ? 1px : 0px;
                    border-color: LabPalette.teal-dim;
                    Text {
                        text: cell.cd - root.m-first + 1;
                        font-family: "monospace";
                        font-size: 10.5px;
                        color: cell.is-start || cell.is-end ? LabPalette.chip-bg : LabPalette.soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // presets — one-click research periods
        HorizontalLayout {
            spacing: 5px;
            height: 22px;
            for p in root.presets: Rectangle {
                height: 22px;
                width: pptx.width + 14px;
                border-radius: 99px;
                background: p.start-days == root.a-start && p.end-days == root.a-end ? LabPalette.teal-06 : transparent;
                border-width: 1px;
                border-color: prta.has-hover ? LabPalette.teal-40 : LabPalette.line2;
                prta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.apply-preset(p); }
                }
                pptx := Text {
                    text: p.label;
                    font-size: 9px; color: LabPalette.lab-muted;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
        // footer — what will be tested + actions
        Rectangle {
            height: 34px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.a-start < 0 ? "Pick a start date"
                        : root.a-end < 0 ? root.human(root.a-start) + " — pick end"
                        : root.human(root.a-start) + " — " + root.human(root.a-end);
                    font-size: 10px;
                    color: root.a-end < 0 ? LabPalette.dim : LabPalette.lab-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 62px; height: 26px; border-radius: 7px;
                    background: LabPalette.panel3;
                    border-width: 1px;
                    border-color: cnsta.has-hover ? LabPalette.white-16 : LabPalette.line;
                    cnsta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancelled(); }
                    }
                    Text { text: "Cancel"; color: LabPalette.lab-muted; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 56px; height: 26px; border-radius: 7px;
                    background: root.a-start >= 0 && root.a-end >= 0 ? LabPalette.run-ink : LabPalette.btn-idle-bg;
                    Text {
                        text: "Apply";
                        color: root.a-start >= 0 && root.a-end >= 0 ? LabPalette.chip-bg : LabPalette.lab-faint;
                        font-size: 10.5px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: root.a-start >= 0 && root.a-end >= 0;
                        mouse-cursor: pointer;
                        clicked => { root.committed(root.iso(root.a-start), root.iso(root.a-end)); }
                    }
                }
            }
        }
    }
}



export component StrategyLabScreen inherits Rectangle {
    // Native std-widgets (LineEdit/TextEdit/ScrollBar) inside this screen
    // must follow the app's dark system, not the workstation OS theme.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in property <LabHeader> lab;
    in property <[LabLibraryRow]> library;
    in property <[LabKpi]> kpis;
    in property <[LabRankRow]> ranking;
    in property <[LabTradeRow]> trades;
    in property <[LabPoint]> equity;
    in property <[LabPoint]> drawdown;
    in property <[LabParam]> params;
    in property <[string]> timeframes;
    in property <[string]> rankby-labels;
    in property <[string]> rank-heads;
    in property <[string]> trade-heads;
    in property <[LabDetailMetric]> detail-metrics;
    in property <[string]> universe-chips;
    in property <[LabPoint]> detail-equity;
    in property <[string]> board-labels;
    in property <[string]> board-columns;
    in property <[string]> board-trades;
    in property <[LabBoardCell]> board-cells;
    in property <int> board-cols: 1;
    in property <[LabMatrixRow]> matrix;
    in property <[LabRankRow]> compare-ranking;
    in property <[LabPoint]> equity-buy;
    in property <[LabPoint]> equity-sell;
    in property <[LabPoint]> drawdown-buy;
    in property <[LabPoint]> drawdown-sell;
    in property <[string]> sym-visible;
    in property <[bool]> sym-visible-on;
    in property <int> filter-active: 0;
    in property <[LabPreset]> date-presets;

    // ── Floating control surfaces (dropdown menus + date-range picker) ──
    // These are rendered as screen-level overlays: the section cards clip
    // their content, so a menu anchored inside a card would be cut off.
    property <int> menu-src: -1;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;
    property <length> menu-w: 140px;
    property <bool> dates-open: false;
    property <length> dates-x: 0px;
    property <length> dates-y: 0px;
    property <[string]> menu-items: root.menu-src == 0 ? root.timeframes
        : root.menu-src == 1 ? root.rankby-labels
        : ["Cumulative P&L", "Daily P&L", "Return %"];
    property <string> menu-current: root.menu-src == 0 ? root.lab.timeframe
        : root.menu-src == 1 ? (root.lab.rankby-current >= 0 && root.lab.rankby-current < root.rankby-labels.length
            ? root.rankby-labels[root.lab.rankby-current] : "")
        : (root.lab.equity-select == 1 ? "Daily P&L" : root.lab.equity-select == 2 ? "Return %" : "Cumulative P&L");

    // Anchor a floating surface at window coordinates (x, y) with width w.
    // The screen can be embedded (lab host) or inside the shell window, so
    // positions are converted from window space into this component's space.
    function open-menu(src: int, x: length, y: length, w: length) {
        root.menu-src = src;
        root.dates-open = false;
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        root.menu-w = w;
    }
    function close-floating() {
        root.menu-src = -1;
        root.dates-open = false;
    }

    in property <bool> head-roomy: true;

    callback library-picked(int);
    callback filter-picked(int);
    callback search-changed(string);
    callback mode-picked(int);
    callback tab-picked(int);
    callback run-requested();
    callback save-requested();
    callback compile-requested();
    callback new-requested();
    callback row-menu(int);
    callback rank-picked(string);
    callback trade-picked(int);
    callback export-trades-requested();
    callback code-changed(string);
    callback param-committed(string, string);
    callback timeframe-picked(string);
    callback capital-committed(string);
    callback dates-committed(string, string);
    callback sym-open();
    callback sym-close();
    callback sym-search-changed(string);
    callback sym-toggle(string);
    callback sym-all-visible();
    callback sym-clear();
    callback sym-apply();
    callback rank-search-changed(string);
    callback rankby-picked(string);
    callback rank-order-toggled();
    callback trade-filter-changed(string);
    callback cmp-side-picked(int);
    callback run-buy-requested();
    callback run-sell-requested();
    callback run-all-requested();
    // Reference redesign callbacks.
    callback lens-picked(int);
    callback cost-committed(string);
    callback inspector-close();
    callback diag-link-clicked();
    callback equity-select-picked(int);
    callback reset-requested();


    background: LabPalette.lab-bg;

    // ══════════════ VAYREN Strategy Lab — reference 1:1 layout ══════════════

    in property <bool> insp-open: root.lab.detail-symbol != "";
    in property <bool> wide: root.width > LabPalette.bp-wide;
    property <int> rail-active: root.lab.run-stop ? 2
        : root.lab.dirty ? 5
        : root.insp-open ? 4
        : root.lab.outdated ? 2
        : root.lab.show-results ? 3
        : 1;

    VerticalLayout {
        spacing: 0;

        // ── TOP: location first, everything else quiet ──
        Rectangle {
            height: LabPalette.topbar-h;
            background: LabPalette.lab-bg;
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                alignment: center;
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "VAYREN";
                        color: LabPalette.lab-text;
                        font-size: 14px;
                        font-weight: 700;
                        letter-spacing: 3.5px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "/  Strategy Lab";
                        color: LabPalette.lab-text;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; background: transparent; }
                    HorizontalLayout {
                        spacing: 4px;
                        for navlbl in ["Market", "Research", "Portfolio", "Live", "System"]: Rectangle {
                            height: 28px;
                            width: navtx.width + 20px;
                            border-radius: 7px;
                            background: nta.has-hover ? LabPalette.white-04 : transparent;
                            nta := TouchArea { }
                            navtx := Text {
                                text: navlbl;
                                color: nta.has-hover ? LabPalette.soft : LabPalette.dim;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        height: 22px;
                        width: pvtx.width + 20px;
                        border-radius: 99px;
                        background: LabPalette.amber-06;
                        border-width: 1px;
                        border-color: LabPalette.amber-30;
                        pvtx := Text {
                            text: "LOCAL PREVIEW";
                            color: LabPalette.lab-amber;
                            font-size: 9px;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: LabPalette.hover2;
                        border-width: 1px;
                        border-color: LabPalette.line;
                        Text {
                            text: "V";
                            color: LabPalette.soft;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
        }

        // ── FLOW RAIL: the research process, made visible ──
        Rectangle {
            height: LabPalette.rail-h;
            background: LabPalette.lab-bg;
            HorizontalLayout {
                padding-left: 22px;
                spacing: 10px;
                alignment: start;
                LabRailStep { num: "01"; name: "DEFINE"; step-on: root.rail-active == 0; }
                LabRailStep { num: "02"; name: "CONFIGURE"; step-on: root.rail-active == 1; }
                LabRailStep { num: "03"; name: "RUN"; step-on: root.rail-active == 2; }
                LabRailStep { num: "04"; name: "READ"; step-on: root.rail-active == 3; }
                LabRailStep { num: "05"; name: "INVESTIGATE"; step-on: root.rail-active == 4; }
                LabRailStep { num: "06"; name: "MODIFY"; step-on: root.rail-active == 5; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
        }

        // ── WORKSPACE (scrollable page) ──
        ScrollView {
            vertical-stretch: 1;
            viewport-width: root.width - 2px;
            // A bare wrapper Rectangle has no implicit size, so the default
            // viewport stayed window-tall and the page could never scroll;
            // the document height must be stated explicitly.
            viewport-height: Math.max(self.height, wsdoc.min-height);
            Rectangle {
                width: Math.min(root.width, LabPalette.max-w);
                // On wide displays the page keeps its measure and centres;
                // left-pinning it would strand the right half of the screen.
                x: Math.max(0px, (root.width - self.width) / 2);
                wsdoc := VerticalLayout {
                    padding-left: LabPalette.ws-px;
                    padding-right: LabPalette.ws-px;
                    padding-top: LabPalette.ws-py;
                    spacing: LabPalette.section-gap;

                    // ════ 01 DEFINE ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "01 · DEFINE THE RESEARCH OBJECT"; }
                        HorizontalLayout {
                            spacing: 26px;
                            Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 0;
                                    Text {
                                        text: root.lab.name == "" ? "NO STRATEGY" : root.lab.name;
                                        font-size: root.wide ? 44px : 34px;
                                        font-weight: 650;
                                        letter-spacing: -1.5px;
                                        color: LabPalette.lab-text;
                                    }
                                    Rectangle { height: 8px; }
                                    Text {
                                        text: root.lab.description;
                                        font-size: 13px;
                                        color: LabPalette.lab-muted;
                                    }
                                    Rectangle { height: 10px; }
                                    Text {
                                        text: root.lab.summary-line;
                                        font-family: "monospace";
                                        font-size: 10.5px;
                                        color: LabPalette.dim;
                                        letter-spacing: 0.3px;
                                    }
                                    Rectangle { height: 18px; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Text {
                                            text: "DIRECTION";
                                            font-size: 10px;
                                            letter-spacing: 1px;
                                            color: LabPalette.dim;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: 9px;
                                            background: LabPalette.inset;
                                            border-width: 1px;
                                            border-color: LabPalette.line;
                                            HorizontalLayout {
                                                padding: 3px;
                                                spacing: 0;
                                                for dmode[idx] in ["Long", "Short", "Compare"]: Rectangle {
                                                    width: 84px;
                                                    height: 30px;
                                                    border-radius: 6px;
                                                    background: root.lab.mode == idx ? LabPalette.run-ink : dmsta.pressed ? LabPalette.white-06 : dmsta.has-hover ? LabPalette.white-04 : transparent;
                                                    dmsta := TouchArea {
                                                        clicked => { root.mode-picked(idx); }
                                                    }
                                                    Text {
                                                        text: dmode;
                                                        color: root.lab.mode == idx ? LabPalette.chip-bg : dmsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                        font-size: 11.5px;
                                                        font-weight: root.lab.mode == idx ? 650 : 400;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.wide;
                                width: 1px;
                                background: LabPalette.line;
                            }
                            Rectangle {
                                visible: root.wide;
                                width: 380px;
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "RESEARCH OBJECTS";
                                        font-size: 10px;
                                        letter-spacing: 1.4px;
                                        color: LabPalette.dim;
                                        font-weight: 600;
                                    }
                                    ScrollView {
                                        viewport-width: 380px;
                                        // The row beside this column (the DEFINE
                                        // card) can be shorter than the list's
                                        // own content; without a stated height the
                                        // layout squeezed the ScrollView, clipping
                                        // the last strategy under the "+ New
                                        // strategy" button so it could not be
                                        // clicked. Size it to its rows (up to the
                                        // designed 160px cap; beyond that it scrolls).
                                        height: Math.min(160px, root.library.length * 46px + Math.max(0px, (root.library.length - 1) * 8px));
                                        viewport-height: Math.max(self.height, root.library.length * 46px + Math.max(0px, (root.library.length - 1) * 8px));
                                        VerticalLayout {
                                            spacing: 8px;
                                            padding-right: 4px;
                                            for librow in root.library: Rectangle {
                                                height: 46px;
                                                border-radius: 10px;
                                                background: LabPalette.panel;
                                                border-width: 1px;
                                                border-color: librow.selected ? LabPalette.teal-35 : libsta.has-hover ? LabPalette.white-16 : LabPalette.line;
                                                libsta := TouchArea {
                                                    clicked => { root.library-picked(librow.real-index); }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 13px;
                                                    padding-right: 13px;
                                                    spacing: 12px;
                                                    VerticalLayout {
                                                        spacing: 3px;
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: librow.name;
                                                            font-size: 12.5px;
                                                            font-weight: 650;
                                                            color: LabPalette.lab-text;
                                                        }
                                                        Text {
                                                            text: librow.description;
                                                            font-size: 10px;
                                                            color: LabPalette.lab-muted;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        width: libtag.width + 18px;
                                                        border-radius: 99px;
                                                        background: transparent;
                                                        border-width: 1px;
                                                        border-color: librow.selected ? LabPalette.green-30 : LabPalette.line;
                                                        
                                                        libtag := Text {
                                                            text: librow.selected ? "ACTIVE" : "DRAFT";
                                                            color: librow.selected ? LabPalette.green : LabPalette.lab-amber;
                                                            font-size: 8.5px;
                                                            letter-spacing: 0.8px;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 10px;
                                        background: transparent;
                                        border-width: 1px;
                                        border-color: newsta.has-hover ? LabPalette.teal-40 : LabPalette.white-16;
                                        newsta := TouchArea {
                                            clicked => { root.new-requested(); }
                                        }
                                        Text {
                                            text: "+ New strategy";
                                            color: newsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                            font-size: 11.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            height: 20px;
                                            width: cnttx.width + 18px;
                                            border-radius: 99px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: LabPalette.line;
                                            cnttx := Text {
                                                text: root.lab.strategy-count-line;
                                                color: LabPalette.lab-muted;
                                                font-size: 8.5px;
                                                letter-spacing: 0.8px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: root.lab.editing-hint;
                                            font-size: 10px;
                                            color: LabPalette.dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════ 02 CONFIGURE + 03 RUN ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "02 · CONFIGURE THE EXPERIMENT YOU ARE ABOUT TO RUN"; }
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: root.lab.config-error != "" ? LabPalette.red-35 : LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                HorizontalLayout {
                                    spacing: 0;
                                    // Universe
                                    Rectangle {
                                        horizontal-stretch: 1.4;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "UNIVERSE"; }
                                            LabCtlButton {
                                                ctl-label: root.lab.sym-button-line == "" ? root.lab.universe : root.lab.sym-button-line;
                                                clicked => { root.sym-open(); }
                                            }
                                            Rectangle { height: 9px; }
                                            HorizontalLayout {
                                                spacing: 5px;
                                                height: 20px;
                                                for chiplbl in root.universe-chips: Rectangle {
                                                    visible: chiplbl != "";
                                                    height: 18px;
                                                    width: chiptx.width + 14px;
                                                    border-radius: 6px;
                                                    background: LabPalette.field-bg;
                                                    border-width: 1px;
                                                    border-color: LabPalette.line2;
                                                    chiptx := Text {
                                                        text: chiplbl;
                                                        font-family: "monospace";
                                                        font-size: 9px;
                                                        color: LabPalette.soft;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Rectangle { visible: root.lab.config-error != ""; height: 7px; }
                                            Text {
                                                visible: root.lab.config-error != "";
                                                text: "Select at least 1 stock.";
                                                font-size: 10px;
                                                color: LabPalette.lab-red;
                                            }
                                        }
                                    }
                                    LabFieldDivider {}
                                    // Timeframe
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "TIMEFRAME"; }
                                            tfctl := LabCtlButton {
                                                ctl-label: root.lab.timeframe;
                                                clicked => {
                                                    root.open-menu(0, self.absolute-position.x,
                                                        self.absolute-position.y + self.height + 4px,
                                                        Math.max(self.width, 140px));
                                                }
                                            }
                                        }
                                    }
                                    LabFieldDivider {}
                                    // Date range — one control family; the
                                    // rich interaction lives inside the picker.
                                    Rectangle {
                                        horizontal-stretch: 1.6;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 7px;
                                            LabFieldLabel { lbl: "DATE RANGE"; }
                                            drctl := Rectangle {
                                                height: LabPalette.field-h;
                                                border-radius: 8px;
                                                background: LabPalette.field-bg;
                                                border-width: 1px;
                                                border-color: root.lab.dates-error != "" ? LabPalette.red-35
                                                    : drta.has-hover ? LabPalette.white-16 : LabPalette.line;
                                                drta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.dates-open = !root.dates-open;
                                                        if (root.dates-open) {
                                                            root.menu-src = -1;
                                                            root.dates-x = drctl.absolute-position.x - root.absolute-position.x;
                                                            root.dates-y = drctl.absolute-position.y - root.absolute-position.y + drctl.height + 4px;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 11px;
                                                    padding-right: 11px;
                                                    alignment: center;
                                                    spacing: 8px;
                                                    Text {
                                                        text: root.lab.dates-human == "" ? "Select date range" : root.lab.dates-human;
                                                        font-size: 11.5px;
                                                        color: root.lab.dates-human == "" ? LabPalette.lab-faint : LabPalette.lab-text;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                    }
                                                    Text { text: "⌄"; color: LabPalette.dim; font-size: 12px; vertical-alignment: center; }
                                                }
                                            }
                                            Text {
                                                visible: root.lab.dates-error != "";
                                                text: root.lab.dates-error;
                                                font-size: 10px;
                                                color: LabPalette.lab-red;
                                            }
                                        }
                                    }
                                    LabFieldDivider {}
                                    // Capital
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "CAPITAL"; }
                                            LabCtlInput {
                                                pre-fix: "₹";
                                                val: root.lab.cfg-capital;
                                                committed(t) => { root.capital-committed(t); }
                                            }
                                        }
                                    }
                                    LabFieldDivider {}
                                    // Transaction cost
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            padding: 16px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "TRANSACTION COST"; }
                                            LabCtlInput {
                                                post-fix: "%";
                                                val: root.lab.cfg-cost;
                                                committed(t) => { root.cost-committed(t); }
                                            }
                                            Rectangle { visible: root.lab.cfg-cost-warn; height: 7px; }
                                            Text {
                                                visible: root.lab.cfg-cost-warn;
                                                text: "0% = unreal. Institutional preview uses ≥0.05%.";
                                                font-size: 10px;
                                                color: LabPalette.lab-amber;
                                            }
                                        }
                                    }
                                }
                                // Run bar — the culmination
                                Rectangle {
                                    height: 46px;
                                    background: LabPalette.panel2;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 18px;
                                        alignment: center;
                                        Text {
                                            text: root.lab.summary-line;
                                            font-family: "monospace";
                                            font-size: 11.5px;
                                            color: LabPalette.lab-text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            visible: root.lab.outdated;
                                            text: "· edited — rerun to refresh";
                                            font-size: 10.5px;
                                            color: LabPalette.lab-amber;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text {
                                            text: root.lab.state-label;
                                            font-size: 10.5px;
                                            color: root.lab.state-tone == 2 ? LabPalette.lab-amber
                                                : root.lab.state-tone == 3 ? LabPalette.lab-red
                                                : root.lab.state-tone == 1 ? LabPalette.green : LabPalette.dim;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 170px;
                                            height: 36px;
                                            border-radius: 9px;
                                            background: root.lab.config-error != "" ? LabPalette.run-error-bg
                                                : root.lab.run-stop ? LabPalette.btn-idle-bg
                                                : root.lab.show-results && !root.lab.outdated ? rta.pressed ? LabPalette.run-done-press
                                                    : rta.has-hover ? LabPalette.run-done-hover : LabPalette.run-done-bg
                                                : rta.pressed ? LabPalette.run-press
                                                : rta.has-hover ? LabPalette.run-hover : LabPalette.run-ink;
                                            border-width: 1px;
                                            border-color: root.lab.show-results && !root.lab.outdated && !root.lab.run-stop ? LabPalette.green-35 : transparent;
                                            rta := TouchArea {
                                                enabled: root.lab.run-enabled;
                                                mouse-cursor: pointer;
                                                clicked => { root.run-requested(); }
                                            }
                                            Text {
                                                text: root.lab.run-label;
                                                color: root.lab.config-error != "" ? LabPalette.red-soft
                                                    : root.lab.run-stop ? LabPalette.soft2
                                                    : root.lab.show-results && !root.lab.outdated ? LabPalette.green-bright : LabPalette.chip-bg;
                                                font-size: 12.5px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                opacity: root.lab.run-enabled ? 1 : 0.6;
                                            }
                                        }
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                            }
                        }
                    }

                    // ════ 04 READ ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "03 · READ ONE ANSWER TO THE EXPERIMENT"; }
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                // receipt-top
                                Rectangle {
                                    height: 46px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 14px;
                                        alignment: center;
                                        Text { text: "RESULT OF"; font-size: 10px; letter-spacing: 1.4px; color: LabPalette.dim; vertical-alignment: center; }
                                        Text { text: root.lab.result-exec-line; font-family: "monospace"; font-size: 11.5px; color: LabPalette.lab-text; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            height: 24px;
                                            width: flagtx.width + 40px;
                                            border-radius: 99px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: root.lab.outdated ? LabPalette.amber-30 : LabPalette.green-30;
                                            Rectangle {
                                                x: 11px;
                                                y: (parent.height - self.height) / 2;
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: root.lab.outdated ? LabPalette.lab-amber : LabPalette.green;
                                            }
                                            flagtx := Text {
                                                x: 24px;
                                                text: root.lab.outdated ? "STALE — PREVIOUS CONFIG" : "CURRENT";
                                                color: root.lab.outdated ? LabPalette.lab-amber : LabPalette.green;
                                                font-size: 9px;
                                                letter-spacing: 1px;
                                                vertical-alignment: center;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // Nothing to read yet — the receipt says so in
                                // one line and offers the action that resolves
                                // it, instead of a skeleton full of dashes.
                                if !root.lab.show-results && !root.lab.run-stop: Rectangle {
                                    height: 44px;
                                    background: LabPalette.inset;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 12px;
                                        alignment: center;
                                        Text {
                                            text: root.lab.empty-reason;
                                            font-size: 11.5px;
                                            color: LabPalette.lab-muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        if root.lab.name == "": Rectangle {
                                            height: 26px;
                                            width: emptytx.width + 22px;
                                            border-radius: 7px;
                                            background: emptsta.has-hover ? LabPalette.white-06 : transparent;
                                            border-width: 1px;
                                            border-color: LabPalette.white-16;
                                            emptsta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.new-requested(); }
                                            }
                                            emptytx := Text {
                                                text: "+ New strategy";
                                                font-size: 11px;
                                                color: emptsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // stale banner
                                if root.lab.outdated: Rectangle {
                                    height: 34px;
                                    background: LabPalette.amber-05;
                                    Text {
                                        text: "Configuration changed since this run — this result belongs to a previous configuration.";
                                        font-size: 11px;
                                        color: LabPalette.lab-amber;
                                        x: 18px;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width - 36px;
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.amber-25; }
                                }
                                // outcome
                                Rectangle {
                                    height: 76px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        spacing: 16px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: "OUTCOME · NET P&L"; font-size: 10px; letter-spacing: 1.4px; color: LabPalette.dim; }
                                            Text {
                                                text: root.lab.result-pnl == "" ? "--" : root.lab.result-pnl;
                                                font-family: "monospace";
                                                font-size: 40px;
                                                font-weight: 600;
                                                letter-spacing: -2px;
                                                color: root.lab.result-pnl-tone == 2 ? LabPalette.green
                                                    : root.lab.result-pnl-tone == 3 ? LabPalette.lab-red : LabPalette.lab-text;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-bottom: 12px;
                                            Text {
                                                visible: root.lab.result-return != "";
                                                text: root.lab.result-return + " return";
                                                font-family: "monospace";
                                                font-size: 13px;
                                                color: root.lab.result-pnl-tone == 2 ? LabPalette.green : LabPalette.lab-red;
                                                vertical-alignment: bottom;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                                // metric groups: SCALE / QUALITY / RISK (kpis model, 3 columns)
                                Rectangle {
                                    height: 130px;
                                    Rectangle {
                                        x: 18px; y: 0;
                                        width: parent.width - 36px; height: 130px;
                                        HorizontalLayout {
                                            spacing: 0;
                                            for grplbl[gidx] in ["SCALE", "QUALITY", "RISK"]: Rectangle {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                Text {
                                                    text: grplbl;
                                                    font-size: 9.5px;
                                                    letter-spacing: 1.2px;
                                                    color: LabPalette.dim;
                                                    font-weight: 600;
                                                    y: 8px;
                                                }
                                            }
                                        }
                                        for k[idx] in root.kpis: Rectangle {
                                            visible: idx > 0;
                                            x: Math.mod(idx - 1, 3) * (parent.width / 3);
                                            y: 22px + Math.floor((idx - 1) / 3) * 34px;
                                            width: parent.width / 3 - 18px;
                                            height: 34px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: k.label;
                                                    font-size: 11px;
                                                    color: LabPalette.lab-muted;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: k.value;
                                                    font-family: "monospace";
                                                    font-size: 13.5px;
                                                    color: k.tone == 2 ? LabPalette.green
                                                        : k.tone == 3 ? LabPalette.lab-red
                                                        : k.tone == 4 ? LabPalette.lab-amber : LabPalette.lab-text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.white-06; }
                                        }
                                    }
                                }
                                // diagnostics
                                if root.lab.diag-show: Rectangle {
                                    height: 54px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 11px;
                                        alignment: center;
                                        Rectangle {
                                            width: 30px; height: 30px; border-radius: 8px;
                                            background: root.lab.diag-stale ? LabPalette.amber-08 : LabPalette.red-08;
                                            
                                            Text { text: "⌁"; color: root.lab.diag-stale ? LabPalette.lab-amber : LabPalette.lab-red; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: root.lab.diag-title; font-size: 12px; font-weight: 650; color: root.lab.diag-stale ? LabPalette.lab-amber : LabPalette.lab-text; overflow: elide; }
                                            Text { text: root.lab.diag-detail; font-size: 11px; color: LabPalette.lab-muted; overflow: elide; }
                                        }
                                        Rectangle {
                                            width: dlttx.width + 8px;
                                            height: 24px;
                                            
                                            dlta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.diag-link-clicked(); }
                                            }
                                            dlttx := Text {
                                                text: "Stocks ↓";
                                                color: dlta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                // risk gate
                                if root.lab.risk-gate-show: Rectangle {
                                    height: 62px;
                                    Rectangle {
                                        x: 18px; y: 8px;
                                        width: parent.width - 36px; height: parent.height - 16px;
                                        border-radius: 10px;
                                        background: LabPalette.red-06;
                                        border-width: 1px;
                                        border-color: LabPalette.red-35;
                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px; spacing: 11px;
                                            Rectangle { width: 30px; height: 30px; border-radius: 8px; background: LabPalette.red-12; 
                                                Text { text: "⊘"; color: LabPalette.lab-red; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 4px;
                                                Text { text: "BLOCKED FROM LIVE — BEYOND RUIN"; font-size: 12px; font-weight: 700; color: LabPalette.lab-red; overflow: elide; }
                                                Text { text: root.lab.risk-gate-text; font-size: 11px; color: LabPalette.lab-muted; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                                // audit lines
                                Rectangle {
                                    height: 30px;
                                    Text {
                                        text: root.lab.range-line;
                                        font-size: 10.5px;
                                        font-family: "monospace";
                                        color: LabPalette.dim;
                                        x: 18px; y: (parent.height - self.height) / 2;
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                                if root.lab.run-id != "" || root.lab.run-ts != "": Rectangle {
                                    height: 26px;
                                    Text {
                                        text: "Run " + root.lab.run-id + "  ·  Hash " + root.lab.cfg-hash + "  ·  " + root.lab.run-ts;
                                        font-size: 10px;
                                        font-family: "monospace";
                                        color: LabPalette.lab-faint;
                                        x: 18px; y: (parent.height - self.height) / 2;
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                            }
                        }
                        // perspectives lens bar
                        Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                spacing: 4px;
                                padding-left: 2px;
                                alignment: center;
                                for lens[idx] in ["Performance", "Trades", "Equity", "Drawdown", "Analytics", "Strategy"]: Rectangle {
                                    height: 100%;
                                    width: lntx.width + 28px;
                                    lsta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.lens-picked(idx); }
                                    }
                                    lntx := Text {
                                        text: lens;
                                        color: root.lab.lens == idx ? LabPalette.lab-text : lsta.has-hover ? LabPalette.soft : LabPalette.dim;
                                        font-size: 11.5px;
                                        font-weight: root.lab.lens == idx ? 600 : 400;
                                        y: (parent.height - self.height) / 2 - 4px;
                                    }
                                    Rectangle {
                                        x: 0; y: parent.height - 2px; width: 100%; height: 2px;
                                        background: root.lab.lens == idx ? LabPalette.lab-teal : transparent;
                                    }
                                }
                            }
                            Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                        }
                        Rectangle { height: 4px; }
                        Text {
                            text: "Same run, different perspective · " + (root.lab.outdated ? "rerun needed" : "selection preserved");
                            font-size: 10px;
                            color: LabPalette.lab-faint;
                        }
                    }

                    // ════ 05 INVESTIGATE ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "04 · INVESTIGATE WHERE THE RESULT CAME FROM"; }
                        // tools row
                        HorizontalLayout {
                            height: 34px;
                            spacing: 9px;
                            Text {
                                text: root.lab.ranking-count;
                                font-size: 10.5px;
                                font-family: "monospace";
                                color: LabPalette.dim;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            LabCtlSearch {
                                width: 170px;
                                ctl-h: 32px;
                                ph: "Search stocks…";
                                val: root.lab.rank-search;
                                changed(t) => { root.rank-search-changed(t); }
                            }
                            rbctl := LabCtlButton {
                                ctl-h: 32px;
                                width: 170px;
                                ctl-label: root.lab.rankby-current >= 0 && root.lab.rankby-current < root.rankby-labels.length
                                    ? root.rankby-labels[root.lab.rankby-current] : "Sort by";
                                clicked => {
                                    root.open-menu(1, self.absolute-position.x,
                                        self.absolute-position.y + self.height + 4px,
                                        Math.max(self.width, 150px));
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        HorizontalLayout {
                            spacing: 12px;
                            // table panel
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0;
                                border-radius: LabPalette.section-radius;
                                background: LabPalette.panel;
                                border-width: 1px;
                                border-color: LabPalette.line;
                                clip: true;
                                height: 74px + Math.max(1, root.ranking.length) * 40px + 34px;
                                VerticalLayout {
                                    spacing: 0;
                                    // grouped header row
                                    Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            spacing: 0;
                                            Rectangle { width: 34px; }
                                            Rectangle { width: 110px; }
                                            Text { text: "OUTCOME"; horizontal-stretch: 2; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                            Text { text: "ACTIVITY"; horizontal-stretch: 2; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                            Text { text: "QUALITY"; horizontal-stretch: 1; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                            Text { text: "RISK"; horizontal-stretch: 2; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    // header row
                                    Rectangle {
                                        height: 30px;
                                        HorizontalLayout {
                                            spacing: 0;
                                            LabTh { th: "#"; tw: 34px; }
                                            LabTh { th: "STOCK"; tw: 110px; ta-left: true; }
                                            LabTh { th: "NET P&L"; stretch: 1; }
                                            LabTh { th: "RETURN"; stretch: 1; }
                                            LabTh { th: "TRADES"; stretch: 1; }
                                            LabTh { th: "WIN %"; stretch: 1; }
                                            LabTh { th: "PF"; stretch: 1; }
                                            LabTh { th: "MAX DD"; stretch: 1; }
                                            LabTh { th: "SHARPE"; stretch: 1; }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                    }
                                    if root.ranking.length == 0: Text {
                                        text: "No rows yet — run the experiment to investigate per-stock results.";
                                        font-size: 11px;
                                        color: LabPalette.dim;
                                        height: 40px;
                                        x: 14px;
                                        vertical-alignment: center;
                                    }
                                    for rrow in root.ranking: Rectangle {
                                        height: 40px;
                                        background: root.lab.detail-symbol == rrow.symbol ? LabPalette.teal-06 : rrta.has-hover ? LabPalette.white-02 : transparent;
                                        rrta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.rank-picked(rrow.symbol); }
                                        }
                                        Rectangle {
                                            visible: root.lab.detail-symbol == rrow.symbol;
                                            x: 0; y: 0; width: 2px; height: 100%;
                                            background: LabPalette.lab-teal;
                                        }
                                        HorizontalLayout {
                                            spacing: 0;
                                            LabTd { td: rrow.rank; tw: 34px; tc: LabPalette.lab-faint; }
                                            LabTd { td: rrow.symbol; tw: 110px; ta-left: true; tc: LabPalette.lab-text; bold: true; no-mono: true; }
                                            LabTd { td: rrow.pnl; stretch: 1; tc: rrow.pnl-tone == 2 ? LabPalette.green : rrow.pnl-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                            LabTd { td: rrow.ret; stretch: 1; tc: rrow.pnl-tone == 2 ? LabPalette.green : rrow.pnl-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                            LabTd { td: rrow.trades; stretch: 1; }
                                            LabTd { td: rrow.win; stretch: 1; }
                                            LabTd { td: rrow.pf; stretch: 1; tc: rrow.pf-tone == 2 ? LabPalette.green : rrow.pf-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                            LabTd { td: rrow.dd; stretch: 1; }
                                            LabTd { td: rrow.sharpe; stretch: 1; }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line2; }
                                    }
                                }
                            }
                            // inspector (in-flow pane on desktop)
                            if root.insp-open && root.wide: Rectangle {
                                width: LabPalette.insp-w;
                                border-radius: LabPalette.section-radius;
                                background: LabPalette.panel3;
                                border-width: 1px;
                                border-color: LabPalette.teal-25;
                                height: 320px;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 0;
                                    HorizontalLayout {
                                        height: 44px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            Text { text: root.lab.detail-symbol; font-size: 17px; letter-spacing: 0.2px; color: LabPalette.lab-text; font-weight: 600; }
                                            Text { text: root.lab.detail-caption; font-family: "monospace"; font-size: 9.5px; color: LabPalette.lab-muted; overflow: elide; }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px;
                                            border-radius: 7px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: ixta.has-hover ? LabPalette.white-20 : LabPalette.line;
                                            
                                            ixta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.inspector-close(); }
                                            }
                                            Text { text: "×"; color: ixta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Rectangle { height: 12px; }
                                    Text {
                                        text: root.lab.detail-stats;
                                        font-family: "monospace";
                                        font-size: 13.5px;
                                        color: LabPalette.lab-text;
                                        overflow: elide;
                                    }
                                    Rectangle { height: 14px; }
                                    Rectangle {
                                        height: Math.ceil(root.detail-metrics.length / 2) * 46px;
                                        for dm[idx] in root.detail-metrics: Rectangle {
                                            x: Math.mod(idx, 2) * (parent.width / 2);
                                            y: Math.floor(idx / 2) * 46px;
                                            width: parent.width / 2;
                                            height: 46px;
                                            VerticalLayout {
                                                padding-right: 12px;
                                                spacing: 5px;
                                                Text { text: dm.label; font-size: 8.5px; letter-spacing: 0.8px; color: LabPalette.dim; }
                                                Text { text: dm.value; font-family: "monospace"; font-size: 12.5px; color: LabPalette.lab-text; }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line2; }
                                        }
                                    }
                                    Rectangle { height: 12px; }
                                    Text {
                                        text: "Inspector reflects the last run." + (root.lab.outdated ? " · configuration changed since — rerun to refresh." : "");
                                        font-size: 10px;
                                        color: LabPalette.dim;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        // ── EQUITY ──
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                Rectangle {
                                    height: 44px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        alignment: center;
                                        Text { text: "Equity"; font-size: 12.5px; font-weight: 650; color: LabPalette.lab-text; vertical-alignment: center; }
                                        Text { text: "cumulative P&L · " + root.lab.equity-caption; font-size: 10px; color: LabPalette.dim; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        eqctl := LabCtlButton {
                                            width: 150px;
                                            ctl-h: 28px;
                                            ctl-label: root.lab.equity-select == 1 ? "Daily P&L" : root.lab.equity-select == 2 ? "Return %" : "Cumulative P&L";
                                            clicked => {
                                                root.open-menu(2, self.absolute-position.x,
                                                    self.absolute-position.y + self.height + 4px,
                                                    Math.max(self.width, 150px));
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                Rectangle {
                                    height: 230px;
                                    clip: true;
                                    Rectangle {
                                        x: 44px; y: 24px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 74px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 124px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 174px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    if root.equity.length == 0: Text {
                                        text: "NO EQUITY SERIES — run to produce the curve.";
                                        font-size: 11px;
                                        color: LabPalette.dim;
                                        x: 16px; y: (parent.height - self.height) / 2;
                                    }
                                    for p in root.equity: Rectangle {
                                        width: 3px;
                                        height: 3px;
                                        border-radius: 2px;
                                        x: 44px + (parent.width - 58px) * (p.x / 1000px);
                                        y: 24px + 150px - 150px * (p.y / 300px);
                                        background: LabPalette.lab-red;
                                    }
                                }
                                Rectangle {
                                    height: 56px;
                                    HorizontalLayout {
                                        spacing: 0;
                                        LabEqStat { es-label: "STARTING CAPITAL"; es-value: root.lab.cfg-capital == "" ? "--" : root.lab.cfg-capital; }
                                        HorizontalLayout { padding-top: 8px; padding-bottom: 8px; Rectangle { width: 1px; background: LabPalette.line2; } }
                                        LabEqStat { es-label: "ENDING CAPITAL"; es-value: root.lab.result-pnl == "" ? "--" : root.lab.result-pnl; es-tone: root.lab.result-pnl-tone; }
                                        HorizontalLayout { padding-top: 8px; padding-bottom: 8px; Rectangle { width: 1px; background: LabPalette.line2; } }
                                        LabEqStat { es-label: "MAX DRAWDOWN"; es-value: root.lab.drawdown-caption == "" ? "--" : root.lab.drawdown-caption; es-tone: 3; }
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                            }
                        }
                    }

                    // ════ 06 MODIFY ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "05 · MODIFY CHANGE THE STRATEGY, RESEARCH AGAIN"; }
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                // studio top
                                Rectangle {
                                    height: 46px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        alignment: center;
                                        Rectangle {
                                            height: 30px;
                                            width: fttx.width + 28px;
                                            border-radius: 8px;
                                            background: LabPalette.inset;
                                            border-width: 1px;
                                            border-color: LabPalette.line;
                                            fttx := Text {
                                                text: (root.lab.name == "" ? "STRATEGY" : root.lab.name) + " · " + (root.lab.version == "" ? "—" : root.lab.version);
                                                font-family: "monospace";
                                                font-size: 11.5px;
                                                color: LabPalette.lab-text;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text { text: root.lab.summary-line; font-family: "monospace"; font-size: 10px; color: LabPalette.dim; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Rectangle {
                                            width: 6px; height: 6px; border-radius: 3px;
                                            background: root.lab.dirty ? LabPalette.lab-amber : LabPalette.green;
                                            
                                        }
                                        Text {
                                            text: root.lab.dirty ? "UNSAVED CHANGES" : "SAVED";
                                            font-size: 9.5px;
                                            letter-spacing: 0.8px;
                                            color: root.lab.dirty ? LabPalette.lab-amber : LabPalette.lab-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // studio meta strip
                                Rectangle {
                                    height: 44px;
                                    HorizontalLayout {
                                        spacing: 0;
                                        LabMetaCell { mc-label: "VERSION"; mc-value: root.lab.version == "" ? "—" : root.lab.version; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "MODE"; mc-value: root.lab.mode == 0 ? "LONG" : root.lab.mode == 1 ? "SHORT" : "COMPARE"; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "TIMEFRAME"; mc-value: root.lab.timeframe == "" ? "—" : root.lab.timeframe; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "REF PF"; mc-value: root.lab.studio-ref-pf == "" ? "—" : root.lab.studio-ref-pf; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "SOURCE"; mc-value: root.lab.studio-source == "" ? "LOCAL" : root.lab.studio-source; }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                Rectangle { height: 12px; }
                                HorizontalLayout {
                                    padding-left: 16px;
                                    Text {
                                        text: "Strategy source — " + (root.lab.description == "" ? "working copy" : root.lab.description);
                                        font-size: 11px;
                                        color: LabPalette.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 380px;
                                    background: LabPalette.code-bg;
                                    TextEdit {
                                        x: 4px; y: 4px;
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                        text: root.lab.code;
                                        font-family: "monospace";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        edited(t) => { root.code-changed(t); }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // studio bar
                                Rectangle {
                                    height: 52px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        alignment: center;
                                        Rectangle {
                                            width: 90px; height: 34px;
                                            border-radius: 8px;
                                            background: LabPalette.inset;
                                            border-width: 1px;
                                            border-color: rstta.has-hover ? LabPalette.white-20 : LabPalette.line;
                                            rstta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.reset-requested(); }
                                            }
                                            Text { text: "Reset"; color: LabPalette.soft; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text {
                                            text: root.lab.dirty ? "Unsaved changes — review, then save." : "Saved · no unsaved changes.";
                                            font-size: 10.5px;
                                            color: LabPalette.dim;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 120px; height: 34px;
                                            border-radius: 8px;
                                            background: LabPalette.run-ink;
                                            opacity: root.lab.dirty ? 1 : 0.4;
                                            svta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.save-requested(); }
                                            }
                                            Text {
                                                text: root.lab.dirty ? "Save changes" : "Saved";
                                                color: LabPalette.chip-bg;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: "Local workspace. Editing changes the working copy; Save stores it in the strategy library. Rerun the experiment above to test changes.";
                                    font-size: 10.5px;
                                    color: LabPalette.dim;
                                    x: 16px; width: parent.width - 32px;
                                    height: 32px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ════ FOOTER ════
                    Rectangle {
                        height: 56px;
                        HorizontalLayout {
                            spacing: 14px;
                            alignment: center;
                            Text { text: "VAYREN · STRATEGY LAB"; font-family: "monospace"; font-size: 10px; letter-spacing: 0.5px; color: LabPalette.lab-faint; vertical-alignment: center; }
                            Text { text: "Research workspace — real strategy layer, native rendering."; font-size: 10px; color: LabPalette.lab-faint; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.lab.progress-label; font-size: 10px; color: LabPalette.dim; vertical-alignment: center; }
                        }
                        Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                    }
                    Rectangle { height: 24px; }
                }
            }
        }
    }

    // ── UNIVERSE DIALOG (overlay) ──
    if root.lab.sym-open: Rectangle {
        ovlta := TouchArea {
            clicked => { root.sym-close(); }
        }
        background: LabPalette.scrim;
        Rectangle {
            width: Math.min(LabPalette.dialog-w, parent.width - 32px);
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: LabPalette.section-radius;
            background: LabPalette.dialog-bg;
            border-width: 1px;
            border-color: LabPalette.line;
            clip: true;
            // Swallow background clicks (the scrim below would close).
            TouchArea { }
            VerticalLayout {
                spacing: 0;
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        alignment: center;
                        Text { text: "Universe"; font-size: 13px; font-weight: 650; color: LabPalette.lab-text; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 22px; height: 22px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-close(); }
                            }
                            Text { text: "×"; color: LabPalette.lab-muted; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                }
                Rectangle {
                    height: 48px;
                    LabCtlSearch {
                        x: 16px; y: 6px; width: parent.width - 32px;
                        ctl-h: 36px;
                        ph: "Search stocks…";
                        val: root.lab.sym-search;
                        changed(t) => { root.sym-search-changed(t); }
                    }
                }
                ScrollView {
                    viewport-width: parent.width - 36px;
                    max-height: 280px;
                    VerticalLayout {
                        spacing: 0;
                        for srow[idx] in root.sym-visible: Rectangle {
                            height: 36px;
                            border-radius: 7px;
                            background: srsta.has-hover ? LabPalette.selected2 : transparent;
                            srsta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-toggle(srow); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text { text: srow; font-family: "monospace"; font-size: 11.5px; color: LabPalette.soft; horizontal-stretch: 1; vertical-alignment: center; }
                                Text {
                                    text: root.sym-visible-on[idx] ? "☑" : "☐";
                                    color: root.sym-visible-on[idx] ? LabPalette.lab-teal : LabPalette.lab-faint;
                                    font-size: 15px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 10px;
                        alignment: center;
                        Text { text: root.lab.sym-count-line; font-family: "monospace"; font-size: 10.5px; color: LabPalette.lab-muted; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 84px; height: 34px;
                            border-radius: 8px;
                            background: LabPalette.run-ink;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-apply(); }
                            }
                            Text { text: "Apply"; color: LabPalette.chip-bg; font-size: 11.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                }
            }
        }
    }

    // ── DROPDOWN MENU HOST (overlay; never clipped by section cards) ──
    if root.menu-src >= 0: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        TouchArea {
            clicked => { root.menu-src = -1; }
        }
        Rectangle {
            x: Math.max(6px, Math.min(root.menu-x, parent.width - root.menu-w - 6px));
            y: root.menu-y;
            width: root.menu-w;
            height: root.menu-items.length * 30px + 8px;
            border-radius: 10px;
            background: LabPalette.dialog-bg;
            border-width: 1px;
            border-color: LabPalette.white-16;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0;
                for mopt in root.menu-items: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: mopt == root.menu-current ? LabPalette.selected2 : mmta.has-hover ? LabPalette.hover2 : transparent;
                    mmta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.menu-src == 0) {
                                root.timeframe-picked(mopt);
                            } else if (root.menu-src == 1) {
                                root.rankby-picked(mopt);
                            } else {
                                root.equity-select-picked(mopt == "Daily P&L" ? 1 : mopt == "Return %" ? 2 : 0);
                            }
                            root.menu-src = -1;
                        }
                    }
                    Text {
                        text: mopt;
                        font-size: 11.5px;
                        color: mopt == root.menu-current ? LabPalette.lab-text : LabPalette.soft;
                        x: 10px; width: parent.width - 20px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── DATE-RANGE PICKER (overlay) ──
    if root.dates-open: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        TouchArea {
            clicked => { root.dates-open = false; }
        }
        LabDateRangePicker {
            x: Math.max(6px, Math.min(root.dates-x, parent.width - self.width - 6px));
            y: root.dates-y;
            start-days: root.lab.dates-start-days;
            end-days: root.lab.dates-end-days;
            today-days: root.lab.today-days;
            presets: root.date-presets;
            committed(s, e) => {
                root.dates-committed(s, e);
                root.dates-open = false;
            }
            cancelled() => { root.dates-open = false; }
        }
    }
}