// Research host window — integration glue ONLY, never visual design.
//
// Root `Window` hosting the EXISTING verified `ResearchScreen` unmodified
// (all presentation, layout, responsive behavior and styling live in
// `../../vayren-shell/ui/research.slint`). Every property below is a pure
// pass-through binding; every callback forwards. Recomposition tiers are
// evaluated from the HOST VIEW size (platform-owned input — never the
// screen's own width, which would feed layout implicit sizes back).
import { ResearchScreen, ResearchMetric, ResearchSignalRow, ResearchTradeRow, ResearchRobustRow, ResearchKv, ResearchCompareRow, ResearchStrategyRow, ResearchExperimentRow, ResearchField, ResearchConfigGroup, ResearchEvidenceDim, ResearchEvidenceWhy, ResearchKvGroup } from "../../vayren-shell/ui/research.slint";
import { VayrenDesign } from "../../vayren-shell/ui/palette.slint";

export component ResearchHostWindow inherits Window {
    title: "VAYREN — Research";
    background: transparent;
    no-frame: true;

    // Physical view size reported by the Qt host (logical after scale).
    in property <length> view-width: 1280px;
    in property <length> view-height: 800px;

    in-out property <string> strategy-name;
    in-out property <string> strategy-version;
    in-out property <string> experiment-id;
    in-out property <string> context-line;
    in-out property <[ResearchStrategyRow]> strategies;
    in-out property <[ResearchExperimentRow]> experiments;
    in-out property <string> strategy-count;
    in-out property <string> experiment-count;
    in-out property <[ResearchConfigGroup]> config-groups;
    in-out property <string> hypothesis;
    in-out property <string> question;
    in-out property <string> effect;
    in-out property <string> create-error;
    in-out property <string> state-label;
    in-out property <int> state-tone;
    in-out property <bool> has-strategy;
    in-out property <bool> show-results;
    in-out property <bool> stale;
    in-out property <bool> run-enabled;
    in-out property <string> run-blocked-reason;
    in-out property <bool> cancel-visible;
    in-out property <bool> create-visible;
    in-out property <[ResearchMetric]> metrics;
    in-out property <string> signal-count-line;
    in-out property <string> trade-count-line;
    in-out property <[ResearchSignalRow]> signals;
    in-out property <[ResearchTradeRow]> trades;
    in-out property <[ResearchRobustRow]> robustness;
    in-out property <[ResearchKv]> validation-rows;
    in-out property <[ResearchKv]> quality-rows;
    in-out property <[ResearchKv]> inspector-rows;
    in-out property <[ResearchKv]> report-sections;
    in-out property <[ResearchCompareRow]> compare-rows;
    in-out property <string> compare-verdict;
    in-out property <string> empty-title;
    in-out property <string> empty-detail;
    in-out property <string> conclusion;
    in-out property <string> validation-status;
    in-out property <string> validation-summary;
    in-out property <string> fingerprint-line;
    in-out property <string> evidence-verdict;
    in-out property <int> evidence-tone;
    in-out property <string> evidence-grade;
    in-out property <[ResearchEvidenceWhy]> evidence-why;
    in-out property <[ResearchEvidenceDim]> evidence-dims;
    in-out property <[ResearchKv]> stats-rows;
    in-out property <[ResearchKv]> montecarlo-rows;
    in-out property <[ResearchKv]> benchmark-rows;
    in-out property <[ResearchKvGroup]> inspector-groups;
    in-out property <int> tab;
    in-out property <bool> inspector-open;
    in-out property <int> narrow-view;
    in-out property <string> signal-filter;
    in-out property <[string]> log-lines;
    in-out property <string> log-status;
    in-out property <bool> log-expanded;
    in-out property <bool> hypothesis-open;
    in-out property <bool> why-open;
    in-out property <bool> technical-open;
    in-out property <bool> show-next-steps;

    callback strategy-picked(int);
    callback config-edited(string, string);
    callback config-option(string, string);
    callback hypothesis-edited(string);
    callback question-edited(string);
    callback effect-edited(string);
    callback create-pressed();
    callback run-pressed();
    callback cancel-pressed();
    callback tab-picked(int);
    callback inspector-toggled();
    callback narrow-view-picked(int);
    callback signal-filter-changed(string);
    callback experiment-picked(int);
    callback hypothesis-toggled();
    callback why-toggled();
    callback technical-toggled();

    screen := ResearchScreen {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        wide: root.view-width >= VayrenDesign.research-wide;
        medium: root.view-width >= VayrenDesign.research-medium;
        strategy-name: root.strategy-name;
        strategy-version: root.strategy-version;
        experiment-id: root.experiment-id;
        context-line: root.context-line;
        strategies: root.strategies;
        experiments: root.experiments;
        strategy-count: root.strategy-count;
        experiment-count: root.experiment-count;
        config-groups: root.config-groups;
        hypothesis: root.hypothesis;
        question: root.question;
        effect: root.effect;
        create-error: root.create-error;
        state-label: root.state-label;
        state-tone: root.state-tone;
        has-strategy: root.has-strategy;
        show-results: root.show-results;
        stale: root.stale;
        run-enabled: root.run-enabled;
        run-blocked-reason: root.run-blocked-reason;
        cancel-visible: root.cancel-visible;
        create-visible: root.create-visible;
        metrics: root.metrics;
        signal-count-line: root.signal-count-line;
        trade-count-line: root.trade-count-line;
        signals: root.signals;
        trades: root.trades;
        robustness: root.robustness;
        validation-rows: root.validation-rows;
        quality-rows: root.quality-rows;
        inspector-rows: root.inspector-rows;
        report-sections: root.report-sections;
        compare-rows: root.compare-rows;
        compare-verdict: root.compare-verdict;
        empty-title: root.empty-title;
        empty-detail: root.empty-detail;
        conclusion: root.conclusion;
        validation-status: root.validation-status;
        validation-summary: root.validation-summary;
        fingerprint-line: root.fingerprint-line;
        evidence-verdict: root.evidence-verdict;
        evidence-tone: root.evidence-tone;
        evidence-grade: root.evidence-grade;
        evidence-why: root.evidence-why;
        evidence-dims: root.evidence-dims;
        stats-rows: root.stats-rows;
        montecarlo-rows: root.montecarlo-rows;
        benchmark-rows: root.benchmark-rows;
        inspector-groups: root.inspector-groups;
        tab: root.tab;
        inspector-open: root.inspector-open;
        narrow-view: root.narrow-view;
        signal-filter: root.signal-filter;
        log-lines: root.log-lines;
        log-status: root.log-status;
        log-expanded: root.log-expanded;
        hypothesis-open: root.hypothesis-open;
        why-open: root.why-open;
        technical-open: root.technical-open;
        show-next-steps: root.show-next-steps;
        strategy-picked(i) => { root.strategy-picked(i); }
        config-edited(k, t) => { root.config-edited(k, t); }
        config-option(k, v) => { root.config-option(k, v); }
        hypothesis-edited(t) => { root.hypothesis-edited(t); }
        question-edited(t) => { root.question-edited(t); }
        effect-edited(t) => { root.effect-edited(t); }
        create-pressed() => { root.create-pressed(); }
        run-pressed() => { root.run-pressed(); }
        cancel-pressed() => { root.cancel-pressed(); }
        tab-picked(i) => { root.tab-picked(i); }
        inspector-toggled() => { root.inspector-toggled(); }
        narrow-view-picked(i) => { root.narrow-view-picked(i); }
        signal-filter-changed(t) => { root.signal-filter-changed(t); }
        experiment-picked(i) => { root.experiment-picked(i); }
        hypothesis-toggled() => { root.hypothesis-toggled(); }
        why-toggled() => { root.why-toggled(); }
        technical-toggled() => { root.technical-toggled(); }
    }
}
