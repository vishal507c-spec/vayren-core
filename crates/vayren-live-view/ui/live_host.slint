// Live host window — integration glue ONLY, never visual design.
//
// Root `Window` hosting the EXISTING verified `LiveScreen` unmodified (all
// presentation, layout, responsive behavior and styling live in
// `../../vayren-shell/ui/live.slint`). Every property below is a pure
// pass-through binding; every callback forwards for the Rust view-model.
// Nothing here may add, restyle, or recompose content — compare against
// the `app.slint` LiveScreen block. Recomposition tiers are evaluated from
// the HOST WINDOW size (platform-owned input — never the screen's own
// width, which would feed layout implicit sizes) using the same LiveTiers
// functions production uses.
import { LiveScreen, LiveTiers, LiveBar, LiveSetup, LiveMarket, LiveSymbolRow, LiveGate, LiveKv, LiveStat, LivePosition, LiveOrder, LiveFill, LiveEventRow, LiveCandle } from "../../vayren-shell/ui/live.slint";

export component LiveHostWindow inherits Window {
    title: "VAYREN — Live";
    background: transparent;
    no-frame: true;

    // Physical view size, reported by the host through the C ABI (logical
    // units after the scale factor). Tiers MUST derive from these numbers,
    // never from the Window's own width/height: an unsized host Window feeds
    // content implicit metrics back into the tier bindings (deprecated
    // layout loop — the whole point of window-level tier computation).
    in property <length> view-width: 1280px;
    in property <length> view-height: 800px;

    in-out property <LiveBar> bar;
    in-out property <LiveSetup> setup;
    in-out property <LiveMarket> market;
    in-out property <[LiveCandle]> candles;
    in-out property <[string]> strategy-names;
    in-out property <int> strategy-selected: -1;
    in-out property <[LiveSymbolRow]> symbols;
    in-out property <string> symbol-filter: "";
    in-out property <[string]> timeframe-names;
    in-out property <int> timeframe-selected: -1;
    in-out property <[LiveGate]> gates;
    in-out property <string> arm-note: "";
    in-out property <[string]> blockers;
    in-out property <[LiveKv]> strategy-rows;
    in-out property <[LiveKv]> position-rows;
    in-out property <[LiveKv]> risk-rows;
    in-out property <[LiveKv]> broker-rows;
    in-out property <[LiveKv]> recon-rows;
    in-out property <[LivePosition]> positions;
    in-out property <[LiveOrder]> orders;
    in-out property <[LiveFill]> fills;
    in-out property <[LiveStat]> stats;
    in-out property <[LiveEventRow]> events;
    in-out property <[string]> event-types;
    in-out property <int> event-type-index: 0;
    in-out property <string> event-filter: "";
    in-out property <bool> inspector-open: true;

    callback mode-picked(int);
    callback strategy-picked(string);
    callback symbol-toggled(int);
    callback symbol-filter-changed(string);
    callback timeframe-picked(string);
    callback quantity-edited(string);
    callback start-requested();
    callback stop-requested();
    callback arm-requested();
    callback halt-requested();
    callback confirm-requested();
    callback event-filter-changed(string);
    callback event-type-picked(string);
    callback inspector-toggled();
    callback configure-broker();

    LiveScreen {
        width: 100%;
        height: 100%;
        bar: root.bar;
        setup: root.setup;
        market: root.market;
        candles: root.candles;
        strategy-names: root.strategy-names;
        strategy-selected: root.strategy-selected;
        symbols: root.symbols;
        symbol-filter: root.symbol-filter;
        timeframe-names: root.timeframe-names;
        timeframe-selected: root.timeframe-selected;
        gates: root.gates;
        arm-note: root.arm-note;
        blockers: root.blockers;
        strategy-rows: root.strategy-rows;
        position-rows: root.position-rows;
        risk-rows: root.risk-rows;
        broker-rows: root.broker-rows;
        recon-rows: root.recon-rows;
        positions: root.positions;
        orders: root.orders;
        fills: root.fills;
        stats: root.stats;
        events: root.events;
        event-types: root.event-types;
        event-type-index: root.event-type-index;
        event-filter: root.event-filter;
        inspector-open: root.inspector-open;
        dock-inspector: LiveTiers.dock-inspector(root.view-width);
        bar-core: LiveTiers.bar-core(root.view-width);
        bar-secondary: LiveTiers.bar-secondary(root.view-width);
        bar-extended: LiveTiers.bar-extended(root.view-width);
        blotters-side-by-side: LiveTiers.blotters-side-by-side(root.view-width);
        tall-inspector: root.view-height >= 720px;
        inspector-w: LiveTiers.inspector-width(root.view-width);
        mode-picked(k) => { root.mode-picked(k); }
        strategy-picked(v) => { root.strategy-picked(v); }
        symbol-toggled(i) => { root.symbol-toggled(i); }
        symbol-filter-changed(t) => { root.symbol-filter-changed(t); }
        timeframe-picked(v) => { root.timeframe-picked(v); }
        quantity-edited(t) => { root.quantity-edited(t); }
        start-requested() => { root.start-requested(); }
        stop-requested() => { root.stop-requested(); }
        arm-requested() => { root.arm-requested(); }
        halt-requested() => { root.halt-requested(); }
        confirm-requested() => { root.confirm-requested(); }
        event-filter-changed(t) => { root.event-filter-changed(t); }
        event-type-picked(v) => { root.event-type-picked(v); }
        inspector-toggled() => { root.inspector-toggled(); }
        configure-broker() => { root.configure-broker(); }
    }
}
