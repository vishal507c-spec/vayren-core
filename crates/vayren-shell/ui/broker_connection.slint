// VAYREN broker CONNECTION workspace — the FINAL production broker screen.
//
// Presentation only: every displayed value is bound to properties fed by the
// Rust `BrokerWorkspace` view-model (backend facts + venue credential
// schemas, never UI inference, never secrets). The screen has ONE purpose:
// BROKER → STATUS → CREDENTIALS → CONNECT → AUTHENTICATION → CONNECTED.
//
// Layout (reference-faithful, 8px grid, canonical tokens only):
//   sidebar (brokers) │ main card (identity + credentials + progress)
// No dashboards, charts, funds, positions, orders, P&L or market data live
// here — whitespace is intentional. Circles use half-size radii (pill rule),
// everything else uses VayrenDesign radii. No hex literals in this file.

import { VayrenPalette, VayrenDesign } from "palette.slint";
import { VButton, VEmptyState, VStatusDot, VBanner } from "components.slint";
import { ScrollView } from "std-widgets.slint";

export struct BrokerRowView {
    id: string,
    display_name: string,
    mark: string,
    venue_subtitle: string,
    status_label: string,
    status_tone: int,
    selected: bool,
    connected: bool,
}

export struct CredentialFieldView {
    key: string,
    label: string,
    placeholder: string,
    secret: bool,
    required: bool,
    saved: bool,
}

export struct ProgressStepView {
    index: int,
    title: string,
    subtitle: string,
    state: int, // 0 pending, 1 active, 2 done, 3 failed
}

export component BrokerConnectionWorkspace inherits Rectangle {
    // ── facts in (Rust `BrokerWorkspace` projection) ──
    in property <[BrokerRowView]> brokers;
    in property <string> broker-display-name: "";
    in property <string> broker-id: "";
    in property <string> logo-mark: "?";
    in property <string> venue-subtitle: "";
    in property <string> env-label: "PAPER";
    in property <string> description-line: "Connect your account to start trading.";
    in property <string> status-pill-label: "Not Connected";
    in property <int> status-pill-tone: 3;
    in property <string> status-message: "";
    in property <[CredentialFieldView]> fields;
    in property <[ProgressStepView]> progress;
    in property <string> cta-label: "Connect to Broker";
    in property <bool> cta-arrow: true;
    in property <bool> cta-enabled: false;
    in property <bool> form-enabled: true;
    in property <bool> is-connected: false;
    in property <bool> is-failed: false;
    in property <string> error-message: "";
    in property <bool> disconnect-visible: false;
    in property <bool> disconnect-enabled: false;
    in property <string> help-caption: "View setup guide.";

    // ── ephemeral field state (Slint-local; secrets cross once via connect) ──
    in-out property <string> field-v0: "";
    in-out property <string> field-v1: "";
    in-out property <string> field-v2: "";
    in-out property <string> field-v3: "";
    in-out property <string> field-v4: "";
    in-out property <string> field-v5: "";
    in-out property <bool> field-show0: false;
    in-out property <bool> field-show1: false;
    in-out property <bool> field-show2: false;
    in-out property <bool> field-show3: false;
    in-out property <bool> field-show4: false;
    in-out property <bool> field-show5: false;
    in-out property <bool> show-error: true;
    // Pre-filled stand-in the host writes into fields that already hold a vault
    // value. Comparing against it is how the UI tells "untouched since the last
    // snapshot" from "retyped", so the SAVED chip can never go stale. Empty on
    // hosts that leave saved fields blank.
    in property <string> saved-sentinel: "";

    // Ephemeral interaction state: arm-before-destroy on the destructive
    // action, and a transient receipt after the clipboard write.
    in-out property <bool> remove-armed: false;
    in-out property <bool> copied: false;
    in-out property <bool> pulse: false;

    callback broker-selected(string);
    callback connect-requested(string, string, string, string, string, string);
    callback retry-requested();
    callback disconnect-requested();
    callback remove-requested();
    callback config-saved(string, string);
    callback copy-callback();
    callback refresh-requested();
    callback help-requested();
    callback add-broker-requested();
    callback paste-requested(int);

    function field-text(i: int) -> string {
        return i == 0 ? root.field-v0 : i == 1 ? root.field-v1 : i == 2 ? root.field-v2
            : i == 3 ? root.field-v3 : i == 4 ? root.field-v4 : root.field-v5;
    }
    function field-shown(i: int) -> bool {
        return i == 0 ? root.field-show0 : i == 1 ? root.field-show1 : i == 2 ? root.field-show2
            : i == 3 ? root.field-show3 : i == 4 ? root.field-show4 : root.field-show5;
    }
    function pill-color() -> color {
        return root.status-pill-tone == 1 ? VayrenPalette.pos
            : root.status-pill-tone == 2 ? VayrenPalette.amber
            : root.status-pill-tone == 3 ? VayrenPalette.neg
            : VayrenPalette.muted;
    }
    // The pill surface tracks the tone, so an inactive venue reads as a quiet
    // neutral chip and red only ever means a failed attempt.
    function pill-surface() -> color {
        return root.status-pill-tone == 1 ? VayrenPalette.pos-dim
            : root.status-pill-tone == 3 ? VayrenPalette.neg-dim
            : root.status-pill-tone == 2 ? VayrenPalette.warn-dim
            : VayrenPalette.hover;
    }
    function step-ink(state: int) -> color {
        return state == 2 ? VayrenPalette.pos
            : state == 1 ? VayrenPalette.accent
            : state == 3 ? VayrenPalette.neg
            : VayrenPalette.faint;
    }
    function step-title-ink(state: int) -> color {
        return state == 0 ? VayrenPalette.muted : VayrenPalette.text;
    }
    function busy() -> bool {
        return !root.form-enabled && !root.is-connected && !root.is-failed;
    }
    // Selection clears the ephemeral secret slots, so a typed value can never
    // leak from one venue into another.
    function clear-fields() {
        root.field-v0 = "";
        root.field-v1 = "";
        root.field-v2 = "";
        root.field-v3 = "";
        root.field-v4 = "";
        root.field-v5 = "";
        root.field-show0 = false;
        root.field-show1 = false;
        root.field-show2 = false;
        root.field-show3 = false;
        root.field-show4 = false;
        root.field-show5 = false;
    }
    // The ONE submission path: click and Ctrl+Enter share it, so the keyboard
    // can never trigger a different action than the button.
    function submit() {
        root.remove-armed = false;
        if root.is-failed {
            root.retry-requested();
        } else {
            root.connect-requested(root.field-v0, root.field-v1, root.field-v2, root.field-v3, root.field-v4, root.field-v5);
        }
    }
    copy-timer := Timer {
        interval: 1500ms;
        running: root.copied;
        triggered() => { root.copied = false; }
    }
    // Runs only while the backend reports an authentication round-trip, so an
    // idle screen never spins a timer.
    pulse-timer := Timer {
        interval: 900ms;
        running: root.busy();
        triggered() => { root.pulse = !root.pulse; }
    }

    background: transparent;

    HorizontalLayout {
        spacing: VayrenDesign.sp-xl;
        padding: VayrenDesign.sp-xl;

        // ── LEFT: broker sidebar ──
        VerticalLayout {
            width: 208px;
            spacing: VayrenDesign.sp-md;
            alignment: start;

            Text {
                text: "BROKERS";
                color: VayrenPalette.text;
                font-size: VayrenDesign.fs-small;
                font-weight: 700;
            }
            if root.brokers.length == 0: VEmptyState {
                title: "No brokers registered";
                detail: "The backend reported no broker venues.";
            }
            Rectangle { height: VayrenDesign.sp-sm; background: transparent; }

            for row in root.brokers: Rectangle {
                height: 56px;
                border-radius: VayrenDesign.radius-lg;
                background: row.selected ? VayrenPalette.selected
                    : row-ta.pressed ? VayrenPalette.pressed
                    : row-ta.has-hover ? VayrenPalette.hover
                    : VayrenPalette.surface;
                border-width: 1px;
                border-color: row.selected ? VayrenPalette.accent
                    : row-ta.has-hover ? VayrenPalette.accent-dim
                    : VayrenPalette.hairline;
                animate background { duration: 120ms; easing: ease-out; }
                animate border-color { duration: 120ms; easing: ease-out; }

                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.clear-fields();
                        root.remove-armed = false;
                        root.broker-selected(row.id);
                    }
                }
                HorizontalLayout {
                    padding-left: VayrenDesign.sp-md;
                    padding-right: VayrenDesign.sp-md;
                    spacing: VayrenDesign.sp-md;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: VayrenDesign.radius;
                        background: VayrenPalette.bg1;
                        clip: true;
                        if row.id == "zerodha": Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("icons/zerodha.svg");
                            image-fit: contain;
                        }
                        if row.id == "fyers": Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("icons/fyers.svg");
                            image-fit: contain;
                        }
                        if row.id != "zerodha" && row.id != "fyers": VerticalLayout {
                            alignment: center;
                            Text {
                                text: row.mark;
                                color: row.selected ? VayrenPalette.accent : VayrenPalette.muted;
                                font-size: VayrenDesign.fs-title;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: row.display-name;
                            color: VayrenPalette.text;
                            font-size: VayrenDesign.fs-small;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: VayrenDesign.sp-sm;
                            VStatusDot {
                                tone: row.status-tone;
                            }
                            Text {
                                text: row.status-label;
                                color: row.status-tone == 1 ? VayrenPalette.pos
                                    : row.status-tone == 3 ? VayrenPalette.neg
                                    : VayrenPalette.muted;
                                font-size: VayrenDesign.fs-label;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    Text {
                        text: "›";
                        color: row.selected || row-ta.has-hover ? VayrenPalette.accent : VayrenPalette.faint;
                        font-size: VayrenDesign.fs-body;
                        vertical-alignment: center;
                        animate color { duration: 120ms; easing: ease-out; }
                    }
                }
            }

            Rectangle {
                height: 44px;
                border-radius: VayrenDesign.radius-lg;
                background: add-ta.pressed ? VayrenPalette.pressed : add-ta.has-hover ? VayrenPalette.hover : transparent;
                border-width: 1px;
                border-color: add-ta.has-hover ? VayrenPalette.accent-dim : VayrenPalette.hairline;
                animate background { duration: 120ms; easing: ease-out; }
                animate border-color { duration: 120ms; easing: ease-out; }
                add-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.add-broker-requested(); }
                }
                HorizontalLayout {
                    padding-left: VayrenDesign.sp-md;
                    spacing: VayrenDesign.sp-md;
                    Text {
                        text: "+";
                        color: add-ta.has-hover ? VayrenPalette.accent : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-metric-sm;
                        font-weight: 700;
                        vertical-alignment: center;
                        animate color { duration: 120ms; easing: ease-out; }
                    }
                    Text {
                        text: "Add Broker";
                        color: add-ta.has-hover ? VayrenPalette.accent : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-small;
                        font-weight: 700;
                        vertical-alignment: center;
                        animate color { duration: 120ms; easing: ease-out; }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        // ── MAIN: connection workspace card ──
        ScrollView {
            horizontal-stretch: 1;
            viewport-width: self.width;

            card := Rectangle {
                width: parent.width;
                background: VayrenPalette.surface;
                border-width: 1px;
                border-color: VayrenPalette.hairline;
                border-radius: VayrenDesign.radius-lg;

                VerticalLayout {
                    padding: VayrenDesign.sp-xxl;
                    spacing: VayrenDesign.sp-xl;
                    alignment: start;

                    // Header: identity + status + environment.
                    HorizontalLayout {
                        spacing: VayrenDesign.sp-xl;
                        Rectangle {
                            width: 52px;
                            height: 52px;
                            border-radius: VayrenDesign.radius-lg;
                            background: VayrenPalette.bg1;
                            clip: true;
                            if root.broker-id == "zerodha": Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("icons/zerodha.svg");
                                image-fit: contain;
                            }
                            if root.broker-id == "fyers": Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("icons/fyers.svg");
                                image-fit: contain;
                            }
                            if root.broker-id != "zerodha" && root.broker-id != "fyers": VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.logo-mark;
                                    color: VayrenPalette.accent;
                                    font-size: VayrenDesign.fs-hero;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: root.broker-display-name;
                                color: VayrenPalette.text;
                                font-size: VayrenDesign.fs-title;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.venue-subtitle != "" ? root.venue-subtitle : "—";
                                color: VayrenPalette.muted;
                                font-size: VayrenDesign.fs-small;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        // Trailing status cluster (nested so the row has no
                        // bare rectangles to absorb free space: the cluster
                        // keeps content width, the gap stays empty).
                        HorizontalLayout {
                            spacing: VayrenDesign.sp-md;
                            Rectangle {
                                height: 26px;
                                horizontal-stretch: 0;
                                border-radius: 13px;
                                background: root.pill-surface();
                                border-width: 1px;
                                border-color: root.pill-color();
                                HorizontalLayout {
                                    padding-left: VayrenDesign.sp-md;
                                    padding-right: VayrenDesign.sp-md;
                                    spacing: 6px;
                                    VStatusDot {
                                        tone: root.status-pill-tone;
                                    }
                                    Text {
                                        text: root.status-pill-label;
                                        color: root.pill-color();
                                        font-size: VayrenDesign.fs-label;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                height: 26px;
                                horizontal-stretch: 0;
                                border-radius: 13px;
                                background: VayrenPalette.hover;
                                border-width: 1px;
                                border-color: VayrenPalette.accent-dim;
                                HorizontalLayout {
                                    padding-left: VayrenDesign.sp-md;
                                    padding-right: VayrenDesign.sp-md;
                                    Text {
                                        text: root.env-label;
                                        color: VayrenPalette.accent;
                                        font-size: VayrenDesign.fs-label;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.description-line;
                        color: VayrenPalette.muted;
                        font-size: VayrenDesign.fs-table;
                    }

                    Rectangle { height: 1px; background: VayrenPalette.hairline; }

                    // The two columns own the card's remaining height, so each
                    // one's footer lands on the same bottom edge instead of the
                    // slack collecting as one block of trailing dead space.
                    HorizontalLayout {
                        spacing: VayrenDesign.sp-3xl;
                        vertical-stretch: 1;

                        // Credentials form.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: VayrenDesign.sp-md;
                            alignment: start;

                            if root.is-connected: Rectangle {
                                height: 42px;
                                border-radius: VayrenDesign.radius;
                                background: VayrenPalette.pos-dim;
                                border-width: 1px;
                                border-color: VayrenPalette.pos;
                                HorizontalLayout {
                                    padding-left: VayrenDesign.sp-lg;
                                    padding-right: VayrenDesign.sp-lg;
                                    spacing: VayrenDesign.sp-md;
                                    Text {
                                        text: "✓";
                                        color: VayrenPalette.pos;
                                        font-size: VayrenDesign.fs-body;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Account Connected & Verified";
                                        color: VayrenPalette.text;
                                        font-size: VayrenDesign.fs-table;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "•";
                                        color: VayrenPalette.pos;
                                        font-size: VayrenDesign.fs-table;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Live trading ready";
                                        color: VayrenPalette.pos;
                                        font-size: VayrenDesign.fs-small;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: VayrenPalette.bg;
                                        border-width: 1px;
                                        border-color: VayrenPalette.pos;
                                        HorizontalLayout {
                                            padding-left: VayrenDesign.sp-sm;
                                            padding-right: VayrenDesign.sp-sm;
                                            Text {
                                                text: "ACTIVE";
                                                color: VayrenPalette.pos;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: VayrenDesign.sp-xs; background: transparent; }

                            for f[i] in root.fields: HorizontalLayout {
                                height: 36px;
                                spacing: VayrenDesign.sp-md;

                                HorizontalLayout {
                                    width: 112px;
                                    Text {
                                        text: f.label;
                                        color: VayrenPalette.muted;
                                        font-size: VayrenDesign.fs-table;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    if f.required: Text {
                                        text: "*";
                                        color: VayrenPalette.neg;
                                        font-size: VayrenDesign.fs-small;
                                        vertical-alignment: center;
                                    }
                                }
                                field-box := Rectangle {
                                    horizontal-stretch: 1;
                                    background: field-input.has-focus ? VayrenPalette.bg2 : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: field-input.has-focus ? VayrenPalette.accent : VayrenPalette.hairline;
                                    border-radius: VayrenDesign.radius;
                                    animate background { duration: 140ms; easing: ease-out; }
                                    animate border-color { duration: 140ms; easing: ease-out; }

                                    // Placeholder drawn BEFORE HorizontalLayout so TextInput is on top
                                    // and directly receives mouse clicks, focus, caret, and clipboard events.
                                    if root.field-text(i) == "": Text {
                                        x: 12px;
                                        y: 0px;
                                        width: field-box.width - (f.secret ? 130px : 72px);
                                        height: 36px;
                                        text: f.placeholder;
                                        color: VayrenPalette.faint;
                                        font-size: VayrenDesign.fs-table;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        padding-left: VayrenDesign.sp-md;
                                        padding-right: VayrenDesign.sp-sm;
                                        spacing: VayrenDesign.sp-xs;

field-input := TextInput {
                                             horizontal-stretch: 1;
                                             text: root.field-text(i);
                                             color: VayrenPalette.text;
                                             font-size: VayrenDesign.fs-table;
                                             single-line: true;
                                             enabled: root.form-enabled;
                                             input-type: f.secret && !root.field-shown(i) ? InputType.password : InputType.text;
                                             vertical-alignment: center;
                                             selection-foreground-color: VayrenPalette.text;
                                             selection-background-color: VayrenPalette.accent-dim;
                                             key-pressed(event) => {
                                                 if (event.modifiers.control && (event.text == "v" || event.text == "V" || event.text == "\u{16}")) {
                                                     self.paste();
                                                     if i == 0 { root.field-v0 = self.text; }
                                                     else if i == 1 { root.field-v1 = self.text; }
                                                     else if i == 2 { root.field-v2 = self.text; }
                                                     else if i == 3 { root.field-v3 = self.text; }
                                                     else if i == 4 { root.field-v4 = self.text; }
                                                     else { root.field-v5 = self.text; }
                                                     return accept;
                                                 }
                                                if (event.modifiers.control && (event.text == "c" || event.text == "C" || event.text == "\u{03}")) {
                                                    self.copy();
                                                    return accept;
                                                }
                                                if (event.modifiers.control && (event.text == "x" || event.text == "X" || event.text == "\u{18}")) {
                                                    self.cut();
                                                    if i == 0 { root.field-v0 = self.text; }
                                                    else if i == 1 { root.field-v1 = self.text; }
                                                    else if i == 2 { root.field-v2 = self.text; }
                                                    else if i == 3 { root.field-v3 = self.text; }
                                                    else if i == 4 { root.field-v4 = self.text; }
                                                    else { root.field-v5 = self.text; }
                                                    return accept;
                                                }
                                                if (event.modifiers.control && (event.text == "a" || event.text == "A" || event.text == "\u{01}")) {
                                                    self.select-all();
                                                    return accept;
                                                }
                                                if (event.text == "\u{0D}" || event.text == "\u{0A}") {
                                                    root.submit();
                                                    return accept;
                                                }
                                                if (event.text == "\u{1B}") {
                                                    root.remove-armed = false;
                                                    return reject;
                                                }
                                                return reject;
                                            }
                                            edited => {
                                                if i == 0 { root.field-v0 = field-input.text; }
                                                else if i == 1 { root.field-v1 = field-input.text; }
                                                else if i == 2 { root.field-v2 = field-input.text; }
                                                else if i == 3 { root.field-v3 = field-input.text; }
                                                else if i == 4 { root.field-v4 = field-input.text; }
                                                else { root.field-v5 = field-input.text; }
                                                // A committed edit on a REVEALED
                                                // field is a real save intent:
                                                // report the venue's own key
                                                // (never a guessed one) with the
                                                // typed value.
                                                if !f.secret || root.field-shown(i) {
                                                    root.config-saved(f.key, field-input.text);
                                                }
                                            }
                                        }

                                        // Dedicated PASTE button for instant clipboard paste
                                        Rectangle {
                                            width: 54px;
                                            height: 24px;
                                            y: (field-box.height - 24px) / 2;
                                            border-radius: 4px;
                                            background: paste-ta.pressed ? VayrenPalette.accent-dim : paste-ta.has-hover ? VayrenPalette.accent : VayrenPalette.hover;
                                            border-width: 1px;
                                            border-color: paste-ta.has-hover ? VayrenPalette.accent : VayrenPalette.hairline;
                                            animate background { duration: 120ms; easing: ease-out; }
                                            Text {
                                                text: "PASTE";
                                                color: paste-ta.has-hover ? VayrenPalette.accent-text : VayrenPalette.muted;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                            paste-ta := TouchArea {
                                                enabled: root.form-enabled;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    field-input.focus();
                                                    field-input.select-all();
                                                    field-input.paste();
                                                    if i == 0 { root.field-v0 = field-input.text; }
                                                    else if i == 1 { root.field-v1 = field-input.text; }
                                                    else if i == 2 { root.field-v2 = field-input.text; }
                                                    else if i == 3 { root.field-v3 = field-input.text; }
                                                    else if i == 4 { root.field-v4 = field-input.text; }
                                                    else { root.field-v5 = field-input.text; }
                                                    root.paste-requested(i);
                                                }
                                            }
                                        }

                                        // SHOW / HIDE toggle for password fields
                                        if f.secret: Rectangle {
                                            width: 48px;
                                            height: 24px;
                                            y: (field-box.height - 24px) / 2;
                                            border-radius: 4px;
                                            background: show-ta.pressed ? VayrenPalette.accent-dim : show-ta.has-hover ? VayrenPalette.selected : VayrenPalette.hover;
                                            border-width: 1px;
                                            border-color: show-ta.has-hover ? VayrenPalette.accent-dim : VayrenPalette.hairline;
                                            animate background { duration: 120ms; easing: ease-out; }
                                            Text {
                                                text: root.field-shown(i) ? "HIDE" : "SHOW";
                                                color: root.field-shown(i) ? VayrenPalette.accent : show-ta.has-hover ? VayrenPalette.text : VayrenPalette.faint;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                                animate color { duration: 120ms; easing: ease-out; }
                                            }
                                            show-ta := TouchArea {
                                                enabled: root.form-enabled;
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if i == 0 { root.field-show0 = !root.field-show0; }
                                                    else if i == 1 { root.field-show1 = !root.field-show1; }
                                                    else if i == 2 { root.field-show2 = !root.field-show2; }
                                                    else if i == 3 { root.field-show3 = !root.field-show3; }
                                                    else if i == 4 { root.field-show4 = !root.field-show4; }
                                                    else { root.field-show5 = !root.field-show5; }
                                                }
                                            }
                                        }
                                    }
                                }

                                // The backend reports whether this key already has
                                // a vault value; the chip surfaces that fact and
                                // steps aside the moment the field is retyped,
                                // so it never claims a stale "saved" state.
                                if f.saved && root.field-text(i) == root.saved-sentinel: Rectangle {
                                    width: 54px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: VayrenPalette.pos-dim;
                                    border-width: 1px;
                                    border-color: VayrenPalette.pos;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "✓";
                                            color: VayrenPalette.pos;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "SAVED";
                                            color: VayrenPalette.pos;
                                            font-size: 10px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // A venue that reports no credential schema renders
                            // the backend's absence honestly — never an invented
                            // "nothing required" claim.
                            if root.fields.length == 0 && !root.is-connected && !root.is-failed: VEmptyState {
                                title: "No credential fields reported";
                                detail: "This venue published no credential schema. Select another broker to continue.";
                            }

                            if root.is-failed && root.show-error: VBanner {
                                message: root.error-message;
                                tone: 3;
                            }
                            if root.is-failed && root.show-error: HorizontalLayout {
                                spacing: VayrenDesign.sp-md;
                                VButton {
                                    label: "RETRY";
                                    variant: 0;
                                    clicked => {
                                        root.show-error = true;
                                        root.retry-requested();
                                    }
                                }
                                VButton {
                                    label: "EDIT CREDENTIALS";
                                    variant: 2;
                                    clicked => { root.show-error = false; }
                                }
                            }

                            // Active live authenticating status card
                            if !root.form-enabled && !root.is-connected && !root.is-failed: Rectangle {
                                height: 42px;
                                border-radius: VayrenDesign.radius;
                                background: VayrenPalette.focus-ring;
                                border-width: 1px;
                                border-color: VayrenPalette.accent-dim;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: VayrenDesign.sp-md;
                                    VStatusDot { tone: 2; }
                                    Text {
                                        text: root.status-message != "" ? root.status-message : "Authenticating with " + root.broker-display-name + "…";
                                        color: VayrenPalette.accent;
                                        font-size: VayrenDesign.fs-small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if !root.is-connected && !(root.is-failed && root.show-error): VButton {
                                label: root.cta-arrow ? root.cta-label + "   →" : root.cta-label;
                                variant: 0;
                                enabled: root.cta-enabled;
                                clicked => { root.submit(); }
                            }
                            if root.is-connected && root.disconnect-visible: HorizontalLayout {
                                spacing: VayrenDesign.sp-md;
                                alignment: start;
                                Rectangle {
                                    height: 40px;
                                    // Sized to the label, never stretched: a
                                    // destructive action must not read as the
                                    // form's primary full-width control.
                                    width: 220px;
                                    horizontal-stretch: 0;
                                    border-radius: VayrenDesign.radius;
                                    background: disc-ta.pressed ? VayrenPalette.neg : disc-ta.has-hover ? VayrenPalette.neg-dim : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: disc-ta.has-hover ? VayrenPalette.neg : VayrenPalette.hairline;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: VayrenDesign.sp-sm;
                                        Text {
                                            text: "DISCONNECT BROKER";
                                            color: disc-ta.has-hover ? VayrenPalette.text : VayrenPalette.neg;
                                            font-size: VayrenDesign.fs-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    disc-ta := TouchArea {
                                        enabled: root.disconnect-enabled;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.remove-armed = false;
                                            root.disconnect-requested();
                                        }
                                    }
                                }
                            }

                            // The vault footnote describes the whole form, not the CTA, so it sits on
                            // the card's bottom edge and the slack above it stays intentional
                            // whitespace instead of trailing dead space.
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: VayrenDesign.sp-sm;
                                Text {
                                    text: "🔒";
                                    color: VayrenPalette.muted;
                                    font-size: VayrenDesign.fs-label;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Credentials are encrypted and stored securely in the OS vault.";
                                    color: VayrenPalette.muted;
                                    font-size: VayrenDesign.fs-label;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { width: 1px; background: VayrenPalette.hairline; }

                        // Connection progress.
                        VerticalLayout {
                            width: 248px;
                            spacing: VayrenDesign.sp-md;
                            alignment: start;

                            Text {
                                text: "Connection Progress";
                                color: VayrenPalette.text;
                                font-size: VayrenDesign.fs-body;
                                font-weight: 700;
                            }
                            Rectangle { height: VayrenDesign.sp-sm; background: transparent; }

                            for s[si] in root.progress: VerticalLayout {
                                spacing: 0;
                                HorizontalLayout {
                                    spacing: VayrenDesign.sp-md;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 12px;
                                        background: s.state == 2 ? VayrenPalette.pos-dim : s.state == 3 ? VayrenPalette.neg-dim : s.state == 1 ? (root.pulse ? VayrenPalette.focus-ring : transparent) : transparent;
                                        border-width: 1px;
                                        border-color: root.step-ink(s.state);
                                        animate background { duration: 900ms; easing: ease-in-out; }
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: s.state == 2 ? "✓" : s.state == 1 ? "●" : s.state == 3 ? "!" : s.index;
                                                color: s.state == 2 ? VayrenPalette.pos : root.step-ink(s.state);
                                                font-size: VayrenDesign.fs-small;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: s.title;
                                            color: s.state == 1 ? VayrenPalette.accent : root.step-title-ink(s.state);
                                            font-size: VayrenDesign.fs-table;
                                            font-weight: 700;
                                            animate color { duration: 200ms; easing: ease-out; }
                                        }
                                        Text {
                                            text: s.subtitle;
                                            color: s.state == 2 ? VayrenPalette.pos : s.state == 1 ? VayrenPalette.accent : VayrenPalette.muted;
                                            font-size: VayrenDesign.fs-label;
                                            font-weight: s.state == 2 ? 600 : 400;
                                        }
                                    }
                                }
                                if si < root.progress.length - 1: Rectangle {
                                    height: 14px;
                                    background: transparent;
                                    HorizontalLayout {
                                        spacing: VayrenDesign.sp-md;
                                        Rectangle {
                                            width: 24px;
                                            background: transparent;
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 2px;
                                                    height: 14px;
                                                    background: s.state == 2 ? VayrenPalette.pos : VayrenPalette.hairline;
                                                }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }

                            // Live connection state feedback card (Clear View)
                            Rectangle {
                                border-radius: VayrenDesign.radius;
                                background: root.is-connected ? VayrenPalette.pos-dim : root.is-failed ? VayrenPalette.neg-dim : !root.form-enabled ? VayrenPalette.focus-ring : VayrenPalette.bg1;
                                border-width: 1px;
                                border-color: root.is-connected ? VayrenPalette.pos : root.is-failed ? VayrenPalette.neg : !root.form-enabled ? VayrenPalette.accent-dim : VayrenPalette.hairline;
                                VerticalLayout {
                                    padding: VayrenDesign.sp-md;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: VayrenDesign.sp-sm;
                                        VStatusDot { tone: root.is-connected ? 1 : root.is-failed ? 3 : !root.form-enabled ? 2 : 0; }
                                        Text {
                                            text: root.is-connected ? "Connected & Verified" : root.is-failed ? "Connection Failed" : !root.form-enabled ? "Authenticating…" : "Ready to Connect";
                                            color: root.is-connected ? VayrenPalette.pos : root.is-failed ? VayrenPalette.neg : !root.form-enabled ? VayrenPalette.accent : VayrenPalette.text;
                                            font-size: VayrenDesign.fs-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.is-connected ? (root.status-message != "" ? root.status-message : "Session active & verified. Ready to trade.")
                                            : root.is-failed ? (root.error-message != "" ? root.error-message : "Authentication failed. Check credentials and retry.")
                                            : !root.form-enabled ? "Verifying 2FA and establishing secure session…"
                                            : "Enter your credentials and click connect.";
                                        color: VayrenPalette.muted;
                                        font-size: VayrenDesign.fs-label;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle { height: VayrenDesign.sp-xs; background: transparent; }

                            // Secondary + destructive actions live in the card
                            // footer, so the progress column reads top-down
                            // (progress → state) and ends on one aligned edge.
                            Rectangle { vertical-stretch: 1; background: transparent; }

                            // Destructive + copy actions. REMOVE arms a confirm step first — it deletes
                            // persisted credentials, so one stray click must never be
                            // enough. COPY writes the broker identity and confirms it.
                            if root.remove-armed: Rectangle {
                                border-radius: VayrenDesign.radius;
                                background: VayrenPalette.neg-dim;
                                border-width: 1px;
                                border-color: VayrenPalette.neg;
                                VerticalLayout {
                                    padding: VayrenDesign.sp-md;
                                    spacing: 2px;
                                    Text {
                                        text: "Remove " + (root.broker-display-name != "" ? root.broker-display-name : "this broker") + "?";
                                        color: VayrenPalette.text;
                                        font-size: VayrenDesign.fs-small;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Saved credentials for this venue are deleted from the OS vault. Orders, positions and history are untouched.";
                                        color: VayrenPalette.muted;
                                        font-size: VayrenDesign.fs-label;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: VayrenDesign.sp-sm;
                                if !root.remove-armed: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: VayrenDesign.radius;
                                    background: copy-ta.pressed ? VayrenPalette.selected : copy-ta.has-hover ? VayrenPalette.hover : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: copy-ta.has-hover ? VayrenPalette.accent : VayrenPalette.hairline;
                                    animate background { duration: 120ms; easing: ease-out; }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: VayrenDesign.sp-sm;
                                        Text {
                                            text: root.copied ? "✓ COPIED" : "COPY DETAILS";
                                            color: root.copied ? VayrenPalette.pos : copy-ta.has-hover ? VayrenPalette.accent : VayrenPalette.muted;
                                            font-size: VayrenDesign.fs-label;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            animate color { duration: 150ms; easing: ease-out; }
                                        }
                                    }
                                    copy-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.copy-callback();
                                            root.copied = true;
                                        }
                                    }
                                }
                                if !root.remove-armed: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: VayrenDesign.radius;
                                    background: rm-ta.pressed ? VayrenPalette.neg : rm-ta.has-hover ? VayrenPalette.neg-dim : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: rm-ta.has-hover ? VayrenPalette.neg : VayrenPalette.hairline;
                                    animate background { duration: 120ms; easing: ease-out; }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: VayrenDesign.sp-sm;
                                        Text {
                                            text: "REMOVE BROKER";
                                            color: rm-ta.has-hover ? VayrenPalette.neg : VayrenPalette.muted;
                                            font-size: VayrenDesign.fs-label;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    rm-ta := TouchArea {
                                        enabled: root.broker-id != "";
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-armed = true; }
                                    }
                                }
                                if root.remove-armed: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: VayrenDesign.radius;
                                    background: yes-ta.pressed ? VayrenPalette.neg : yes-ta.has-hover ? VayrenPalette.neg-dim : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: VayrenPalette.neg;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "YES, REMOVE";
                                            color: VayrenPalette.neg;
                                            font-size: VayrenDesign.fs-label;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    yes-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.remove-armed = false;
                                            root.remove-requested();
                                        }
                                    }
                                }
                                if root.remove-armed: Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: VayrenDesign.radius;
                                    background: no-ta.pressed ? VayrenPalette.pressed : no-ta.has-hover ? VayrenPalette.hover : VayrenPalette.bg1;
                                    border-width: 1px;
                                    border-color: no-ta.has-hover ? VayrenPalette.accent : VayrenPalette.hairline;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "KEEP";
                                            color: no-ta.has-hover ? VayrenPalette.accent : VayrenPalette.muted;
                                            font-size: VayrenDesign.fs-label;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                    no-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.remove-armed = false; }
                                    }
                                }
                            }

                            Rectangle {
                                background: help-ta.pressed ? VayrenPalette.pressed : help-ta.has-hover ? VayrenPalette.row-hover : VayrenPalette.bg1;
                                border-width: 1px;
                                border-color: help-ta.has-hover ? VayrenPalette.accent-dim : VayrenPalette.hairline;
                                border-radius: VayrenDesign.radius;
                                animate background { duration: 120ms; easing: ease-out; }
                                animate border-color { duration: 120ms; easing: ease-out; }
                                VerticalLayout {
                                    padding: VayrenDesign.sp-md;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: VayrenDesign.sp-sm;
                                        Text {
                                            text: "ⓘ";
                                            color: help-ta.has-hover ? VayrenPalette.accent : VayrenPalette.muted;
                                            font-size: VayrenDesign.fs-small;
                                            vertical-alignment: center;
                                            animate color { duration: 120ms; easing: ease-out; }
                                        }
                                        Text {
                                            text: "Need help?";
                                            color: VayrenPalette.text;
                                            font-size: VayrenDesign.fs-small;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text {
                                            text: "↗";
                                            color: help-ta.has-hover ? VayrenPalette.accent : VayrenPalette.faint;
                                            font-size: VayrenDesign.fs-small;
                                            vertical-alignment: center;
                                            animate color { duration: 120ms; easing: ease-out; }
                                        }
                                    }
                                    Text {
                                        text: root.help-caption;
                                        color: VayrenPalette.muted;
                                        font-size: VayrenDesign.fs-label;
                                        wrap: word-wrap;
                                    }
                                }
                                help-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.help-requested(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
