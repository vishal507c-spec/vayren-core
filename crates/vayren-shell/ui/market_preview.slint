// VAYREN Market â€” development preview harness (slint-viewer only).
//
// Fast loop for the market surface, including the timeframe ladder's overflow
// menu (the hidden 1D / 1W entries):
//
//     slint-viewer --auto-reload crates/vayren-shell/ui/market_preview.slint
//
// This file is NOT compiled into the shell (build.rs compiles ui/app.slint
// only) and never ships: it instantiates the REAL MarketScreen with
// representative demo bindings so every state â€” hover, the open overflow menu,
// a hidden timeframe selected â€” can be seen and clicked exactly like
// production. Tokens only, like every surface.

import { VayrenPalette } from "palette.slint";
import { MarketScreen } from "market.slint";

export component MarketPreview inherits Window {
    preferred-width: 1440px;
    preferred-height: 810px;
    title: "VAYREN â€” MARKET PREVIEW";
    background: VayrenPalette.bg;

    // Active chart timeframe. Picking any cell (visible or in the overflow
    // menu) moves this, and the row re-binds from it â€” the same single
    // selection authority the Rust state uses.
    in-out property <string> frame: "1D";
    // Start with the overflow menu open so the preview shows it immediately;
    // the first real interaction (chevron / scrim / Esc) takes the property
    // over exactly like production.
    in-out property <string> open-sheet: "overflow";

