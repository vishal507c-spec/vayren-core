// VAYREN LIVE — DESIGN REVIEW DEMO (sample data, not part of the app build).
//
// Populated with a representative RUNNING session so the whole surface can be
// judged in slint-viewer:
//   slint-viewer ui/live_demo.slint
// Every value below is fake sample data for visual review only. Nothing here is
// read by Rust and none of it reaches the real app.
//
// Struct values use the anonymous-literal form (`{ field: value, ... }`) inside
// a property binding — this Slint version does not accept `S { ... }`
// instantiations at a call site.

import { LiveScreen, LiveBar, LiveSetup, LiveMarket, LiveSymbolRow, LiveGate,
         LiveKv, LiveStat, LivePosition, LiveOrder, LiveFill, LiveEventRow,
         LiveWatchlistRow, LiveWebSocket, LiveMarketData, LiveRemoteGateway,
         LiveActiveStrategy, LiveEligibility, LiveEligibilityRow,
         LiveSelectedStock, LivePipelineStep, LiveFooter } from "live.slint";

export component LiveDemo inherits Window {
    preferred-width: 1600px;
    preferred-height: 900px;
    min-width: 1024px;
    min-height: 700px;
    title: "VAYREN LIVE — design review (sample data)";
    background: #0b0e13;

