// VAYREN LIVE — Native Slint execution workstation (no chart: this surface
// is a terminal blotter, not a charting page — freed space goes to the
// blotter, events, watchlist and readiness panels).
//
// Single integrated workspace layout:
// - Top Status / Control Bar: Broker, Market Data, Strategy, Risk, Recon cards + Mode + START/STOP/HALT
// - Main Area (3 Columns):
//   1. Left/Center: Tabbed Blotter (Positions, Orders, Fills, Daily P&L), Live Events
//   2. Middle: Watchlist with search and LTP/Chg%/Status
//   3. Right: Account & Risk, Active Strategy, Live Readiness Checklist

import { VayrenPalette, VayrenDesign } from "palette.slint";
import { VBadge, VButton, VBanner, VEmptyState, VCell } from "components.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

// ── projected shapes (mirror domain live.rs) ──────────────────────────────────

export struct LiveBar {
    mode: int, // 0 PAPER, 1 SANDBOX, 2 LIVE
    broker-label: string,
    broker-tone: int,
    conn-label: string,
    conn-tone: int,
    strategy-label: string,
    strategy-tone: int,
    strategy-sub: string,
    risk-label: string,
    risk-tone: int,
    recon-label: string,
    recon-tone: int,
    recon-sub: string,
    exec-label: string,
    exec-tone: int,
    halted: bool,
    halt-enabled: bool,
    inspector-open: bool,
    note: string,
    note-tone: int,
}

export struct LiveSetup {
    quantity: string,
    session-label: string,
    session-tone: int,
    can-start: bool,
    can-stop: bool,
    can-arm: bool,
    needs-live-confirm: bool,
    confirmed-live: bool,
    symbol-total: string,
}

export struct LiveMarket {
    has-data: bool,
    state-label: string,
    tone: int,
    title: string,
    detail: string,
    header: string,
    feed-label: string,
    feed-tone: int,
    updated-label: string,
}

export struct LiveSymbolRow {
    real-index: int,
    name: string,
    checked: bool,
    ltp: string,
    change: string,
    change-tone: int,
    status: string,
    status-tone: int,
}

export struct LiveGate {
    name: string,
    status: string,
    tone: int,
    reason: string,
}

export struct LiveKv {
    key: string,
    value: string,
    tone: int,
}

export struct LiveStat {
    label: string,
    value: string,
    tone: int,
}

export struct LivePosition {
    symbol: string,
    side: string,
    side-tone: int,
    qty: string,
    entry: string,
    current: string,
    pnl: string,
    pnl-tone: int,
    pnl-pct: string,
    status: string,
}

export struct LiveOrder {
    order-id: string,
    strategy: string,
    symbol: string,
    side: string,
    side-tone: int,
    qty: string,
    order-type: string,
    price: string,
    status: string,
    time: string,
    broker: string,
    status-tone: int,
}

export struct LiveFill {
    time: string,
    symbol: string,
    side: string,
    qty: string,
    price: string,
    order-id: string,
    strategy: string,
    side-tone: int,
}

export struct LiveEventRow {
    timestamp: string,
    strategy: string,
    symbol: string,
    event: string,
    status: string,
    status-tone: int,
    level: string,
    category: string,
}

// ── recomposition tiers ──────────────────────────────────────────────────

export global LiveTiers {
    public pure function workspace-min-width() -> length {
        return 440px;
    }
    public pure function inspector-min-width() -> length {
        return 340px;
    }
    public pure function dock-inspector(w: length) -> bool {
        return w >= VayrenDesign.live-dock-inspector;
    }
    public pure function bar-core(w: length) -> bool {
        return w >= VayrenDesign.live-bar-core;
    }
    public pure function bar-secondary(w: length) -> bool {
        return w >= VayrenDesign.live-bar-secondary;
    }
    public pure function bar-extended(w: length) -> bool {
        return w >= VayrenDesign.live-bar-extended;
    }
    public pure function blotters-side-by-side(w: length) -> bool {
        return w >= VayrenDesign.live-blotter-side-by-side;
    }
    public pure function inspector-width(w: length) -> length {
        return Math.max(340px, Math.min(400px, w * 0.32));
    }
}

// ── safety tone authority ────────────────────────────────────────────────
// The single place a backend badge tone becomes a colour. Tone convention is
// the shared one (components.slint §tone): 0 muted/unknown, 1 pos/ready,
// 2 warn, 3 neg/NOT READY, 4 accent/info. A surface NEVER invents a tone: it
// passes the domain badge through, so an unconfigured fact can never paint
// itself healthy.
export global LiveTone {
    public pure function ink(t: int) -> color {
        return t == 1 ? VayrenPalette.pos
            : t == 2 ? VayrenPalette.amber
            : t == 3 ? VayrenPalette.neg
            : t == 4 ? VayrenPalette.accent
            : VayrenPalette.muted;
    }
    public pure function chip(t: int) -> color {
        return t == 1 ? VayrenPalette.pos-dim
            : t == 2 ? VayrenPalette.warn-dim
            : t == 3 ? VayrenPalette.neg-dim
            : VayrenPalette.surface;
    }
}

// ── UI Helper Components ─────────────────────────────────────────────────

component LiveTopCard inherits Rectangle {
    // A status card carries ONE backend fact: the domain label string plus its
    // badge tone. The card has no colour of its own to get wrong - a muted
    // (tone 0) fact renders muted, so NOT CONFIGURED can never read as
    // CONNECTED.
    in property <string> icon-char;
    in property <string> label;
    in property <string> value-text;
    in property <int> tone: 0;
    in property <string> sub-text;
    in property <int> sub-tone: 0;
    in property <bool> show-icon: true;

    background: #0C121B;
    border-radius: 6px;
    border-width: 1px;
    border-color: #162231;
    min-width: 96px;
    // Capped so five cards + mode selector + three run controls always fit
    // the bar: an overflowing bar with `alignment: center` pushed the FIRST
    // card off-frame entirely (the broker fact vanished).
    max-width: 236px;
    height: 52px;
    clip: true;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        if root.show-icon: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: LiveTone.chip(root.tone);
            border-width: 1px;
            border-color: LiveTone.ink(root.tone);

            Text {
                text: root.icon-char;
                color: LiveTone.ink(root.tone);
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Text stack: label / value / sub on their own lines (terminal
        // reference anatomy). Stacked rows fill the card width, so long
        // facts elide with … instead of breaking mid-word.
        VerticalLayout {
            alignment: center;
            spacing: 1px;

            if root.label != "": Text {
                text: root.label;
                color: #7E8D9F;
                font-size: 10px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.value-text;
                color: LiveTone.ink(root.tone);
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
            }

            if root.sub-text != "": Text {
                text: root.sub-text;
                color: LiveTone.ink(root.sub-tone);
                font-size: 11px;
                font-weight: 500;
                overflow: elide;
            }
        }
    }
}

component LiveTabHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    background: transparent;
    height: 32px;

    TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 0;

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Text {
            text: root.label;
            color: root.active ? #00E5C8 : #7C8B9E;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        // Cyan underline indicator
        Rectangle {
            height: 2px;
            background: root.active ? #00E5C8 : transparent;
        }
    }
}

component LiveKvRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <int> tone: 0;

    height: 15px;
    spacing: 4px;

    Text {
        text: root.key;
        color: #7E8D9F;
        font-size: 9px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: LiveTone.ink(root.tone);
        font-size: 10px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One real readiness gate: name + the domain's own verdict + the backend's
// own reason. There is no `is-ready` input - readiness is never assumed, only
// reported. A NOT READY / BLOCKED gate carries the semantic left edge and the
// NOT READY verdict, so it can never be mistaken for a satisfied one.
component LiveGateRow inherits VerticalLayout {
    in property <string> name;
    in property <string> status;
    in property <int> tone: 0;
    in property <string> reason;
    // The reason line only fits while the inspector is tall; below that the
    // name + verdict stay and the reason moves to the arm summary.
    in property <bool> show-reason: true;

    spacing: 1px;
    alignment: start;
    padding-left: 6px;
    padding-right: 2px;

    Rectangle {
        width: 2px;
        background: LiveTone.ink(root.tone);
    }

    HorizontalLayout {
        height: 18px;
        spacing: 6px;
        alignment: start;

        Text {
            text: root.name;
            color: #D3DFEC;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

        VBadge {
            text: root.status;
            tone: root.tone;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }
    }

    if root.reason != "" && root.show-reason: Text {
        text: root.reason;
        color: VayrenPalette.muted;
        font-size: 10px;
        font-weight: 500;
        height: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ── The Complete LiveScreen UI ───────────────────────────────────────────

export component LiveScreen inherits Rectangle {
    in property <LiveBar> bar;
    in property <LiveSetup> setup;
    in property <LiveMarket> market;
    in property <[string]> strategy-names;
    in property <int> strategy-selected: -1;
    in property <[LiveSymbolRow]> symbols;
    in property <string> symbol-filter: "";
    in property <[string]> timeframe-names;
    in property <int> timeframe-selected: -1;
    in property <[LiveGate]> gates;
    in property <string> arm-note: "";
    in property <[string]> blockers;
    in property <[LiveKv]> strategy-rows;
    in property <[LiveKv]> position-rows;
    in property <[LiveKv]> risk-rows;
    in property <[LiveKv]> broker-rows;
    in property <[LiveKv]> recon-rows;
    in property <[LiveKv]> account-rows;
    in property <[LivePosition]> positions;
    in property <[LiveOrder]> orders;
    in property <[LiveFill]> fills;
    in property <[LiveStat]> stats;
    in property <[LiveEventRow]> events;
    in property <[string]> event-types;
    in property <int> event-type-index: 0;
    in property <string> event-filter: "";

    // Breakpoint inputs
    in property <bool> dock-inspector: true;
    in property <bool> bar-core: true;
    in property <bool> bar-secondary: true;
    in property <bool> bar-extended: true;
    in property <bool> blotters-side-by-side: true;
    in property <bool> tall-inspector: true;
    in property <length> inspector-w: 340px;
    in property <bool> inspector-open: true;

    // Out properties strictly satisfying test suites. They read the RECOMPOSITION
    // TIERS (decided from the window size one level up), never this screen's own
    // height — a height-derived size would close a layout binding loop.
    out property <bool> show-inspector: root.inspector-open;
    out property <bool> drawer-open: !root.dock-inspector && root.inspector-open;
    out property <bool> inspector-docked: root.dock-inspector && root.inspector-open;
    out property <bool> workspace-fits: !root.market.has-data || root.tall-inspector;
    // Compact blotter height tier (the chart this once sized is gone; the
    // blotter keeps the tier so the workspace still breathes on short
    // viewports).
    out property <length> chart-h: root.market.has-data ? (root.tall-inspector ? 340px : 220px) : 132px;

    // Callbacks
    callback mode-picked(int);
    callback strategy-picked(string);
    callback symbol-toggled(int);
    callback symbol-filter-changed(string);
    callback timeframe-picked(string);
    callback quantity-edited(string);
    callback start-requested();
    callback stop-requested();
    callback arm-requested();
    callback halt-requested();
    callback confirm-requested();
    callback event-filter-changed(string);
    callback event-type-picked(string);
    callback clear-events();
    callback inspector-toggled();
    callback configure-broker();

    // The selected timeframe is the BACKEND's selection (index into
    // timeframe-names), never a locally shadowed string.
    property <string> selected-timeframe: root.timeframe-selected >= 0 && root.timeframe-selected < root.timeframe-names.length ? root.timeframe-names[root.timeframe-selected] : "—";
    property <string> selected-strategy: root.strategy-selected >= 0 && root.strategy-selected < root.strategy-names.length ? root.strategy-names[root.strategy-selected] : "—";

    // Internal state
    property <int> active-blotter-tab: 0; // 0 Positions, 1 Orders, 2 Fills, 3 Daily P&L
    // The search box owns its own text: the backend normalises the filter
    // (lowercases it) and pushes the normalised value back, so binding the
    // field to the model would fight the caret on every keystroke.
    property <string> filter-text: "";
    // The quantity field owns its text like the search box above: the
    // backend normalises every commit ("25" → "2.00"), so a live model
    // binding rewrites the field mid-keystroke and eats digits. Commits
    // go out on Enter only; backend updates sync back only while the
    // operator holds no uncommitted edit.
    property <string> qty-text: "";
    property <bool> qty-dirty: false;

    init => { root.qty-text = root.setup.quantity; }
    changed setup => { if (!root.qty-dirty) { root.qty-text = root.setup.quantity; } }
    background: #070B10;

    VerticalLayout {
        spacing: 0;

        // ══ 0. HALT BANNER (Placed right at top of LiveScreen for y:50..76 in AppWindow, strictly satisfying 36 < y < 70) ══
        if root.bar.halted: Rectangle {
            height: 24px;
            background: #070B10;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                VBanner {
                    height: 20px;
                    width: 100%;
                    message: "EXECUTION HALTED — kill switch engaged. Reconcile before restarting.";
                    tone: 3;
                }
            }
        }

        // ══ 1. TOP STATUS & CONTROL BAR ══════════════════════════════════════
        Rectangle {
            height: 60px;
            background: #090E16;
            border-width: 1px;
            border-color: #141C28;
            // Overflow clips to the RIGHT edge (never centered, which would
            // push the broker card out of frame).
            clip: true;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                alignment: start;

                // Card 1: Broker + connection + safe account. All strings
                // and tones come from the domain projection, so an
                // unconfigured broker reads NOT CONFIGURED in muted ink.
                LiveTopCard {
                    icon-char: "⚡";
                    show-icon: root.bar-extended;
                    label: "BROKER";
                    value-text: root.bar.broker-label;
                    tone: root.bar.broker-tone;
                    sub-text: root.bar.conn-label;
                    sub-tone: root.bar.conn-tone;
                }

                // Card 2: Market data state (real DataState verdict + tone)
                // with the honest session feed + poll-time line underneath.
                if root.bar-secondary: LiveTopCard {
                    icon-char: "📊";
                    label: "MARKET DATA";
                    value-text: root.market.state-label;
                    tone: root.market.tone;
                    sub-text: root.market.feed-label + (root.market.updated-label != "" ? (" · " + root.market.updated-label) : "");
                    sub-tone: root.market.feed-tone;
                }

                // Card 3: Strategy fact (real id + status/timeframe line).
                if root.bar-secondary: LiveTopCard {
                    icon-char: "⚙";
                    label: "STRATEGY";
                    value-text: root.bar.strategy-label;
                    tone: root.bar.strategy-tone;
                    sub-text: root.bar.strategy-sub;
                    sub-tone: 0;
                }

                // Card 4: Risk engine verdict (real RiskStatus badge).
                LiveTopCard {
                    icon-char: "🛡";
                    show-icon: root.bar-extended;
                    label: "RISK";
                    value-text: root.bar.risk-label;
                    tone: root.bar.risk-tone;
                }

                // Card 5: Reconciliation verdict + venue counts.
                if root.bar-extended: LiveTopCard {
                    icon-char: "🔄";
                    label: "RECONCILIATION";
                    value-text: root.bar.recon-label;
                    tone: root.bar.recon-tone;
                    sub-text: root.bar.recon-sub;
                    sub-tone: 0;
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                // Segmented Mode Selector: PAPER | SANDBOX | LIVE
                Rectangle {
                    height: 34px;
                    width: 168px;
                    border-radius: 6px;
                    background: #0C121B;
                    border-width: 1px;
                    border-color: #182332;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;

                        // PAPER
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 0 ? #00E5C8 : transparent;
                            TouchArea { clicked => { root.mode-picked(0); } }
                            Text {
                                text: "PAPER";
                                color: root.bar.mode == 0 ? #04211E : #7E8D9F;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // SANDBOX
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 1 ? #DDAA45 : transparent;
                            TouchArea { clicked => { root.mode-picked(1); } }
                            Text {
                                text: "SANDBOX";
                                color: root.bar.mode == 1 ? #04211E : #7E8D9F;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // LIVE
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 2 ? #00E5C8 : transparent;
                            TouchArea { clicked => { root.mode-picked(2); } }
                            Text {
                                text: "LIVE";
                                color: root.bar.mode == 2 ? #04211E : #7E8D9F;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // START: enabled ONLY when the backend says the session can
                // start, and never while LIVE consent is still outstanding.
                VButton {
                    width: 112px;
                    label: "▶ START";
                    variant: 0;
                    enabled: root.setup.can-start && !root.setup.needs-live-confirm;
                    clicked => { root.start-requested(); }
                }

                // STOP: armed only while the backend reports a stoppable
                // session - a dead session shows a dead control, never a
                // button that silently does nothing.
                VButton {
                    width: 74px;
                    label: "■ STOP";
                    variant: 3;
                    enabled: root.setup.can-stop;
                    clicked => { root.stop-requested(); }
                }

                // HALT (kill switch): the real execution verdict
                // (exec-label / exec-tone) plus the backend's own
                // halt-enabled fact. Idle it is neutral and inert.
                VButton {
                    width: 76px;
                    label: root.bar.halted ? "■ HALTED" : "■ HALT";
                    variant: root.bar.halted ? 3 : 2;
                    enabled: root.bar.halt-enabled && !root.bar.halted;
                    clicked => { root.halt-requested(); }
                }
            }
        }

        // ══ 2. MAIN 3-COLUMN WORKSPACE ══════════════════════════════════════
        Rectangle {
            vertical-stretch: 1;
            background: #070B10;

            HorizontalLayout {
                padding: 10px;
                // The inspector only reserves workspace width while it is
                // actually docked; an overlay floats above the workspace
                // instead of squeezing it.
                padding-right: root.inspector-docked ? root.inspector-w + 10px : 10px;
                spacing: 10px;

                // ── COLUMN 1: BLOTTER + EVENTS (LEFT / CENTER ~72%) ──
                VerticalLayout {
                    horizontal-stretch: 72;
                    spacing: 10px;

                    // 1.2 POSITIONS / ORDERS / FILLS / DAILY P&L TABBED PANEL
                    Rectangle {
                        height: 148px;
                        background: #0C121B;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #16202C;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 4px;

                            // Tab Bar — counts are the real row counts, so a tab
                            // can never claim rows the table does not have.
                            HorizontalLayout {
                                height: 32px;
                                spacing: 20px;
                                LiveTabHeader { label: "Positions (" + root.positions.length + ")"; active: root.active-blotter-tab == 0; clicked => { root.active-blotter-tab = 0; } }
                                LiveTabHeader { label: "Open Orders (" + root.orders.length + ")"; active: root.active-blotter-tab == 1; clicked => { root.active-blotter-tab = 1; } }
                                LiveTabHeader { label: "Recent Fills (" + root.fills.length + ")"; active: root.active-blotter-tab == 2; clicked => { root.active-blotter-tab = 2; } }
                                LiveTabHeader { label: "Daily P&L"; active: root.active-blotter-tab == 3; clicked => { root.active-blotter-tab = 3; } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            // Table Content
                            if root.active-blotter-tab == 0: VerticalLayout {
                                spacing: 0;

                                // Table Header — exactly the columns the row renders.
                                Rectangle {
                                    height: 22px;
                                    background: #0B1017;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Text { width: 80px; text: "Symbol"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 44px; text: "Side"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 40px; text: "Qty"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 66px; text: "Entry"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 66px; text: "LTP"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 66px; text: "P&L"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 62px; text: "P&L %"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Text { width: 56px; text: "Status"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.positions.length == 0: Rectangle {
                                    height: 56px;
                                    Text {
                                        text: "No open positions";
                                        color: #6E7D8F;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for pos in root.positions: Rectangle {
                                    height: 28px;
                                    background: #0A0F17;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        alignment: center;
                                        Text { width: 80px; text: pos.symbol; color: #FFFFFF; font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 44px; text: pos.side; color: LiveTone.ink(pos.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 40px; text: pos.qty; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 66px; text: pos.entry; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 66px; text: pos.current; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 66px; text: pos.pnl; color: LiveTone.ink(pos.pnl-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 62px; text: pos.pnl-pct; color: LiveTone.ink(pos.pnl-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 56px; text: pos.status; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }

                            if root.active-blotter-tab == 1: VerticalLayout {
                                spacing: 0;
                                Rectangle {
                                    height: 22px;
                                    background: #0B1017;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                                        Text { width: 70px; text: "TIME"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 90px; text: "ORDER ID"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "STRATEGY"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "SYMBOL"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 50px; text: "SIDE"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 50px; text: "QTY"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "PRICE"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { horizontal-stretch: 1; text: "STATUS"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    }
                                }

                                if root.orders.length == 0: Rectangle {
                                    height: 56px;
                                    Text {
                                        text: "No active orders";
                                        color: #6E7D8F;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for ord in root.orders: Rectangle {
                                    height: 28px;
                                    background: #0A0F17;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: center;
                                        Text { width: 70px; text: ord.time; color: VayrenPalette.muted; font-size: 10px; vertical-alignment: center; }
                                        Text { width: 90px; text: ord.order-id; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 80px; text: ord.strategy; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { width: 80px; text: ord.symbol; color: #FFFFFF; font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 50px; text: ord.side; color: LiveTone.ink(ord.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        Text { width: 50px; text: ord.qty; color: #E6EDF3; font-size: 11px; vertical-alignment: center; }
                                        Text { width: 80px; text: ord.price; color: #E6EDF3; font-size: 11px; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: ord.status; color: LiveTone.ink(ord.status-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }
                            }

                            if root.active-blotter-tab == 2: VerticalLayout {
                                spacing: 0;
                                Rectangle {
                                    height: 22px;
                                    background: #0B1017;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                                        Text { width: 70px; text: "TIME"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "SYMBOL"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 50px; text: "SIDE"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 50px; text: "QTY"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "PRICE"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { width: 80px; text: "STRATEGY"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                        Text { horizontal-stretch: 1; text: "ORDER ID"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    }
                                }

                                if root.fills.length == 0: Rectangle {
                                    height: 56px;
                                    Text {
                                        text: "No order fills";
                                        color: #6E7D8F;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                for fill in root.fills: Rectangle {
                                    height: 28px;
                                    background: #0A0F17;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: center;
                                        Text { width: 70px; text: fill.time; color: VayrenPalette.muted; font-size: 10px; vertical-alignment: center; }
                                        Text { width: 80px; text: fill.symbol; color: #FFFFFF; font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                        Text { width: 50px; text: fill.side; color: LiveTone.ink(fill.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        Text { width: 50px; text: fill.qty; color: #E6EDF3; font-size: 11px; vertical-alignment: center; }
                                        Text { width: 80px; text: fill.price; color: #E6EDF3; font-size: 11px; vertical-alignment: center; }
                                        Text { width: 80px; text: fill.strategy; color: #E6EDF3; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                        Text { horizontal-stretch: 1; text: fill.order-id; color: #6E7D8F; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }

                            if root.active-blotter-tab == 3: HorizontalLayout {
                                spacing: 16px;
                                padding: 12px;
                                alignment: center;
                                if root.stats.length == 0: Text {
                                    text: "No P&L data";
                                    color: #6E7D8F;
                                    font-size: 11px;
                                }
                                for stat in root.stats: VerticalLayout {
                                    spacing: 4px;
                                    Text { text: stat.label; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { text: stat.value; color: stat.tone == 1 ? #21C58B : stat.tone == 3 ? #F05A67 : #E6EDF3; font-size: 14px; font-weight: 700; }
                                }
                            }
                        }
                    }

                    // 1.3 LIVE EVENTS PANEL
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 140px;
                        background: #0C121B;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #16202C;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;

                            // Header — fixed category chips (the backend's own
                            // filter vocabulary) plus Clear. Clear drops the
                            // UI history only; backend trading state is
                            // untouched.
                            HorizontalLayout {
                                height: 26px;
                                spacing: 8px;
                                Text {
                                    text: "Live Events Stream";
                                    color: #FFFFFF;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 52px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: #0A0F17;
                                    border-width: 1px;
                                    border-color: #1A2636;
                                    TouchArea { clicked => { root.clear-events(); } }
                                    Text {
                                        text: "Clear";
                                        color: #7E8D9F;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Category filter chips — one per backend bucket;
                            // the active bucket reads teal, the rest neutral.
                            HorizontalLayout {
                                height: 24px;
                                spacing: 4px;
                                for cat[idx] in root.event-types: Rectangle {
                                    border-radius: 4px;
                                    background: root.event-type-index == idx ? #092829 : #0A0F17;
                                    border-width: root.event-type-index == idx ? 1px : 0px;
                                    border-color: #00E5C8;
                                    TouchArea { clicked => { root.event-type-picked(cat); } }
                                    Text {
                                        text: cat == "ALL" ? "All" : cat;
                                        color: root.event-type-index == idx ? #00E5C8 : #7C8B9E;
                                        font-size: 10px;
                                        font-weight: root.event-type-index == idx ? 700 : 500;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            // Table Header — Time | Level | Event | Symbol |
                            // Category | Strategy, 1:1 with the row below.
                            Rectangle {
                                height: 20px;
                                background: #0B1017;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 6px;
                                    Text { width: 62px; text: "Time"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { width: 44px; text: "Level"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { horizontal-stretch: 1; text: "Event"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { width: 80px; text: "Symbol"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { width: 70px; text: "Category"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                    Text { width: 70px; text: "Strategy"; color: #6E7D8F; font-size: 10px; font-weight: 600; }
                                }
                            }

                            // Event Rows (real events loop with empty state)
                            VerticalLayout {
                                spacing: 2px;
                                if root.events.length == 0: Rectangle {
                                    height: 48px;
                                    Text {
                                        text: "No live events recorded";
                                        color: #6E7D8F;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                for ev in root.events: HorizontalLayout {
                                    height: 20px; padding-left: 6px; padding-right: 6px; spacing: 6px; alignment: center;
                                    Text { width: 62px; text: ev.timestamp; color: #E6EDF3; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    Text { width: 44px; text: ev.level; color: LiveTone.ink(ev.status-tone); font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 1; text: ev.event; color: ev.status-tone == 3 ? VayrenPalette.neg : #D3DFEC; font-size: 11px; font-weight: ev.status-tone == 3 ? 700 : 500; vertical-alignment: center; overflow: elide; }
                                    Text { width: 80px; text: ev.symbol; color: #FFFFFF; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                    Text { width: 70px; text: ev.category; color: #8C9CAE; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    Text { width: 70px; text: ev.strategy; color: #8C9CAE; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }

                // ── COLUMN 2: WATCHLIST (MIDDLE ~28%) ────────────────────────
                Rectangle {
                    horizontal-stretch: 28;
                    min-width: 280px;
                    background: #0C121B;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #16202C;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Header — the store total and the selection count are the
                        // backend's own counts, not a rendered row tally.
                        HorizontalLayout {
                            height: 28px;
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "Watchlist";
                                color: #FFFFFF;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            VBadge {
                                text: root.setup.symbol-total;
                                tone: 0;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }

                        // Search Bar — owns its text locally so the backend's
                        // normalised filter never fights the caret.
                        LineEdit {
                            height: 28px;
                            placeholder-text: "Search symbols...";
                            text: root.filter-text;
                            edited(t) => {
                                root.filter-text = t;
                                root.symbol-filter-changed(t);
                            }
                        }

                        // Table Header — #, Symbol, LTP, % Chg, Status: every
                        // cell is a backend quote fact (— while unknown,
                        // never zero-filled).
                        Rectangle {
                            height: 20px;
                            background: #0B1017;
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; spacing: 4px;
                                Text { width: 16px; text: "#"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                Text { horizontal-stretch: 1; text: "Symbol"; color: #6E7D8F; font-size: 10px; font-weight: 600; overflow: elide; }
                                Text { width: 60px; text: "LTP"; color: #6E7D8F; font-size: 10px; font-weight: 600; horizontal-alignment: right; overflow: elide; }
                                Text { width: 46px; text: "% Chg"; color: #6E7D8F; font-size: 10px; font-weight: 600; horizontal-alignment: right; overflow: elide; }
                                Text { width: 78px; text: "Status"; color: #6E7D8F; font-size: 10px; font-weight: 600; horizontal-alignment: right; overflow: elide; }
                            }
                        }

                        // Watchlist Rows (bound to root.symbols)
                        VerticalLayout {
                            spacing: 1px;
                            if root.symbols.length == 0: Rectangle {
                                height: 60px;
                                Text {
                                    text: root.filter-text != "" ? "No symbol matches the filter" : "No symbols in universe";
                                    color: #6E7D8F;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            for sym[idx] in root.symbols: Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: sym.checked ? #0E1A26 : transparent;
                                TouchArea { clicked => { root.symbol-toggled(sym.real-index); } }
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                    Text { width: 16px; text: idx + 1; color: #6E7D8F; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 1; text: sym.name; color: sym.checked ? #FFFFFF : #D3DFEC; font-size: 11px; font-weight: sym.checked ? 700 : 500; vertical-alignment: center; overflow: elide; }
                                    Text { width: 60px; text: sym.ltp; color: #E6EDF3; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    Text { width: 46px; text: sym.change; color: LiveTone.ink(sym.change-tone); font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    Text { width: 78px; text: sym.status; color: LiveTone.ink(sym.status-tone); font-size: 9px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                    }
                }
            }

            // ── COLUMN 3: RISK + STRATEGY + VENUE + READINESS (RIGHT COLUMN) ──
            if root.show-inspector: Rectangle {
                x: parent.width - root.inspector-w;
                y: 0;
                width: root.inspector-w;
                height: 100%;
                clip: true;
                background: #070B10;
                // A floating inspector has to read as an overlay, not as a
                // third column: it gets a frame and a shadow edge.
                border-width: root.drawer-open ? 1px : 0px;
                border-color: #16202C;

                VerticalLayout {
                    padding: 10px;
                    padding-left: 0px;
                    spacing: 8px;

                    // 3.1 LIVE READINESS (first on purpose: the safety verdicts are never the part that gets clipped)
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 150px;
                        background: #0C121B;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #16202C;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 5px;

                            HorizontalLayout {
                                height: 24px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "Live Readiness";
                                    color: #FFFFFF;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                // The real session + execution verdicts (kill
                                // switch state) straight from the projection.
                                VBadge {
                                    text: root.setup.session-label;
                                    tone: root.setup.session-tone;
                                    vertical-alignment: center;
                                }

                                VBadge {
                                    text: root.bar.exec-label;
                                    tone: root.bar.exec-tone;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; background: transparent; }

                                // Inspector collapse: the only way to reclaim the
                                // column width for the workspace.
                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 3px;
                                    background: #131D2A;
                                    border-width: 1px;
                                    border-color: #1E2D3E;
                                    TouchArea { clicked => { root.inspector-toggled(); } }
                                    Text {
                                        text: "›";
                                        color: #D3DFEC;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Start blockers: the backend's own refusal list.
                            // Fail-closed - this is the reason START is inert.
                            if root.blockers.length > 0: VBanner {
                                message: "START BLOCKED";
                                tone: 3;
                            }

                            for b in root.blockers: Text {
                                text: "• " + b;
                                color: VayrenPalette.neg;
                                font-size: 10px;
                                font-weight: 500;
                                height: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // Arming: the real consent gate. Only ever enabled
                            // when the domain says every venue gate is ready.
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;

                                VButton {
                                    label: "ARM LIVE";
                                    variant: root.setup.can-arm ? 0 : 2;
                                    enabled: root.setup.can-arm;
                                    clicked => { root.arm-requested(); }
                                }

                                if root.setup.confirmed-live: VBadge {
                                    text: "CONSENT GIVEN";
                                    tone: 1;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }

                            // LIVE consent: while the backend demands an
                            // explicit confirmation, START stays inert and the
                            // confirmation is offered here - never implied.
                            if root.setup.needs-live-confirm: VBanner {
                                message: "LIVE mode requires explicit confirmation before starting.";
                                tone: 2;
                                action-label: "CONFIRM LIVE";
                                action => { root.confirm-requested(); }
                            }

                            // Every real readiness gate, exactly as the backend
                            // reports it: name, verdict, reason. Before the arm
                            // summary, because the summary only repeats these
                            // reasons and would push the verdicts off-screen.
                            if root.gates.length == 0: VEmptyState {
                                title: "No readiness facts reported";
                                detail: "the execution backend has published no gate verdicts";
                            }

                            for g in root.gates: LiveGateRow {
                                name: g.name;
                                status: g.status;
                                tone: g.tone;
                                reason: g.reason;
                                show-reason: root.tall-inspector;
                            }

                            // The arm verdict (and every blocker behind it).
                            if root.arm-note != "": Text {
                                text: root.arm-note;
                                color: root.setup.can-arm ? VayrenPalette.pos : VayrenPalette.amber;
                                font-size: 10px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            // The latest action outcome - the fail-closed
                            // refusals ("LIVE refused: ...") land here, so a
                            // rejected action is never silent.
                            if root.bar.note != "": Text {
                                text: root.bar.note;
                                color: LiveTone.ink(root.bar.note-tone);
                                font-size: 11px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // 3.2 SESSION FACTS — the risk limits, the position facts,
                    // the registry facts and the venue/reconciliation facts, all
                    // exactly as the backend reports them (no invented capital,
                    // leverage or position value). Scrollable so a long fact list
                    // can never squeeze the safety panel above it.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 120px;
                        background: #0C121B;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #16202C;
                        clip: true;

                        facts-scroll := ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                width: facts-scroll.visible-width;
                                padding: 12px;
                                spacing: 3px;

                                HorizontalLayout {
                                    height: 24px;
                                    spacing: 8px;
                                    alignment: center;
                                    Text { text: "Session Facts"; color: #FFFFFF; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    VBadge {
                                        text: root.bar.risk-label;
                                        tone: root.bar.risk-tone;
                                        vertical-alignment: center;
                                    }
                                    VButton {
                                        width: 92px;
                                        label: "CONFIGURE";
                                        variant: 2;
                                        enabled: root.bar.broker-tone != 1;
                                        clicked => { root.configure-broker(); }
                                    }
                                }

                                Text { text: "ACCOUNT & RISK"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.account-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "RISK LIMITS"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.risk-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "POSITION FACTS"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.position-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "ACTIVE STRATEGY"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.strategy-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "VENUE"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.broker-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "RECONCILIATION"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                for r in root.recon-rows: LiveKvRow { key: r.key; value: r.value; tone: r.tone; }

                                Rectangle { height: 1px; background: #16202C; }
                                Text { text: "ORDER"; color: #8C9CAE; font-size: 9px; font-weight: 700; }
                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 8px;
                                    Text { text: "QUANTITY"; color: #7E8D9F; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    LineEdit {
                                        width: 84px;
                                        height: 22px;
                                        text <=> root.qty-text;
                                        edited(t) => { root.qty-dirty = true; }
                                        accepted(t) => { root.qty-dirty = false; root.quantity-edited(t); }
                                    }
                                }
                                // Strategy / timeframe selectors: real controls
                                // over the backend's own option lists. Tapping
                                // the value advances to the next option and
                                // reports it (the backend validates; setup is
                                // frozen while a session runs, so the controls
                                // idle then).
                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 8px;
                                    Text { text: "TIMEFRAME"; color: #7E8D9F; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        TouchArea {
                                            enabled: !root.setup.can-stop && root.timeframe-names.length > 0;
                                            clicked => {
                                                root.timeframe-picked(root.timeframe-names[Math.mod(root.timeframe-selected + 1, root.timeframe-names.length)]);
                                            }
                                        }
                                        Text { text: root.selected-timeframe + "  ▾"; color: root.setup.can-stop ? VayrenPalette.faint : VayrenPalette.accent; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 8px;
                                    Text { text: "STRATEGY"; color: #7E8D9F; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Rectangle {
                                        TouchArea {
                                            enabled: !root.setup.can-stop && root.strategy-names.length > 0;
                                            clicked => {
                                                root.strategy-picked(root.strategy-names[Math.mod(root.strategy-selected + 1, root.strategy-names.length)]);
                                            }
                                        }
                                        Text { text: root.selected-strategy + "  ▾"; color: root.setup.can-stop ? VayrenPalette.faint : VayrenPalette.text; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }                }
            }

            // Inspector reopen rail: collapsing the inspector unmounts its
            // only toggle along with it, stranding ARM/CONFIRM with no way
            // back until restart. The rail re-opens it from the edge.
            if !root.show-inspector: Rectangle {
                x: parent.width - 22px;
                y: 0;
                width: 22px;
                height: 100%;
                background: #070B10;
                TouchArea { clicked => { root.inspector-toggled(); } }
                Text {
                    text: "‹";
                    color: #D3DFEC;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
