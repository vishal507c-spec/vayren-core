// ── recomposition tiers ──────────────────────────────────────────────────

export global LiveTiers {
    // ── the two hard content floors of the workstation ──
    public pure function workspace-min-width() -> length {
        return 440px;
    }
    public pure function inspector-min-width() -> length {
        return 440px;
    }

    // STEP 24: the inspector clips (`clip: true` below), so its width must be
    // the CONTENT minimum, never a tighter visual preference. At 1920x1080
    // @150% the logical viewport is 1280 wide; a 400px cap squeezed the two
    // fixed-label columns (90 + 50 + 70 plus gaps) and cut the right-hand
    // VALUES off-frame, which is exactly the reported clipping. The floor is
    // now sized from the widest row this panel actually lays out.
    public pure function inspector-width(w: length) -> length {
        return Math.max(440px, Math.min(520px, w * 0.32));
    }

    // ── the width the workspace column actually receives ──
    // Every workspace-region tier below is measured against THIS, not the
    // window: with the inspector docked the workspace gets `w` minus the
    // inspector, its gutter and the layout padding, so a threshold applied
    // straight to the window width is wrong by ~550px exactly where the
    // clipping is worst. Deriving it here keeps one decision source.
    public pure function workspace-width(w: length) -> length {
        // padding 10 left + 10 right + 10 gutter between the two columns.
        return w - (dock-inspector(w) ? inspector-width(w) + 20px : 0px) - 20px;
    }

    // ── command bar: computed from the widgets, never guessed ──
    // Width each command-bar region needs to render un-elided: one status
    // card, the LIVE mode indicator and the START/STOP group.
    public pure function bar-card-width() -> length { return 150px; }
    public pure function bar-mode-width() -> length { return 84px; }
    public pure function bar-transport-width() -> length { return 264px; }
    public pure function bar-strategy-width() -> length { return 170px; }
    public pure function bar-capital-width() -> length { return 195px; }
    // 12px padding each side + the one 8px gap before the first card.
    public pure function bar-chrome() -> length { return 32px; }
    public pure function bar-gap() -> length { return 8px; }

    // BROKER + EC2 cards + Controls (minimal toolbar spine).
    public pure function bar-core(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + 2 * bar-card-width() + 6 * bar-gap();
    }
    // + MARKET DATA / ORDER WS / STRATEGY: the session's own inputs.
    public pure function bar-secondary(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + bar-capital-width() + 4 * bar-card-width() + 8 * bar-gap();
    }
    // + one more status card (reconciliation / executor) beyond the four the
    // bar ships: reserved headroom, strictly stronger than bar-secondary —
    // never a clone of it.
    public pure function bar-extended(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + bar-capital-width() + 5 * bar-card-width() + 9 * bar-gap();
    }

    // The inspector docks only when the workspace floor STILL fits beside it.
    // The old fixed 800px threshold docked a 440px inspector into an 800px
    // window, leaving the workspace 330px — narrower than the screen's own
    // declared `workspace-min-width()` — so the watchlist chips and the
    // search box were clipped with no way to reach them.
    public pure function dock-inspector(w: length) -> bool {
        return w >= VayrenDesign.live-dock-inspector
            && w >= workspace-min-width() + inspector-width(w) + 30px;
    }

    // The watchlist header holds title + count + nine chips + search on one
    // row only when the workspace is wide enough for all of it; below that
    // the chips move to their own scrollable strip (never clipped).
    public pure function watchlist-header-inline(w: length) -> bool {
        return workspace-width(w) >= VayrenDesign.live-watchlist-header-inline;
    }

    // The blotter tab bar holds its five full labels plus Clear only when the
    // panel can afford them; below that the labels shorten and Clear becomes
    // icon-sized (previously "Clear" was sliced mid-word at 1024x640).
    public pure function blotters-side-by-side(w: length) -> bool {
        return workspace-width(w) >= VayrenDesign.live-blotter-tabs-wide;
    }
}

// ── safety tone authority ────────────────────────────────────────────────
// The single place a backend badge tone becomes a colour. Tone convention is
// the shared one (components.slint §tone): 0 muted/unknown, 1 pos/ready,
// 2 warn, 3 neg/NOT READY, 4 accent/info. A surface NEVER invents a tone: it
// passes the domain badge through, so an unconfigured fact can never paint
// itself healthy.
export global LiveTone {
    public pure function ink(t: int) -> color {
        return t == 1 ? VayrenPalette.pos
            : t == 2 ? VayrenPalette.amber
            : t == 3 ? VayrenPalette.neg
            : t == 4 ? VayrenPalette.accent
            : VayrenPalette.muted;
    }
    public pure function chip(t: int) -> color {
        return t == 1 ? VayrenPalette.pos-dim
            : t == 2 ? VayrenPalette.warn-dim
            : t == 3 ? VayrenPalette.neg-dim
            : VayrenPalette.surface;
    }
}

// ── UI Helper Components ─────────────────────────────────────────────────

component LiveTopCard inherits Rectangle {
    // A status card carries ONE backend fact: the domain label string plus its
    // badge tone. The card has no colour of its own to get wrong - a muted
    // (tone 0) fact renders muted, so NOT CONFIGURED can never read as
    // CONNECTED.
    in property <string> icon-char;
    in property <string> label;
    in property <string> value-text;
    in property <int> tone: 0;
    in property <string> sub-text;
    in property <int> sub-tone: 0;
    in property <bool> show-icon: true;
    callback clicked();

    background: VayrenPalette.live-panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: VayrenPalette.live-line-soft;
    min-width: 120px;
    max-width: 175px;
    height: 48px;
    clip: true;

    TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: stretch;

        if root.show-icon: Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: LiveTone.chip(root.tone);
            border-width: 1px;
            border-color: LiveTone.ink(root.tone);

            Text {
                text: root.icon-char;
                color: LiveTone.ink(root.tone);
                font-size: root.icon-char == "EC2" ? 8px : 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Text stack: label / value / sub on their own lines
        VerticalLayout {
            alignment: center;
            spacing: 1px;

            if root.label != "": Text {
                text: root.label;
                color: VayrenPalette.muted;
                font-size: 9.5px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.value-text;
                color: LiveTone.ink(root.tone);
                font-size: 11.5px;
                font-weight: 700;
                overflow: elide;
            }

            if root.sub-text != "": Text {
                text: root.sub-text;
                color: LiveTone.ink(root.sub-tone);
                font-size: 9.5px;
                font-weight: 500;
                overflow: elide;
            }
        }
    }
}

component LiveBrokerCapitalCard inherits Rectangle {
    in property <string> broker-name: "";
    in property <string> value-text: "Unavailable";
    in property <string> sub-text: "Available margin";
    in property <string> status-text: "DISCONNECTED";
    in property <int> tone: 0;
    in property <string> last-updated: "";
    callback refresh-requested();

    background: VayrenPalette.live-panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.tone == 1 ? VayrenPalette.live-teal-deep : VayrenPalette.live-line-soft;
    min-width: 160px;
    max-width: 215px;
    height: 48px;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 7px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        alignment: space-between;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            // Top row: Header "BROKER CAPITAL" + Broker Name tag
            HorizontalLayout {
                spacing: 5px;
                alignment: start;

                Text {
                    text: "BROKER CAPITAL";
                    color: VayrenPalette.muted;
                    font-size: 9px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                if root.broker-name != "": Rectangle {
                    height: 13px;
                    border-radius: 3px;
                    background: LiveTone.chip(root.tone);
                    border-width: 1px;
                    border-color: LiveTone.ink(root.tone);
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.broker-name;
                            color: LiveTone.ink(root.tone);
                            font-size: 8px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Main value: Capital amount formatted in INR
            Text {
                text: root.value-text;
                color: root.tone == 1 ? VayrenPalette.live-teal : (root.tone == 3 ? VayrenPalette.neg : (root.tone == 2 ? VayrenPalette.amber : VayrenPalette.muted));
                font-size: 13.5px;
                font-weight: 800;
                overflow: elide;
            }

            // Sub text: Status first if non-connected, followed by description and timestamp
            Text {
                text: (root.status-text != "" && root.status-text != "CONNECTED" ? (root.status-text + " · ") : "")
                    + (root.sub-text != "" ? root.sub-text : "Available margin")
                    + (root.last-updated != "" ? (" · " + root.last-updated) : "");
                color: root.status-text != "" && root.status-text != "CONNECTED" ? VayrenPalette.amber : VayrenPalette.muted;
                font-size: 9px;
                font-weight: 500;
                overflow: elide;
            }
        }

        // Right side: Compact refresh button
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: refresh-touch.has-hover ? VayrenPalette.hover : transparent;
                border-width: 1px;
                border-color: refresh-touch.has-hover ? VayrenPalette.live-line-soft : transparent;

                refresh-touch := TouchArea {
                    clicked => { root.refresh-requested(); }
                }

                Text {
                    text: "↻";
                    color: refresh-touch.has-hover ? VayrenPalette.live-teal : VayrenPalette.muted;
                    font-size: 13px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component LiveTabHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    background: transparent;
    height: 32px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: stretch;
        spacing: 0;

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Text {
            text: root.label;
            color: root.active ? VayrenPalette.live-teal : (ta.has-hover ? VayrenPalette.text : VayrenPalette.muted);
            font-size: 12px;
            font-weight: root.active ? 700 : 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
        }

        Rectangle {
            height: 2px;
            border-radius: 1px;
            background: root.active ? VayrenPalette.live-teal : (ta.has-hover ? VayrenPalette.live-line-soft : transparent);
        }
    }
}

// One real readiness gate: name + the domain's own verdict + the backend's
// own reason. There is no `is-ready` input — readiness is never assumed, only
// reported. A NOT READY / BLOCKED gate carries the semantic left edge and the
// NOT READY verdict, so it can never be mistaken for a satisfied one.
component LiveGateRow inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <int> tone: 0;
    in property <string> reason;
    in property <bool> show-reason: true;

    background: VayrenPalette.live-panel-deep;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.tone == 3 ? VayrenPalette.neg : (root.tone == 1 ? VayrenPalette.live-line-soft : VayrenPalette.live-line-faint);

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;

        HorizontalLayout {
            height: 18px;
            spacing: 6px;
            alignment: center;

            VStatusDot {
                tone: root.tone;
            }

            Text {
                horizontal-stretch: 1;
                text: root.name;
                color: VayrenPalette.text;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            VBadge {
                text: root.status;
                tone: root.tone;
                vertical-alignment: center;
            }
        }

        if root.show-reason && root.reason != "": Text {
            text: root.reason;
            color: root.tone == 3 ? VayrenPalette.neg : VayrenPalette.muted;
            font-size: 10px;
            font-weight: 500;
            overflow: elide;
        }
    }
}


// One execution-pipeline stage. Three chips fit per inspector row; the
// component keeps each stage's own reached/current/failed state so a joined
// string can never blur the engine's verdict.
component LivePipelineChip inherits Rectangle {
    in property <string> label;
    in property <bool> reached;
    in property <bool> current;
    in property <bool> failed;

    height: 18px;
    border-radius: 3px;
    background: root.failed ? VayrenPalette.neg-dim : (root.current ? VayrenPalette.live-teal-deep : (root.reached ? VayrenPalette.live-panel-deep : transparent));
    border-width: 1px;
    border-color: root.failed ? VayrenPalette.neg : (root.current ? VayrenPalette.live-teal : (root.reached ? VayrenPalette.live-line-soft : VayrenPalette.live-line-faint));

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        alignment: stretch;
        Text {
            text: (root.failed ? "✕ " : (root.reached ? "✓ " : "")) + root.label;
            color: root.failed ? VayrenPalette.neg : (root.current ? VayrenPalette.live-teal : (root.reached ? VayrenPalette.text : VayrenPalette.muted));
            font-size: 9px;
            font-weight: root.current ? 700 : 500;
            vertical-alignment: center;
        }
    }
}

// Three chips per row, left-aligned. The row owns the window into the
// pipeline so the inspector never grows a fourth column at narrow widths.
component LivePipelineRow inherits HorizontalLayout {
    in property <[LivePipelineStep]> steps;
    in property <int> first: 0;

    spacing: 4px;
    alignment: start;

    if root.steps.length > root.first: LivePipelineChip {
        label: root.steps[root.first].label;
        reached: root.steps[root.first].reached;
        current: root.steps[root.first].current;
        failed: root.steps[root.first].failed;
    }
    if root.steps.length > root.first + 1: LivePipelineChip {
        label: root.steps[root.first + 1].label;
        reached: root.steps[root.first + 1].reached;
        current: root.steps[root.first + 1].current;
        failed: root.steps[root.first + 1].failed;
    }
    if root.steps.length > root.first + 2: LivePipelineChip {
        label: root.steps[root.first + 2].label;
        reached: root.steps[root.first + 2].reached;
        current: root.steps[root.first + 2].current;
        failed: root.steps[root.first + 2].failed;
    }
}


component LiveConfirmModal inherits Rectangle {
    in property <string> broker-name;
    in property <string> broker-conn;
    in property <int> broker-tone: 0;
    in property <string> strategy-name;
    in property <string> timeframe;
    in property <string> quantity;
    in property <string> symbol-count;
    in property <string> capital-value;
    in property <int> capital-tone: 0;
    in property <[string]> blockers;
    in property <bool> can-confirm: true;

    callback confirm();
    callback cancel();

    background: VayrenPalette.live-scrim;

    TouchArea {
        // Backdrop click absorber
    }

    Rectangle {
        width: 500px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: VayrenDesign.radius;
        border-width: 1px;
        border-color: VayrenPalette.amber;
        background: VayrenPalette.surface;
        clip: true;

        VerticalLayout {
            spacing: 0;

            // Modal Header
            Rectangle {
                height: 44px;
                background: VayrenPalette.elevated;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            VStatusDot { tone: 2; }
                            Text {
                                text: "CONFIRM LIVE EXECUTION";
                                color: VayrenPalette.amber;
                                font-size: VayrenDesign.fs-body;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        VBadge {
                            text: "OPERATOR CONSENT";
                            tone: 2;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: VayrenPalette.hairline;
            }

            // Modal Body
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Warning Notice Box
                Rectangle {
                    background: VayrenPalette.warn-dim;
                    border-radius: VayrenDesign.radius-sm;
                    border-width: 1px;
                    border-color: VayrenPalette.amber;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "⚠ WARNING: REAL CAPITAL AT RISK";
                            color: VayrenPalette.amber;
                            font-size: VayrenDesign.fs-small;
                            font-weight: 700;
                        }
                        Text {
                            text: "Orders in LIVE mode are submitted directly to the broker and risk real funds. Verify venue connectivity, strategy parameters, and capital limits before giving operator consent.";
                            color: VayrenPalette.text;
                            font-size: VayrenDesign.fs-label;
                            wrap: word-wrap;
                        }
                    }
                }

                // Configuration Parameter Grid
                Rectangle {
                    background: VayrenPalette.bg;
                    border-radius: VayrenDesign.radius-sm;
                    border-width: 1px;
                    border-color: VayrenPalette.hairline;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // Row: Mode & Broker
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "EXECUTION MODE"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: "LIVE (Real Broker Orders)"; color: VayrenPalette.neg; font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "BROKER / VENUE"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    VStatusDot { tone: root.broker-name != "" ? root.broker-tone : 3; }
                                    Text {
                                        text: root.broker-name != "" ? (root.broker-name + (root.broker-conn != "" ? (" (" + root.broker-conn + ")") : "")) : "Broker not configured";
                                        color: root.broker-name != "" ? VayrenPalette.text : VayrenPalette.neg;
                                        font-size: VayrenDesign.fs-small;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }

                        // Row: Strategy & Timeframe
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "ACTIVE STRATEGY"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: root.strategy-name; color: VayrenPalette.text; font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "TIMEFRAME"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: root.timeframe; color: VayrenPalette.text; font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                        }

                        // Row: Order Sizing & Universe
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "DEFAULT QUANTITY / SIZING"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: root.quantity; color: VayrenPalette.accent; font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "ACTIVE UNIVERSE"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: root.symbol-count; color: VayrenPalette.text; font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                        }

                        // Row: Account Capital / Available Margin
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "REPORTED CAPITAL"; color: VayrenPalette.muted; font-size: VayrenDesign.fs-label; font-weight: 600; }
                                Text { text: root.capital-value; color: root.capital-tone == 1 ? VayrenPalette.pos : (root.capital-tone == 3 ? VayrenPalette.neg : VayrenPalette.text); font-size: VayrenDesign.fs-small; font-weight: 700; }
                            }
                        }
                    }
                }

                // Safety Gate & Blocker Status
                if root.blockers.length > 0: Rectangle {
                    background: VayrenPalette.neg-dim;
                    border-radius: VayrenDesign.radius-sm;
                    border-width: 1px;
                    border-color: VayrenPalette.neg;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "START BLOCKED BY SAFETY GATES:";
                            color: VayrenPalette.neg;
                            font-size: VayrenDesign.fs-label;
                            font-weight: 700;
                        }
                        for b in root.blockers: Text {
                            text: "• " + b;
                            color: VayrenPalette.neg;
                            font-size: VayrenDesign.fs-label;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.blockers.length == 0: Rectangle {
                    background: VayrenPalette.pos-dim;
                    border-radius: VayrenDesign.radius-sm;
                    border-width: 1px;
                    border-color: VayrenPalette.pos;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: center;
                        VStatusDot { tone: 1; }
                        Text {
                            text: "All venue safety gates and readiness checks satisfied. Review the parameters above and confirm to START LIVE execution.";
                            color: VayrenPalette.pos;
                            font-size: VayrenDesign.fs-label;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                    }
                }

                // Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    VButton {
                        width: 110px;
                        label: "CANCEL";
                        variant: 1;
                        clicked => { root.cancel(); }
                    }

                    VButton {
                        width: 190px;
                        label: root.can-confirm ? "CONFIRM & START LIVE" : "BLOCKED BY VENUE";
                        variant: 0;
                        enabled: root.can-confirm;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

// ── The Complete LiveScreen UI ───────────────────────────────────────────
// Readiness gates (LiveGate) are reported by the backend, never assumed:
// a NOT READY / BLOCKED gate keeps its own verdict and reason.

export component LiveScreen inherits Rectangle {
    in property <LiveBar> bar;
    in property <LiveSetup> setup;
    in property <LiveMarket> market;
    in property <[string]> strategy-names;
    in property <int> strategy-selected: -1;
    in property <[LiveSymbolRow]> symbols;
    in property <string> symbol-filter: "";
    in property <[string]> timeframe-names;
    in property <int> timeframe-selected: -1;
    in property <[LiveGate]> gates;
    in property <[string]> blockers;
    in property <[string]> venue-blockers;
    in property <[LiveKv]> strategy-rows;
    in property <[LiveKv]> position-rows;
    in property <[LiveKv]> risk-rows;
    in property <[LiveKv]> broker-rows;
    in property <[LiveKv]> recon-rows;
    in property <[LiveKv]> account-rows;
    in property <[LivePosition]> positions;
    in property <[LiveOrder]> orders;
    in property <[LiveFill]> fills;
    in property <[LiveStat]> stats;
    in property <[LiveEventRow]> events;
    in property <[string]> event-types;
    in property <int> event-type-index: 0;
    in property <string> event-filter: "";
    in property <LiveWebSocket> ws;
    in property <LiveMarketData> md;
    in property <LiveRemoteGateway> gateway;
    in property <LiveActiveStrategy> active-strat;
    in property <[LiveWatchlistRow]> watchlist;
    in property <LiveEligibility> eligibility;
    in property <[LiveEligibilityRow]> eligibility-rows;
    in property <LiveSelectedStock> selected-stock;
    in property <LiveFooter> footer;
    in property <int> filter-chip-selected: 0;
    in property <string> filter-chip-counts: "";
    // Placeholder only: Rust replaces this with the nine runtime-driven
    // execution buckets (with live counts) on every projection. It is not the
    // source of the chip list and never renders as-is in the wired app.
    in property <[string]> filter-chips: ["ALL (0)", "READY (0)", "SIGNAL (0)", "ORDER (0)", "IN POSITION (0)", "WAITING (0)", "NO DATA (0)", "RISK BLOCKED (0)", "REJECTED (0)"];

    // Breakpoint inputs
    in property <bool> dock-inspector: true;
    in property <bool> bar-core: true;
    in property <bool> bar-secondary: true;
    in property <bool> bar-extended: true;
    in property <bool> blotters-side-by-side: true;
    in property <bool> watchlist-header-inline: true;
    in property <bool> tall-inspector: true;
    in property <length> inspector-w: LiveTiers.inspector-width(root.width);
    in property <bool> inspector-open: true;

    // Out properties strictly satisfying test suites. They read the RECOMPOSITION
    // TIERS (decided from the window size one level up), never this screen's own
    // height — a height-derived size would close a layout binding loop.
    out property <bool> show-inspector: root.inspector-open;
    out property <bool> drawer-open: !root.dock-inspector && root.inspector-open;
    out property <bool> inspector-docked: root.dock-inspector && root.inspector-open;
    // Blotter tab bar runs in its compact form (short labels + icon-only
    // Clear) whenever the panel cannot hold the full row un-elided.
    out property <bool> blotters-compact: !root.blotters-side-by-side;
    // The watchlist header keeps title + chips + search on one row only while
    // all of it fits; otherwise the chips take their own scrollable strip.
    out property <bool> chips-inline: root.watchlist-header-inline;

    // Callbacks
    callback mode-picked(int);
    callback strategy-picked(string);
    callback symbol-toggled(int);
    callback universe-save();
    callback symbol-filter-changed(string);
    callback timeframe-picked(string);
    callback quantity-edited(string);
    callback start-requested();
    callback stop-requested();
    callback confirm-requested();
    callback confirm-open-requested();
    callback confirm-cancel-requested();
    callback event-filter-changed(string);
    callback event-type-picked(string);
    callback clear-events();
    callback inspector-toggled();
    callback configure-broker();
    callback watchlist-selected(string);
    callback filter-chip-picked(int);
    callback watchlist-search-changed(string);
    callback refresh-stocks();
    callback broker-capital-refresh();

    // The selected timeframe is the BACKEND's selection (index into
    // timeframe-names), never a locally shadowed string.
    property <string> selected-timeframe: root.timeframe-selected >= 0 && root.timeframe-selected < root.timeframe-names.length ? root.timeframe-names[root.timeframe-selected] : (root.timeframe-names.length > 0 ? root.timeframe-names[0] : "15m");
    property <string> selected-strategy: root.strategy-selected > 0 && root.strategy-selected < root.strategy-names.length ? root.strategy-names[root.strategy-selected] : "Select Strategy";

    // Internal state
    property <int> active-blotter-tab: 0; // 0 Positions, 1 Orders, 2 Fills, 3 Live Events, 4 Daily P&L
    // The search box owns its own text: the backend normalises the filter
    // (lowercases it) and pushes the normalised value back, so binding the
    // field to the model would fight the caret on every keystroke.
    property <string> filter-text: "";
    // The quantity field owns its text like the search box above: the
    // backend normalises every commit ("25" → "2.00"), so a live model
    // binding rewrites the field mid-keystroke and eats digits. Commits
    // go out on Enter only; backend updates sync back only while the
    // operator holds no uncommitted edit.
    property <string> qty-text: "";
    property <bool> qty-dirty: false;

    // STEP 4: the ONE start verdict. Derived from backend facts only — a
    // running session reads RUNNING, a session with reported blockers reads
    // START BLOCKED, and an unblocked stopped session reads READY TO START.
    // Never optimistic: nothing here is set by a click.
    property <string> start-verdict: root.setup.can-stop ? "● RUNNING" : (root.blockers.length > 0 ? "✕ START BLOCKED" : "✓ READY TO START");
    // The exact reason START is unavailable, or the outcome of the last
    // click. Rendered on the LIVE screen so a press is never silent — this
    // is the difference between "nothing happened" and "here is why".
    property <string> start-reason: root.blockers.length > 0 ? root.blockers[0] : (root.setup.pending-start ? "waiting for backend confirmation…" : "");
    property <int> start-reason-tone: root.blockers.length > 0 ? 3 : 2;

    // The events search box owns its text like the watchlist search above:
    // the backend normalises the query, so the field never binds to the
    // model and no keystroke is rewritten mid-edit.
    property <string> event-filter-text: "";
    property <bool> is-narrow-bar: root.width < 1320px;
    // Short windows compress the two stacked boards so the footer status
    // strip (clock / snapshot age) always stays on screen.
    property <length> watchlist-min-h: root.height < 640px ? 150px : (root.height < 720px ? 190px : 220px);
    property <length> blotter-min-h: root.height < 640px ? 120px : (root.height < 720px ? 160px : 200px);

    init => {
        Palette.color-scheme = ColorScheme.dark;
        root.qty-text = root.setup.quantity;
    }
    changed setup => { if (!root.qty-dirty) { root.qty-text = root.setup.quantity; } }
    min-width: 0px;
    clip: true;
    background: VayrenPalette.bg;

    VerticalLayout {
        spacing: 0;
        min-width: 0px;
        width: 100%;

        // ══ 0b. ACTION OUTCOME / BLOCKER BANNER ═════════════════════════════
        // A press must never be silent: the backend's refusal reason (or the
        // live action note) is printed here, so a blocked START explains
        // itself instead of looking like a dead button.
        if root.bar.note != "" || root.start-reason != "": Rectangle {
            height: 24px;
            background: VayrenPalette.bg;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                VBanner {
                    height: 20px;
                    width: 100%;
                    message: root.bar.note != "" ? root.bar.note : (root.start-reason != "" ? (root.start-verdict + " — " + root.start-reason) : root.start-verdict);
                    // The banner's tone follows the message it actually
                    // prints: an action note carries its own tone, a blocker
                    // banner carries the blocker severity.
                    tone: root.bar.note != "" ? root.bar.note-tone : root.start-reason-tone;
                }
            }
        }

        // ══ 0c. LIVE CONFIRMATION BANNER ═════════════════════════════════════
        if root.setup.needs-live-confirm: Rectangle {
            height: 28px;
            background: VayrenPalette.bg;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                VBanner {
                    height: 24px;
                    width: 100%;
                    message: "LIVE mode requires explicit operator confirmation before starting.";
                    tone: 2;
                    action-label: "CONFIRM LIVE";
                    action => { root.confirm-open-requested(); }
                }
            }
        }

        if root.setup.confirmed-live && root.bar.mode == 1 && !root.setup.can-stop: Rectangle {
            height: 24px;
            background: VayrenPalette.bg;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                VBanner {
                    height: 20px;
                    width: 100%;
                    message: "✓ LIVE mode confirmed by operator — press START to begin execution.";
                    tone: 1;
                }
            }
        }

        // ══ 1. TOP STATUS & CONTROL BAR ══════════════════════════════════════
        Rectangle {
            height: root.is-narrow-bar ? 98px : 58px;
            min-width: 0px;
            width: 100%;
            background: VayrenPalette.live-topbar;
            border-width: 1px;
            border-color: VayrenPalette.live-line-deep;
            clip: true;

            // WIDE VIEW: Single row with clearly separated groups (Status on left, Controls on right)
            if !root.is-narrow-bar: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                alignment: stretch;

                // ── Group 1: Venue & Account Status ──
                LiveTopCard {
                    icon-char: "B";
                    show-icon: true;
                    label: "BROKER";
                    value-text: root.bar.broker-label != "" ? root.bar.broker-label : "NOT CONFIGURED";
                    tone: root.bar.broker-tone;
                    sub-text: root.bar.conn-label != "" ? root.bar.conn-label : "DISCONNECTED";
                    sub-tone: root.bar.conn-tone;
                    clicked => { root.configure-broker(); }
                }

                LiveBrokerCapitalCard {
                    broker-name: root.bar.capital-broker-name;
                    value-text: root.bar.capital-value;
                    sub-text: root.bar.capital-sub;
                    status-text: root.bar.capital-status;
                    tone: root.bar.capital-tone;
                    last-updated: root.bar.capital-last-updated;
                    refresh-requested => { root.broker-capital-refresh(); }
                }

                LiveTopCard {
                    icon-char: "EC2";
                    show-icon: true;
                    label: "EC2 / REMOTE GATEWAY";
                    value-text: root.gateway.status != "" ? root.gateway.status : "DISCONNECTED";
                    tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                    sub-text: (root.gateway.rtt != "" ? ("RTT: " + root.gateway.rtt) : "RTT: N/A")
                        + (root.gateway.last-heartbeat != "" ? (" · HB: " + root.gateway.last-heartbeat) : "");
                    sub-tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                }

                LiveTopCard {
                    icon-char: "WS";
                    show-icon: true;
                    label: "WS CONNECTION";
                    value-text: root.ws.status != "" ? root.ws.status : "DISCONNECTED";
                    tone: root.ws.tone != 0 ? root.ws.tone : (root.ws.status == "CONNECTED" ? 1 : (root.ws.status == "CONNECTING" || root.ws.status == "RECONNECTING" ? 2 : 3));
                    sub-text: root.ws.last-error != "" ? root.ws.last-error
                        : (root.ws.latency != "" && root.ws.latency != "—" ? ("RTT: " + root.ws.latency)
                        : (root.ws.last-tick != "" && root.ws.last-tick != "—" ? ("Last: " + root.ws.last-tick)
                        : (root.ws.sub != "" && root.ws.sub != "—" ? root.ws.sub : "Live Stream")));
                    sub-tone: root.ws.last-error != "" ? 3 : (root.ws.tone != 0 ? root.ws.tone : 0);
                }

                Rectangle { horizontal-stretch: 1; min-width: 6px; background: transparent; }

                // ── Group 2: Strategy & Trading Mode ──
                Rectangle {
                    height: 34px;
                    width: 220px;
                    border-radius: 6px;
                    background: VayrenPalette.live-panel;
                    border-width: 1px;
                    border-color: root.strategy-selected >= 0 ? VayrenPalette.live-teal-deep : VayrenPalette.live-line-soft;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: stretch;

                        Text {
                            text: "STRATEGY";
                            color: root.strategy-selected > 0 ? VayrenPalette.live-teal : VayrenPalette.live-ink-dim;
                            font-size: 9.5px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            min-width: 125px;
                            height: 26px;
                            enabled: !root.setup.can-stop && root.strategy-names.length > 0;
                            model: root.strategy-names;
                            current-index: root.strategy-selected;
                            selected(v) => { root.strategy-picked(v); }
                        }
                    }
                }

                // Execution mode indicator: LIVE only. PAPER and SANDBOX
                // are not supported — the indicator is static and
                // non-interactive. The backend can only operate in LIVE mode.
                Rectangle {
                    height: 34px;
                    width: LiveTiers.bar-mode-width();
                    border-radius: 6px;
                    background: VayrenPalette.live-panel;
                    border-width: 1px;
                    border-color: VayrenPalette.live-line-soft;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        alignment: stretch;

                        // LIVE indicator (only supported execution mode)
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: VayrenPalette.neg;
                            Text {
                                text: "LIVE";
                                color: VayrenPalette.text-bright;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Group 3: Execution Controls & Clock ──
                VButton {
                    width: root.setup.pending-start ? 104px : 82px;
                    height: 34px;
                    label: root.setup.pending-start ? "⏳ STARTING…" : "▶ START";
                    variant: 0;
                    enabled: root.setup.start-clickable;
                    clicked => { root.start-requested(); }
                }

                VButton {
                    width: root.setup.pending-stop ? 100px : 72px;
                    height: 34px;
                    label: root.setup.pending-stop ? "⏳ STOPPING…" : "■ STOP";
                    variant: 3;
                    enabled: root.setup.can-stop && !root.setup.pending-stop;
                    clicked => { root.stop-requested(); }
                }

            }

            // NARROW VIEW: Reflows into two neat, unclipped rows
            if root.is-narrow-bar: VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 5px;
                alignment: center;

                // Row 1: Venue & Account Status + Clock
                HorizontalLayout {
                    height: 48px;
                    spacing: 8px;
                    alignment: stretch;

                    LiveTopCard {
                        icon-char: "B";
                        show-icon: true;
                        label: "BROKER";
                        value-text: root.bar.broker-label != "" ? root.bar.broker-label : "NOT CONFIGURED";
                        tone: root.bar.broker-tone;
                        sub-text: root.bar.conn-label != "" ? root.bar.conn-label : "DISCONNECTED";
                        sub-tone: root.bar.conn-tone;
                    }

                    LiveBrokerCapitalCard {
                        broker-name: root.bar.capital-broker-name;
                        value-text: root.bar.capital-value;
                        sub-text: root.bar.capital-sub;
                        status-text: root.bar.capital-status;
                        tone: root.bar.capital-tone;
                        last-updated: root.bar.capital-last-updated;
                        refresh-requested => { root.broker-capital-refresh(); }
                    }

                    LiveTopCard {
                        icon-char: "EC2";
                        show-icon: true;
                        label: "EC2 / GATEWAY";
                        value-text: root.gateway.status != "" ? root.gateway.status : "DISCONNECTED";
                        tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                        sub-text: (root.gateway.rtt != "" ? ("RTT: " + root.gateway.rtt) : "RTT: N/A");
                        sub-tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                    }

                    LiveTopCard {
                        icon-char: "WS";
                        show-icon: true;
                        label: "WS CONNECTION";
                        value-text: root.ws.status != "" ? root.ws.status : "DISCONNECTED";
                        tone: root.ws.tone != 0 ? root.ws.tone : (root.ws.status == "CONNECTED" ? 1 : (root.ws.status == "CONNECTING" || root.ws.status == "RECONNECTING" ? 2 : 3));
                        sub-text: root.ws.last-error != "" ? root.ws.last-error
                            : (root.ws.latency != "" && root.ws.latency != "—" ? ("RTT: " + root.ws.latency)
                            : (root.ws.last-tick != "" && root.ws.last-tick != "—" ? ("Last: " + root.ws.last-tick)
                            : (root.ws.sub != "" && root.ws.sub != "—" ? root.ws.sub : "Live Stream")));
                        sub-tone: root.ws.last-error != "" ? 3 : (root.ws.tone != 0 ? root.ws.tone : 0);
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                }

                // Row 2: Strategy Selector, Mode Selector, Action Controls
                HorizontalLayout {
                    height: 34px;
                    spacing: 8px;
                    alignment: stretch;

                    Rectangle {
                        height: 34px;
                        width: 220px;
                        border-radius: 6px;
                        background: VayrenPalette.live-panel;
                        border-width: 1px;
                        border-color: root.strategy-selected >= 0 ? VayrenPalette.live-teal-deep : VayrenPalette.live-line-soft;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 6px;
                            alignment: stretch;

                            Text {
                                text: "STRATEGY";
                                color: root.strategy-selected > 0 ? VayrenPalette.live-teal : VayrenPalette.live-ink-dim;
                                font-size: 9.5px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            ComboBox {
                                horizontal-stretch: 1;
                                min-width: 125px;
                                height: 26px;
                                enabled: !root.setup.can-stop && root.strategy-names.length > 0;
                                model: root.strategy-names;
                                current-index: root.strategy-selected;
                                selected(v) => { root.strategy-picked(v); }
                            }
                        }
                    }

                    // Execution mode indicator: LIVE only. PAPER and SANDBOX
                    // are not supported — the indicator is static and
                    // non-interactive. The backend can only operate in LIVE mode.
                    Rectangle {
                        height: 34px;
                        width: LiveTiers.bar-mode-width();
                        border-radius: 6px;
                        background: VayrenPalette.live-panel;
                        border-width: 1px;
                        border-color: VayrenPalette.live-line-soft;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 2px;
                            alignment: stretch;

                            // LIVE indicator (only supported execution mode)
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: VayrenPalette.neg;
                                Text {
                                    text: "LIVE";
                                    color: VayrenPalette.text-bright;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    VButton {
                        width: root.setup.pending-start ? 104px : 82px;
                        height: 34px;
                        label: root.setup.pending-start ? "⏳ STARTING…" : "▶ START";
                        variant: 0;
                        enabled: root.setup.start-clickable;
                        clicked => { root.start-requested(); }
                    }

                    VButton {
                        width: root.setup.pending-stop ? 100px : 72px;
                        height: 34px;
                        label: root.setup.pending-stop ? "⏳ STOPPING…" : "■ STOP";
                        variant: 3;
                        enabled: root.setup.can-stop && !root.setup.pending-stop;
                        clicked => { root.stop-requested(); }
                    }

                }
            }
        }

        // ══ 1b. STRATEGY STOCK LIST (read-only; managed in Strategy Lab) ══════
        Rectangle {
            height: 66px;
            min-width: 0px;
            width: 100%;
            background: VayrenPalette.live-panel-deep;
            border-width: 1px;
            border-color: VayrenPalette.live-line-deep;
            clip: true;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                // Row 1: Header Row (Heading, exchange, count on left; Read-only badge and refresh on right)
                HorizontalLayout {
                    height: 22px;
                    spacing: 8px;
                    alignment: stretch;

                    Text {
                        text: "LIVE TRADE STOCKS";
                        font-family: "monospace";
                        font-size: 11px;
                        font-weight: 800;
                        color: VayrenPalette.text-bright;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: VayrenPalette.live-panel;
                        border-width: 1px;
                        border-color: VayrenPalette.live-teal;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.setup.universe-exchange != "" ? root.setup.universe-exchange : "NSE";
                                font-family: "monospace";
                                font-size: 10px;
                                font-weight: 800;
                                color: VayrenPalette.live-teal;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: root.strategy-selected < 0
                            ? "Select a strategy above"
                            : (root.setup.stock-universe.length > 0
                                ? (root.setup.stock-universe.length + " stocks saved")
                                : "No saved stocks");
                        font-family: "monospace";
                        font-size: 10px;
                        font-weight: 600;
                        color: root.setup.stock-universe.length > 0 ? VayrenPalette.live-ink : VayrenPalette.live-ink-dim;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    VBadge {
                        text: "READ-ONLY";
                        tone: 0;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 22px;
                        height: 18px;
                        border-radius: 4px;
                        background: band-refresh-touch.has-hover ? VayrenPalette.hover : transparent;
                        border-width: 1px;
                        border-color: band-refresh-touch.has-hover ? VayrenPalette.live-line-soft : transparent;

                        band-refresh-touch := TouchArea {
                            clicked => { root.refresh-stocks(); }
                        }

                        Text {
                            text: "↻";
                            color: band-refresh-touch.has-hover ? VayrenPalette.live-teal : VayrenPalette.live-ink-dim;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Row 2: Dedicated Chips Row Below Header
                if root.setup.stock-universe.length == 0: HorizontalLayout {
                    height: 24px;
                    alignment: start;
                    Text {
                        text: root.strategy-selected < 0
                            ? "Choose a strategy above to load its saved trading universe"
                            : "No stocks saved for this strategy · Configure and save universe in Strategy Lab";
                        font-size: 10.5px;
                        color: VayrenPalette.live-ink-dim;
                        vertical-alignment: center;
                    }
                }

                if root.setup.stock-universe.length > 0: ScrollView {
                    height: 24px;
                    horizontal-stretch: 1;
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: always-off;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for symbol in root.setup.stock-universe: Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: VayrenPalette.live-panel;
                            border-width: 1px;
                            border-color: VayrenPalette.live-teal-deep;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: symbol;
                                    font-family: "monospace";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: VayrenPalette.live-teal;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ══ 2. MAIN 3-COLUMN WORKSPACE ══════════════════════════════════════
        Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            width: 100%;
            clip: true;
            background: VayrenPalette.bg;

            HorizontalLayout {
                min-width: 0px;
                width: 100%;
                padding: 10px;
                // The inspector only reserves workspace width while it is
                // actually docked; an overlay floats above the workspace
                // instead of squeezing it.
                padding-right: root.inspector-docked ? root.inspector-w + 10px : (!root.show-inspector ? 34px : 10px);
                spacing: 10px;

                // ── COLUMN 1: WORKSTATION WORKSPACE (LEFT ~70%) ──
                VerticalLayout {
                    horizontal-stretch: 70;
                    min-width: 0px;
                    spacing: 10px;

                    // ── STRATEGY WATCHLIST (operator's live instrument board) ──
                    // Fed by the backend projection: LTP/CHG, the risk plan,
                    // the ELIG verdict and the signal/order/position state.
                    // Rows are the selection surface; the nine chips scope the
                    // execution buckets and never re-order the data.
                    Rectangle {
                        vertical-stretch: 3;
                        min-height: root.watchlist-min-h;
                        min-width: 0px;
                        width: 100%;
                        clip: true;
                        background: VayrenPalette.live-panel;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: VayrenPalette.live-line;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            // Header: title + count + chips (inline while they
                            // all fit) + search. Below the tier the chips move
                            // onto their own scrollable strip — every chip
                            // stays reachable instead of being cut off.
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                alignment: stretch;

                                Text {
                                    text: "STRATEGY WATCHLIST";
                                    color: VayrenPalette.text-bright;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                VBadge {
                                    text: root.watchlist.length > 0 ? (root.watchlist.length + " ROWS") : ((root.filter-chip-selected != 0 || root.filter-text != "") ? "0 MATCHES" : "AWAITING DATA");
                                    tone: root.watchlist.length > 0 ? 4 : 0;
                                    vertical-alignment: center;
                                }

                                Rectangle { width: 6px; background: transparent; }

                                if root.chips-inline: HorizontalLayout {
                                    vertical-stretch: 1;
                                    spacing: 4px;
                                    alignment: start;
                                    for chip[c-idx] in root.filter-chips: Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal-deep : VayrenPalette.live-panel-deep;
                                        border-width: 1px;
                                        border-color: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal : VayrenPalette.live-line-soft;
                                        TouchArea { clicked => { root.filter-chip-picked(c-idx); } }
                                        HorizontalLayout {
                                            padding-left: 7px; padding-right: 7px; alignment: center;
                                            Text {
                                                text: chip;
                                                color: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal : VayrenPalette.live-ink-mute;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; background: transparent; }

                                LineEdit {
                                    width: root.chips-inline ? 150px : 110px;
                                    height: 26px;
                                    text: root.filter-text;
                                    placeholder-text: root.chips-inline ? "Search symbol…" : "Search";
                                    edited(t) => {
                                        root.filter-text = t;
                                        root.watchlist-search-changed(t);
                                        root.symbol-filter-changed(t);
                                    }
                                }
                            }

                            // Chips strip: the same nine buckets, horizontally
                            // scrollable, while the header tier cannot hold
                            // them inline.
                            if !root.chips-inline: ScrollView {
                                width: 100%;
                                height: 24px;
                                horizontal-scrollbar-policy: as-needed;
                                vertical-scrollbar-policy: always-off;
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    for chip[c-idx] in root.filter-chips: Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal-deep : VayrenPalette.live-panel-deep;
                                        border-width: 1px;
                                        border-color: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal : VayrenPalette.live-line-soft;
                                        TouchArea { clicked => { root.filter-chip-picked(c-idx); } }
                                        HorizontalLayout {
                                            padding-left: 7px; padding-right: 7px; alignment: center;
                                            Text {
                                                text: chip;
                                                color: root.filter-chip-selected == c-idx ? VayrenPalette.live-teal : VayrenPalette.live-ink-mute;
                                                font-size: 9.5px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // The board itself: horizontally scrollable from
                            // 1360px of columns, vertically scrollable rows.
                            wl-scroll := ScrollView {
                                width: 100%;
                                min-width: 0px;
                                vertical-stretch: 1;
                                viewport-width: Math.max(self.width, 1360px);
                                horizontal-scrollbar-policy: as-needed;
                                vertical-scrollbar-policy: as-needed;

                                VerticalLayout {
                                    width: 100%;
                                    spacing: 1px;

                                    // Column header
                                    Rectangle {
                                        height: 24px;
                                        background: VayrenPalette.bg1;
                                        border-radius: 4px;
                                        HorizontalLayout {
                                            padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            Text { width: 14px; text: ""; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 84px; text: "SYMBOL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 65px; text: "LTP"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 54px; text: "CHG%"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 58px; text: "REF HI"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 58px; text: "REF LO"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 68px; text: "BREAK LOW"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 65px; text: "ENTRY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 65px; text: "STOP"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 58px; text: "RISK/SH"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 44px; text: "QTY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 70px; text: "MAX RISK"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 72px; text: "PLANNED"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 54px; text: "UTIL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 78px; text: "STATUS"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 86px; text: "ELIG"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 58px; text: "SIGNAL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 72px; text: "ORDER"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 72px; text: "POSITION"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                            Text { width: 68px; text: "P&L"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        }
                                    }

                                    if root.watchlist.length > 0: VerticalLayout {
                                        spacing: 1px;
                                        for row in root.watchlist: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: row.selected ? VayrenPalette.live-row-checked : (wl-row-touch.has-hover ? VayrenPalette.hover : transparent);
                                            border-width: 1px;
                                            border-color: row.selected ? VayrenPalette.live-teal-deep : (wl-row-touch.has-hover ? VayrenPalette.live-line-soft : transparent);

                                            wl-row-touch := TouchArea {
                                                clicked => { root.watchlist-selected(row.full-symbol != "" ? row.full-symbol : row.symbol); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                                Rectangle { width: 14px; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: LiveTone.ink(row.status-tone); } }
                                                Text { width: 84px; text: row.symbol; color: row.selected ? VayrenPalette.live-teal : VayrenPalette.text-bright; font-size: 11.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 65px; text: row.ltp; color: VayrenPalette.text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 54px; text: row.change; color: LiveTone.ink(row.change-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 58px; text: row.ref-high; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 58px; text: row.ref-low; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 68px; text: row.break-low; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 65px; text: row.entry; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 65px; text: row.stop; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 58px; text: row.risk-share; color: VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 44px; text: row.qty; color: VayrenPalette.text; font-size: 10.5px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 70px; text: row.max-allowed-risk; color: VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 72px; text: row.planned-risk; color: VayrenPalette.text; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 54px; text: row.risk-util; color: LiveTone.ink(row.risk-util-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 78px; text: row.status; color: LiveTone.ink(row.status-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 86px; text: row.eligibility; color: LiveTone.ink(row.eligibility-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 58px; text: row.signal; color: LiveTone.ink(row.signal-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 72px; text: row.order; color: LiveTone.ink(row.order-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 72px; text: row.position; color: VayrenPalette.text; font-size: 10.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                Text { width: 68px; text: row.pnl; color: LiveTone.ink(row.pnl-tone); font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
                                            }
                                        }
                                    }

                                    if root.watchlist.length == 0 && (root.filter-chip-selected != 0 || root.filter-text != ""): VEmptyState {
                                        height: 120px;
                                        title: "No symbols match";
                                        detail: "No symbols match your current search and filter criteria.";
                                    }

                                    // No rows yet: the strategy's own universe is
                                    // the editor — toggles + SAVE UNIVERSE go
                                    // straight to the backend, never into a
                                    // local copy.
                                    if root.watchlist.length == 0 && root.filter-chip-selected == 0 && root.filter-text == "": VerticalLayout {
                                        spacing: 2px;

                                        HorizontalLayout {
                                            height: 26px;
                                            spacing: 8px;
                                            alignment: stretch;
                                            Text {
                                                text: "STRATEGY UNIVERSE";
                                                color: VayrenPalette.live-ink-mute;
                                                font-size: 10px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: root.setup.symbol-total + " tracked";
                                                color: VayrenPalette.live-ink-dim;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            VButton {
                                                width: 140px;
                                                height: 24px;
                                                label: "SAVE UNIVERSE";
                                                variant: 2;
                                                enabled: root.strategy-selected >= 0 && !root.setup.can-stop;
                                                clicked => { root.universe-save(); }
                                            }
                                        }

                                        for sym in root.symbols: Rectangle {
                                            height: 26px;
                                            background: sym.checked ? VayrenPalette.live-row-checked : transparent;

                                            TouchArea {
                                                clicked => { root.symbol-toggled(sym.real-index); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 6px; spacing: 6px; alignment: start;
                                                Rectangle {
                                                    width: 14px;
                                                    height: 14px;
                                                    border-radius: 3px;
                                                    background: sym.checked ? VayrenPalette.live-teal : transparent;
                                                    border-width: 1px;
                                                    border-color: sym.checked ? VayrenPalette.live-teal : VayrenPalette.live-line-soft;
                                                    Text {
                                                        text: "✓";
                                                        color: VayrenPalette.accent-text;
                                                        font-size: 10px;
                                                        font-weight: 800;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Text { width: 160px; text: sym.name; color: VayrenPalette.text-bright; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                Text { width: 80px; text: sym.ltp; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; }
                                                Text { width: 70px; text: sym.change; color: LiveTone.ink(sym.change-tone); font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 90px; text: sym.status; color: LiveTone.ink(sym.status-tone); font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                            }
                                        }

                                        if root.symbols.length == 0: VEmptyState {
                                            height: 72px;
                                            title: root.strategy-selected < 0
                                                ? "No strategy selected"
                                                : (root.filter-text != "" ? "No symbol matches the filter" : "No symbols configured for this strategy");
                                            detail: root.strategy-selected < 0 ? "Pick a strategy to load its saved universe." : "Configure and save the universe in Strategy Lab.";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // TABBED BLOTTER & EVENTS STREAM PANEL
                    Rectangle {
                        vertical-stretch: 2;
                        min-height: root.blotter-min-h;
                        min-width: 0px;
                        width: 100%;
                        clip: true;
                        background: VayrenPalette.live-panel;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: VayrenPalette.live-line;

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 4px;

                            // Tab Bar
                            HorizontalLayout {
                                height: 32px;
                                spacing: root.blotters-compact ? 8px : 14px;
                                LiveTabHeader { label: root.blotters-compact ? ("Pos (" + root.positions.length + ")") : ("Positions (" + root.positions.length + ")"); active: root.active-blotter-tab == 0; clicked => { root.active-blotter-tab = 0; } }
                                LiveTabHeader { label: root.blotters-compact ? ("Ord (" + root.orders.length + ")") : ("Orders (" + root.orders.length + ")"); active: root.active-blotter-tab == 1; clicked => { root.active-blotter-tab = 1; } }
                                LiveTabHeader { label: root.blotters-compact ? ("Fills (" + root.fills.length + ")") : ("Fills (" + root.fills.length + ")"); active: root.active-blotter-tab == 2; clicked => { root.active-blotter-tab = 2; } }
                                LiveTabHeader { label: root.blotters-compact ? ("Events (" + root.events.length + ")") : ("Live Events (" + root.events.length + ")"); active: root.active-blotter-tab == 3; clicked => { root.active-blotter-tab = 3; } }
                                LiveTabHeader { label: root.blotters-compact ? "P&L" : "Daily P&L"; active: root.active-blotter-tab == 4; clicked => { root.active-blotter-tab = 4; } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }

                                if root.active-blotter-tab == 3: Rectangle {
                                    width: root.blotters-compact ? 28px : 56px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: VayrenPalette.live-panel-deep;
                                    border-width: 1px;
                                    border-color: VayrenPalette.live-line-faint;
                                    TouchArea { clicked => { root.clear-events(); } }
                                    Text {
                                        text: root.blotters-compact ? "✕" : "Clear";
                                        color: VayrenPalette.live-ink-faint;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Tab 0: Positions
                            if root.active-blotter-tab == 0: VerticalLayout {
                                spacing: 0;
                                vertical-stretch: 1;
                                Rectangle {
                                    height: 24px;
                                    background: VayrenPalette.bg1;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                        Text { width: 90px; text: "SYMBOL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "SIDE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "QTY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "ENTRY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "LTP"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "P&L"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 70px; text: "P&L %"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "STATUS"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                    }
                                }

                                if root.positions.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        text: "No open positions (SOURCE: BROKER / RECONCILIATION)";
                                        color: VayrenPalette.muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.positions.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    viewport-width: self.width;
                                    vertical-scrollbar-policy: as-needed;
                                    VerticalLayout {
                                        spacing: 1px;
                                        for pos in root.positions: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: pos-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep;
                                            border-width: 1px;
                                            border-color: pos-touch.has-hover ? VayrenPalette.live-line-soft : transparent;
                                            pos-touch := TouchArea {}
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                                Text { width: 90px; text: pos.symbol; color: VayrenPalette.text-bright; font-size: 11.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 50px; text: pos.side; color: LiveTone.ink(pos.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 50px; text: pos.qty; color: VayrenPalette.text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 80px; text: pos.entry; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; }
                                                Text { width: 80px; text: pos.current; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; }
                                                Text { width: 80px; text: pos.pnl; color: LiveTone.ink(pos.pnl-tone); font-size: 11.5px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 70px; text: pos.pnl-pct; color: LiveTone.ink(pos.pnl-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { horizontal-stretch: 1; text: pos.status; color: VayrenPalette.muted; font-size: 10.5px; font-weight: 600; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Tab 1: Orders
                            if root.active-blotter-tab == 1: VerticalLayout {
                                spacing: 0;
                                vertical-stretch: 1;
                                Rectangle {
                                    height: 24px;
                                    background: VayrenPalette.bg1;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                        Text { width: 70px; text: "TIME"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 90px; text: "ORDER ID"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "STRATEGY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "SYMBOL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "SIDE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "QTY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "PRICE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 70px; text: "STATUS"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "DETAIL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                    }
                                }

                                if root.orders.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        text: "No orders submitted yet";
                                        color: VayrenPalette.muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.orders.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    viewport-width: self.width;
                                    vertical-scrollbar-policy: as-needed;
                                    VerticalLayout {
                                        spacing: 1px;
                                        for ord in root.orders: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: ord-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep;
                                            border-width: 1px;
                                            border-color: ord-touch.has-hover ? VayrenPalette.live-line-soft : transparent;
                                            ord-touch := TouchArea {}
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                                Text { width: 70px; text: ord.time; color: VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 90px; text: ord.order-id; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                Text { width: 80px; text: ord.strategy; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                Text { width: 80px; text: ord.symbol; color: VayrenPalette.text-bright; font-size: 11.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 50px; text: ord.side; color: LiveTone.ink(ord.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 50px; text: ord.qty; color: VayrenPalette.text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 80px; text: ord.price; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; }
                                                Text { width: 70px; text: ord.status; color: LiveTone.ink(ord.status-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { horizontal-stretch: 1; text: ord.reason != "" ? ord.reason : "—"; color: ord.status-tone == 3 ? VayrenPalette.neg : VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Tab 2: Fills
                            if root.active-blotter-tab == 2: VerticalLayout {
                                spacing: 0;
                                vertical-stretch: 1;
                                Rectangle {
                                    height: 24px;
                                    background: VayrenPalette.bg1;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                        Text { width: 70px; text: "TIME"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "SYMBOL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "SIDE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 50px; text: "QTY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "PRICE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "STRATEGY"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "ORDER ID"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                    }
                                }

                                if root.fills.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        text: "No order fills (SOURCE: ORDER / TRADE WS)";
                                        color: VayrenPalette.muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.fills.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    viewport-width: self.width;
                                    vertical-scrollbar-policy: as-needed;
                                    VerticalLayout {
                                        spacing: 1px;
                                        for fill in root.fills: Rectangle {
                                            height: 28px;
                                            border-radius: 4px;
                                            background: fill-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep;
                                            border-width: 1px;
                                            border-color: fill-touch.has-hover ? VayrenPalette.live-line-soft : transparent;
                                            fill-touch := TouchArea {}
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: stretch;
                                                Text { width: 70px; text: fill.time; color: VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; }
                                                Text { width: 80px; text: fill.symbol; color: VayrenPalette.text-bright; font-size: 11.5px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Text { width: 50px; text: fill.side; color: LiveTone.ink(fill.side-tone); font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                Text { width: 50px; text: fill.qty; color: VayrenPalette.text; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                                Text { width: 80px; text: fill.price; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; }
                                                Text { width: 80px; text: fill.strategy; color: VayrenPalette.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                Text { horizontal-stretch: 1; text: fill.order-id; color: VayrenPalette.muted; font-size: 10.5px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Tab 3: Live Events Stream
                            if root.active-blotter-tab == 3: VerticalLayout {
                                spacing: 4px;
                                vertical-stretch: 1;

                                HorizontalLayout {
                                    height: 26px;
                                    spacing: 6px;
                                    alignment: stretch;

                                    ScrollView {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        horizontal-scrollbar-policy: as-needed;
                                        vertical-scrollbar-policy: always-off;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            for cat[idx] in root.event-types: Rectangle {
                                                height: 22px;
                                                border-radius: 11px;
                                                background: root.event-type-index == idx ? VayrenPalette.live-teal-deep : (cat-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep);
                                                border-width: 1px;
                                                border-color: root.event-type-index == idx ? VayrenPalette.live-teal : (cat-touch.has-hover ? VayrenPalette.muted : VayrenPalette.live-line-soft);
                                                cat-touch := TouchArea { clicked => { root.event-type-picked(cat); } }
                                                HorizontalLayout {
                                                    padding-left: 8px; padding-right: 8px; alignment: center;
                                                    Text {
                                                        text: cat;
                                                        color: root.event-type-index == idx ? VayrenPalette.live-teal : (cat-touch.has-hover ? VayrenPalette.text : VayrenPalette.muted);
                                                        font-size: 10px;
                                                        font-weight: root.event-type-index == idx ? 700 : 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    LineEdit {
                                        width: 140px;
                                        height: 24px;
                                        text: root.event-filter-text;
                                        placeholder-text: "Filter events…";
                                        edited(t) => {
                                            root.event-filter-text = t;
                                            root.event-filter-changed(t);
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 22px;
                                    background: VayrenPalette.bg1;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px; spacing: 6px; alignment: stretch;
                                        Text { width: 72px; text: "TIME"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 44px; text: "LEVEL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { horizontal-stretch: 1; text: "EVENT"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 80px; text: "SYMBOL"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                        Text { width: 70px; text: "SOURCE"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; }
                                    }
                                }

                                if root.events.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    Text {
                                        text: "No system events logged";
                                        color: VayrenPalette.muted;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.events.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    viewport-width: self.width;
                                    vertical-scrollbar-policy: as-needed;
                                    VerticalLayout {
                                        spacing: 1px;
                                        for ev in root.events: Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: ev-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep;
                                            border-width: 1px;
                                            border-color: ev-touch.has-hover ? VayrenPalette.live-line-soft : transparent;
                                            ev-touch := TouchArea {}
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px; spacing: 6px; alignment: stretch;
                                                Text { width: 72px; text: ev.time; color: VayrenPalette.muted; font-size: 10px; vertical-alignment: center;
                                                    Tooltip { text: @markdown("\{ev.timestamp}"); }
                                                }
                                                Text { width: 44px; text: ev.level; color: LiveTone.ink(ev.status-tone); font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                                Text { horizontal-stretch: 1; text: ev.event; color: ev.status-tone == 3 ? VayrenPalette.neg : VayrenPalette.text; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                                Text { width: 80px; text: ev.symbol; color: VayrenPalette.text-bright; font-size: 10.5px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                Text { width: 70px; text: ev.category; color: VayrenPalette.muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                            }

                            // Tab 4: Daily P&L
                            if root.active-blotter-tab == 4: VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 16px;
                                    padding: 12px;
                                    alignment: center;
                                    if root.stats.length == 0: Text {
                                        text: "No P&L data";
                                        color: VayrenPalette.muted;
                                        font-size: 11px;
                                    }
                                    for stat in root.stats: VerticalLayout {
                                        spacing: 4px;
                                        Text { text: stat.label; color: VayrenPalette.muted; font-size: 10.5px; font-weight: 700; }
                                        Text { text: stat.value; color: stat.tone == 1 ? VayrenPalette.pos : stat.tone == 3 ? VayrenPalette.neg : VayrenPalette.text; font-size: 15px; font-weight: 800; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── COLUMN 2: INSPECTOR (RIGHT COLUMN ~30%) ─────────────────────────
            if root.show-inspector: Rectangle {
                x: parent.width - root.inspector-w;
                y: 0;
                width: root.inspector-w;
                height: 100%;
                clip: true;
                background: VayrenPalette.bg;
                border-width: root.drawer-open ? 1px : 0px;
                border-color: VayrenPalette.live-line;

                inspector-scroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    // The cards keep their natural height and the column
                    // scrolls inside its own dock. Without this the viewport
                    // collapses to the dock height, the cards squash to their
                    // min-heights and the tail (readiness / broker actions)
                    // paints over the footer strip.
                    viewport-height: Math.max(self.height, inspector-body.preferred-height);

                    inspector-body := VerticalLayout {
                        width: 100%;
                        padding: 10px;
                        padding-left: 4px;
                        padding-right: 8px;
                        spacing: 8px;

                        // ACTIVE STRATEGY & RUNTIME
                        Rectangle {
                            min-height: 110px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    alignment: stretch;

                                    Text {
                                        text: "ACTIVE STRATEGY";
                                        color: VayrenPalette.text-bright;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    VBadge {
                                        text: root.active-strat.mode != "" ? root.active-strat.mode : "LIVE";
                                        tone: root.active-strat.mode-tone != 0 ? root.active-strat.mode-tone : 3;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: VayrenPalette.live-panel-deep;
                                        TouchArea { clicked => { root.inspector-toggled(); } }
                                        Text {
                                            text: "›";
                                            color: VayrenPalette.live-ink;
                                            font-size: 14px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Text {
                                    text: root.active-strat.name != "" ? root.active-strat.name : (root.bar.strategy-label != "" ? root.bar.strategy-label : "None Selected");
                                    color: VayrenPalette.live-teal;
                                    font-size: 14px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: "Runtime Status: " + (root.active-strat.status != "" ? root.active-strat.status : "STOPPED");
                                    color: LiveTone.ink(root.active-strat.status-tone);
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                // Engine uptime — the ONE elapsed reading. The
                                // host re-applies the projection every second
                                // while RUNNING and the value derives from the
                                // backend's authoritative start epoch, so it
                                // persists across refreshes/reconnects and
                                // resets on restart. With no epoch the line
                                // stays honest ("--:--:--") — never invented.
                                Text {
                                    text: root.active-strat.engine-running
                                        ? "ENGINE RUNNING: " + (root.active-strat.engine-clock != "" ? root.active-strat.engine-clock : "--:--:--")
                                        : "ENGINE STOPPED";
                                    color: root.active-strat.engine-running ? VayrenPalette.live-teal : VayrenPalette.muted;
                                    font-size: 11px;
                                    font-weight: 800;
                                }

                                if root.active-strat.stopped-at != "" && root.active-strat.stopped-at != "—": Text {
                                    text: "Last Stopped At: " + root.active-strat.stopped-at;
                                    color: VayrenPalette.muted;
                                    font-size: 10.5px;
                                }

                                if !root.active-strat.engine-running && root.active-strat.duration != "" && root.active-strat.duration != "—": Text {
                                    text: "Last Runtime Duration: " + root.active-strat.duration;
                                    color: VayrenPalette.muted;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: "Signals generated: " + root.active-strat.today-signals;
                                    color: VayrenPalette.muted;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                }

                                if root.active-strat.orders-detail != "": Text {
                                    text: "Orders: " + root.active-strat.orders-detail;
                                    color: VayrenPalette.muted;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                }

                                Text {
                                    text: "Universe: " + root.setup.symbol-total;
                                    color: VayrenPalette.muted;
                                    font-size: 10.5px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // ORDER & SESSION — the two LIVE inputs the
                        // confirmation modal reads back verbatim. Quantity
                        // commits on Enter (the backend normalises and
                        // reports the value back); the timeframe is the
                        // backend's own selection, never a local shadow.
                        Rectangle {
                            min-height: 96px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Text {
                                    text: "ORDER & SESSION";
                                    color: VayrenPalette.text-bright;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    alignment: stretch;

                                    Text {
                                        width: 96px;
                                        text: "QUANTITY";
                                        color: VayrenPalette.muted;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    LineEdit {
                                        horizontal-stretch: 1;
                                        height: 26px;
                                        text: root.qty-text;
                                        enabled: !root.setup.can-stop;
                                        edited(t) => {
                                            root.qty-text = t;
                                            root.qty-dirty = true;
                                        }
                                        accepted(t) => {
                                            root.qty-dirty = false;
                                            root.quantity-edited(t);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 26px;
                                    spacing: 8px;
                                    alignment: stretch;

                                    Text {
                                        width: 96px;
                                        text: "TIMEFRAME";
                                        color: VayrenPalette.muted;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: tf-touch.has-hover ? VayrenPalette.hover : VayrenPalette.live-panel-deep;
                                        border-width: 1px;
                                        border-color: tf-touch.has-hover ? VayrenPalette.live-line-soft : transparent;

                                        tf-touch := TouchArea {
                                            enabled: !root.setup.can-stop && root.timeframe-names.length > 0;
                                            clicked => {
                                                root.timeframe-picked(root.timeframe-names[Math.mod(root.timeframe-selected + 1, root.timeframe-names.length)]);
                                            }
                                        }

                                        Text {
                                            text: root.selected-timeframe + "  ▾";
                                            color: root.setup.can-stop ? VayrenPalette.faint : VayrenPalette.live-teal;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // SELECTED STOCK & EXECUTION PIPELINE
                        Rectangle {
                            min-height: root.selected-stock.symbol != "" ? (120px + Math.ceil(root.selected-stock.pipeline.length / 3) * 22px) : 52px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.selected-stock.symbol != "" ? VayrenPalette.live-teal-deep : VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    alignment: stretch;

                                    Text {
                                        text: "SELECTED INSTRUMENT";
                                        color: VayrenPalette.text-bright;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    if root.selected-stock.symbol != "": VBadge {
                                        text: root.selected-stock.symbol;
                                        tone: 4;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    if root.selected-stock.symbol != "": Text {
                                        text: root.selected-stock.ltp != "" ? ("LTP " + root.selected-stock.ltp + " (" + root.selected-stock.change + ")") : "";
                                        color: LiveTone.ink(root.selected-stock.change-tone);
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.selected-stock.symbol == "": Text {
                                    text: "Select any symbol in Strategy Watchlist to inspect real-time risk, levels & order pipeline.";
                                    color: VayrenPalette.muted;
                                    font-size: 10px;
                                    wrap: word-wrap;
                                }

                                if root.selected-stock.symbol != "": VerticalLayout {
                                    spacing: 5px;

                                    // Risk & Levels row
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "ENTRY: " + (root.selected-stock.entry-price != "" ? root.selected-stock.entry-price : "—"); color: VayrenPalette.text; font-size: 10.5px; font-weight: 600; }
                                        Text { text: "STOP: " + (root.selected-stock.stop-price != "" ? root.selected-stock.stop-price : "—"); color: VayrenPalette.text; font-size: 10.5px; font-weight: 600; }
                                        Text { text: "RISK/SH: " + (root.selected-stock.risk-share != "" ? root.selected-stock.risk-share : "—"); color: VayrenPalette.muted; font-size: 10.5px; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: "QTY: " + (root.selected-stock.calculated-qty != "" ? root.selected-stock.calculated-qty : "—"); color: VayrenPalette.accent; font-size: 10.5px; font-weight: 700; }
                                    }

                                    // Reference High / Low / Break Low
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "REF HI: " + (root.selected-stock.ref-high != "" ? root.selected-stock.ref-high : "—"); color: VayrenPalette.muted; font-size: 10px; }
                                        Text { text: "REF LO: " + (root.selected-stock.ref-low != "" ? root.selected-stock.ref-low : "—"); color: VayrenPalette.muted; font-size: 10px; }
                                        Text { text: "BREAK LO: " + (root.selected-stock.break-low != "" ? root.selected-stock.break-low : "—"); color: VayrenPalette.muted; font-size: 10px; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text { text: "UTIL: " + (root.selected-stock.risk-util != "" ? root.selected-stock.risk-util : "—"); color: VayrenPalette.text; font-size: 10px; font-weight: 600; }
                                    }

                                    // Pipeline Stage & Status
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: stretch;
                                        Text { text: "STAGE:"; color: VayrenPalette.muted; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                                        Text {
                                            text: root.selected-stock.pipeline-stage != "" ? root.selected-stock.pipeline-stage : (root.selected-stock.signal != "" ? ("SIGNAL: " + root.selected-stock.signal) : "MONITORING");
                                            color: root.selected-stock.pipeline-stage != "" ? VayrenPalette.live-teal : VayrenPalette.text;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        if root.selected-stock.order != "": Text {
                                            text: "· ORDER: " + root.selected-stock.order;
                                            color: VayrenPalette.text-bright;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        if root.selected-stock.current-position != "": Text {
                                            text: "POS: " + root.selected-stock.current-position;
                                            color: VayrenPalette.live-teal;
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Pipeline Steps Graphic (if populated) —
                                    // three chips per row keeps every stage
                                    // readable inside the inspector width.
                                    if root.selected-stock.pipeline.length > 0: VerticalLayout {
                                        spacing: 4px;
                                        LivePipelineRow {
                                            steps: root.selected-stock.pipeline;
                                            first: 0;
                                        }
                                        if root.selected-stock.pipeline.length > 3: LivePipelineRow {
                                            steps: root.selected-stock.pipeline;
                                            first: 3;
                                        }
                                        if root.selected-stock.pipeline.length > 6: LivePipelineRow {
                                            steps: root.selected-stock.pipeline;
                                            first: 6;
                                        }
                                    }

                                    // Order Reason or Risk Banner
                                    if root.selected-stock.order-reason != "": Text {
                                        text: "Detail: " + root.selected-stock.order-reason;
                                        color: VayrenPalette.neg;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                    if root.selected-stock.risk-banner-text != "": Text {
                                        text: "Notice: " + root.selected-stock.risk-banner-text;
                                        color: VayrenPalette.amber;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // LIVE READINESS — why the start gate is open or
                        // closed. The verdict, the blockers and every gate row
                        // are the backend's own facts; nothing here is
                        // assumed. The ARM ceremony is the operator's, and it
                        // is only offered while the backend says it may be.
                        Rectangle {
                            min-height: 150px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.blockers.length > 0 ? VayrenPalette.neg : VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                HorizontalLayout {
                                    height: 24px;
                                    spacing: 8px;
                                    alignment: stretch;

                                    Text {
                                        text: "LIVE READINESS";
                                        color: VayrenPalette.text-bright;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    VBadge {
                                        text: root.start-verdict;
                                        tone: root.setup.can-stop ? 1 : (root.blockers.length > 0 ? 3 : 2);
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    height: 20px;
                                    spacing: 8px;
                                    alignment: stretch;

                                    Text {
                                        width: 96px;
                                        text: "SESSION";
                                        color: VayrenPalette.muted;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.setup.session-label != "" ? root.setup.session-label : "—";
                                        color: LiveTone.ink(root.setup.session-tone);
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    Text {
                                        text: "SIZE " + (root.setup.quantity != "" ? root.setup.quantity : "—");
                                        color: VayrenPalette.text;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.blockers.length > 0: VerticalLayout {
                                    spacing: 3px;
                                    for b in root.blockers: Text {
                                        text: "✕ " + b;
                                        color: VayrenPalette.neg;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                }

                                if root.gates.length == 0: VEmptyState {
                                    height: 56px;
                                    title: "No gates reported";
                                    detail: "The backend has not published readiness gates yet.";
                                }

                                for g in root.gates: LiveGateRow {
                                    name: g.name;
                                    status: g.status;
                                    tone: g.tone;
                                    reason: g.reason;
                                }
                            }
                        }

                        // BROKER ACCOUNT & CONNECTION
                        Rectangle {
                            min-height: 100px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;

                                Text {
                                    text: "BROKER ACCOUNT";
                                    color: VayrenPalette.text-bright;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Broker:";
                                        width: 112px;
                                        color: VayrenPalette.muted;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.bar.broker-label != "" ? root.bar.broker-label : "NOT CONFIGURED";
                                        color: root.bar.broker-label != "" ? VayrenPalette.text-bright : VayrenPalette.muted;
                                        font-size: 11.5px;
                                        font-weight: 700;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Available Capital:";
                                        width: 112px;
                                        color: VayrenPalette.muted;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.bar.capital-value != "" ? root.bar.capital-value : "Unavailable";
                                        color: root.bar.capital-tone == 1 ? VayrenPalette.live-teal : (root.bar.capital-tone == 3 ? VayrenPalette.neg : (root.bar.capital-tone == 2 ? VayrenPalette.amber : VayrenPalette.muted));
                                        font-size: 12.5px;
                                        font-weight: 800;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Status:";
                                        width: 112px;
                                        color: VayrenPalette.muted;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.bar.conn-label != "" ? root.bar.conn-label : "DISCONNECTED";
                                        color: LiveTone.ink(root.bar.conn-tone);
                                        font-size: 11px;
                                        font-weight: 700;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: end;
                                    VButton {
                                        label: "CONFIGURE BROKER";
                                        variant: 1;
                                        clicked => { root.configure-broker(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Inspector reopen rail
            if !root.show-inspector: Rectangle {
                x: parent.width - 28px;
                y: 0;
                width: 28px;
                height: 100%;
                background: VayrenPalette.bg;
                TouchArea { clicked => { root.inspector-toggled(); } }
                Text {
                    text: "‹";
                    color: VayrenPalette.live-ink;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        // ══ 3. FOOTER STATUS STRIP ══════════════════════════════════════════
        Rectangle {
            height: 22px;
            background: VayrenPalette.live-panel-deep;
            border-width: 1px;
            border-color: VayrenPalette.live-line-deep;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                alignment: stretch;
                Text { text: "BROKER: " + (root.footer.broker != "" ? root.footer.broker : "NOT CONFIGURED"); color: VayrenPalette.muted; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Text { text: "WS: " + (root.footer.websocket != "" ? root.footer.websocket : "DISCONNECTED"); color: VayrenPalette.muted; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Text { text: "DATA: " + (root.footer.market-data != "" ? root.footer.market-data : "NO DATA"); color: VayrenPalette.muted; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Text { text: "RECON: " + (root.footer.reconciliation != "" ? root.footer.reconciliation : "NOT CONFIGURED"); color: VayrenPalette.muted; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                if root.footer.snapshot-time != "": Text { text: "SNAPSHOT: " + root.footer.snapshot-time; color: VayrenPalette.muted; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.footer.clock != "" ? root.footer.clock : ""; color: VayrenPalette.live-teal; font-size: 10.5px; font-weight: 700; vertical-alignment: center; }
            }
        }

    }

    if root.setup.confirm-dialog-open: LiveConfirmModal {
        width: parent.width;
        height: parent.height;
        broker-name: root.bar.broker-label;
        broker-conn: root.bar.conn-label;
        broker-tone: root.bar.conn-tone;
        strategy-name: root.selected-strategy;
        timeframe: root.selected-timeframe;
        quantity: root.setup.quantity;
        symbol-count: root.setup.symbol-total;
        capital-value: root.bar.capital-value;
        capital-tone: root.bar.capital-tone;
        blockers: root.venue-blockers;
        can-confirm: root.setup.needs-live-confirm && root.venue-blockers.length == 0;
        cancel => { root.confirm-cancel-requested(); }
        confirm => { root.confirm-requested(); }
    }
}
