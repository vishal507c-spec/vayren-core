    strategy-label: string,
    strategy-tone: int,
    strategy-sub: string,
    risk-label: string,
    risk-tone: int,
    recon-label: string,
    recon-tone: int,
    recon-sub: string,
    exec-label: string,
    exec-tone: int,
    halted: bool,
    halt-enabled: bool,
    inspector-open: bool,
    note: string,
    note-tone: int,
}

