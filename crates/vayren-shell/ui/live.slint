// VAYREN LIVE — Native Slint execution workstation (no chart: this surface
// is a terminal blotter, not a charting page — freed space goes to the
// blotter, events, watchlist and readiness panels).
//
// Single integrated workspace layout:
// - Top Status / Control Bar: Broker, Market Data, Strategy, Risk, Recon cards + Mode + START/STOP/HALT
// - Main Area (3 Columns):
//   1. Left/Center: Tabbed Blotter (Positions, Orders, Fills, Daily P&L), Live Events
//   2. Middle: Watchlist with search and LTP/Chg%/Status
//   3. Right: Account & Risk, Active Strategy, Live Readiness Checklist

import { VayrenPalette, VayrenDesign } from "palette.slint";
import { VBadge, VButton, VBanner, VEmptyState, VCell, VStatusDot } from "components.slint";
import { LineEdit, ScrollView, ComboBox } from "std-widgets.slint";

// ── projected shapes (mirror domain live.rs) ──────────────────────────────────

