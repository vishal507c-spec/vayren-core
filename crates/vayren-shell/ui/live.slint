// ── recomposition tiers ──────────────────────────────────────────────────

export global LiveTiers {
    // ── the two hard content floors of the workstation ──
    public pure function workspace-min-width() -> length {
        return 440px;
    }
    public pure function inspector-min-width() -> length {
        return 440px;
    }

    // STEP 24: the inspector clips (`clip: true` below), so its width must be
    // the CONTENT minimum, never a tighter visual preference. At 1920x1080
    // @150% the logical viewport is 1280 wide; a 400px cap squeezed the two
    // fixed-label columns (90 + 50 + 70 plus gaps) and cut the right-hand
    // VALUES off-frame, which is exactly the reported clipping. The floor is
    // now sized from the widest row this panel actually lays out.
    public pure function inspector-width(w: length) -> length {
        return Math.max(440px, Math.min(520px, w * 0.32));
    }

    // ── the width the workspace column actually receives ──
    // Every workspace-region tier below is measured against THIS, not the
    // window: with the inspector docked the workspace gets `w` minus the
    // inspector, its gutter and the layout padding, so a threshold applied
    // straight to the window width is wrong by ~550px exactly where the
    // clipping is worst. Deriving it here keeps one decision source.
    public pure function workspace-width(w: length) -> length {
        // padding 10 left + 10 right + 10 gutter between the two columns.
        return w - (dock-inspector(w) ? inspector-width(w) + 20px : 0px) - 20px;
    }

    // ── command bar: computed from the widgets, never guessed ──
    // Width each command-bar region needs to render un-elided: one status
    // card, the PAPER|SANDBOX|LIVE selector and the START/STOP/HALT group.
    public pure function bar-card-width() -> length { return 150px; }
    public pure function bar-mode-width() -> length { return 168px; }
    public pure function bar-transport-width() -> length { return 264px; }
    public pure function bar-strategy-width() -> length { return 170px; }
    // 12px padding each side + the one 8px gap before the first card.
    public pure function bar-chrome() -> length { return 32px; }
    public pure function bar-gap() -> length { return 8px; }

    // BROKER + RISK ENGINE only: the two facts that decide whether the
    // workstation is safe to touch at all.
    // The strategy selector is always present, so its width is in every tier.
    public pure function bar-core(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + 2 * bar-card-width() + 6 * bar-gap();
    }
    // + MARKET DATA / ORDER WS / STRATEGY: the session's own inputs.
    public pure function bar-secondary(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + 5 * bar-card-width() + 10 * bar-gap();
    }
    // + RECONCILIATION / EXECUTOR: only while all seven stay readable.
    public pure function bar-extended(w: length) -> bool {
        return w >= bar-chrome() + bar-strategy-width() + bar-mode-width() + bar-transport-width()
            + 7 * bar-card-width() + 12 * bar-gap();
    }

    // The inspector docks only when the workspace floor STILL fits beside it.
    // The old fixed 800px threshold docked a 440px inspector into an 800px
    // window, leaving the workspace 330px — narrower than the screen's own
    // declared `workspace-min-width()` — so the watchlist chips and the
    // search box were clipped with no way to reach them.
    public pure function dock-inspector(w: length) -> bool {
        return w >= VayrenDesign.live-dock-inspector
            && w >= workspace-min-width() + inspector-width(w) + 30px;
    }

    // The watchlist header holds title + count + nine chips + search on one
    // row only when the workspace is wide enough for all of it; below that
    // the chips move to their own scrollable strip (never clipped).
    public pure function watchlist-header-inline(w: length) -> bool {
        return workspace-width(w) >= VayrenDesign.live-watchlist-header-inline;
    }

    // The blotter tab bar holds its five full labels plus Clear only when the
    // panel can afford them; below that the labels shorten and Clear becomes
    // icon-sized (previously "Clear" was sliced mid-word at 1024x640).
    public pure function blotters-side-by-side(w: length) -> bool {
        return workspace-width(w) >= VayrenDesign.live-blotter-tabs-wide;
    }
}

// ── safety tone authority ────────────────────────────────────────────────
// The single place a backend badge tone becomes a colour. Tone convention is
// the shared one (components.slint §tone): 0 muted/unknown, 1 pos/ready,
// 2 warn, 3 neg/NOT READY, 4 accent/info. A surface NEVER invents a tone: it
// passes the domain badge through, so an unconfigured fact can never paint
// itself healthy.
export global LiveTone {
    public pure function ink(t: int) -> color {
        return t == 1 ? VayrenPalette.pos
            : t == 2 ? VayrenPalette.amber
            : t == 3 ? VayrenPalette.neg
            : t == 4 ? VayrenPalette.accent
            : VayrenPalette.muted;
    }
    public pure function chip(t: int) -> color {
        return t == 1 ? VayrenPalette.pos-dim
            : t == 2 ? VayrenPalette.warn-dim
            : t == 3 ? VayrenPalette.neg-dim
            : VayrenPalette.surface;
    }
}

// ── UI Helper Components ─────────────────────────────────────────────────

component LiveTopCard inherits Rectangle {
    // A status card carries ONE backend fact: the domain label string plus its
    // badge tone. The card has no colour of its own to get wrong - a muted
    // (tone 0) fact renders muted, so NOT CONFIGURED can never read as
    // CONNECTED.
    in property <string> icon-char;
    in property <string> label;
    in property <string> value-text;
    in property <int> tone: 0;
    in property <string> sub-text;
    in property <int> sub-tone: 0;
    in property <bool> show-icon: true;
    in property <string> source-text: "";

    background: VayrenPalette.live-panel;
    border-radius: 6px;
    border-width: 1px;
    border-color: VayrenPalette.live-line-mist;
    min-width: 90px;
    max-width: 175px;
    height: 52px;
    clip: true;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        alignment: center;

        if root.show-icon: Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: LiveTone.chip(root.tone);
            border-width: 1px;
            border-color: LiveTone.ink(root.tone);

            Text {
                text: root.icon-char;
                color: LiveTone.ink(root.tone);
                font-size: 10px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Text stack: label / value / sub / source on their own lines
        VerticalLayout {
            alignment: center;
            spacing: 1px;

            if root.label != "": Text {
                text: root.label;
                color: VayrenPalette.live-ink-faint;
                font-size: 10px;
                font-weight: 700;
                overflow: elide;
            }

            Text {
                text: root.value-text;
                color: LiveTone.ink(root.tone);
                font-size: 11px;
                font-weight: 700;
                overflow: elide;
            }

            if root.sub-text != "": Text {
                text: root.sub-text;
                color: LiveTone.ink(root.sub-tone);
                font-size: 10px;
                font-weight: 500;
                overflow: elide;
            }

            if root.source-text != "": Text {
                text: "SRC: " + root.source-text;
                color: VayrenPalette.live-ink-dim;
                font-size: 10px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }
}


// One real readiness gate: name + the domain's own verdict + the backend's
// own reason. There is no `is-ready` input - readiness is never assumed, only
// reported. A NOT READY / BLOCKED gate carries the semantic left edge and the
// NOT READY verdict, so it can never be mistaken for a satisfied one.
// ── The Complete LiveScreen UI ───────────────────────────────────────────

export component LiveScreen inherits Rectangle {
    in property <LiveBar> bar;
    in property <LiveSetup> setup;
    in property <LiveMarket> market;
    in property <[string]> strategy-names;
    in property <int> strategy-selected: -1;
    in property <[LiveSymbolRow]> symbols;
    in property <string> symbol-filter: "";
    in property <[string]> timeframe-names;
    in property <int> timeframe-selected: -1;
    in property <[LiveGate]> gates;
    in property <string> arm-note: "";
    in property <[string]> blockers;
    in property <[LiveKv]> strategy-rows;
    in property <[LiveKv]> position-rows;
    in property <[LiveKv]> risk-rows;
    in property <[LiveKv]> broker-rows;
    in property <[LiveKv]> recon-rows;
    in property <[LiveKv]> account-rows;
    in property <[LivePosition]> positions;
    in property <[LiveOrder]> orders;
    in property <[LiveFill]> fills;
    in property <[LiveStat]> stats;
    in property <[LiveEventRow]> events;
    in property <[string]> event-types;
    in property <int> event-type-index: 0;
    in property <string> event-filter: "";
    in property <LiveWebSocket> ws;
    in property <LiveMarketData> md;
    in property <LiveRemoteGateway> gateway;
    in property <LiveActiveStrategy> active-strat;
    in property <[LiveWatchlistRow]> watchlist;
    in property <LiveEligibility> eligibility;
    in property <[LiveEligibilityRow]> eligibility-rows;
    in property <LiveSelectedStock> selected-stock;
    in property <LiveFooter> footer;
    in property <int> filter-chip-selected: 0;
    in property <string> filter-chip-counts: "";
    // Placeholder only: Rust replaces this with the nine runtime-driven
    // execution buckets (with live counts) on every projection. It is not the
    // source of the chip list and never renders as-is in the wired app.
    in property <[string]> filter-chips: ["ALL (0)", "READY (0)", "SIGNAL (0)", "ORDER (0)", "IN POSITION (0)", "WAITING (0)", "NO DATA (0)", "RISK BLOCKED (0)", "REJECTED (0)"];

    // Breakpoint inputs
    in property <bool> dock-inspector: true;
    in property <bool> bar-core: true;
    in property <bool> bar-secondary: true;
    in property <bool> bar-extended: true;
    in property <bool> blotters-side-by-side: true;
    in property <bool> watchlist-header-inline: true;
    in property <bool> tall-inspector: true;
    in property <length> inspector-w: LiveTiers.inspector-width(root.width);
    in property <bool> inspector-open: true;

    // Out properties strictly satisfying test suites. They read the RECOMPOSITION
    // TIERS (decided from the window size one level up), never this screen's own
    // height — a height-derived size would close a layout binding loop.
    out property <bool> show-inspector: root.inspector-open;
    out property <bool> drawer-open: !root.dock-inspector && root.inspector-open;
    out property <bool> inspector-docked: root.dock-inspector && root.inspector-open;
    // Blotter tab bar runs in its compact form (short labels + icon-only
    // Clear) whenever the panel cannot hold the full row un-elided.
    out property <bool> blotters-compact: !root.blotters-side-by-side;
    // The watchlist header keeps title + chips + search on one row only while
    // all of it fits; otherwise the chips take their own scrollable strip.
    out property <bool> chips-inline: root.watchlist-header-inline;

    // Callbacks
    callback mode-picked(int);
    callback strategy-picked(string);
    callback symbol-toggled(int);
    callback universe-save();
    callback symbol-filter-changed(string);
    callback timeframe-picked(string);
    callback quantity-edited(string);
    callback start-requested();
    callback stop-requested();
    callback arm-requested();
    callback halt-requested();
    callback confirm-requested();
    callback event-filter-changed(string);
    callback event-type-picked(string);
    callback clear-events();
    callback inspector-toggled();
    callback configure-broker();
    callback watchlist-selected(string);
    callback filter-chip-picked(int);
    callback watchlist-search-changed(string);

    // The selected timeframe is the BACKEND's selection (index into
    // timeframe-names), never a locally shadowed string.
    property <string> selected-timeframe: root.timeframe-selected >= 0 && root.timeframe-selected < root.timeframe-names.length ? root.timeframe-names[root.timeframe-selected] : "—";
    property <string> selected-strategy: root.strategy-selected >= 0 && root.strategy-selected < root.strategy-names.length ? root.strategy-names[root.strategy-selected] : "—";

    // Internal state
    property <int> active-blotter-tab: 0; // 0 Positions, 1 Orders, 2 Fills, 3 Daily P&L
    // The search box owns its own text: the backend normalises the filter
    // (lowercases it) and pushes the normalised value back, so binding the
    // field to the model would fight the caret on every keystroke.
    property <string> filter-text: "";
    // The quantity field owns its text like the search box above: the
    // backend normalises every commit ("25" → "2.00"), so a live model
    // binding rewrites the field mid-keystroke and eats digits. Commits
    // go out on Enter only; backend updates sync back only while the
    // operator holds no uncommitted edit.
    property <string> qty-text: "";
    property <bool> qty-dirty: false;

    // STEP 4: the ONE start verdict. Derived from backend facts only — a
    // running session reads RUNNING, a session with reported blockers reads
    // START BLOCKED, and an unblocked stopped session reads READY TO START.
    // Never optimistic: nothing here is set by a click.
    property <string> start-verdict: root.setup.can-stop ? "● RUNNING" : (root.blockers.length > 0 ? "✕ START BLOCKED" : "✓ READY TO START");

    // Watchlist columns always preserved. Internal horizontal scrolling handles narrow viewports.
    property <bool> watchlist-columns-wide: true;

    init => { root.qty-text = root.setup.quantity; }
    changed setup => { if (!root.qty-dirty) { root.qty-text = root.setup.quantity; } }
    min-width: 0px;
    width: 100%;
    clip: true;
    background: VayrenPalette.bg;

    VerticalLayout {
        spacing: 0;
        min-width: 0px;
        width: 100%;

        // ══ 0. HALT BANNER (Placed right at top of LiveScreen for y:50..76 in AppWindow, strictly satisfying 36 < y < 70) ══
        if root.bar.halted: Rectangle {
            height: 24px;
            background: VayrenPalette.bg;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                VBanner {
                    height: 20px;
                    width: 100%;
                    message: "EXECUTION HALTED — kill switch engaged. Reconcile before restarting.";
                    tone: 3;
                }
            }
        }

        // ══ 1. TOP STATUS & CONTROL BAR ══════════════════════════════════════
        Rectangle {
            height: 60px;
            min-width: 0px;
            width: 100%;
            background: VayrenPalette.live-topbar;
            border-width: 1px;
            border-color: VayrenPalette.live-line-deep;
            // Overflow clips to the RIGHT edge (never centered, which would
            // push the broker card out of frame).
            clip: true;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                alignment: start;

                // Card 1: Broker + connection + safe account
                LiveTopCard {
                    icon-char: "B";
                    show-icon: root.bar-extended;
                    label: "BROKER";
                    value-text: root.bar.broker-label != "" ? root.bar.broker-label : "NOT CONFIGURED";
                    tone: root.bar.broker-tone;
                    sub-text: root.bar.conn-label != "" ? root.bar.conn-label : "DISCONNECTED";
                    sub-tone: root.bar.conn-tone;
                    source-text: "FYERS API";
                }

                // Dedicated Card: EC2 / Remote Gateway connection + heartbeat + latency
                LiveTopCard {
                    icon-char: "EC2";
                    show-icon: root.bar-extended;
                    label: "EC2 / REMOTE GATEWAY";
                    value-text: root.gateway.status != "" ? root.gateway.status : "DISCONNECTED";
                    tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                    sub-text: (root.gateway.last-heartbeat != "" ? ("HB: " + root.gateway.last-heartbeat) : "HB: NOT AVAILABLE")
                        + " · " + (root.gateway.rtt != "" ? ("RTT: " + root.gateway.rtt) : "RTT: NOT AVAILABLE");
                    sub-tone: root.gateway.tone != 0 ? root.gateway.tone : 3;
                    source-text: root.gateway.conn-state != "" ? ("EC2 WSS (" + root.gateway.conn-state + ")") : (root.gateway.detail != "" ? root.gateway.detail : "EC2 WSS");
                }

                // Card 2: Market data + order WS, merged into one data-feed fact
                if root.bar-secondary: LiveTopCard {
                    icon-char: "M";
                    show-icon: root.bar-extended;
                    label: "MARKET DATA";
                    value-text: root.md.status != "" ? root.md.status : (root.market.state-label != "" ? root.market.state-label : "NO DATA");
                    tone: root.md.tone != 0 ? root.md.tone : root.market.tone;
                    sub-text: root.ws.status != "" ? ("ORDER WS: " + root.ws.status) : "ORDER WS: DISCONNECTED";
                    sub-tone: root.ws.tone;
                    source-text: "MARKET WSS";
                }

                // Card 3: Strategy fact (real id + running status)
                if root.bar-secondary: LiveTopCard {
                    icon-char: "S";
                    show-icon: root.bar-extended;
                    label: "STRATEGY";
                    value-text: root.active-strat.name != "" ? root.active-strat.name : (root.bar.strategy-label != "" ? root.bar.strategy-label : "NOT SELECTED");
                    tone: root.active-strat.status-tone != 0 ? root.active-strat.status-tone : root.bar.strategy-tone;
                    sub-text: root.active-strat.status != "" ? root.active-strat.status : (root.bar.strategy-sub != "" ? root.bar.strategy-sub : "STOPPED");
                    sub-tone: root.active-strat.status-tone;
                    source-text: "STRATEGY RT";
                }

                // Card 4: Risk engine verdict + capital
                LiveTopCard {
                    icon-char: "R";
                    show-icon: root.bar-extended;
                    label: "RISK ENGINE";
                    value-text: root.bar.risk-label != "" ? root.bar.risk-label : "NOT READY";
                    tone: root.bar.risk-tone;
                    sub-text: root.bar.risk-sub != "" ? root.bar.risk-sub : "CAPITAL: NOT AVAILABLE";
                    sub-tone: root.bar.risk-tone == 3 ? 3 : 0;
                    source-text: "RISK ENGINE";
                }

                // Reconciliation + executor: only on the extended tier, where
                // there is room. Narrow screens keep the four facts above.
                if root.bar-extended: LiveTopCard {
                    icon-char: "RC";
                    show-icon: false;
                    label: "RECONCILIATION";
                    value-text: root.bar.recon-label != "" ? root.bar.recon-label : "NOT CONFIGURED";
                    tone: root.bar.recon-tone;
                    sub-text: root.bar.recon-sub != "" ? root.bar.recon-sub : "0 MISMATCHES";
                    sub-tone: root.bar.recon-tone;
                    source-text: "RECON ENGINE";
                }

                if root.bar-extended: LiveTopCard {
                    icon-char: "EX";
                    show-icon: false;
                    label: "EXECUTOR";
                    value-text: root.bar.exec-label != "" ? root.bar.exec-label : "STANDBY";
                    tone: root.bar.exec-tone;
                    sub-text: root.setup.session-label != "" ? root.setup.session-label : "PHASE 6 RT";
                    sub-tone: root.bar.exec-tone;
                    source-text: "PHASE 6 RT";
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                // Single strategy selector, always visible in the top bar.
                Rectangle {
                    height: 34px;
                    width: LiveTiers.bar-strategy-width();
                    border-radius: 6px;
                    background: VayrenPalette.live-panel;
                    border-width: 1px;
                    border-color: root.strategy-selected >= 0 ? VayrenPalette.live-teal : VayrenPalette.live-line-soft;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: "STRATEGY";
                            color: root.strategy-selected >= 0 ? VayrenPalette.live-teal : VayrenPalette.live-ink-dim;
                            font-size: 9px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            horizontal-stretch: 1;
                            min-width: 70px;
                            height: 26px;
                            enabled: !root.setup.can-stop && root.strategy-names.length > 0;
                            model: root.strategy-names;
                            current-value: root.selected-strategy;
                            selected(v) => { root.strategy-picked(v); }
                        }
                    }
                }

                // Segmented Mode Selector: PAPER | SANDBOX | LIVE
                Rectangle {
                    height: 34px;
                    width: 168px;
                    border-radius: 6px;
                    background: VayrenPalette.live-panel;
                    border-width: 1px;
                    border-color: VayrenPalette.live-line-soft;

                    HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;

                        // PAPER
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 0 ? VayrenPalette.live-teal : transparent;
                            TouchArea { clicked => { root.mode-picked(0); } }
                            Text {
                                text: "PAPER";
                                color: root.bar.mode == 0 ? VayrenPalette.accent-text : VayrenPalette.live-ink-faint;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // SANDBOX
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 1 ? VayrenPalette.amber : transparent;
                            TouchArea { clicked => { root.mode-picked(1); } }
                            Text {
                                text: "SANDBOX";
                                color: root.bar.mode == 1 ? VayrenPalette.accent-text : VayrenPalette.live-ink-faint;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // LIVE
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.bar.mode == 2 ? VayrenPalette.neg : transparent;
                            TouchArea { clicked => { root.mode-picked(2); } }
                            Text {
                                text: "LIVE";
                                color: root.bar.mode == 2 ? VayrenPalette.text-bright : VayrenPalette.live-ink-faint;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // START: enabled ONLY when the backend says the session can
                // start, and never while LIVE consent is still outstanding.
                VButton {
                    width: 112px;
                    label: "▶ START";
                    variant: 0;
                    enabled: root.setup.can-start && !root.setup.needs-live-confirm;
                    clicked => { root.start-requested(); }
                }

                // STOP: armed only while the backend reports a stoppable
                // session - a dead session shows a dead control, never a
                // button that silently does nothing.
                VButton {
                    width: 74px;
                    label: "■ STOP";
                    variant: 3;
                    enabled: root.setup.can-stop;
                    clicked => { root.stop-requested(); }
                }

                // HALT (kill switch): the real execution verdict
                // (exec-label / exec-tone) plus the backend's own
                // halt-enabled fact. Idle it is neutral and inert.
                VButton {
                    width: 76px;
                    label: root.bar.halted ? "■ HALTED" : "■ HALT";
                    variant: root.bar.halted ? 3 : 2;
                    enabled: root.bar.halt-enabled && !root.bar.halted;
                    clicked => { root.halt-requested(); }
                }

                // One verdict + one clock, carried here because the duplicated
                // footer strip is gone: every fact now lives in exactly one place.
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: root.footer.risk != "" ? root.footer.risk : (root.bar.halted ? "✕ EXECUTION HALTED" : (root.setup.can-stop ? "● RUNNING" : (root.blockers.length > 0 ? "✕ START BLOCKED" : "✓ READY TO START")));
                        color: root.bar.halted || root.blockers.length > 0 ? VayrenPalette.neg : VayrenPalette.pos;
                        font-size: 10px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.footer.clock;
                        color: VayrenPalette.live-ink-dim;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ══ 2. MAIN 3-COLUMN WORKSPACE ══════════════════════════════════════
        Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            width: 100%;
            clip: true;
            background: VayrenPalette.bg;

            HorizontalLayout {
                min-width: 0px;
                width: 100%;
                padding: 10px;
                // The inspector only reserves workspace width while it is
                // actually docked; an overlay floats above the workspace
                // instead of squeezing it.
                padding-right: root.inspector-docked ? root.inspector-w + 10px : 10px;
                spacing: 10px;

                // ── COLUMN 1: WORKSTATION WORKSPACE (LEFT ~70%) ──
                VerticalLayout {
                    horizontal-stretch: 70;
                    min-width: 0px;
                    spacing: 10px;

                }
            }

            // ── COLUMN 2: INSPECTOR (RIGHT COLUMN ~30%) ─────────────────────────
            if root.show-inspector: Rectangle {
                x: parent.width - root.inspector-w;
                y: 0;
                width: root.inspector-w;
                height: 100%;
                clip: true;
                background: VayrenPalette.bg;
                border-width: root.drawer-open ? 1px : 0px;
                border-color: VayrenPalette.live-line;

                inspector-scroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;

                    VerticalLayout {
                        width: 100%;
                        padding: 10px;
                        padding-left: 4px;
                        padding-right: 8px;
                        spacing: 8px;

                        // 3.1 ACTIVE STRATEGY CARD
                        Rectangle {
                            min-height: 110px;
                            background: VayrenPalette.live-panel;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: VayrenPalette.live-line;

                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 6px;
                                    alignment: center;

                                    Text {
                                        text: "STRATEGY";
                                        color: VayrenPalette.text-bright;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }

                                    VBadge {
                                        text: "● " + (root.active-strat.mode != "" ? root.active-strat.mode : (root.bar.mode == 2 ? "LIVE" : root.bar.mode == 1 ? "SANDBOX" : "PAPER"));
                                        tone: root.active-strat.mode-tone != 0 ? root.active-strat.mode-tone : (root.bar.mode == 2 ? 3 : 0);
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: VayrenPalette.live-btn;
                                        border-width: 1px;
                                        border-color: VayrenPalette.live-btn-line;
                                        TouchArea { clicked => { root.inspector-toggled(); } }
                                        Text {
                                            text: "›";
                                            color: VayrenPalette.live-ink;
                                            font-size: 14px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // STRATEGY + STATUS is the operator's first read
                                // (STEP 32 hierarchy): name left, lifecycle right,
                                // and the lifecycle is the DOMAIN's session label —
                                // never a locally invented "ACTIVE".
                                HorizontalLayout {
                                    height: 18px;
                                    spacing: 4px;
                                    Text { width: 80px; text: "STRATEGY"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: root.active-strat.name != "" ? root.active-strat.name : "—"; color: VayrenPalette.live-teal; font-size: 11px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                                    Text { width: 50px; text: "STATUS"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { width: 65px; text: root.active-strat.status != "" ? root.active-strat.status : "—"; color: LiveTone.ink(root.active-strat.status-tone != 0 ? root.active-strat.status-tone : root.bar.exec-tone); font-size: 11px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }

                                // MODE is independent of STATUS: a LIVE selection
                                // with a stopped session must read exactly so.
                                HorizontalLayout {
                                    height: 18px;
                                    spacing: 4px;
                                    Text { width: 80px; text: "MODE"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: root.active-strat.mode != "" ? root.active-strat.mode : (root.bar.mode == 2 ? "LIVE" : root.bar.mode == 1 ? "SANDBOX" : "PAPER"); color: LiveTone.ink(root.active-strat.mode-tone != 0 ? root.active-strat.mode-tone : (root.bar.mode == 2 ? 3 : 0)); font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { width: 50px; text: "SYMBOLS"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { width: 65px; text: root.active-strat.symbols-count != "" ? root.active-strat.symbols-count : "—"; color: VayrenPalette.text; font-size: 10px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }

                                HorizontalLayout {
                                    height: 18px;
                                    spacing: 4px;
                                    Text { width: 80px; text: "SIGNALS TODAY"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: root.active-strat.today-signals != "" ? root.active-strat.today-signals : "—"; color: VayrenPalette.text; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { width: 50px; text: "ORDERS"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { width: 65px; text: root.active-strat.orders-today != "" ? root.active-strat.orders-today : "—"; color: VayrenPalette.text; font-size: 10px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }

                                HorizontalLayout {
                                    height: 18px;
                                    spacing: 4px;
                                    Text { width: 80px; text: "POSITIONS"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; min-width: 0px; text: root.active-strat.current-position != "" ? root.active-strat.current-position : "—"; color: VayrenPalette.pos; font-size: 10px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { width: 50px; text: "STARTED"; color: VayrenPalette.live-ink-dim; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                                    Text { width: 65px; text: root.active-strat.started-at != "" ? root.active-strat.started-at : "—"; color: VayrenPalette.muted; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }

                    }
                }
            }

            // Inspector reopen rail
            if !root.show-inspector: Rectangle {
                x: parent.width - 28px;
                y: 0;
                width: 28px;
                height: 100%;
                background: VayrenPalette.bg;
                TouchArea { clicked => { root.inspector-toggled(); } }
                Text {
                    text: "‹";
                    color: VayrenPalette.live-ink;
                    font-size: 14px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
