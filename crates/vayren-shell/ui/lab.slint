// VAYREN Strategy Lab — native Slint workstation surface (AI_ENTRY.md §1).
// Presentation only: every value arrives via the `lab`
// struct + row models projected by the Rust view-model (lab.rs); the screen
// reports user actions through callbacks and never infers state.
//
// Visual contract: ONE unified strategy header (replaces the fragmented
// NO STRATEGY / BUY—LONG / -- / READY strip), mode segmented control lives
// HERE only (floating BUY/LONG box removed), compact institutional config
// toolbar, hairline-separated KPI band (no card-per-metric, Net P&L
// strongest), analysis tabs whose content always fills the remaining space
// (no giant voids), and stock ranking integrated as the PERFORMANCE section.

import { VayrenPalette, VayrenDesign, LabPalette } from "palette.slint";
import { VBadge, VButton, VBanner, VEmptyState, VCell } from "components.slint";
import { ScrollView, TextEdit, Palette } from "std-widgets.slint";

export struct LabPoint {
    x: length,
    y: length,
}

// Ranking-table window geometry, derived in Rust (the UI never re-computes
// layout maths) — `spec §12/§17`.
export struct RankWindow {
    total: int,
    first: int,
    count: int,
    row-h: length,
    viewport-h: length,
    scroll-px: length,
    max-scroll-px: length,
    thumb-h: length,
    thumb-y: length,
    scrollable: bool,
    // Band identity split in two 32-bit halves: Slint's `int` is i32, and a
    // 64-bit signature must survive the trip exactly (a false "unchanged" would
    // leave a stale table on screen).
    signature-hi: int,
    signature-lo: int,
    overscan: int,
}

// Trade detail fact: label, value and the P&L tone. Declared before LabHeader
// (Slint resolves types in declaration order) and separate from
// `LabDetailMetric`, which the ranking inspector uses.
export struct LabTradeMetric {
    label: string,
    value: string,
    tone: int,
}

// §02 validation row: the label plus its tone (0 pass, 1 warn, 2 fail). The
// tone is a NUMBER, not a colour — the palette owns the mapping. Declared
// before LabHeader because Slint resolves types in declaration order.
export struct LabCheckData {
    label: string,
    kind: int,
}

export struct LabHeader {
    has-strategy: bool,    name: string,
    description: string,
    tags: string,
    version: string,
    modified: string,
    last-backtest: string,
    state-label: string,
    state-tone: int, // VBadge tone
    mode: int,       // 0 LONG, 1 SHORT, 2 COMPARE
    outdated: bool,
    run-enabled: bool,
    universe: string,
    timeframe: string,
    dates: string,
    capital: string,
    show-results: bool,
    tab: int,
    summary-line: string,
    empty-reason: string,
    equity-caption: string,
    drawdown-caption: string,
    ranking-count: string,
    run-stop: bool,
    verdict-label: string,
    verdict-note: string,
    verdict-tone: int,
    progress-label: string,
    run-label: string,
    code: string,
    dirty: bool,
    cfg-universe-csv: string,
    timeframe-index: int,
    cfg-dates-start: string,
    cfg-dates-end: string,
    cfg-capital: string,
    config-error: string,
    rank-search: string,
    rank-desc: bool,
    rankby-current: int,
    trade-needle: string,
    trade-symbol: string,
    trade-filters-active: bool,
    selected-trade: int,
    compare-side: int, // 0 ALL, 1 LONG, 2 SHORT
    is-compare: bool,
    // drill-down (empty symbol = none selected)
    detail-symbol: string,
    detail-title: string,
    detail-stats: string,
    detail-caption: string,
    // compare page
    cmp-verdict: string,
    cmp-reason: string,
    cmp-tone: int,
    cmp-trade-summary: string,
    // Trade blotter state (`spec §2`): honest counts, the filter/sort state and
    // the ONE selected trade's facts.
    trade-summary: string,
    trade-needle: string,
    trade-side-filter: int,
    trade-result-filter: int,
    trade-sort: int,
    trade-sort-labels: [string],
    trade-total: int,
    trade-detail-symbol: string,
    trade-detail-side: string,
    trade-detail-metrics: [LabTradeMetric],
    cmp-stale: string,
    cmp-scope: string,
    cmp-leader: string,
    cmp-has-sides: bool,
    sym-open: bool,
    sym-search: string,
    sym-button-line: string,
    sym-count-line: string,
    sym-selected-line: string,
    // ── Reference redesign additions ──
    run-id: string,
    run-ts: string,
    cfg-hash: string,
    result-pnl: string,
    result-return: string,
    result-pnl-tone: int,       // 2=positive, 3=negative
    result-exec-line: string,
    stale-exec-line: string,
    stale-cur-line: string,
    range-line: string,
    diag-show: bool,
    diag-title: string,
    diag-detail: string,
    diag-stale: bool,
    risk-gate-show: bool,
    risk-gate-text: string,
    lens: int,                  // 0=Performance 1=Trades 2=Equity 3=Drawdown 4=Analytics 5=Strategy
    strategy-count-line: string,
    editing-hint: string,
    studio-ref-pf: string,
    studio-source: string,
    equity-select: int,         // 0=Cumulative P&L 1=Daily P&L 2=Return%
    // ── Date-range control (presentation derives from the ISO cfg dates) ──
    dates-human: string,        // "22 Sep 2026 — 22 Sep 2026"
    dates-error: string,        // inline validation, empty = valid
    today-days: int,            // days since 1970-01-01 (calendar anchor)
    // Committed selection as calendar anchors (days since epoch, -1 = unset).
    // Rust parses the ISO fields once — Slint never re-parses strings.
    dates-start-days: int,
    dates-end-days: int,
    // ── §02 CONFIGURE (three-row structured config) ──
    tf-short-idx: int,          // selected cell inside tf-short, -1 = behind MORE
    range-preset-idx: int,      // active preset cell, -1 = a hand-picked range
    range-from-human: string,   // "19 Sep 2019" (formatted in Rust)
    range-to-human: string,     // "18 Aug 2026"
    range-to-live: bool,        // range ends at the last available bar
    range-span-line: string,    // "1,684 DAYS"
    timeframe-label: string,    // resolved ladder entry (one authority)
    capital-label: string,      // "₹10,000" from the committed input
    capital-ok: bool,           // validate_form bit 4
    chips-more-line: string,    // "+522" when the chip row is capped
    cfg-checks: [LabCheckData],
    cov-pct: int,               // integer percent; 0 when unmeasured
    cov-note: string,
    cov-kind: int,              // 0 pass, 1 warn, 2 fail
    cov-on: bool,               // false = unmeasured → the strip is hidden
    cov-caption: string,        // "SAMPLED" when the probe was bounded
    // ── live run progress (formatted in Rust from measured events) ──
    prog-active: bool,
    prog-headline: string,      // "127 / 527 stocks"
    prog-counts: string,        // "Completed 127   Failed 0   …   Remaining 398"
    prog-current: string,       // "AARTIIND"
    prog-stage: string,         // "Trade generation"
    prog-stage-pct: float,
    prog-elapsed: string,       // "02:14"
    prog-eta: string,           // "~06:32" or "—" when not yet measurable
    prog-speed: string,         // "0.95 s/stock"
    prog-throughput: string,    // "0.95 stocks/s"
    prog-failed-line: string,
    prog-pct: float,
    prog-cancelled: bool,
    prog-long: bool,
    prog-watchdog: string,      // "LONG-RUNNING — 00:47" / "" when healthy
}

