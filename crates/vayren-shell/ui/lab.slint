// ══════════════ reference-layout helpers ══════════════

component LabEyebrow inherits Rectangle {
    in property <string> eyebrow-text;
    height: 20px;
    width: 100%;
    ebtx := Text {
        text: eyebrow-text;
        font-size: 10px;
        letter-spacing: 1.6px;
        color: LabPalette.dim;
        font-weight: 600;
        x: 0;
        y: (parent.height - self.height) / 2;
    }
    Rectangle {
        x: ebtx.width + 10px;
        y: parent.height / 2;
        height: 1px;
        width: parent.width - ebtx.width - 20px;
        background: LabPalette.line2;
    }
}

component LabFieldLabel inherits Rectangle {
    in property <string> lbl;
    in property <string> hint: "";
    // A hint that OPENS something (the date-range "CUSTOM" door) rather than
    // being a caption — the affordance has to be real, not painted.
    in property <bool> hint-accent: false;
    callback hint-clicked();
    height: 19px;
    Text {
        text: root.lbl;
        x: 0;
        width: parent.width;
        horizontal-alignment: left;
        font-size: 10.5px;
        letter-spacing: 1px;
        color: LabPalette.lab-muted;
        vertical-alignment: center;
    }
    if root.hint != "": Rectangle {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        Text {
            text: root.hint;
            font-size: 10px;
            letter-spacing: 1px;
            color: root.hint-accent ? LabPalette.lab-teal : LabPalette.dim;
            // The hint is right-aligned against the FULL label width, so it
            // can never land on top of the label text.
            x: 0;
            width: parent.width;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        hta := TouchArea {
            enabled: root.hint-accent;
            mouse-cursor: pointer;
            clicked => { root.hint-clicked(); }
        }
    }
}

component LabFieldDivider inherits Rectangle {
    width: 1px;
    background: LabPalette.line2;
}

// Segmented control: equal cells, one selected, click reports the cell index.
// Equal widths are the point — a cell wider than its own label is the layout
// bug this component exists to make impossible.
component LabSegmented inherits Rectangle {
    in property <[string]> items;
    in property <int> selected-idx: -1;
    in property <length> cell-h: LabPalette.cfg-sub-h;
    // The ladder keeps going past the visible cells; the overflow is one
    // explicit cell, never a silently truncated list.
    in property <bool> more-cell: false;
    callback picked(int);
    callback more-picked();
    height: root.cell-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: LabPalette.line;
    clip: true;
    HorizontalLayout {
        spacing: 0;
        for seglbl[segidx] in root.items: Rectangle {
            horizontal-stretch: 1;
            height: root.cell-h;
            background: segidx == root.selected-idx ? LabPalette.seg-on-bg
                : sgta.has-hover ? LabPalette.white-04 : transparent;
            sgta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(segidx); }
            }
            Text {
                text: seglbl;
                font-size: 10.5px;
                letter-spacing: 0.4px;
                font-weight: segidx == root.selected-idx ? 650 : 400;
                color: segidx == root.selected-idx ? LabPalette.chip-bg : LabPalette.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 3px;
                width: parent.width - 6px;
                overflow: elide;
            }
            Rectangle {
                visible: segidx != root.items.length - 1;
                x: parent.width - 1px; y: 0; width: 1px; height: parent.height;
                background: LabPalette.line2;
            }
        }
        if root.more-cell: Rectangle {
            horizontal-stretch: 1;
            height: root.cell-h;
            background: sgta2.has-hover ? LabPalette.white-04 : transparent;
            sgta2 := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.more-picked(); }
            }
            Text {
                // "MORE", and NOT "MORE ▼". The cell is ~41px wide at this column
                // weight: a chevron beside the word needs ~40px, which either
                // clipped the word to "M..." or — with the chevron in a
                // sub-layout — handed this cell a wider max-width than its four
                // timeframe siblings, so `horizontal-stretch: 1` gave it the
                // slack and broke the equal-width invariant this component
                // exists to protect. The word alone fits, reads, and stays even.
                text: "MORE";
                font-size: 10px;
                letter-spacing: 0.2px;
                color: LabPalette.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 2px;
                width: parent.width - 4px;
                overflow: elide;
            }
        }
    }
}

component LabCtlButton inherits Rectangle {
    in property <string> ctl-label;
    in property <length> ctl-h: LabPalette.field-h;
    // Real focus (the surface this control opened is up) — not a painted
    // affordance that lies about where the keyboard is.
    in property <bool> ctl-focus: false;
    callback clicked();
    height: root.ctl-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: root.ctl-focus ? LabPalette.teal-40
        : cbta.has-hover ? LabPalette.white-16 : LabPalette.line;
    cbta := TouchArea {
        mouse-cursor: pointer;
        // Immediate action on press (brief §6): no release-wait latency.
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.clicked();
            }
        }
    }
    // Label and chevron positioned ABSOLUTELY, not by a HorizontalLayout.
//
// Inside a bare `Rectangle` in Slint 1.17 a HorizontalLayout here sized itself
// to its content instead of the button's width, so `horizontal-stretch: 1` on
// the label had no slack to hand out and the chevron was packed flush against
// the label's last glyph. Every ▾ control in the lab therefore read as one
// longer word with the affordance buried mid-text ("30m▾"), and no amount of
// `alignment` changed it — `start`, `center` and a stretch factor all produced
// the same packed block. Stating the geometry is what actually pins the
// chevron to the right padding edge, which is where a dropdown caret belongs.
Text {
    text: root.ctl-label;
    font-size: 12px;
    color: LabPalette.lab-text;
    x: 11px;
    width: parent.width - 11px - 15px - 11px;
    horizontal-alignment: left;
    vertical-alignment: center;
    overflow: elide;
}
if root.ctl-focus: Text {
    text: "▌";
    color: LabPalette.lab-teal;
    font-size: 11px;
    x: parent.width - 11px - 9px;
    width: 9px;
    horizontal-alignment: center;
    vertical-alignment: center;
}
if !root.ctl-focus: Text {
    // "▼" (U+25BC), not "▾" (U+25BE). A glyph probe across this UI's resolved
    // font showed ↓ → ∨ ✓ ● ˅ ▼ all painting and ▾ painting NOTHING — U+25BE
    // is the one codepoint here with no glyph in the stack, so it silently
    // vanished and took the dropdown affordance with it.
    text: "▼";
    color: LabPalette.dim;
    font-size: 10px;
    x: parent.width - 11px - 9px;
    width: 9px;
    horizontal-alignment: center;
    vertical-alignment: center;
}
}

// Dark text field — same control family as LabCtlButton (height, radius,
// border, focus). TextInput mirror follows the proven broker_connection
// pattern (local mirror + commit on accepted).
component LabCtlInput inherits Rectangle {
    in property <string> val;
    in property <string> pre-fix: "";
    in property <string> post-fix: "";
    in property <string> ph: "";
    callback committed(string);
    height: LabPalette.field-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: ctl-ti.has-focus ? LabPalette.teal-40 : LabPalette.line;
    property <string> cur: root.val;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        // NOT `alignment: center`, same reason as LabCtlButton: it centres
        // [₹, digits] as a block, so the amount floated in the middle of its
        // well instead of starting at the same 11px left edge as the field's
        // own placeholder overlay assumes (and as every other control in the
        // card does). Amounts are read and corrected by position, so they
        // start at the left.
        alignment: start;
        spacing: 0;
        Text { visible: root.pre-fix != ""; text: root.pre-fix; color: LabPalette.dim; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
        ctl-ti := TextInput {
            horizontal-stretch: 1;
            min-width: 0;
            text: root.cur;
            font-family: "monospace";
            font-size: 11.5px;
            color: LabPalette.lab-text;
            single-line: true;
            vertical-alignment: center;
            edited => { root.cur = self.text; }
            accepted => { root.committed(self.text); }
        }
        Text { visible: root.post-fix != ""; text: root.post-fix; color: LabPalette.dim; font-size: 11px; vertical-alignment: center; }
    }
    if root.cur == "": Text {
        // Placeholder overlay (non-interactive; pointer passes through).
        x: root.pre-fix != "" ? 22px : 11px;
        width: parent.width - (root.pre-fix != "" ? 33px : 22px);
        height: 100%;
        text: root.ph;
        color: LabPalette.lab-faint;
        font-size: 11.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Dark live-search field — mirrors text on every edit (filter-as-you-type).
component LabCtlSearch inherits Rectangle {
    in property <string> val;
    in property <string> ph: "";
    in property <length> ctl-h: LabPalette.field-h;
    callback changed(string);
    height: root.ctl-h;
    border-radius: 8px;
    background: LabPalette.field-bg;
    border-width: 1px;
    border-color: s-ti.has-focus ? LabPalette.teal-40 : LabPalette.line;
    property <string> cur: root.val;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        s-ti := TextInput {
            horizontal-stretch: 1;
            min-width: 0;
            text: root.cur;
            font-size: 11.5px;
            color: LabPalette.lab-text;
            single-line: true;
            vertical-alignment: center;
            edited => { root.cur = self.text; root.changed(self.text); }
        }
    }
    if root.cur == "": Text {
        x: 11px;
        width: parent.width - 22px;
        height: 100%;
        text: root.ph;
        color: LabPalette.lab-faint;
        font-size: 11.5px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Ranking-table drag state. Kept in the UI (not the data layer) because it is
// pure gesture bookkeeping: where the press started and what the scroll offset
// was at that moment. `press-y` (not `y`) — `y` is Rectangle's own property.
component RankScrollState inherits Rectangle {
    in-out property <bool> pressed;
    in-out property <float> offset;
    in-out property <length> press-y;
}

component LabTh inherits Rectangle {
    in property <string> th;
    in property <length> tw: 0px;
    in property <int> stretch: 0;
    in property <bool> ta-left: false;
    height: 30px;
    // preferred-width (not width): a bound `width` would pin the cell and
    // defeat `horizontal-stretch`, collapsing every metric column to 0px.
    preferred-width: root.tw;
    horizontal-stretch: root.stretch;
Text {
            text: root.th;
            font-size: 10px;
            letter-spacing: 0.6px;
        color: LabPalette.dim;
        font-weight: 600;
        horizontal-alignment: root.ta-left ? left : right;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }
}

component LabTd inherits Rectangle {
    in property <string> td;
    in property <length> tw: 0px;
    in property <int> stretch: 0;
    in property <bool> ta-left: false;
    in property <bool> bold: false;
    in property <bool> no-mono: false;
    in property <color> tc: LabPalette.soft;
    height: 40px;
    // preferred-width (not width): see LabTh — a bound width collapses the
    // stretched metric columns.
    preferred-width: root.tw;
    horizontal-stretch: root.stretch;
    Text {
        text: root.td;
        font-family: root.no-mono ? "Inter" : "monospace";
        font-size: 11.5px;
        font-weight: root.bold ? 650 : 400;
        color: root.tc;
        horizontal-alignment: root.ta-left ? left : right;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
    }
}

component LabEqStat inherits Rectangle {
    in property <string> es-label;
    in property <string> es-value;
    in property <int> es-tone: 0;
    horizontal-stretch: 1;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 6px;
        Text { text: root.es-label; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.dim; }
        Text {
            text: root.es-value;
            font-family: "monospace";
            font-size: 12.5px;
            color: root.es-tone == 2 ? LabPalette.green : root.es-tone == 3 ? LabPalette.lab-red : LabPalette.lab-text;
            overflow: elide;
        }
    }
}

component LabMetaCell inherits Rectangle {
    in property <string> mc-label;
    in property <string> mc-value;
    horizontal-stretch: 1;
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        spacing: 5px;
        Text { text: root.mc-label; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.dim; }
        Text { text: root.mc-value; font-size: 11.5px; font-family: "monospace"; color: LabPalette.lab-text; overflow: elide; }
    }
}

struct LabCivil {
    y: int,
    m: int,
    d: int,
}

// ── Compact date-range picker ──────────────────────────────────────────
// START → END two-step mental model with live hover preview, presets and
// one-click correction (end-before-start auto-swaps). Pure presentation:
// the calendar is integer civil-date arithmetic; data stays ISO and is
// committed through the existing dates-committed(start, end) contract.
component LabDateRangePicker inherits Rectangle {
    in property <int> start-days;   // committed selection (-1 = unset)
    in property <int> end-days;
    in property <int> today-days;
    in property <[LabPreset]> presets;
    callback committed(string, string);
    callback cancelled();

    width: 296px;
    height: 344px;
    border-radius: 12px;
    background: LabPalette.dialog-bg;
    border-width: 1px;
    border-color: LabPalette.white-16;
    // Swallow background clicks so the scrim below does not close the picker.
    TouchArea { }

    // ---- epoch<->civil (days since 1970-01-01, proleptic Gregorian) ----
    pure function dfc(y: int, m: int, d: int) -> int {
        let my = m <= 2 ? y - 1 : y;
        let era = Math.floor((my >= 0 ? my : my - 399) / 400);
        let yoe = my - era * 400;
        let mp = m + (m > 2 ? -3 : 9);
        let doy = Math.floor((153 * mp + 2) / 5) + d - 1;
        let doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
        return era * 146097 + doe - 719468;
    }
    pure function cfd(z: int) -> LabCivil {
        let zz = z + 719468;
        let era = Math.floor((zz >= 0 ? zz : zz - 146096) / 146097);
        let doe = zz - era * 146097;
        let yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
        let y = yoe + era * 400;
        let doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
        let mp = Math.floor((5 * doy + 2) / 153);
        let d = doy - Math.floor((153 * mp + 2) / 5) + 1;
        let m = mp + (mp < 10 ? 3 : -9);
        return { y: y + (m <= 2 ? 1 : 0), m: m, d: d };
    }
    pure function iso(z: int) -> string {
        let c = root.cfd(z);
        return c.y + "-" + (c.m < 10 ? "0" : "") + c.m + "-" + (c.d < 10 ? "0" : "") + c.d;
    }
    pure function human(z: int) -> string {
        let c = root.cfd(z);
        let mo = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][c.m - 1];
        return c.d + " " + mo + " " + c.y;
    }
    pure function months-of(z: int) -> int {
        let c = root.cfd(z);
        return c.y * 12 + c.m - 1;
    }

    // ---- selection state (-2 = untouched → follow committed props) ----
    property <int> st-start: -2;
    property <int> st-end: -2;
    property <int> a-start: root.st-start == -2 ? root.start-days : root.st-start;
    property <int> a-end: root.st-end == -2 ? root.end-days : root.st-end;
    property <int> hover-days: -1;
    // live preview end: committed/hovered while the START is already set
    property <int> eff-end: root.a-end >= 0 ? root.a-end
        : root.a-start >= 0 && root.hover-days >= root.a-start ? root.hover-days : -1;
    property <bool> picking-end: root.a-start >= 0 && root.a-end < 0;

    function pick(z: int) {
        if (root.a-start < 0 || root.a-end >= 0) {
            // fresh START (also restarts the range after a complete pair)
            root.st-start = z;
            root.st-end = -1;
        } else if (z < root.a-start) {
            // never destroy the selection — correct it by swapping
            root.st-end = root.st-start;
            root.st-start = z;
        } else {
            root.st-end = z;
        }
        root.vshift = 0;
    }
    function apply-preset(p: LabPreset) {
        root.st-start = p.start-days;
        root.st-end = p.end-days;
        root.vshift = 0;
    }

    // ---- viewed month: anchor (start → today) + manual navigation ----
    property <int> anchor-days: root.a-start >= 0 ? root.a-start : root.today-days;
    property <int> vshift;
    property <int> vtotal: root.months-of(root.anchor-days) + root.vshift;
    property <int> vy: Math.floor(root.vtotal / 12);
    property <int> vm: root.vtotal - root.vy * 12 + 1;
    property <int> m-first: root.dfc(root.vy, root.vm, 1);
    property <int> m-last: root.dfc(root.vy, root.vm, root.vm == 2
        ? (Math.mod(root.vy, 4) == 0 && (Math.mod(root.vy, 100) != 0 || Math.mod(root.vy, 400) == 0) ? 29 : 28)
        : (root.vm == 4 || root.vm == 6 || root.vm == 9 || root.vm == 11) ? 30 : 31);
    property <int> m-offset: Math.mod(root.m-first + 3, 7); // Monday-first grid

    VerticalLayout {
        padding: 14px;
        spacing: 6px;

        // month navigation — "where am I"
        Rectangle {
            height: 28px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 26px; height: 26px; border-radius: 7px;
                    background: pvta.has-hover ? LabPalette.hover2 : transparent;
                    pvta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.vshift -= 1; }
                    }
                    Text { text: "‹"; color: LabPalette.soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: ["January", "February", "March", "April", "May", "June", "July",
                               "August", "September", "October", "November", "December"][root.vm - 1] + " " + root.vy;
                        font-size: 12px; font-weight: 650; color: LabPalette.lab-text;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 26px; height: 26px; border-radius: 7px;
                    background: nxta.has-hover ? LabPalette.hover2 : transparent;
                    nxta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.vshift += 1; }
                    }
                    Text { text: "›"; color: LabPalette.soft; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        // weekday header
        HorizontalLayout {
            spacing: 0;
            for wd in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]: Rectangle {
                horizontal-stretch: 1;
                height: 16px;
                Text { text: wd; font-size: 10px; letter-spacing: 0.3px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // day grid — 6 weeks × 7 days
        for widx in [0, 1, 2, 3, 4, 5]: HorizontalLayout {
            spacing: 0;
            for didx in [0, 1, 2, 3, 4, 5, 6]: cell := Rectangle {
                horizontal-stretch: 1;
                height: 27px;
                property <int> cd: root.m-first + (widx * 7 + didx) - root.m-offset;
                property <bool> valid: self.cd >= root.m-first && self.cd <= root.m-last;
                property <bool> is-start: self.valid && root.a-start == self.cd;
                property <bool> is-end: self.valid && root.eff-end == self.cd && self.cd != root.a-start;
                property <bool> in-range: self.valid && root.a-start >= 0 && root.eff-end >= 0
                    && self.cd > root.a-start && self.cd < root.eff-end;
                property <bool> is-today: self.valid && self.cd == root.today-days;
                background: self.in-range ? LabPalette.teal-06
                    : self.valid && cta.has-hover ? LabPalette.white-04 : transparent;
                cta := TouchArea {
                    enabled: cell.valid;
                    mouse-cursor: pointer;
                    clicked => { root.pick(cell.cd); }
                    changed has-hover => {
                        if self.has-hover {
                            root.hover-days = cell.cd;
                        } else if root.hover-days == cell.cd {
                            root.hover-days = -1;
                        }
                    }
                }
                Rectangle {
                    visible: cell.in-range;
                    x: 0; y: 4px; width: parent.width; height: cell.height - 8px;
                    background: LabPalette.teal-06;
                }
                Rectangle {
                    visible: cell.valid;
                    width: 23px; height: 23px;
                    border-radius: 12px;
                    x: (cell.width - self.width) / 2;
                    y: (cell.height - self.height) / 2;
                    background: cell.is-start || cell.is-end ? LabPalette.lab-teal : transparent;
                    border-width: cell.is-today && !cell.is-start && !cell.is-end ? 1px : 0px;
                    border-color: LabPalette.teal-dim;
                    Text {
                        text: cell.cd - root.m-first + 1;
                        font-family: "monospace";
                        font-size: 10.5px;
                        color: cell.is-start || cell.is-end ? LabPalette.chip-bg : LabPalette.soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // presets — one-click research periods
        HorizontalLayout {
            spacing: 5px;
            height: 22px;
            for p in root.presets: Rectangle {
                height: 22px;
                width: pptx.width + 14px;
                border-radius: 99px;
                background: p.start-days == root.a-start && p.end-days == root.a-end ? LabPalette.teal-06 : transparent;
                border-width: 1px;
                border-color: prta.has-hover ? LabPalette.teal-40 : LabPalette.line2;
                prta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.apply-preset(p); }
                }
                pptx := Text {
                    text: p.label;
                    font-size: 10px; color: LabPalette.lab-muted;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
        // footer — what will be tested + actions
        Rectangle {
            height: 34px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.a-start < 0 ? "Pick a start date"
                        : root.a-end < 0 ? root.human(root.a-start) + " — pick end"
                        : root.human(root.a-start) + " — " + root.human(root.a-end);
                    font-size: 10px;
                    color: root.a-end < 0 ? LabPalette.dim : LabPalette.lab-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 62px; height: 26px; border-radius: 7px;
                    background: LabPalette.panel3;
                    border-width: 1px;
                    border-color: cnsta.has-hover ? LabPalette.white-16 : LabPalette.line;
                    cnsta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancelled(); }
                    }
                    Text { text: "Cancel"; color: LabPalette.lab-muted; font-size: 10.5px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 56px; height: 26px; border-radius: 7px;
                    background: root.a-start >= 0 && root.a-end >= 0 ? LabPalette.run-ink : LabPalette.btn-idle-bg;
                    Text {
                        text: "Apply";
                        color: root.a-start >= 0 && root.a-end >= 0 ? LabPalette.chip-bg : LabPalette.lab-faint;
                        font-size: 10.5px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: root.a-start >= 0 && root.a-end >= 0;
                        mouse-cursor: pointer;
                        clicked => { root.committed(root.iso(root.a-start), root.iso(root.a-end)); }
                    }
                }
            }
        }
    }
}



export component StrategyLabScreen inherits Rectangle {
    // Native std-widgets (LineEdit/TextEdit/ScrollBar) inside this screen
    // must follow the app's dark system, not the workstation OS theme.
    init => {
        Palette.color-scheme = ColorScheme.dark;
        // Arm the coverage count-up once, so the strip grows from 0 to the
        // measured percent instead of appearing pre-filled.
        root.cov-armed = true;
    }

    in property <LabHeader> lab;
    in property <RankWindow> lab-rank-window;
    // Trade blotter window — the same engine, its own geometry.
    in property <RankWindow> lab-trade-window;
    in property <[LabLibraryRow]> library;
    in property <[LabKpi]> kpis;
    in property <[LabRankRow]> ranking;
    in property <[LabTradeRow]> trades;
    in property <[LabPoint]> equity;
    in property <[LabPoint]> drawdown;
    in property <[LabParam]> params;
    in property <[string]> timeframes;
    in property <[string]> rankby-labels;
    in property <[string]> rank-heads;
    in property <[string]> trade-heads;
    in property <[LabDetailMetric]> detail-metrics;
    in property <[string]> universe-chips;
    in property <[LabPoint]> detail-equity;
    in property <[string]> board-labels;
    in property <[string]> board-columns;
    in property <[string]> board-trades;
    in property <[LabBoardCell]> board-cells;
    in property <int> board-cols: 1;
    in property <[LabMatrixRow]> matrix;
    in property <[LabRankRow]> compare-ranking;
    in property <[LabPoint]> equity-buy;
    in property <[LabPoint]> equity-sell;
    in property <[LabPoint]> drawdown-buy;
    in property <[LabPoint]> drawdown-sell;
    in property <[string]> sym-visible;
    in property <[bool]> sym-visible-on;
    in property <int> filter-active: 0;
    in property <[LabPreset]> date-presets;
    // §02: the first cells of the REAL timeframe ladder, and the real date
    // range preset labels. Both are presentation caps — the rest of the ladder
    // and the full range are still reachable (dropdown / MAX).
    in property <[string]> tf-short;
    in property <[string]> range-preset-labels;
    // Coverage count-up. Armed once on creation so the strip animates from 0
    // to the measured percent instead of appearing pre-filled.
    property <bool> cov-armed: false;
    property <int> cov-shown: root.cov-armed ? root.lab.cov-pct : 0;
    animate cov-shown { duration: 900ms; easing: ease-out; }

    // ── Floating control surfaces (dropdown menus + date-range picker) ──
    // These are rendered as screen-level overlays: the section cards clip
    // their content, so a menu anchored inside a card would be cut off.
    property <int> menu-src: -1;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;
    property <length> menu-w: 140px;
    property <bool> dates-open: false;
    property <length> dates-x: 0px;
    property <length> dates-y: 0px;
    property <[string]> menu-items: root.menu-src == 0 ? root.timeframes
        : root.menu-src == 1 ? root.rankby-labels
        : ["Cumulative P&L", "Daily P&L", "Return %"];
    property <string> menu-current: root.menu-src == 0 ? root.lab.timeframe-label
        : root.menu-src == 1 ? (root.lab.rankby-current >= 0 && root.lab.rankby-current < root.rankby-labels.length
            ? root.rankby-labels[root.lab.rankby-current] : "")
        : (root.lab.equity-select == 1 ? "Daily P&L" : root.lab.equity-select == 2 ? "Return %" : "Cumulative P&L");

    // Anchor a floating surface at window coordinates (x, y) with width w.
    // The screen can be embedded (lab host) or inside the shell window, so
    // positions are converted from window space into this component's space.
    function open-menu(src: int, x: length, y: length, w: length) {
        root.menu-src = src;
        root.dates-open = false;
        root.menu-x = x - root.absolute-position.x;
        root.menu-y = y - root.absolute-position.y;
        root.menu-w = w;
    }
    function close-floating() {
        root.menu-src = -1;
        root.dates-open = false;
    }

    in property <bool> head-roomy: true;

    callback library-picked(int);
    callback filter-picked(int);
    callback search-changed(string);
    callback mode-picked(int);
    callback tab-picked(int);
    callback run-requested();
    callback run-cancel-requested();
    callback save-requested();
    callback compile-requested();
    callback new-requested();
    callback row-menu(int);
    callback rank-picked(string);
    // Virtual-window scroll surface (spec §8: the frame path is O(1) window
    // arithmetic, never a data re-sort).
    callback rank-scrolled(float);
    callback rank-scroll-to(float);
    callback rank-viewport-reported(length);
    callback trade-picked(int);
    // Trade blotter surface: scroll, search, sort, filters and the detail close.
    // `spec §19`: the scroll path only re-lays the window.
    callback trade-scrolled(float);
    callback trade-search-changed(string);
    callback trade-sort-picked(int);
    callback trade-side-picked(int);
    callback trade-result-picked(int);
    callback trade-viewport-reported(length);
    callback trade-detail-close();
    callback export-trades-requested();
    callback code-changed(string);
    callback param-committed(string, string);
    callback timeframe-picked(string);
    callback range-preset-picked(int);
    callback capital-committed(string);
    callback dates-committed(string, string);
    callback sym-open();
    callback sym-close();
    callback sym-search-changed(string);
    callback sym-toggle(string);
    callback sym-all-visible();
    callback sym-clear();
    callback sym-apply();
    callback rank-search-changed(string);
    callback rankby-picked(string);
    callback rank-order-toggled();
    callback trade-filter-changed(string);
    callback cmp-side-picked(int);
    callback run-buy-requested();
    callback run-sell-requested();
    callback run-all-requested();
    // Reference redesign callbacks.
    callback lens-picked(int);
    callback inspector-close();
    callback diag-link-clicked();
    callback equity-select-picked(int);
    callback reset-requested();


    background: LabPalette.lab-bg;

    // ══════════════ VAYREN Strategy Lab — reference 1:1 layout ══════════════

    in property <bool> insp-open: root.lab.detail-symbol != "";
    in property <bool> wide: root.width > LabPalette.bp-wide;
    property <int> rail-active: root.lab.run-stop ? 2
        : root.lab.dirty ? 5
        : root.insp-open ? 4
        : root.lab.outdated ? 2
        : root.lab.show-results ? 3
        : 1;

    VerticalLayout {
        spacing: 0;

        // ── WORKSPACE (scrollable page) ──
        ScrollView {
            vertical-stretch: 1;
            viewport-width: root.width - 2px;
            // A bare wrapper Rectangle has no implicit size, so the default
            // viewport stayed window-tall and the page could never scroll;
            // the document height must be stated explicitly.
            viewport-height: Math.max(self.height, wsdoc.min-height);
            Rectangle {
                width: Math.min(root.width, LabPalette.max-w);
                // On wide displays the page keeps its measure and centres;
                // left-pinning it would strand the right half of the screen.
                x: Math.max(0px, (root.width - self.width) / 2);
                wsdoc := VerticalLayout {
                    padding-left: LabPalette.ws-px;
                    padding-right: LabPalette.ws-px;
                    padding-top: LabPalette.ws-py;
                    spacing: LabPalette.section-gap;

                    // ════ 01 DEFINE ════
                    VerticalLayout {
                        spacing: 0;
                        // A nested VerticalLayout is sized to its CONTENT on the
                        // cross axis, so without this the section collapses to the
                        // width of the name/description and the 380px objects
                        // column is stranded mid-page instead of on the right
                        // edge. Stated here so the width no longer depends on a
                        // sibling's self-referential `parent.width` binding.
                        horizontal-stretch: 1;
                        LabEyebrow { eyebrow-text: "01 · DEFINE THE RESEARCH OBJECT"; }
                        HorizontalLayout {
                            spacing: 26px;
                            Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    spacing: 0;
                                    // Every child below states its height, and
                                    // the leftover goes to ONE trailing slack
                                    // sink. This column is shorter than the
                                    // RESEARCH OBJECTS column beside it, and an
                                    // unsized child of a VerticalLayout absorbs
                                    // all of that slack — which is how the mode
                                    // row first ended up 130px below the
                                    // description, pinned to the bottom by
                                    // `alignment: end`. Stating the mode row's
                                    // height alone only moved the problem: the
                                    // NAME then took the slack instead and
                                    // stretched to 280px. The sink makes the
                                    // column deterministic: name, description,
                                    // mode, all packed from the top.
                                    Text {
                                        text: root.lab.name == "" ? "NO STRATEGY" : root.lab.name;
                                        font-size: root.wide ? 44px : 34px;
                                        height: root.wide ? 56px : 46px;
                                        font-weight: 650;
                                        letter-spacing: -1.5px;
                                        color: LabPalette.lab-text;
                                    }
                                    Rectangle { height: 8px; }
                                    Text {
                                        text: root.lab.description;
                                        font-size: 13px;
                                        height: 19px;
                                        color: LabPalette.lab-muted;
                                    }
                                    Rectangle { height: 10px; }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        height: 36px;
                                        alignment: start;
                                        Rectangle {
                                            height: 36px;
                                            border-radius: 9px;
                                            background: LabPalette.inset;
                                            border-width: 1px;
                                            border-color: LabPalette.line;
                                            HorizontalLayout {
                                                padding: 3px;
                                                spacing: 0;
                                                for dmode[idx] in ["Long", "Short", "Compare"]: Rectangle {
                                                    width: 84px;
                                                    height: 30px;
                                                    border-radius: 6px;
                                                    background: root.lab.mode == idx ? LabPalette.run-ink : dmsta.pressed ? LabPalette.white-06 : dmsta.has-hover ? LabPalette.white-04 : transparent;
                                                    dmsta := TouchArea {
                                                        clicked => { root.mode-picked(idx); }
                                                    }
                                                    Text {
                                                        text: dmode;
                                                        color: root.lab.mode == idx ? LabPalette.chip-bg : dmsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                        font-size: 11.5px;
                                                        font-weight: root.lab.mode == idx ? 650 : 400;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                visible: root.wide;
                                width: 1px;
                                background: LabPalette.line;
                            }
                            Rectangle {
                                visible: root.wide;
                                width: 380px;
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "RESEARCH OBJECTS";
                                        font-size: 10px;
                                        letter-spacing: 1.4px;
                                        color: LabPalette.dim;
                                        font-weight: 600;
                                    }
                                    ScrollView {
                                        viewport-width: 380px;
                                        // The row beside this column (the DEFINE
                                        // card) can be shorter than the list's
                                        // own content; without a stated height the
                                        // layout squeezed the ScrollView, clipping
                                        // the last strategy under the "+ New
                                        // strategy" button so it could not be
                                        // clicked. Size it to its rows (up to the
                                        // designed 160px cap; beyond that it scrolls).
                                        height: Math.min(160px, root.library.length * 46px + Math.max(0px, (root.library.length - 1) * 8px));
                                        viewport-height: Math.max(self.height, root.library.length * 46px + Math.max(0px, (root.library.length - 1) * 8px));
                                        VerticalLayout {
                                            spacing: 8px;
                                            padding-right: 4px;
                                            for librow in root.library: Rectangle {
                                                height: 46px;
                                                border-radius: 10px;
                                                background: LabPalette.panel;
                                                border-width: 1px;
                                                border-color: librow.selected ? LabPalette.teal-35 : libsta.has-hover ? LabPalette.white-16 : LabPalette.line;
                                                libsta := TouchArea {
                                                    clicked => { root.library-picked(librow.real-index); }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 13px;
                                                    padding-right: 13px;
                                                    spacing: 12px;
                                                    VerticalLayout {
                                                        spacing: 3px;
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: librow.name;
                                                            font-size: 12.5px;
                                                            font-weight: 650;
                                                            color: LabPalette.lab-text;
                                                        }
                                                        Text {
                                                            text: librow.description;
                                                            font-size: 10px;
                                                            color: LabPalette.lab-muted;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Rectangle {
                                                        height: 20px;
                                                        width: libtag.width + 18px;
                                                        border-radius: 99px;
                                                        background: transparent;
                                                        border-width: 1px;
                                                        border-color: librow.selected ? LabPalette.green-30 : LabPalette.line;
                                                        
                                                        libtag := Text {
                                                            text: librow.selected ? "ACTIVE" : "DRAFT";
                                                            color: librow.selected ? LabPalette.green : LabPalette.lab-amber;
                                                            font-size: 10px;
                                                            letter-spacing: 0.8px;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
}
                                        }
                                    }
                                    // The slack sink. Invisible, and the only
                                    // thing in this column allowed to grow.
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                                    }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 10px;
                                        background: transparent;
                                        border-width: 1px;
                                        border-color: newsta.has-hover ? LabPalette.teal-40 : LabPalette.white-16;
                                        newsta := TouchArea {
                                            clicked => { root.new-requested(); }
                                        }
                                        Text {
                                            text: "+ New strategy";
                                            color: newsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                            font-size: 11.5px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Rectangle {
                                            height: 20px;
                                            width: cnttx.width + 18px;
                                            border-radius: 99px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: LabPalette.line;
                                            cnttx := Text {
                                                text: root.lab.strategy-count-line;
                                                color: LabPalette.lab-muted;
                                                font-size: 10px;
                                                letter-spacing: 0.8px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: root.lab.editing-hint;
                                            font-size: 10px;
                                            color: LabPalette.dim;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════ 02 CONFIGURE THE EXPERIMENT ════
                    VerticalLayout {
                        spacing: 0;
                        // The card is the §02 width authority. Every block
                        // inside it sizes off THIS width, never off a width
                        // derived from its own row — a child measuring against
                        // its own container is a self-reference, and Slint
                        // resolves it to an ancestor's width instead.
                        cfgcard := Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: root.lab.config-error != "" ? LabPalette.red-35 : LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                // ── four columns, ONE three-row baseline ──
                                // Every column is label 19 / control 36 /
                                // sub 30 with the same gaps, so the rows line
                                // up across the card. The explicit row height
                                // is what makes that structural, not a hope.
                                cfgrow := HorizontalLayout {
                                    spacing: 0;
                                    height: LabPalette.cfg-col-h + 38px;
                                    // Column widths are EXPLICIT fractions of the
                                    // card, not stretch weights: a weight is only
                                    // distributed over the space the controls do
                                    // not demand, so a control with a wide
                                    // minimum silently steals a column's share.
                                    // 105 / 78 / 138 / 62 over 383 = the mock's
                                    // 1.05 / 0.55 / 1.38 / 0.62.
                                    // UNIVERSE
                                    Rectangle {
                                        width: cfgcard.width * 105 / 383;
                                        VerticalLayout {
                                            padding-left: 22px; padding-right: 22px;
                                            padding-top: 18px; padding-bottom: 20px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "UNIVERSE"; }
                                            Rectangle { height: 12px; }
                                            // Real focus: the control carries the
                                            // accent ring exactly while the
                                            // selector it opens is up.
                                            ucell := LabCtlButton {
                                                ctl-focus: root.lab.sym-open;
                                                ctl-label: root.lab.sym-button-line == "" ? root.lab.universe : root.lab.sym-button-line;
                                                clicked => { root.sym-open(); }
                                            }
                                            // The chip row only earns its 30px when
                                            // it says something the button does not.
                                            // `chips-more-line` is empty exactly when
                                            // every symbol already fits in the button
                                            // line, so on a short universe this row
                                            // used to repeat "A, B, C" verbatim 15px
                                            // below itself. Shown only past the cap,
                                            // where it carries the first symbols the
                                            // button has stopped naming.
                                            if root.lab.chips-more-line != "": Rectangle { height: 15px; }
                                            // Clipping wrapper: six pills overflow a 105/383
                                            // share and used to paint over the TIMEFRAME
                                            // segmented control (`clip` lives on Rectangles in
                                            // Slint 1.17, so the row sits one level in and the
                                            // wrapper does the cutting). The count survives in
                                            // the button ("526 STOCKS").
                                            if root.lab.chips-more-line != "": Rectangle {
                                                clip: true;
                                                height: LabPalette.cfg-sub-h;
                                            HorizontalLayout {
                                                spacing: 5px;
                                                height: 100%;
                                                for chiplbl in root.universe-chips: Rectangle {
                                                    visible: chiplbl != "";
                                                    height: 18px;
                                                    width: chiptx.width + 14px;
                                                    border-radius: 6px;
                                                    background: LabPalette.field-bg;
                                                    border-width: 1px;
                                                    border-color: LabPalette.line2;
                                                    chiptx := Text {
                                                        text: chiplbl;
                                                        font-family: "monospace";
                                                        font-size: 10px;
                                                        color: LabPalette.soft;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.lab.chips-more-line != "": Rectangle {
                                                    height: 18px;
                                                    width: moretx.width + 14px;
                                                    border-radius: 6px;
                                                    background: transparent;
                                                    border-width: 1px;
                                                    border-color: LabPalette.line;
                                                    moretx := Text {
                                                        text: root.lab.chips-more-line;
                                                        font-family: "monospace";
                                                        font-size: 10px;
                                                        color: LabPalette.dim;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            }
                                        }
                                        LabFieldDivider { x: parent.width - 1px; }
                                    }
                                    // TIMEFRAME
                                    Rectangle {
                                        width: cfgcard.width * 78 / 383;
                                        VerticalLayout {
                                            padding-left: 22px; padding-right: 22px;
                                            padding-top: 18px; padding-bottom: 20px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "TIMEFRAME"; }
                                            Rectangle { height: 12px; }
                                            tfctl := LabCtlButton {
                                                ctl-label: root.lab.timeframe-label;
                                                clicked => {
                                                    root.open-menu(0, self.absolute-position.x,
                                                        self.absolute-position.y + self.height + 4px,
                                                        Math.max(self.width, 140px));
                                                }
                                            }
                                            Rectangle { height: 15px; }
                                            // Segmented control over the REAL
                                            // ladder; anything past the cap stays
                                            // one click away behind MORE.
                                            LabSegmented {
                                                items: root.tf-short;
                                                selected-idx: root.lab.tf-short-idx;
                                                more-cell: root.timeframes.length > root.tf-short.length;
                                                picked(i) => {
                                                    if (i >= 0 && i < root.tf-short.length) {
                                                        root.timeframe-picked(root.tf-short[i]);
                                                    }
                                                }
                                                more-picked() => {
                                                    root.open-menu(0, tfctl.absolute-position.x,
                                                        tfctl.absolute-position.y + tfctl.height + 4px,
                                                        Math.max(tfctl.width, 140px));
                                                }
                                            }
                                        }
                                        LabFieldDivider { x: parent.width - 1px; }
                                    }
                                    // DATE RANGE
                                    Rectangle {
                                        width: cfgcard.width * 138 / 383;
                                        VerticalLayout {
                                            padding-left: 22px; padding-right: 22px;
                                            padding-top: 18px; padding-bottom: 20px;
                                            spacing: 0;
                                            LabFieldLabel {
                                                lbl: "DATE RANGE";
                                                hint: "CUSTOM";
                                                hint-accent: true;
                                                hint-clicked() => {
                                                                                        root.dates-open = !root.dates-open;
                                                    if (root.dates-open) {
                                                        root.menu-src = -1;
                                                        root.dates-x = drctl.absolute-position.x - root.absolute-position.x;
                                                        root.dates-y = drctl.absolute-position.y - root.absolute-position.y + drctl.height + 4px;
                                                    }
                                                }
                                            }
                                            Rectangle { height: 12px; }
                                            // One control, two halves. The TO
                                            // half wears the accent only when the
                                            // range really ends at the last
                                            // available bar.
                                            HorizontalLayout {
                                                spacing: 8px;
                                                height: LabPalette.field-h;
                                                drctl := Rectangle {
                                                    horizontal-stretch: 1;
                                                    min-width: 90px;
                                                    height: LabPalette.field-h;
                                                    border-radius: 8px;
                                                    background: LabPalette.field-bg;
                                                    border-width: 1px;
                                                    border-color: root.lab.dates-error != "" ? LabPalette.red-35
                                                        : drta.has-hover ? LabPalette.white-16 : LabPalette.line;
                                                    drta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.dates-open = !root.dates-open;
                                                            if (root.dates-open) {
                                                                root.menu-src = -1;
                                                                root.dates-x = drctl.absolute-position.x - root.absolute-position.x;
                                                                root.dates-y = drctl.absolute-position.y - root.absolute-position.y + drctl.height + 4px;
                                                            }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 11px; padding-right: 11px;
                                                        // `alignment: start`, not `center`:
                                                        // with two children the main-axis
                                                        // `center` packed [FROM, date] as a
                                                        // block and the date's stretch was
                                                        // never honoured, so both dates
                                                        // floated mid-field instead of
                                                        // starting on the same 11px edge the
                                                        // padding declares.
                                                        spacing: 8px; alignment: start;
                                                        Text { text: "FROM"; font-size: 10px; letter-spacing: 1.2px; color: LabPalette.dim; min-width: 0; vertical-alignment: center; }
                                                        Text {
                                                            text: root.lab.range-from-human == "" ? "—" : root.lab.range-from-human;
                                                            font-family: "monospace";
                                                            font-size: 11.5px;
                                                            color: root.lab.range-from-human == "" ? LabPalette.lab-faint : LabPalette.lab-text;
                                                            horizontal-stretch: 1; min-width: 0; overflow: elide; vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                Text { text: "→"; color: LabPalette.lab-faint; font-size: 12px; vertical-alignment: center; }
                                                drectl := Rectangle {
                                                    horizontal-stretch: 1;
                                                    min-width: 90px;
                                                    height: LabPalette.field-h;
                                                    border-radius: 8px;
                                                    background: LabPalette.field-bg;
                                                    border-width: 1px;
                                                    border-color: root.lab.dates-error != "" ? LabPalette.red-35
                                                        : root.lab.range-to-live ? LabPalette.teal-40
                                                        : drtta.has-hover ? LabPalette.white-16 : LabPalette.line;
                                                    drtta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.dates-open = !root.dates-open;
                                                            if (root.dates-open) {
                                                                // Anchored to the FROM half
                                                                // (drctl), NOT to this half:
                                                                // both halves open the SAME
                                                                // picker, so deriving x from
                                                                // whichever half was hit made
                                                                // the overlay jump 190px for
                                                                // no reason the user could see.
                                                                root.menu-src = -1;
                                                                root.dates-x = drctl.absolute-position.x - root.absolute-position.x;
                                                                root.dates-y = drctl.absolute-position.y - root.absolute-position.y + drctl.height + 4px;
                                                            }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 11px; padding-right: 11px;
                                                        spacing: 8px; alignment: start;
                                                        Text {
                                                            text: "TO";
                                                            font-size: 10px; letter-spacing: 1.2px;
                                                            color: root.lab.range-to-live ? LabPalette.lab-teal : LabPalette.dim;
                                                            min-width: 0;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: root.lab.range-to-human == "" ? "—" : root.lab.range-to-human;
                                                            font-family: "monospace";
                                                            font-size: 11.5px;
                                                            color: root.lab.range-to-human == "" ? LabPalette.lab-faint : LabPalette.lab-text;
                                                            horizontal-stretch: 1; min-width: 0; overflow: elide; vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle { height: 15px; }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                height: LabPalette.cfg-sub-h;
                                                LabSegmented {
                                                    items: root.range-preset-labels;
                                                    selected-idx: root.lab.range-preset-idx;
                                                    picked(i) => { root.range-preset-picked(i); }
                                                }
                                                Text {
                                                    text: root.lab.range-span-line;
                                                    font-family: "monospace";
                                                    font-size: 10px;
                                                    letter-spacing: 0.8px;
                                                    color: LabPalette.dim;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if root.lab.dates-error != "": Text {
                                                text: root.lab.dates-error;
                                                font-size: 10px;
                                                color: LabPalette.lab-red;
                                                overflow: elide;
                                            }
                                        }
                                        LabFieldDivider { x: parent.width - 1px; }
                                    }
                                    // CAPITAL
                                    Rectangle {
                                        width: cfgcard.width * 62 / 383;
                                        VerticalLayout {
                                            padding-left: 22px; padding-right: 22px;
                                            padding-top: 18px; padding-bottom: 20px;
                                            spacing: 0;
                                            LabFieldLabel { lbl: "CAPITAL"; }
                                            Rectangle { height: 12px; }
                                            LabCtlInput {
                                                pre-fix: "₹";
                                                val: root.lab.cfg-capital;
                                                committed(t) => { root.capital-committed(t); }
                                            }
                                            Rectangle { height: 15px; }
                                            // The other three columns spend their
                                            // 30px sub-row on something the control
                                            // does not already say; CAPITAL spent
                                            // its on nothing. The input stays raw
                                            // digits because it is an edit surface,
                                            // so this is the CONFIRMED read — the
                                            // grouped, ₹-prefixed amount the engine
                                            // will actually parse, i.e. the same
                                            // string the run bar shows. One field,
                                            // two roles: edit, then confirm.
                                            Rectangle {
                                                height: LabPalette.cfg-sub-h;
                                                visible: root.lab.capital-label != "";
                                                HorizontalLayout {
                                                    spacing: 5px; alignment: start;
                                                    Text {
                                                        text: "→";
                                                        font-size: 10px;
                                                        color: LabPalette.dim;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.lab.capital-label;
                                                        font-family: "monospace";
                                                        font-size: 10.5px;
                                                        color: LabPalette.soft;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                // ── DATA COMPLETENESS ──
                                // Hidden entirely unless the kernel actually
                                // measured: a fake 0% bar is worse than no bar.
                                //
                                // Absolute placement off `cfgcard.width` — the
                                // §02 width authority. This strip deliberately
                                // avoids a layout: a `horizontal-stretch` weight
                                // on a bare Rectangle child (and `width: 100%`
                                // inside a stretched layout) both lay the track
                                // out at ZERO in Slint 1.17, which silently
                                // erased the whole bar.
                                if root.lab.cov-on: Rectangle {
                                    height: 44px;
                                    background: LabPalette.panel2;
                                    Rectangle {
                                        x: 22px; y: 19px;
                                        width: 6px; height: 6px;
                                        border-radius: 3px;
                                        background: LabPalette.lab-teal;
                                    }
                                    Text {
                                        x: 40px; y: 13px;
                                        width: 170px; height: 18px;
                                        text: "DATA COMPLETENESS";
                                        font-size: 10.5px; letter-spacing: 1.2px;
                                        color: LabPalette.lab-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        x: 225px; y: 19px;
                                        width: cfgcard.width * 40 / 100;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: LabPalette.track-bg;
                                        border-width: 1px;
                                        border-color: LabPalette.line2;
                                        clip: true;
                                        Rectangle {
                                            height: 100%;
                                            border-radius: 3px;
                                            background: root.lab.cov-kind == 2 ? LabPalette.lab-red
                                                : root.lab.cov-kind == 1 ? LabPalette.lab-amber : LabPalette.lab-teal;
                                            width: parent.width * root.cov-shown / 100;
                                            animate width { duration: 900ms; easing: ease-out; }
                                        }
                                    }
                                    Text {
                                        x: cfgcard.width * 40 / 100 + 249px; y: 13px;
                                        width: 52px; height: 18px;
                                        text: root.cov-shown + "%";
                                        font-family: "monospace";
                                        font-size: 13px;
                                        color: LabPalette.lab-text;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    // "VERIFIED" would overstate a bounded
                                    // probe, so the caption states what was read.
                                    Text {
                                        x: cfgcard.width * 40 / 100 + 311px; y: 15px;
                                        width: 72px; height: 14px;
                                        text: root.lab.cov-caption;
                                        font-size: 10px; letter-spacing: 1.2px;
                                        color: LabPalette.dim;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        x: cfgcard.width * 40 / 100 + 393px; y: 13px;
                                        width: cfgcard.width * 60 / 100 - 415px; height: 18px;
                                        text: root.lab.cov-note;
                                        font-size: 10.5px;
                                        color: LabPalette.lab-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                                // ── LIVE RUN PROGRESS ──
                                // Every value below was measured by the
                                // backend after real work finished. There is
                                // no local ticker: if the backend stops
                                // sending, the panel freezes exactly where it
                                // was, which is what "stuck" must look like.
                                if root.lab.prog-active: Rectangle {
                                    height: 132px;
                                    background: LabPalette.panel2;
                                    VerticalLayout {
                                        padding-left: 22px; padding-right: 22px;
                                        padding-top: 14px; padding-bottom: 14px;
                                        spacing: 9px;
                                        HorizontalLayout {
                                            spacing: 12px; alignment: center;
                                            Text {
                                                text: root.lab.prog-cancelled ? "CANCELLED" : "RUNNING";
                                                font-size: 11px; letter-spacing: 2px; font-weight: 700;
                                                color: root.lab.prog-cancelled ? LabPalette.lab-amber
                                                    : root.lab.prog-long ? LabPalette.lab-amber : LabPalette.lab-teal;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                // Empty when healthy: a dash here would read as a
                                                // status the run never reported.
                                                text: root.lab.prog-watchdog;
                                                font-size: 10px;
                                                color: root.lab.prog-watchdog != "" ? LabPalette.lab-amber : LabPalette.lab-faint;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.lab.prog-headline + "   " + (Math.round(root.lab.prog-pct * 10) / 10) + "%";
                                                font-family: "monospace"; font-size: 11px;
                                                color: LabPalette.lab-text; vertical-alignment: center;
                                            }
                                        }
                                        // overall bar (absolute off the padded
                                        // parent: a stretched weight lays out
                                        // at ZERO in Slint 1.17, like the
                                        // coverage strip below documents).
                                        progtrack := Rectangle {
                                            width: parent.width - 44px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: LabPalette.track-bg;
                                            border-width: 1px;
                                            border-color: LabPalette.line2;
                                            clip: true;
                                            Rectangle {
                                                height: 100%;
                                                border-radius: 3px;
                                                background: root.lab.prog-cancelled ? LabPalette.lab-amber : LabPalette.lab-teal;
                                                width: parent.width * root.lab.prog-pct / 100;
                                                animate width { duration: 300ms; easing: ease-out; }
                                            }
                                        }
                                        // current symbol + its own sub-stage bar
                                        HorizontalLayout {
                                            spacing: 10px; alignment: center;
                                            Text {
                                                text: "CURRENT";
                                                font-size: 10px; letter-spacing: 1.2px;
                                                color: LabPalette.dim; vertical-alignment: center;
                                            }
                                            Text {
                                                text: root.lab.prog-current;
                                                font-family: "monospace"; font-size: 12px;
                                                color: LabPalette.lab-text; vertical-alignment: center;
                                            }
                                            Text {
                                                text: "STAGE";
                                                font-size: 10px; letter-spacing: 1.2px;
                                                color: LabPalette.dim; vertical-alignment: center;
                                            }
                                            Text {
                                                text: root.lab.prog-stage;
                                                font-size: 10.5px;
                                                color: LabPalette.lab-muted; vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Rectangle {
                                                width: stagetx.width + 16px;
                                                height: 16px;
                                                border-radius: 4px;
                                                background: LabPalette.field-bg;
                                                border-width: 1px;
                                                border-color: LabPalette.line2;
                                                stagetx := Text {
                                                    text: Math.round(root.lab.prog-stage-pct) + "%";
                                                    font-family: "monospace"; font-size: 10px;
                                                    color: LabPalette.dim;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 16px; alignment: center;
                                            Text {
                                                text: root.lab.prog-counts;
                                                font-size: 10.5px;
                                                color: LabPalette.lab-muted;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: "Elapsed " + root.lab.prog-elapsed
                                                    + "   ETA " + root.lab.prog-eta
                                                    + "   " + root.lab.prog-throughput;
                                                font-family: "monospace"; font-size: 10px;
                                                color: LabPalette.dim; vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 116px;
                                                height: 28px;
                                                border-radius: 7px;
                                                background: cbnta.has-hover ? LabPalette.run-error-bg : transparent;
                                                border-width: 1px;
                                                border-color: cbnta.has-hover ? LabPalette.red-35 : LabPalette.white-16;
                                                cbnta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.run-cancel-requested(); }
                                                }
                                                Text {
                                                    text: "CANCEL RUN";
                                                    font-size: 10px; letter-spacing: 1.2px; font-weight: 650;
                                                    color: cbnta.has-hover ? LabPalette.red-soft : LabPalette.soft;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if root.lab.prog-failed-line != "": Text {
                                            text: root.lab.prog-failed-line;
                                            font-size: 10.5px;
                                            color: LabPalette.lab-red;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                                // ── RUN BAR: checks · action · real facts ──
                                Rectangle {
                                    height: 68px;
                                    background: LabPalette.panel2;
                                    HorizontalLayout {
                                        padding-left: 22px; padding-right: 22px;
                                        spacing: 20px; alignment: center;
                                        // left 1fr — a horizontal ScrollView, not a bare
                                        // row: a long fail reason (the backend's verbatim
                                        // `config-error`, which the operator MUST see) used
                                        // to shove the state label, RUN control and the
                                        // universe/capital facts off the card edge. Now the
                                        // verdicts scroll in place and the controls stay put.
                                        // Clean states fit without scrolling, so the strip
                                        // looks exactly as before when nothing is wrong.
                                        ScrollView {
                                            horizontal-stretch: 1;
                                            height: 22px;
                                            horizontal-scrollbar-policy: always-off;
                                            vertical-scrollbar-policy: always-off;
                                            HorizontalLayout {
                                            spacing: 16px; alignment: start;
                                            for chk in root.lab.cfg-checks: HorizontalLayout {
                                                spacing: 6px; alignment: center;
                                                Text {
                                                    text: chk.kind == 0 ? "✓" : chk.kind == 1 ? "●" : "✕";
                                                    font-size: 10px;
                                                    color: chk.kind == 0 ? LabPalette.green : chk.kind == 1 ? LabPalette.lab-amber : LabPalette.lab-red;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: chk.label;
                                                    font-size: 10.5px;
                                                    color: chk.kind == 2 ? LabPalette.red-soft : LabPalette.lab-muted;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            }
                                        }
                                        // centre auto — the whole run-button
                                        // state matrix, unchanged.
                                        HorizontalLayout {
                                            spacing: 16px; alignment: center;
                                            Text {
                                                text: root.lab.state-label;
                                                font-size: 10.5px;
                                                color: root.lab.state-tone == 2 ? LabPalette.lab-amber
                                                    : root.lab.state-tone == 3 ? LabPalette.lab-red
                                                    : root.lab.state-tone == 1 ? LabPalette.green : LabPalette.dim;
                                                vertical-alignment: center;
                                            }
Rectangle {
                                                width: 170px;
                                                height: 36px;
                                                border-radius: 9px;
                                                // A DISABLED run must stop LOOKING
                                                // enabled. The surface used to keep
                                                // the bright `run-ink` fill while only
                                                // the glyph dropped to 0.6, so during
                                                // a live run the dead button still read
                                                // as the primary call to action. The
                                                // pressed/hover branches stay reachable
                                                // only while the TouchArea is enabled.
                                                background: root.lab.config-error != "" ? LabPalette.run-error-bg
                                                    : root.lab.run-stop ? LabPalette.btn-idle-bg
                                                    : !(root.lab.run-enabled && !root.lab.prog-active && !root.lab.run-stop) ? LabPalette.btn-idle-bg
                                                    : root.lab.show-results && !root.lab.outdated ? rta.pressed ? LabPalette.run-done-press
                                                        : rta.has-hover ? LabPalette.run-done-hover : LabPalette.run-done-bg
                                                    : rta.pressed ? LabPalette.run-press
                                                        : rta.has-hover ? LabPalette.run-hover : LabPalette.run-ink;
                                                border-width: 1px;
                                                border-color: root.lab.show-results && !root.lab.outdated && !root.lab.run-stop ? LabPalette.green-35 : transparent;
                                                rta := TouchArea {
                                                    // A run in flight owns the workspace: a second
                                                    // RUN would race the first one's equity chain.
                                                    enabled: root.lab.run-enabled && !root.lab.prog-active && !root.lab.run-stop;
                                                    mouse-cursor: pointer;
                                                    clicked => { root.run-requested(); }
                                                }
                                                Text {
                                                    text: root.lab.run-label;
                                                    color: root.lab.config-error != "" ? LabPalette.red-soft
                                                        : root.lab.run-stop ? LabPalette.soft2
                                                        : root.lab.show-results && !root.lab.outdated ? LabPalette.green-bright : LabPalette.chip-bg;
                                                    font-size: 12.5px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    opacity: root.lab.run-enabled && !root.lab.prog-active && !root.lab.run-stop ? 1 : 0.6;
                                                }
                                            }
                                            // Keyboard hint, not a state chip. The
                                            // 18px bordered pill was
                                            // indistinguishable from the status
                                            // pills elsewhere on the bar, so it read
                                            // as a fourth piece of run state. Same
                                            // glyphs, same place, no chrome — the
                                            // spacing around it now does the
                                            // separating.
Text {
                                                text: "CTRL + ⏎";
                                                font-family: "monospace";
                                                font-size: 10px;
                                                color: LabPalette.dim;
                                                vertical-alignment: center;
                                            }
                                        }
                                        // right auto — real facts only. The
                                        // mock's "Est. runtime" is gone: nothing
                                        // in this state ever measured one.
                                        // Auto-sized (never stretched): the left verdicts
                                        // own every spare pixel, so a long fail reason
                                        // scrolls inside its own cell instead of stealing
                                        // the facts' share.
                                        HorizontalLayout {
                                            spacing: 22px; alignment: center;
                                            VerticalLayout {
                                                spacing: 3px; alignment: center;
                                                Text { text: "UNIVERSE"; font-size: 10px; letter-spacing: 1.2px; color: LabPalette.dim; }
                                                Text {
                                                    text: root.lab.sym-button-line;
                                                    font-family: "monospace"; font-size: 11px;
                                                    color: LabPalette.soft; vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 3px; alignment: center;
                                                Text { text: "CAPITAL"; font-size: 10px; letter-spacing: 1.2px; color: LabPalette.dim; }
                                                Text {
                                                    text: root.lab.capital-label;
                                                    font-family: "monospace"; font-size: 11px;
                                                    color: LabPalette.soft; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                            }
                        }
                    }

                    // ════ 04 READ ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "03 · READ ONE ANSWER TO THE EXPERIMENT"; }
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                // receipt-top. LEFT-aligned, not centred: this row is a status BAR, and it
                                // shares its left edge with the audit lines below it
                                // (`range-line`, the run hash). The 1fr spacer that
                                // used to centre the flag left a 46px band with one
                                // word adrift in the middle of 1250px, which read as a
                                // layout gap instead of a status — so the spacer is
                                // gone and the flag starts at the same 18px as
                                // everything below.
                                Rectangle {
                                    height: 46px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 14px;
                                        Rectangle {
                                            height: 24px;
                                            width: flagtx.width + 40px;
                                            border-radius: 99px;
                                            background: transparent;
                                            border-width: 1px;
                                            // Reference 1:1 flag priority: CHECK > RUNNING > STALE > CURRENT.
                                            border-color: root.lab.config-error != "" ? LabPalette.red-35
                                                : root.lab.run-stop ? LabPalette.amber-30
                                                : root.lab.outdated ? LabPalette.amber-30 : LabPalette.green-30;
                                            Rectangle {
                                                x: 11px;
                                                y: (parent.height - self.height) / 2;
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: root.lab.config-error != "" ? LabPalette.lab-red
                                                    : root.lab.run-stop ? LabPalette.lab-amber
                                                    : root.lab.outdated ? LabPalette.lab-amber : LabPalette.green;
                                            }
                                            flagtx := Text {
                                                x: 24px;
                                                text: root.lab.config-error != "" ? "CHECK INPUTS"
                                                    : root.lab.run-stop ? "RUNNING"
                                                    : root.lab.outdated ? "STALE — PREVIOUS CONFIG" : "CURRENT";
                                                color: root.lab.config-error != "" ? LabPalette.lab-red
                                                    : root.lab.run-stop ? LabPalette.lab-amber
                                                    : root.lab.outdated ? LabPalette.lab-amber : LabPalette.green;
                                                font-size: 10px;
                                                letter-spacing: 1px;
                                                vertical-alignment: center;
                                                height: parent.height;
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // Nothing to read yet — the receipt says so in
                                // one line and offers the action that resolves
                                // it, instead of a skeleton full of dashes.
                                if !root.lab.show-results && !root.lab.run-stop: Rectangle {
                                    height: 44px;
                                    background: LabPalette.inset;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 12px;
                                        alignment: center;
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        if root.lab.name == "": Rectangle {
                                            height: 26px;
                                            width: emptytx.width + 22px;
                                            border-radius: 7px;
                                            background: emptsta.has-hover ? LabPalette.white-06 : transparent;
                                            border-width: 1px;
                                            border-color: LabPalette.white-16;
                                            emptsta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.new-requested(); }
                                            }
                                            emptytx := Text {
                                                text: "+ New strategy";
                                                font-size: 11px;
                                                color: emptsta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // stale banner — reference 1:1 (Shown vs Yours now).
                                if root.lab.outdated: Rectangle {
                                    height: (root.lab.stale-exec-line != "" || root.lab.stale-cur-line != "") ? 76px : 34px;
                                    background: LabPalette.amber-05;
                                    VerticalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 2px;
                                        alignment: center;
                                        Text {
                                            text: "Configuration changed since this run — this result belongs to a previous configuration.";
                                            font-size: 11px;
                                            color: LabPalette.lab-amber;
                                            overflow: elide;
                                        }
                                        if root.lab.stale-exec-line != "": Text {
                                            text: "Shown: " + root.lab.stale-exec-line;
                                            font-family: "monospace";
                                            font-size: 10px;
                                            color: LabPalette.lab-amber;
                                            overflow: elide;
                                        }
                                        if root.lab.stale-cur-line != "": Text {
                                            text: "Yours now: " + root.lab.stale-cur-line;
                                            font-family: "monospace";
                                            font-size: 10px;
                                            color: LabPalette.lab-amber;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.amber-25; }
                                }
                                // outcome
                                Rectangle {
                                    height: 76px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        spacing: 16px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: "OUTCOME · NET P&L"; font-size: 10px; letter-spacing: 1.4px; color: LabPalette.dim; }
                                            Text {
                                                text: root.lab.result-pnl == "" ? "--" : root.lab.result-pnl;
                                                font-family: "monospace";
                                                font-size: 40px;
                                                font-weight: 600;
                                                letter-spacing: -2px;
                                                color: root.lab.result-pnl-tone == 2 ? LabPalette.green
                                                    : root.lab.result-pnl-tone == 3 ? LabPalette.lab-red : LabPalette.lab-text;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-bottom: 12px;
                                            Text {
                                                visible: root.lab.result-return != "";
                                                text: root.lab.result-return + " return";
                                                font-family: "monospace";
                                                font-size: 13px;
                                                color: root.lab.result-pnl-tone == 2 ? LabPalette.green : LabPalette.lab-red;
                                                vertical-alignment: bottom;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                                // metric groups: SCALE / QUALITY / RISK (kpis model, 3 columns)
                                Rectangle {
                                    height: 130px;
                                    Rectangle {
                                        x: 18px; y: 0;
                                        width: parent.width - 36px; height: 130px;
                                        HorizontalLayout {
                                            spacing: 0;
for grplbl[gidx] in ["SCALE", "QUALITY", "RISK"]: Rectangle {
                                                horizontal-stretch: 1;
                                                height: 22px;
                                                Text {
                                                    text: grplbl;
                                                    font-size: 10.5px;
                                                    letter-spacing: 1px;
                                                    // `x` AND `width` are both stated on
                                                    // purpose. `horizontal-alignment`
                                                    // alone is inert here: an unconstrained
                                                    // Text sizes to its own content, so the
                                                    // property had nothing to align
                                                    // inside and every group header stayed
                                                    // centred over its column while the
                                                    // metrics below sat at the left edge.
                                                    // Binding the width makes the header
                                                    // share the metrics' left edge.
                                                    x: 0;
                                                    width: parent.width;
                                                    horizontal-alignment: left;
                                                    color: LabPalette.dim;
                                                    font-weight: 600;
                                                    y: 8px;
                                                }
                                            }
                                        }
                                        for k[idx] in root.kpis: Rectangle {
                                            visible: idx > 0;
                                            x: Math.mod(idx - 1, 3) * (parent.width / 3);
                                            y: 22px + Math.floor((idx - 1) / 3) * 34px;
                                            width: parent.width / 3 - 18px;
                                            height: 34px;
                                            // Absolute halves, not a stretched
                                            // HorizontalLayout. Two reasons: a
                                            // childless-stretch row does not
                                            // distribute here (the pair stayed
                                            // glued at the left, so "TRADES" and
                                            // its value read as the one token
                                            // "TRADES—"), and this cell already
                                            // positions itself absolutely, so the
                                            // label and the value should be placed
                                            // by the same authority. Label left,
                                            // value right: three scannable columns
                                            // that line up under their headers.
                                            Text {
                                                text: k.label;
                                                font-size: 11px;
                                                color: LabPalette.lab-muted;
                                                x: 0;
                                                width: parent.width * 0.56;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: k.value;
                                                font-family: "monospace";
                                                font-size: 13.5px;
                                                color: k.tone == 2 ? LabPalette.green
                                                    : k.tone == 3 ? LabPalette.lab-red
                                                    : k.tone == 4 ? LabPalette.lab-amber : LabPalette.lab-text;
                                                x: parent.width * 0.56;
                                                width: parent.width * 0.44;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
overflow: elide;
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.white-06; }
                                        }
                                    }
                                }
                                // diagnostics
                                if root.lab.diag-show: Rectangle {
                                    height: 54px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 18px;
                                        spacing: 11px;
                                        alignment: center;
                                        Rectangle {
                                            width: 30px; height: 30px; border-radius: 8px;
                                            background: root.lab.diag-stale ? LabPalette.amber-08 : LabPalette.red-08;
                                            
                                            Text { text: "!"; color: root.lab.diag-stale ? LabPalette.lab-amber : LabPalette.lab-red; font-size: 14px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 4px;
                                            Text { text: root.lab.diag-title; font-size: 12px; font-weight: 650; color: root.lab.diag-stale ? LabPalette.lab-amber : LabPalette.lab-text; overflow: elide; }
                                            Text { text: root.lab.diag-detail; font-size: 11px; color: LabPalette.lab-muted; overflow: elide; }
                                        }
                                        Rectangle {
                                            width: dlttx.width + 8px;
                                            height: 24px;
                                            
                                            dlta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.diag-link-clicked(); }
                                            }
                                            dlttx := Text {
                                                text: "Stocks ↓";
                                                color: dlta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                // risk gate
                                if root.lab.risk-gate-show: Rectangle {
                                    height: 62px;
                                    Rectangle {
                                        x: 18px; y: 8px;
                                        width: parent.width - 36px; height: parent.height - 16px;
                                        border-radius: 10px;
                                        background: LabPalette.red-06;
                                        border-width: 1px;
                                        border-color: LabPalette.red-35;
                                        HorizontalLayout {
                                            padding-left: 14px; padding-right: 14px; spacing: 11px;
                                            Rectangle { width: 30px; height: 30px; border-radius: 8px; background: LabPalette.red-12; 
                                                Text { text: "⊘"; color: LabPalette.lab-red; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 4px;
                                                Text { text: "BLOCKED FROM LIVE — BEYOND RUIN"; font-size: 12px; font-weight: 700; color: LabPalette.lab-red; overflow: elide; }
                                                Text { text: root.lab.risk-gate-text; font-size: 11px; color: LabPalette.lab-muted; overflow: elide; }
                                            }
                                        }
                                    }
                                }
                                // audit lines
                                Rectangle {
                                    height: 30px;
                                    Text {
                                        text: root.lab.range-line;
                                        font-size: 10.5px;
                                        font-family: "monospace";
                                        color: LabPalette.dim;
                                        x: 18px; y: (parent.height - self.height) / 2;
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                                if root.lab.run-id != "" || root.lab.run-ts != "": Rectangle {
                                    height: 26px;
                                    Text {
                                        text: "Run " + root.lab.run-id + "  ·  Hash " + root.lab.cfg-hash + "  ·  " + root.lab.run-ts;
                                        font-size: 10px;
                                        font-family: "monospace";
                                        color: LabPalette.lab-faint;
                                        x: 18px; y: (parent.height - self.height) / 2;
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                            }
                        }
                        // perspectives lens bar
                        Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                spacing: 4px;
                                padding-left: 2px;
                                alignment: center;
                                for lens[idx] in ["Performance", "Trades", "Equity", "Drawdown", "Analytics"]: Rectangle {
                                    height: 100%;
                                    width: lntx.width + 28px;
                                    lsta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.lens-picked(idx); }
                                    }
                                    lntx := Text {
                                        text: lens;
                                        color: root.lab.lens == idx ? LabPalette.lab-text : lsta.has-hover ? LabPalette.soft : LabPalette.dim;
                                        font-size: 11.5px;
                                        font-weight: root.lab.lens == idx ? 600 : 400;
                                        y: (parent.height - self.height) / 2 - 4px;
                                    }
                                    Rectangle {
                                        x: 0; y: parent.height - 2px; width: 100%; height: 2px;
                                        background: root.lab.lens == idx ? LabPalette.lab-teal : transparent;
                                    }
                                }
                            }
                            Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                        }
                        Rectangle { height: 4px; }
                    }

                    // ════ 05 INVESTIGATE ════
                    // The lens selects the perspective: on Trades the stock-level
                    // summary gives way to the individual trade blotter (they are
                    // two different questions, and the blotter is a different
                    // page, not a filter of this table).
                    if root.lab.lens != 1: VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "04 · INVESTIGATE WHERE THE RESULT CAME FROM"; }
                        // Lens 0 (Performance) owns the stock grid + inspector;
                        // every other lens renders its own body below, so hidden
                        // subtrees are never instantiated.
                        if root.lab.lens == 0: VerticalLayout {
                            spacing: 0;
                        // tools row
                        HorizontalLayout {
                            height: 34px;
                            spacing: 9px;
                            Text {
                                text: root.lab.ranking-count;
                                font-size: 10.5px;
                                font-family: "monospace";
                                color: LabPalette.dim;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            LabCtlSearch {
                                width: 170px;
                                ctl-h: 32px;
                                ph: "Search stocks…";
                                val: root.lab.rank-search;
                                changed(t) => { root.rank-search-changed(t); }
                            }
                            rbctl := LabCtlButton {
                                ctl-h: 32px;
                                width: 170px;
                                ctl-label: root.lab.rankby-current >= 0 && root.lab.rankby-current < root.rankby-labels.length
                                    ? root.rankby-labels[root.lab.rankby-current] : "Sort by";
                                clicked => {
                                    root.open-menu(1, self.absolute-position.x,
                                        self.absolute-position.y + self.height + 4px,
                                        Math.max(self.width, 150px));
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        HorizontalLayout {
                            spacing: 12px;
                            // table panel
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0;
                                border-radius: LabPalette.section-radius;
                                background: LabPalette.panel;
                                border-width: 1px;
                                border-color: LabPalette.line;
                                clip: true;
                                // Bounded viewport (spec §1/§12): the table never
                                // grows with the dataset, the header stays
                                // sticky, and the row band is positioned by the
                                // Rust-side window instead of a layout.
                                height: root.lab-rank-window.viewport-h;
                                init => { root.rank-viewport-reported(root.lab-rank-window.viewport-h); }
                                // Window resize re-reports: the Rust window owns
                                // the geometry, the viewport height is the fact.
                                changed height => { root.rank-viewport-reported(self.height); }
                                // Wheel + drag scrolling (`spec §8`: the frame
                                // path only re-lays the window).
                                rank-scroll-area := TouchArea {
                                    scroll-event(ev) => {
                                        if (ev.delta-y == 0px) { return reject; }
                                        let notches = (ev.delta-y / 1px) / 120.0;
                                        root.rank-scrolled(-notches * (root.lab-rank-window.row-h / 1px));
                                        return accept;
                                    }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                            rank-press.pressed = true;
                                            rank-press.offset = root.lab-rank-window.scroll-px / 1px;
                                            rank-press.press-y = self.mouse-y;
                                        } else if (ev.kind == PointerEventKind.move && rank-press.pressed) {
                                            root.rank-scrolled(rank-press.offset - (rank-press.press-y - self.mouse-y) / 1px);
                                        } else if (ev.kind == PointerEventKind.up) {
                                            rank-press.pressed = false;
                                        }
                                    }
                                }
                                rank-press := RankScrollState {
                                    pressed: false;
                                    offset: 0;
                                    press-y: 0px;
                                }
                                // grouped header row
                                Rectangle {
                                    height: 20px;
                                    y: 0;
                                    HorizontalLayout {
                                        spacing: 0;
                                        Rectangle { width: 34px; }
                                        Rectangle { width: 110px; }
                                        Text { text: "OUTCOME"; horizontal-stretch: 2; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { text: "ACTIVITY"; horizontal-stretch: 2; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { text: "QUALITY"; horizontal-stretch: 1; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                        Text { text: "RISK"; horizontal-stretch: 2; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                // header row (sticky: outside the scrolled band)
                                Rectangle {
                                    height: 30px;
                                    y: 20px;
                                    HorizontalLayout {
                                        spacing: 0;
                                        LabTh { th: "#"; tw: 34px; }
                                        LabTh { th: "STOCK"; tw: 110px; ta-left: true; }
                                        LabTh { th: "NET P&L"; stretch: 1; }
                                        LabTh { th: "RETURN"; stretch: 1; }
                                        LabTh { th: "TRADES"; stretch: 1; }
                                        LabTh { th: "WIN %"; stretch: 1; }
                                        LabTh { th: "PF"; stretch: 1; }
                                        LabTh { th: "MAX DD"; stretch: 1; }
                                        LabTh { th: "SHARPE"; stretch: 1; }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                if root.ranking.length == 0: Text {
                                    text: "No rows yet — run the experiment to investigate per-stock results.";
                                    font-size: 11px;
                                    color: LabPalette.dim;
                                    height: 40px;
                                    y: 50px;
                                    x: 14px;
                                    vertical-alignment: center;
                                }
                                // The row band: `root.ranking` holds ONLY the
                                // virtual window (visible + adaptive overscan),
                                // so the rendered element count tracks the
                                // viewport, not the dataset.
                                for rrow[rindex] in root.ranking: Rectangle {
                                    height: root.lab-rank-window.row-h;
                                    y: 50px + rindex * root.lab-rank-window.row-h - root.lab-rank-window.scroll-px;
                                    width: parent.width - (root.lab-rank-window.scrollable ? 10px : 0px);
                                    background: root.lab.detail-symbol == rrow.symbol ? LabPalette.teal-06 : rrta.has-hover ? LabPalette.white-02 : transparent;
                                    rrta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.rank-picked(rrow.symbol); }
                                    }
                                    Rectangle {
                                        visible: root.lab.detail-symbol == rrow.symbol;
                                        x: 0; y: 0; width: 2px; height: 100%;
                                        background: LabPalette.lab-teal;
                                    }
                                    HorizontalLayout {
                                        spacing: 0;
                                        LabTd { td: rrow.rank; tw: 34px; tc: LabPalette.lab-faint; }
                                        LabTd { td: rrow.symbol; tw: 110px; ta-left: true; tc: LabPalette.lab-text; bold: true; no-mono: true; }
                                        LabTd { td: rrow.pnl; stretch: 1; tc: rrow.pnl-tone == 2 ? LabPalette.green : rrow.pnl-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                        LabTd { td: rrow.ret; stretch: 1; tc: rrow.pnl-tone == 2 ? LabPalette.green : rrow.pnl-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                        LabTd { td: rrow.trades; stretch: 1; }
                                        LabTd { td: rrow.win; stretch: 1; }
                                        LabTd { td: rrow.pf; stretch: 1; tc: rrow.pf-tone == 2 ? LabPalette.green : rrow.pf-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                        LabTd { td: rrow.dd; stretch: 1; }
                                        LabTd { td: rrow.sharpe; stretch: 1; }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line2; }
                                }
                                // Scrollbar (`spec §12`): geometry comes from
                                // Rust, drawn only when the data is taller than
                                // the viewport.
                                Rectangle {
                                    visible: root.lab-rank-window.scrollable;
                                    x: parent.width - 6px;
                                    y: 50px;
                                    width: 3px;
                                    height: parent.height - 50px;
                                    background: LabPalette.line2;
                                    Rectangle {
                                        y: root.lab-rank-window.thumb-y;
                                        width: 3px;
                                        height: Math.min(root.lab-rank-window.thumb-h, parent.height - 50px);
                                        border-radius: 2px;
                                        background: LabPalette.white-20;
                                    }
                                    sba := TouchArea {
                                        width: 10px;
                                        x: -7px;
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down) {
                                                sbd.pressed = true;
                                                sbd.press-y = self.mouse-y;
                                            } else if (ev.kind == PointerEventKind.move && sbd.pressed) {
                                                // Same sign as the content drag
                                                // above: thumb down scrolls down.
                                                root.rank-scrolled((self.mouse-y - sbd.press-y) / 1px);
                                                sbd.press-y = self.mouse-y;
                                            } else if (ev.kind == PointerEventKind.up) {
                                                sbd.pressed = false;
                                            }
                                        }
                                    }
                                    sbd := RankScrollState { pressed: false; offset: 0; press-y: 0px; }
                                }
                            }
                            // inspector (in-flow pane on desktop)
                            if root.insp-open && root.wide: Rectangle {
                                width: LabPalette.insp-w;
                                border-radius: LabPalette.section-radius;
                                background: LabPalette.panel3;
                                border-width: 1px;
                                border-color: LabPalette.teal-25;
                                height: 320px;
                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 0;
                                    HorizontalLayout {
                                        height: 44px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            Text { text: root.lab.detail-symbol; font-size: 17px; letter-spacing: 0.2px; color: LabPalette.lab-text; font-weight: 600; }
                                            Text { text: root.lab.detail-caption; font-family: "monospace"; font-size: 10.5px; color: LabPalette.lab-muted; overflow: elide; }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px;
                                            border-radius: 7px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: ixta.has-hover ? LabPalette.white-20 : LabPalette.line;
                                            
                                            ixta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.inspector-close(); }
                                            }
                                            Text { text: "×"; color: ixta.has-hover ? LabPalette.lab-text : LabPalette.lab-muted; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Rectangle { height: 12px; }
                                    Text {
                                        text: root.lab.detail-stats;
                                        font-family: "monospace";
                                        font-size: 26px;
                                        font-weight: 600;
                                        color: root.lab.detail-symbol == "" ? LabPalette.dim : LabPalette.lab-text;
                                        overflow: elide;
                                    }
                                    Rectangle { height: 14px; }
                                    Rectangle {
                                        height: Math.ceil(root.detail-metrics.length / 2) * 46px;
                                        for dm[idx] in root.detail-metrics: Rectangle {
                                            x: Math.mod(idx, 2) * (parent.width / 2);
                                            y: Math.floor(idx / 2) * 46px;
                                            width: parent.width / 2;
                                            height: 46px;
                                            VerticalLayout {
                                                padding-right: 12px;
                                                spacing: 5px;
                                                Text { text: dm.label; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.dim; }
                                                Text { text: dm.value; font-family: "monospace"; font-size: 12.5px; color: LabPalette.lab-text; }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line2; }
                                        }
                                    }
                                    Rectangle { height: 12px; }
                                    Text {
                                        text: "Inspector reflects the last run." + (root.lab.outdated ? " · configuration changed since — rerun to refresh." : "");
                                        font-size: 10px;
                                        color: LabPalette.dim;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        } // lens == 0 grid body (tools + table + inspector)
                        // ── EQUITY (lens 2 page) ──
                        // Lens-exclusive, like every other lens. It used to also
                        // render underneath the Performance lens, so the lens bar
                        // offered "Equity" as a tab while the default tab already
                        // showed the identical card further down the same page —
                        // two answers to "which panel am I looking at?" The Trades
                        // lens has always been exclusive; this makes Equity match.
                        if root.lab.lens == 2: Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                Rectangle {
                                    height: 44px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        alignment: center;
                                        Text { text: "Equity"; font-size: 12.5px; font-weight: 650; color: LabPalette.lab-text; vertical-alignment: center; }
                                        // The measure name used to be spelled out here
                                        // AND inside the view selector sitting 40px to
                                        // the right — on the default view that read as
                                        // "cumulative P&L · …" next to "Cumulative P&L".
                                        // The selector already names the measure and can
                                        // change; the caption's job is the SPAN, which
                                        // the selector never states.
                                        Text { text: root.lab.equity-caption; font-size: 10px; color: LabPalette.dim; vertical-alignment: center; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        eqctl := LabCtlButton {
                                            width: 150px;
                                            ctl-h: 28px;
                                            ctl-label: root.lab.equity-select == 1 ? "Daily P&L" : root.lab.equity-select == 2 ? "Return %" : "Cumulative P&L";
                                            clicked => {
                                                root.open-menu(2, self.absolute-position.x,
                                                    self.absolute-position.y + self.height + 4px,
                                                    Math.max(self.width, 150px));
                                            }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                Rectangle {
                                    height: 230px;
                                    clip: true;
                                    Rectangle {
                                        x: 44px; y: 24px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 74px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 124px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    Rectangle {
                                        x: 44px; y: 174px; width: parent.width - 58px; height: 1px;
                                        background: LabPalette.white-05;
                                    }
                                    if root.equity.length == 0: Text {
                                        text: "NO EQUITY SERIES — run to produce the curve.";
                                        font-size: 11px;
                                        color: LabPalette.dim;
                                        x: 16px; y: (parent.height - self.height) / 2;
                                    }
                                    // Windowed like the rank grid: the first 300
                                    // points bound the element count, the note
                                    // owns the remainder honestly.
                                    for p[pidx] in root.equity: Rectangle {
                                        visible: pidx < 300;
                                        width: 3px;
                                        height: 3px;
                                        border-radius: 2px;
                                        x: 44px + (parent.width - 58px) * (p.x / 1000px);
                                        y: 24px + 150px - 150px * (p.y / 300px);
                                        background: root.lab.result-pnl-tone == 2 ? LabPalette.lab-red : LabPalette.green;
                                    }
                                    if root.equity.length > 300: Text {
                                        text: "sampled across " + root.equity.length + " points";
                                        font-size: 10px;
                                        color: LabPalette.dim;
                                        x: 44px; y: parent.height - 16px;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    height: 56px;
                                    HorizontalLayout {
                                        spacing: 0;
                                        // Grouped + ₹-prefixed, from the same projection the run bar reads. The raw
                                         // `cfg-capital` string showed "10000" here and "₹10,000" 600px
                                         // away in the same view.
                                         LabEqStat { es-label: "STARTING CAPITAL"; es-value: root.lab.capital-label == "" ? "--" : root.lab.capital-label; }
                                        HorizontalLayout { padding-top: 8px; padding-bottom: 8px; Rectangle { width: 1px; background: LabPalette.line2; } }
                                        LabEqStat { es-label: "ENDING CAPITAL"; es-value: root.lab.result-pnl == "" ? "--" : root.lab.result-pnl; es-tone: root.lab.result-pnl-tone; }
                                        HorizontalLayout { padding-top: 8px; padding-bottom: 8px; Rectangle { width: 1px; background: LabPalette.line2; } }
                                        LabEqStat { es-label: "MAX DRAWDOWN"; es-value: root.lab.drawdown-caption == "" ? "--" : root.lab.drawdown-caption; es-tone: 3; }
                                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                            }
                        }
                    }

                    // ════ TRADE BLOTTER (lens: Trades) ════
                    // Individual trade records — the real engine trades, one row
                    // each. Virtualized: the model handed to this page holds only
                    // the visible band, while the scrollbar and the count reflect
                    // the COMPLETE trade list.
                    if root.lab.lens == 1: VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "04 · TRADE BLOTTER — EVERY INDIVIDUAL TRADE"; }
                        // tools row: honest count, search, sort, side + result filters
                        HorizontalLayout {
                            height: 34px;
                            spacing: 9px;
                            Text {
                                text: root.lab.trade-summary;
                                font-size: 10.5px;
                                font-family: "monospace";
                                color: LabPalette.dim;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            LabCtlSearch {
                                width: 170px;
                                ctl-h: 32px;
                                ph: "Search stock or reason…";
                                val: root.lab.trade-needle;
                                changed(t) => { root.trade-search-changed(t); }
                            }
                            sidectl := LabCtlButton {
                                ctl-h: 32px;
                                width: 110px;
                                ctl-label: root.lab.trade-side-filter == 1 ? "Long only" : root.lab.trade-side-filter == 2 ? "Short only" : "All sides";
                                clicked => { root.trade-side-picked(root.lab.trade-side-filter == 2 ? 0 : root.lab.trade-side-filter + 1); }
                            }
                            resultctl := LabCtlButton {
                                ctl-h: 32px;
                                width: 118px;
                                ctl-label: root.lab.trade-result-filter == 1 ? "Winners" : root.lab.trade-result-filter == 2 ? "Losers" : "All results";
                                clicked => { root.trade-result-picked(root.lab.trade-result-filter == 2 ? 0 : root.lab.trade-result-filter + 1); }
                            }
                            sortctl := LabCtlButton {
                                ctl-h: 32px;
                                width: 150px;
                                ctl-label: "Sort · " + (root.lab.trade-sort-labels.length > 0 ? root.lab.trade-sort-labels[Math.min(root.lab.trade-sort, root.lab.trade-sort-labels.length - 1)] : "Entry time");
                                clicked => { root.trade-sort-picked(root.lab.trade-sort + 1 >= root.lab.trade-sort-labels.length ? 0 : root.lab.trade-sort + 1); }
                            }
                        }
                        Rectangle { height: 12px; }
                        // The blotter viewport: bounded, sticky header, windowed
                        // rows, real scrollbar. Same engine as the ranking grid.
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0;
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            height: root.lab-trade-window.viewport-h;
                            init => { root.trade-viewport-reported(root.lab-trade-window.viewport-h); }
                            // Window resize re-reports, same contract as rank.
                            changed height => { root.trade-viewport-reported(self.height); }
                            trade-scroll-area := TouchArea {
                                scroll-event(ev) => {
                                    if (ev.delta-y == 0px) { return reject; }
                                    let notches = (ev.delta-y / 1px) / 120.0;
                                    root.trade-scrolled(-notches * (root.lab-trade-window.row-h / 1px));
                                    return accept;
                                }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                        trade-press.pressed = true;
                                        trade-press.offset = root.lab-trade-window.scroll-px / 1px;
                                        trade-press.press-y = self.mouse-y;
                                    } else if (ev.kind == PointerEventKind.move && trade-press.pressed) {
                                        root.trade-scrolled(trade-press.offset - (trade-press.press-y - self.mouse-y) / 1px);
                                    } else if (ev.kind == PointerEventKind.up) {
                                        trade-press.pressed = false;
                                    }
                                }
                            }
                            trade-press := RankScrollState { pressed: false; offset: 0; press-y: 0px; }
                            // grouped header (sticky: outside the scrolled band)
                            Rectangle {
                                height: 20px;
                                y: 0;
                                HorizontalLayout {
                                    spacing: 0;
                                    Rectangle { width: 46px; }
                                    Rectangle { width: 110px; }
                                    Text { text: "TIMING"; horizontal-stretch: 2; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                    Text { text: "PRICES"; horizontal-stretch: 2; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                    Text { text: "OUTCOME"; horizontal-stretch: 1; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                    Text { text: "HOLD"; horizontal-stretch: 1; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                    Text { text: "EXIT"; horizontal-stretch: 1; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.lab-faint; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                height: 26px;
                                y: 20px;
                                HorizontalLayout {
                                    spacing: 0;
                                    LabTh { th: "#"; tw: 46px; height: 26px; }
                                    LabTh { th: "STOCK"; tw: 110px; ta-left: true; height: 26px; }
                                    LabTh { th: "SIDE"; tw: 64px; height: 26px; }
                                    LabTh { th: "ENTRY"; stretch: 1; height: 26px; }
                                    LabTh { th: "ENTRY PX"; stretch: 1; height: 26px; }
                                    LabTh { th: "EXIT"; stretch: 1; height: 26px; }
                                    LabTh { th: "EXIT PX"; stretch: 1; height: 26px; }
                                    LabTh { th: "P&L"; stretch: 1; height: 26px; }
                                    LabTh { th: "R"; tw: 62px; height: 26px; }
                                    LabTh { th: "BARS"; tw: 58px; height: 26px; }
                                    LabTh { th: "REASON"; tw: 104px; ta-left: true; height: 26px; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                            }
                            // Honest empty: a filter that matches nothing says
                            // so (the summary carries the recorded count),
                            // only a run with no trades at all gets the
                            // generic line.
                            if root.lab.trade-total == 0 && (root.lab.trade-needle != "" || root.lab.trade-side-filter != 0 || root.lab.trade-result-filter != 0): Text {
                                text: root.lab.trade-summary;
                                font-size: 11px;
                                color: LabPalette.dim;
                                height: 30px;
                                y: 46px;
                                x: 14px;
                                vertical-alignment: center;
                            }
                            if root.lab.trade-total == 0 && root.lab.trade-needle == "" && root.lab.trade-side-filter == 0 && root.lab.trade-result-filter == 0: Text {
                                text: "No trades yet — run the backtest to record individual trades.";
                                font-size: 11px;
                                color: LabPalette.dim;
                                height: 30px;
                                y: 46px;
                                x: 14px;
                                vertical-alignment: center;
                            }
                            // The window: `root.trades` carries ONLY the visible
                            // band (viewport + adaptive overscan), so the element
                            // count tracks the viewport, never the trade count.
                            for trow[tindex] in root.trades: Rectangle {
                                height: root.lab-trade-window.row-h;
                                y: 46px + tindex * root.lab-trade-window.row-h - root.lab-trade-window.scroll-px;
                                width: parent.width - (root.lab-trade-window.scrollable ? 10px : 0px);
                                background: trow.selected ? LabPalette.teal-06 : tta.has-hover ? LabPalette.white-02 : transparent;
                                tta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.trade-picked(trow.abs-index); }
                                }
                                Rectangle {
                                    visible: trow.selected;
                                    x: 0; y: 0; width: 2px; height: 100%;
                                    background: LabPalette.lab-teal;
                                }
                                HorizontalLayout {
                                    spacing: 0;
                                    LabTd { td: trow.no; tw: 46px; tc: LabPalette.lab-faint; }
                                    LabTd { td: trow.symbol; tw: 110px; ta-left: true; tc: LabPalette.lab-text; bold: true; no-mono: true; }
                                    LabTd { td: trow.side; tw: 64px; tc: trow.side == "LONG" ? LabPalette.green : LabPalette.lab-red; }
                                    LabTd { td: trow.entry; stretch: 1; }
                                    LabTd { td: trow.entry-px; stretch: 1; }
                                    LabTd { td: trow.exit; stretch: 1; }
                                    LabTd { td: trow.exit-px; stretch: 1; }
                                    LabTd { td: trow.pnl; stretch: 1; tc: trow.pnl-tone == 2 ? LabPalette.green : trow.pnl-tone == 3 ? LabPalette.lab-red : LabPalette.soft; }
                                    LabTd { td: trow.r; tw: 62px; }
                                    LabTd { td: trow.bars; tw: 58px; }
                                    LabTd { td: trow.reason; tw: 104px; ta-left: true; tc: LabPalette.soft; no-mono: true; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line2; }
                            }
                            // scrollbar (geometry from Rust, drawn only when needed)
                            Rectangle {
                                visible: root.lab-trade-window.scrollable;
                                x: parent.width - 6px;
                                y: 46px;
                                width: 3px;
                                height: parent.height - 46px;
                                background: LabPalette.line2;
                                Rectangle {
                                    y: root.lab-trade-window.thumb-y;
                                    width: 3px;
                                    height: Math.min(root.lab-trade-window.thumb-h, parent.height - 46px);
                                    border-radius: 2px;
                                    background: LabPalette.white-20;
                                }
                                tsba := TouchArea {
                                    width: 10px;
                                    x: -7px;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            tsbd.pressed = true;
                                            tsbd.press-y = self.mouse-y;
                                        } else if (ev.kind == PointerEventKind.move && tsbd.pressed) {
                                            // Same sign as the content drag
                                            // above: thumb down scrolls down.
                                            root.trade-scrolled((self.mouse-y - tsbd.press-y) / 1px);
                                            tsbd.press-y = self.mouse-y;
                                        } else if (ev.kind == PointerEventKind.up) {
                                            tsbd.pressed = false;
                                        }
                                    }
                                }
                                tsbd := RankScrollState { pressed: false; offset: 0; press-y: 0px; }
                            }
                        }
                        Rectangle { height: 12px; }
                        // Selected trade detail — built for the ONE clicked trade
                        // (`spec §27`): nothing is precomputed per row.
                        if root.lab.trade-detail-symbol != "": Rectangle {
                            horizontal-stretch: 1;
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel3;
                            border-width: 1px;
                            border-color: LabPalette.teal-25;
                            VerticalLayout {
                                spacing: 0;
                                HorizontalLayout {
                                    spacing: 0;
                                    Text { text: root.lab.trade-detail-symbol; font-size: 16px; font-weight: 600; color: LabPalette.lab-text; vertical-alignment: center; }
                                    Text { text: "  " + root.lab.trade-detail-side; font-size: 10.5px; font-family: "monospace"; color: LabPalette.lab-muted; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    dtx := LabCtlButton {
                                        ctl-h: 26px;
                                        width: 26px;
                                        ctl-label: "×";
                                        clicked => { root.trade-detail-close(); }
                                    }
                                }
                                Rectangle { height: 12px; }
                                HorizontalLayout {
                                    spacing: 0;
                                    for dmetric in root.lab.trade-detail-metrics: VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: dmetric.label; font-size: 10px; letter-spacing: 0.6px; color: LabPalette.dim; }
                                        Text { text: dmetric.value; font-family: "monospace"; font-size: 12.5px; color: dmetric.tone == 2 ? LabPalette.green : dmetric.tone == 3 ? LabPalette.lab-red : LabPalette.lab-text; }
                                    }
                                }
                            }
                        }
                    }

                    // ════ 06 MODIFY ════
                    VerticalLayout {
                        spacing: 0;
                        LabEyebrow { eyebrow-text: "05 · MODIFY CHANGE THE STRATEGY, RESEARCH AGAIN"; }
                        Rectangle {
                            border-radius: LabPalette.section-radius;
                            background: LabPalette.panel;
                            border-width: 1px;
                            border-color: LabPalette.line;
                            clip: true;
                            VerticalLayout {
                                spacing: 0;
                                // studio meta strip
                                Rectangle {
                                    height: 44px;
                                    HorizontalLayout {
                                        spacing: 0;
                                        LabMetaCell { mc-label: "VERSION"; mc-value: root.lab.version == "" ? "—" : root.lab.version; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "MODE"; mc-value: root.lab.mode == 0 ? "LONG" : root.lab.mode == 1 ? "SHORT" : "COMPARE"; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "TIMEFRAME"; mc-value: root.lab.timeframe-label == "" ? "—" : root.lab.timeframe-label; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "REF PF"; mc-value: root.lab.studio-ref-pf == "" ? "—" : root.lab.studio-ref-pf; }
                                        Rectangle { width: 1px; background: LabPalette.line2; }
                                        LabMetaCell { mc-label: "SOURCE"; mc-value: root.lab.studio-source == "" ? "LOCAL" : root.lab.studio-source; }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                Rectangle { height: 12px; }
                                // Explicit height for the same reason the §01
                                // mode row needed one: an unsized child of a
                                // VerticalLayout absorbs the column's leftover,
                                // which parked this caption in the middle of a
                                // 280px void between the meta strip and the
                                // editor it is labelling.
                                HorizontalLayout {
                                    padding-left: 16px;
                                    height: 18px;
                                    Text {
                                        text: "Strategy source — " + (root.lab.description == "" ? "working copy" : root.lab.description);
                                        font-size: 11px;
                                        color: LabPalette.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 380px;
                                    background: LabPalette.code-bg;
                                    TextEdit {
                                        x: 4px; y: 4px;
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                        text: root.lab.code;
                                        font-family: "monospace";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        edited(t) => { root.code-changed(t); }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                                // studio bar
                                Rectangle {
                                    height: 52px;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        alignment: center;
                                        Rectangle {
                                            width: 90px; height: 34px;
                                            border-radius: 8px;
                                            background: LabPalette.inset;
                                            border-width: 1px;
                                            border-color: rstta.has-hover ? LabPalette.white-20 : LabPalette.line;
                                            rstta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.reset-requested(); }
                                            }
                                            Text { text: "Reset"; color: LabPalette.soft; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        Text {
                                            text: root.lab.dirty ? "Unsaved changes — review, then save." : "Saved · no unsaved changes.";
                                            font-size: 10.5px;
                                            color: root.lab.dirty ? LabPalette.lab-amber : LabPalette.dim;
                                            vertical-alignment: center;
                                        }
                                        // Always "Save changes", never "Saved". The
                                        // label used to become "Saved" (at 0.4
                                        // opacity, still a filled 34px pill) the
                                        // moment the buffer was clean — so a status
                                        // and the sentence to its left both said
                                        // "Saved", and a status was wearing a
                                        // button's shape. The action keeps one
                                        // label; the STATE lives in the one line of
                                        // text, which is also where the dirty case
                                        // now gets an amber tint instead of asking
                                        // the eye to parse the word.
                                        Rectangle {
                                            width: 120px; height: 34px;
                                            border-radius: 8px;
                                            background: root.lab.dirty ? LabPalette.run-ink : LabPalette.btn-idle-bg;
                                            svta := TouchArea {
                                                enabled: root.lab.dirty;
                                                mouse-cursor: pointer;
                                                clicked => { root.save-requested(); }
                                            }
                                            Text {
                                                text: "Save changes";
                                                color: root.lab.dirty ? LabPalette.chip-bg : LabPalette.dim;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ════ FOOTER ════
                    // Collapses to nothing when there is nothing to say. The row
                    // was a fixed 56px (+24px tail) that existed only to hold one
                    // right-aligned `progress-label`; with no run in flight that
                    // string is empty and the band rendered as 80px of dead space
                    // under the last card.
                    if root.lab.progress-label != "": Rectangle {
                        height: 40px;
                        HorizontalLayout {
                            padding-right: 18px;
                            spacing: 14px;
                            alignment: center;
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.lab.progress-label; font-size: 10px; color: LabPalette.dim; vertical-alignment: center; }
                        }
                        Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line2; }
                    }
                    Rectangle { height: 24px; }
                }
            }
        }
    }

    // ── UNIVERSE DIALOG (overlay) ──
    if root.lab.sym-open: Rectangle {
        ovlta := TouchArea {
            clicked => { root.sym-close(); }
        }
        background: LabPalette.scrim;
        Rectangle {
            width: Math.min(LabPalette.dialog-w, parent.width - 32px);
            height: 420px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: LabPalette.section-radius;
            background: LabPalette.dialog-bg;
            border-width: 1px;
            border-color: LabPalette.line;
            clip: true;
            // Swallow background clicks (the scrim below would close).
            TouchArea { }
            VerticalLayout {
                spacing: 0;
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 10px;
                        alignment: center;
                        Text { text: "Universe"; font-size: 13px; font-weight: 650; color: LabPalette.lab-text; vertical-alignment: center; }
                        Text { text: root.lab.sym-selected-line; font-size: 10.5px; color: LabPalette.lab-muted; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 22px; height: 22px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-close(); }
                            }
                            Text { text: "×"; color: LabPalette.lab-muted; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: LabPalette.line; }
                }
                Rectangle {
                    height: 48px;
                    LabCtlSearch {
                        x: 16px; y: 6px; width: parent.width - 32px;
                        ctl-h: 36px;
                        ph: "Search stocks…";
                        val: root.lab.sym-search;
                        changed(t) => { root.sym-search-changed(t); }
                    }
                }
                ScrollView {
                    viewport-width: parent.width - 36px;
                    max-height: 280px;
                    VerticalLayout {
                        spacing: 0;
                        for srow[idx] in root.sym-visible: Rectangle {
                            height: 36px;
                            border-radius: 7px;
                            background: srsta.has-hover ? LabPalette.selected2 : transparent;
                            srsta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-toggle(srow); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text { text: srow; font-family: "monospace"; font-size: 11.5px; color: LabPalette.soft; horizontal-stretch: 1; vertical-alignment: center; }
                                // The tick is "✓" (U+2713), NOT "☑" (U+2611),
                                // and the empty state is a DRAWN box, not "☐"
                                // (U+2610). A glyph probe of this dialog's font
                                // showed both ballot-box codepoints painting
                                // nothing — they ship only in Segoe UI Symbol —
                                // so every row in the universe picker showed no
                                // checkbox at all, selected or not, and the one
                                // thing the dialog exists to communicate was
                                // invisible. "✓" renders. The empty box is now a
                                // Rectangle, which cannot go missing.
                                if root.sym-visible-on[idx]: Text {
                                    text: "✓";
                                    color: LabPalette.lab-teal;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if !root.sym-visible-on[idx]: Rectangle {
                                    width: 13px; height: 13px;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: LabPalette.dim;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 54px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: root.lab.sym-count-line; font-family: "monospace"; font-size: 10.5px; color: LabPalette.lab-muted; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Rectangle {
                            width: 62px; height: 34px;
                            border-radius: 8px;
                            background: transparent;
                            border-width: 1px;
                            border-color: clta.has-hover ? LabPalette.white-16 : LabPalette.line;
                            clta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-clear(); }
                            }
                            Text { text: "Clear"; color: LabPalette.lab-muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 52px; height: 34px;
                            border-radius: 8px;
                            background: transparent;
                            border-width: 1px;
                            border-color: alta.has-hover ? LabPalette.white-16 : LabPalette.line;
                            alta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-all-visible(); }
                            }
                            Text { text: "All"; color: LabPalette.lab-muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 70px; height: 34px;
                            border-radius: 8px;
                            background: LabPalette.panel3;
                            border-width: 1px;
                            border-color: cnta.has-hover ? LabPalette.white-16 : LabPalette.line;
                            cnta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-close(); }
                            }
                            Text { text: "Cancel"; color: LabPalette.lab-muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 84px; height: 34px;
                            border-radius: 8px;
                            background: LabPalette.run-ink;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.sym-apply(); }
                            }
                            Text { text: "Apply"; color: LabPalette.chip-bg; font-size: 11.5px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                                    Rectangle { y: 0; height: 1px; width: 100%; background: LabPalette.line; }
                                }
                            }
                        } // equity body (lens 0 + lens 2)
                        // ── DRAWDOWN (lens 3) — caption only until the lens
                        // owns a chart; never an invented curve.
                        if root.lab.lens == 3: Text {
                            text: root.lab.drawdown-caption == "" ? "No drawdown series — run to produce the curve." : root.lab.drawdown-caption;
                            font-size: 11px;
                            color: LabPalette.dim;
                        }
                        // ── ANALYTICS (lens 4) — the verdict line only; the
                        // section below already carries the full facts.
                        if root.lab.lens == 4: Text {
                            text: root.lab.summary-line == "" ? "No analytics yet — run the experiment." : root.lab.summary-line;
                            font-size: 11px;
                            color: LabPalette.dim;
                        }
                    }

    // ── DROPDOWN MENU HOST (overlay; never clipped by section cards) ──
    if root.menu-src >= 0: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        TouchArea {
            clicked => { root.menu-src = -1; }
        }
        Rectangle {
            x: Math.max(6px, Math.min(root.menu-x, parent.width - root.menu-w - 6px));
            y: root.menu-y;
            width: root.menu-w;
            height: root.menu-items.length * 30px + 8px;
            border-radius: 10px;
            background: LabPalette.dialog-bg;
            border-width: 1px;
            border-color: LabPalette.white-16;
            clip: true;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0;
                for mopt in root.menu-items: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: mopt == root.menu-current ? LabPalette.selected2 : mmta.has-hover ? LabPalette.hover2 : transparent;
                    mmta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.menu-src == 0) {
                                root.timeframe-picked(mopt);
                            } else if (root.menu-src == 1) {
                                root.rankby-picked(mopt);
                            } else {
                                root.equity-select-picked(mopt == "Daily P&L" ? 1 : mopt == "Return %" ? 2 : 0);
                            }
                            root.menu-src = -1;
                        }
                    }
                    Text {
                        text: mopt;
                        font-size: 11.5px;
                        color: mopt == root.menu-current ? LabPalette.lab-text : LabPalette.soft;
                        x: 10px; width: parent.width - 20px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── DATE-RANGE PICKER (overlay) ──
    if root.dates-open: Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        TouchArea {
            clicked => { root.dates-open = false; }
        }
        LabDateRangePicker {
            x: Math.max(6px, Math.min(root.dates-x, parent.width - self.width - 6px));
            y: root.dates-y;
            start-days: root.lab.dates-start-days;
            end-days: root.lab.dates-end-days;
            today-days: root.lab.today-days;
            presets: root.date-presets;
            committed(s, e) => {
                root.dates-committed(s, e);
                root.dates-open = false;
            }
            cancelled() => { root.dates-open = false; }
        }
    }
}