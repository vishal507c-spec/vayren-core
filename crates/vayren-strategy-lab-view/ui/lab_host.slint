// Strategy Lab host window — integration glue ONLY, never visual design.
//
// Root `Window` hosting the EXISTING verified `StrategyLabScreen` unmodified
// (all presentation, layout, responsive behavior and styling live in
// `../../vayren-shell/ui/lab.slint`). Every property below is a pure
// pass-through binding; every callback forwards outward for the Rust
// view-model. Nothing here may add, restyle, or recompose content — compare
// against the `app.slint` StrategyLabScreen block (identical bindings).

import { StrategyLabScreen, LabHeader, LabLibraryRow, LabKpi, LabRankRow, LabTradeRow, LabPoint, LabParam, LabDetailMetric, LabBoardCell, LabMatrixRow, LabPreset, LabCheckData, RankWindow } from "../../vayren-shell/ui/lab.slint";

export component LabHostWindow inherits Window {
    title: "VAYREN \u{2014} Strategy Lab";
    background: transparent;
    no-frame: true;

    in-out property <LabHeader> lab;
    in-out property <[LabLibraryRow]> library;
    in-out property <[LabKpi]> kpis;
    in-out property <[LabRankRow]> ranking;
    in-out property <[LabTradeRow]> trades;
    in-out property <[LabPoint]> equity;
    in-out property <[LabPoint]> drawdown;
    in-out property <[LabParam]> params;
    in-out property <[string]> timeframes;
    in-out property <[string]> rankby-labels;
    in-out property <[string]> rank-heads;
    in-out property <[string]> trade-heads;
    in-out property <[LabDetailMetric]> detail-metrics;
    in-out property <[string]> universe-chips;
    in-out property <[LabPoint]> detail-equity;
    in-out property <[string]> board-labels;
    in-out property <[string]> board-columns;
    in-out property <[string]> board-trades;
    in-out property <[LabBoardCell]> board-cells;
    in-out property <int> board-cols: 1;
    in-out property <[LabMatrixRow]> matrix;
    in-out property <[LabRankRow]> compare-ranking;
    in-out property <[LabPoint]> equity-buy;
    in-out property <[LabPoint]> equity-sell;
    in-out property <[LabPoint]> drawdown-buy;
    in-out property <[LabPoint]> drawdown-sell;
    in-out property <[string]> sym-visible;
    in-out property <[bool]> sym-visible-on;
    in-out property <int> filter-active: 0;
    in-out property <[LabPreset]> date-presets;
    // §02 config row (pass-through, same as `app.slint`).
    in-out property <[string]> tf-short;
    in-out property <[string]> range-preset-labels;
    // Ranking virtual-window geometry (pass-through, same as `app.slint`).
    in-out property <RankWindow> lab-rank-window;
    in-out property <RankWindow> lab-trade-window;

    callback library-picked(int);
    callback filter-picked(int);
    callback search-changed(string);
    callback mode-picked(int);
    callback tab-picked(int);
    callback run-requested();
    callback run-cancel-requested();
    callback save-requested();
    callback compile-requested();
    callback new-requested();
    callback row-menu(int);
    callback rank-picked(string);
    callback trade-picked(int);
    callback trade-scrolled(float);
    callback trade-search-changed(string);
    callback trade-sort-picked(int);
    callback trade-side-picked(int);
    callback trade-result-picked(int);
    callback trade-viewport-reported(length);
    callback trade-detail-close();
    callback export-trades-requested();
    callback code-changed(string);
    callback param-committed(string, string);
    callback timeframe-picked(string);
    callback range-preset-picked(int);
    callback capital-committed(string);
    callback dates-committed(string, string);
    callback rank-search-changed(string);
    callback rankby-picked(string);
    callback rank-order-toggled();
    callback trade-filter-changed(string);
    callback cmp-side-picked(int);
    callback run-buy-requested();
    callback run-sell-requested();
    callback run-all-requested();
    callback sym-open();
    callback sym-close();
    callback sym-search-changed(string);
    callback sym-toggle(string);
    callback sym-all-visible();
    callback sym-clear();
    callback sym-apply();
    callback lens-picked(int);
    callback rank-scrolled(float);
    callback rank-scroll-to(float);
    callback rank-viewport-reported(length);
    callback inspector-close();
    callback diag-link-clicked();
    callback equity-select-picked(int);
    callback reset-requested();

    StrategyLabScreen {
        width: 100%;
        height: 100%;
        lab: root.lab;
        library: root.library;
        kpis: root.kpis;
        ranking: root.ranking;
        trades: root.trades;
        equity: root.equity;
        drawdown: root.drawdown;
        params: root.params;
        timeframes: root.timeframes;
        rankby-labels: root.rankby-labels;
        rank-heads: root.rank-heads;
        trade-heads: root.trade-heads;
        detail-metrics: root.detail-metrics;
        universe-chips: root.universe-chips;
        detail-equity: root.detail-equity;
        board-labels: root.board-labels;
        board-columns: root.board-columns;
        board-trades: root.board-trades;
        board-cells: root.board-cells;
        board-cols: root.board-cols;
        matrix: root.matrix;
        compare-ranking: root.compare-ranking;
        equity-buy: root.equity-buy;
        equity-sell: root.equity-sell;
        drawdown-buy: root.drawdown-buy;
        drawdown-sell: root.drawdown-sell;
        sym-visible: root.sym-visible;
        sym-visible-on: root.sym-visible-on;
        date-presets: root.date-presets;
        tf-short: root.tf-short;
        range-preset-labels: root.range-preset-labels;
        lab-rank-window: root.lab-rank-window;
        lab-trade-window: root.lab-trade-window;
        filter-active: root.filter-active;
        head-roomy: root.width >= 1210px;
        library-picked(idx) => { root.library-picked(idx); }
        filter-picked(idx) => { root.filter-picked(idx); }
        search-changed(text) => { root.search-changed(text); }
        mode-picked(idx) => { root.mode-picked(idx); }
        tab-picked(idx) => { root.tab-picked(idx); }
        run-requested() => { root.run-requested(); }
        run-cancel-requested() => { root.run-cancel-requested(); }
        save-requested() => { root.save-requested(); }
        compile-requested() => { root.compile-requested(); }
        new-requested() => { root.new-requested(); }
        row-menu(idx) => { root.row-menu(idx); }
        rank-picked(symbol) => { root.rank-picked(symbol); }
        trade-picked(idx) => { root.trade-picked(idx); }
        trade-scrolled(px) => { root.trade-scrolled(px); }
        trade-search-changed(text) => { root.trade-search-changed(text); }
        trade-sort-picked(idx) => { root.trade-sort-picked(idx); }
        trade-side-picked(idx) => { root.trade-side-picked(idx); }
        trade-result-picked(idx) => { root.trade-result-picked(idx); }
        trade-viewport-reported(h) => { root.trade-viewport-reported(h); }
        trade-detail-close() => { root.trade-detail-close(); }
        export-trades-requested() => { root.export-trades-requested(); }
        code-changed(text) => { root.code-changed(text); }
        param-committed(key, text) => { root.param-committed(key, text); }
        timeframe-picked(text) => { root.timeframe-picked(text); }
        range-preset-picked(idx) => { root.range-preset-picked(idx); }
        capital-committed(text) => { root.capital-committed(text); }
        dates-committed(start, end) => { root.dates-committed(start, end); }
        rank-search-changed(text) => { root.rank-search-changed(text); }
        rankby-picked(text) => { root.rankby-picked(text); }
        rank-order-toggled() => { root.rank-order-toggled(); }
        trade-filter-changed(text) => { root.trade-filter-changed(text); }
        cmp-side-picked(idx) => { root.cmp-side-picked(idx); }
        run-buy-requested() => { root.run-buy-requested(); }
        run-sell-requested() => { root.run-sell-requested(); }
        run-all-requested() => { root.run-all-requested(); }
        sym-open() => { root.sym-open(); }
        sym-close() => { root.sym-close(); }
        sym-search-changed(text) => { root.sym-search-changed(text); }
        sym-toggle(symbol) => { root.sym-toggle(symbol); }
        sym-all-visible() => { root.sym-all-visible(); }
        sym-clear() => { root.sym-clear(); }
        sym-apply() => { root.sym-apply(); }
        lens-picked(idx) => { root.lens-picked(idx); }
        rank-scrolled(px) => { root.rank-scrolled(px); }
        rank-scroll-to(px) => { root.rank-scroll-to(px); }
        rank-viewport-reported(h) => { root.rank-viewport-reported(h); }
        inspector-close() => { root.inspector-close(); }
        diag-link-clicked() => { root.diag-link-clicked(); }
        equity-select-picked(idx) => { root.equity-select-picked(idx); }
        reset-requested() => { root.reset-requested(); }
    }
}
