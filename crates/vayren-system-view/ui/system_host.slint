// System host window — integration glue ONLY, never visual design.
//
// Root `Window` hosting the EXISTING verified `BrokerPanel` unmodified (all
// presentation, layout and styling live in `../../vayren-shell/ui/broker.slint`).
// Every property below is a pure pass-through binding; every action callback
// forwards outward for the host's action drain. Nothing here may add,
// restyle, or recompose content — compare against the `app.slint`
// BrokerPanel instance block.
import { BrokerPanel, BrokerCheckRow } from "../../vayren-shell/ui/broker.slint";
import { BrokerConnectionWorkspace, BrokerRowView, CredentialFieldView, ProgressStepView } from "../../vayren-shell/ui/broker_connection.slint";
import { VayrenPalette, VayrenDesign } from "../../vayren-shell/ui/palette.slint";
import { ScrollView } from "std-widgets.slint";

// One system-health grid row (legacy `SystemHealthPanel` parity): key + value,
// tone follows the legacy stylesheet rule (ok=pos, bad=neg, "--"=muted).
export struct HealthRow {
    label: string,
    value: string,
    tone: int,
}

// One event-log line (legacy `EventLogPanel` parity): level-tagged text.
export struct LogRow {
    text: string,
    tone: int,
}

export component SystemHostWindow inherits Window {
    title: "VAYREN — System";
    background: transparent;
    no-frame: true;

    in-out property <string> broker-name;
    in-out property <string> broker-id;
    in-out property <int> env-kind: 0;
    in-out property <string> env-label;
    in-out property <string> health-label;
    in-out property <bool> health-connected: false;
    in-out property <bool> live-ready: false;
    in-out property <[string]> blockers;
    in-out property <string> status-glyph: "○";
    in-out property <string> status-label: "";
    in-out property <int> status-tone: 0;
    in-out property <string> status-explanation: "";
    in-out property <string> reason-line: "";
    in-out property <string> account-id: "—";
    in-out property <string> conn-label: "Not connected";
    in-out property <int> conn-tone: 0;
    in-out property <string> last-sync: "—";
    in-out property <string> health-summary: "";
    in-out property <int> health-summary-tone: 0;
    in-out property <[BrokerCheckRow]> check-rows;
    in-out property <string> funds-line: "—";
    in-out property <string> funds-sub: "";
    in-out property <string> positions-line: "—";
    in-out property <string> positions-sub: "";
    in-out property <string> orders-line: "—";
    in-out property <string> orders-sub: "";
    in-out property <string> credentials-line: "";
    in-out property <string> callback-display: "—";
    in-out property <bool> refresh-visible: false;
    in-out property <string> refresh-label: "REFRESH";
    in-out property <bool> refresh-enabled: false;
    in-out property <bool> refresh-primary: false;
    in-out property <string> login-label: "CONNECT";
    in-out property <bool> login-enabled: false;
    in-out property <bool> login-primary: false;
    in-out property <string> configure-label: "CONFIGURE";
    in-out property <bool> disconnect-visible: false;
    in-out property <bool> disconnect-enabled: false;
    in-out property <bool> remove-visible: false;

    // System-health grid + event log (legacy `SystemHealthPanel`/`EventLogPanel`
    // parity). Templates/hidden defaults mirror the legacy docks (hidden).
    in-out property <bool> health-open: false;
    in-out property <bool> log-open: false;
    in-out property <[HealthRow]> health-rows;
    in-out property <[LogRow]> log-rows;
    callback health-toggle();
    callback log-toggle();

    callback login-requested();
    callback refresh-requested();
    callback disconnect-requested();
    callback remove-requested();
    callback config-saved(string, string);
    callback copy-callback();
    // Connection workspace intents (retry reuses login, manage reuses
    // refresh, disconnect is shared — same manager methods as before).
    callback select-requested(string);
    callback connect-requested(string, string, string, string, string, string);
    callback help-requested();
    callback add-requested();

    // Connection workspace facts (Rust `BrokerWorkspace` projection).
    in-out property <[BrokerRowView]> conn-brokers;
    in-out property <string> conn-display-name: "";
    in-out property <string> conn-mark: "?";
    in-out property <string> conn-venue-subtitle: "";
    in-out property <string> conn-env-label: "PAPER";
    in-out property <string> conn-description: "Connect your account to start trading.";
    in-out property <string> conn-pill-label: "Not Connected";
    in-out property <int> conn-pill-tone: 3;
    in-out property <string> conn-status-message: "";
    in-out property <[CredentialFieldView]> conn-fields;
    in-out property <[ProgressStepView]> conn-progress;
    in-out property <string> conn-cta-label: "Connect to Broker";
    in-out property <bool> conn-cta-arrow: true;
    in-out property <bool> conn-cta-enabled: false;
    in-out property <bool> conn-form-enabled: true;
    in-out property <bool> conn-is-connected: false;
    in-out property <bool> conn-is-failed: false;
    in-out property <string> conn-error-message: "";
    in-out property <bool> conn-disconnect-visible: false;
    in-out property <bool> conn-disconnect-enabled: false;
    in-out property <string> conn-help-caption: "View setup guide.";

    VerticalLayout {
        spacing: 0;

        // ── collapsible ops sections (legacy dock toggles, native home here) ──
        Rectangle {
            height: 24px;
            background: VayrenPalette.surface;
            HorizontalLayout {
                padding-left: VayrenDesign.sp-md;
                padding-right: VayrenDesign.sp-md;
                spacing: VayrenDesign.sp-sm;
                TouchArea {
                    width: health-lbl.width + 8px;
                    health-lbl := Text {
                        text: root.health-open ? "SYSTEM HEALTH ^" : "SYSTEM HEALTH v";
                        color: root.health-open ? VayrenPalette.text : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    clicked => { root.health-toggle(); }
                }
                TouchArea {
                    width: log-lbl.width + 8px;
                    log-lbl := Text {
                        text: root.log-open ? "EVENT LOG ^" : "EVENT LOG v";
                        color: root.log-open ? VayrenPalette.text : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    clicked => { root.log-toggle(); }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        if root.health-open: Rectangle {
            background: VayrenPalette.surface;
            VerticalLayout {
                padding: VayrenDesign.sp-md;
                spacing: VayrenDesign.sp-sm;
                for row in root.health-rows: HorizontalLayout {
                    Text {
                        text: row.label;
                        color: VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: row.value;
                        color: row.tone == 1 ? VayrenPalette.pos
                            : row.tone == 3 ? VayrenPalette.neg
                            : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.log-open: Rectangle {
            background: VayrenPalette.bg;
            border-color: VayrenPalette.hairline;
            border-width: 1px;
            height: min(200px, log-view.preferred-height + 12px);
            log-view := ScrollView {
                viewport-width: root.width - 2 * VayrenDesign.sp-md;
                VerticalLayout {
                    padding: VayrenDesign.sp-md;
                    spacing: 2px;
                    if root.log-rows.length == 0: Text {
                        text: "No events yet.";
                        color: VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        vertical-alignment: center;
                    }
                    for row in root.log-rows: Text {
                        text: row.text;
                        color: row.tone == 1 ? VayrenPalette.pos
                            : row.tone == 2 ? VayrenPalette.amber
                            : row.tone == 3 ? VayrenPalette.neg
                            : VayrenPalette.muted;
                        font-size: VayrenDesign.fs-label;
                        wrap: no-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: root.width;

            BrokerConnectionWorkspace {
                width: root.width;
                height: max(self.preferred-height, root.height);
                brokers: root.conn-brokers;
                broker-display-name: root.conn-display-name;
                logo-mark: root.conn-mark;
                venue-subtitle: root.conn-venue-subtitle;
                env-label: root.conn-env-label;
                description-line: root.conn-description;
                status-pill-label: root.conn-pill-label;
                status-pill-tone: root.conn-pill-tone;
                status-message: root.conn-status-message;
                fields: root.conn-fields;
                progress: root.conn-progress;
                cta-label: root.conn-cta-label;
                cta-arrow: root.conn-cta-arrow;
                cta-enabled: root.conn-cta-enabled;
                form-enabled: root.conn-form-enabled;
                is-connected: root.conn-is-connected;
                is-failed: root.conn-is-failed;
                error-message: root.conn-error-message;
                disconnect-visible: root.conn-disconnect-visible;
                disconnect-enabled: root.conn-disconnect-enabled;
                help-caption: root.conn-help-caption;
                broker-selected(id) => { root.select-requested(id); }
                connect-requested(v0, v1, v2, v3, v4, v5) => { root.connect-requested(v0, v1, v2, v3, v4, v5); }
                retry-requested() => { root.login-requested(); }
                disconnect-requested() => { root.disconnect-requested(); }
                refresh-requested() => { root.refresh-requested(); }
                help-requested() => { root.help-requested(); }
                add-broker-requested() => { root.add-requested(); }
            }
        }
    }
}

