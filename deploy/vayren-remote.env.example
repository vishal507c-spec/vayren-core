# VAYREN remote transport — PRODUCTION environment template (EC2).
#
# Copy to /etc/vayren/remote.env on the EC2 host, fill in the secrets,
# then:  chown vayren:vayren /etc/vayren/remote.env && chmod 600 /etc/vayren/remote.env
#
# This file is a TEMPLATE ONLY — it ships with NO secrets. The real file
# lives outside source control (.gitignore covers .env). Broker credentials
# (FYERS app id / secret / TOTP / access token) NEVER belong here.

# --- Backend bind (MUST stay loopback; the proxy is the only public face) ---
VAYREN_REMOTE_HOST=127.0.0.1
VAYREN_REMOTE_PORT=8765
VAYREN_REMOTE_PATH=/vayren/v1

# --- Remote client credentials (provision on EC2, see runbook) ---
# Full-control token for operator clients (Windows EXE). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VAYREN_REMOTE_TOKEN=
# Optional read-only token for display-only clients (Android APK status view):
# VAYREN_REMOTE_READ_TOKEN=
# Alternative to the two lines above (one `role:token` per line, 0600):
# VAYREN_REMOTE_TOKEN_FILE=/etc/vayren/remote_tokens.txt

# --- TLS at the backend (leave EMPTY behind the nginx proxy) ---
# The proxy terminates public TLS on 443; backend traffic stays on loopback.
# Set these only if the backend itself must terminate TLS (non-loopback bind
# without them REFUSES to start — see RemoteConfig.check).
# VAYREN_REMOTE_TLS_CERT=/etc/letsencrypt/live/<domain>/fullchain.pem
# VAYREN_REMOTE_TLS_KEY=/etc/letsencrypt/live/<domain>/privkey.pem
# VAYREN_REMOTE_ALLOW_PLAINTEXT=

# --- Timeouts / limits (defaults are EC2-2GB-safe; tune without code edits) ---
VAYREN_REMOTE_AUTH_TIMEOUT_S=10.0
VAYREN_REMOTE_HEARTBEAT_S=20.0
VAYREN_REMOTE_IDLE_TIMEOUT_S=90.0
VAYREN_REMOTE_POLL_S=1.0
VAYREN_REMOTE_MAX_CLIENTS=8
